---
import Layout from './Layout.astro';
import { getSession } from '../utils/auth';
import { db } from '../db/db';
import { vendors as vendorsTable, vendorUsers as vendorUsersTable, payments as paymentsTable } from '../db/schema';
import { eq, and, desc } from 'drizzle-orm';
import { useTranslations, getTranslatedType } from '../utils/i18n';
import { INFO_CHANNEL_URL, SUBSCRIPTION_FEE, TOTAL_FREE, PAYMENT_URL, PAYMENT_TYPE, SALE_URL } from '../config/region';
import { checkVendorActive, formatSubscriptionFee, formatBillingMonth, formatDateString } from '../utils/billing';
import '../styles/admin.css';

interface Props {
  title: string;
  activeTab: 'categories' | 'products' | 'settings' | 'design' | 'analytics' | 'tickets' | 'qr' | 'config' | 'billing';
  vendorSlug: string;
}

const { title, activeTab, vendorSlug } = Astro.props;

// 1. Authenticate user
const session = getSession(Astro.cookies);
const { t, locale, dir } = useTranslations(Astro.cookies, Astro.request);

let redirectUrl: string | null = null;
if (!session) {
  redirectUrl = '/admin/login';
}

let vendor: any = null;
let hasMultipleVendors = false;
let billingStatus: any = null;
let isBillingBlocked = false;
let paymentHistoryList: any[] = [];
let hasPendingPayment = false;
let hasRequiredPayment = false;

if (session) {
  // 2. Fetch vendor
  const vendorList = await db
    .select()
    .from(vendorsTable)
    .where(eq(vendorsTable.slug, vendorSlug))
    .limit(1);

  if (vendorList.length === 0) {
    return new Response(t('vendorNotFound'), { status: 404 });
  }
  vendor = vendorList[0];

  // 3. Verify authorization
  const hasAccess = await db
    .select()
    .from(vendorUsersTable)
    .where(
      and(
        eq(vendorUsersTable.userId, session.userId),
        eq(vendorUsersTable.vendorId, vendor.id)
      )
    )
    .limit(1);

  if (hasAccess.length === 0) {
    redirectUrl = '/admin';
  } else {
    // Update vendor activity timestamp on page loads (exclude super admin)
    if (session.username !== 'super') {
      await db
        .update(vendorsTable)
        .set({ lastActiveAt: new Date() })
        .where(eq(vendorsTable.id, vendor.id));
    }

    // 4. Query user vendor count
    const userVendors = await db
      .select({ id: vendorUsersTable.id })
      .from(vendorUsersTable)
      .where(eq(vendorUsersTable.userId, session.userId));
    hasMultipleVendors = userVendors.length > 1;

    // Billing validation
    billingStatus = await checkVendorActive(vendor);
    isBillingBlocked = !billingStatus.active && session.username !== 'super';

    // Fetch full payment history for this vendor
    paymentHistoryList = await db
      .select()
      .from(paymentsTable)
      .where(eq(paymentsTable.vendorId, vendor.id))
      .orderBy(desc(paymentsTable.createdAt));

    hasPendingPayment = paymentHistoryList.some(pay => pay.status === 'pending');
    hasRequiredPayment = paymentHistoryList.some(pay => pay.status === 'unpaid' || pay.status === 'rejected') || isBillingBlocked;
  }
}

const bannerTranslations = {
  fa: {
    bannerText: 'سفارش‌گیری آنلاین و فروشگاه مجزا را با «پلتفرم فروش» راه‌اندازی کنید!',
    bannerAction: 'مشاهده پلتفرم فروش ⚡',
    bannerBadge: 'جدید'
  },
  tr: {
    bannerText: 'Çevrimiçi sipariş ve bağımsız mağazanızı "Satış Platformu" ile kurun!',
    bannerAction: 'Satış Platformuna Git ⚡',
    bannerBadge: 'Yeni'
  },
  en: {
    bannerText: 'Set up online ordering & your independent store with the "Sales Platform"!',
    bannerAction: 'Go to Sales Platform ⚡',
    bannerBadge: 'New'
  }
};

const bannerT = bannerTranslations[locale as 'fa' | 'en' | 'tr'] || bannerTranslations['en'];

// Authenticated and initialized successfully
---

{redirectUrl ? (
  <script is:inline define:vars={{ redirectUrl }}>
    window.location.href = redirectUrl;
  </script>
) : (
  <Layout title={`${title} — ${t('dashboard')} ${vendor.name}`} description={`${t('dashboard')} - ${vendor.name}`}>
  <!-- Cropper.js CDN Dependencies -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js" is:inline crossorigin="anonymous" referrerpolicy="no-referrer"></script>

  {SALE_URL && (
    <div class="admin-top-banner">
      <div class="banner-content">
        <span class="banner-badge">{bannerT.bannerBadge}</span>
        <span class="banner-text">{bannerT.bannerText}</span>
        <a href={SALE_URL} class="banner-action-btn" target="_blank" rel="noopener noreferrer">
          {bannerT.bannerAction}
        </a>
      </div>
    </div>
  )}

  <div class={`admin-layout-container ${SALE_URL ? 'has-top-banner' : ''}`} style={`direction: ${dir};`}>
    <!-- Mobile Header -->
    <header class="admin-mobile-header">
      <button class="hamburger-btn" id="mobile-nav-toggle" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="nav-icon-svg">
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
      </button>
      
      <span class="mobile-page-title">{title}</span>
      
      <div class="mobile-header-avatar">
        {session.name.substring(0, 1)}
      </div>
    </header>

    <!-- Navigation Backdrop (Mobile) -->
    <div class="admin-sidenav-backdrop" id="sidenav-backdrop"></div>

    <!-- Sidebar Navigation -->
    <aside class="admin-sidenav" id="admin-sidenav">
      <div class="platform-brand">
        <img src="/logo.png" alt="shottt" class="platform-logo-img" />
        
        <!-- Brand small language switcher -->
        <div class="lang-dropdown-container">
          <button type="button" class="brand-lang-trigger" id="brand-lang-trigger" aria-haspopup="listbox" aria-expanded="false">
            <span>{locale.toUpperCase()}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="lang-dropdown-menu" id="brand-lang-menu">
            <button type="button" class={`lang-dropdown-item ${locale === 'fa' ? 'active' : ''}`} data-lang="fa">فارسی</button>
            <button type="button" class={`lang-dropdown-item ${locale === 'en' ? 'active' : ''}`} data-lang="en">English</button>
            <button type="button" class={`lang-dropdown-item ${locale === 'tr' ? 'active' : ''}`} data-lang="tr">Türkçe</button>
          </div>
        </div>
      </div>

      <div class="sidenav-header">
        <div class="brand-badge-wrapper">
          <div class="brand-avatar">
            {vendor.name.substring(0, 1)}
          </div>
          <div class="brand-meta">
            <h2 class="brand-title-name">{vendor.name}</h2>
            <p class="brand-sub-title">{getTranslatedType(vendor.type, t)}</p>
          </div>
        </div>
        <button class="btn-icon mobile-close-nav-btn" id="mobile-nav-close" aria-label="Close">✕</button>
      </div>

      <nav class="sidenav-menu">
        {isBillingBlocked ? (
          <a href="#" class="sidenav-link active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2" />
              <line x1="1" y1="10" x2="23" y2="10" />
            </svg>
            <span>{t('paymentPanel')}</span>
            {hasRequiredPayment ? (
              <span style="font-size: 0.625rem; background-color: #fee2e2; color: #b91c1c; padding: 0.15rem 0.5rem; border-radius: 9999px; font-weight: 600; margin-inline-start: auto; white-space: nowrap;">
                {locale === 'fa' ? 'نیاز به پرداخت' : (locale === 'tr' ? 'Gerekli' : 'Required')}
              </span>
            ) : hasPendingPayment ? (
              <span style="font-size: 0.625rem; background-color: #fef3c7; color: #b45309; padding: 0.15rem 0.5rem; border-radius: 9999px; font-weight: 600; margin-inline-start: auto; white-space: nowrap;">
                {locale === 'fa' ? 'در انتظار بررسی' : (locale === 'tr' ? 'Bekliyor' : 'Pending')}
              </span>
            ) : null}
          </a>
        ) : (
          <>
            <a href={`/admin/${vendorSlug}/products`} class={`sidenav-link ${activeTab === 'products' ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
                <polyline points="21 8 21 21 3 21 3 8" />
                <rect x="1" y="3" width="22" height="5" />
                <line x1="10" y1="12" x2="14" y2="12" />
              </svg>
              <span>{t('products')}</span>
            </a>

            <a href={`/admin/${vendorSlug}/categories`} class={`sidenav-link ${activeTab === 'categories' ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
                <line x1="4" y1="6" x2="20" y2="6" />
                <line x1="4" y1="12" x2="20" y2="12" />
                <line x1="4" y1="18" x2="20" y2="18" />
              </svg>
              <span>{t('categories')}</span>
            </a>

            <a href={`/admin/${vendorSlug}/analytics`} class={`sidenav-link ${activeTab === 'analytics' ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
                <line x1="18" y1="20" x2="18" y2="10" />
                <line x1="12" y1="20" x2="12" y2="4" />
                <line x1="6" y1="20" x2="6" y2="14" />
              </svg>
              <span>{t('analytics')}</span>
            </a>

            <a href={`/admin/${vendorSlug}/design`} class={`sidenav-link ${activeTab === 'design' ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
                <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 14.7255 3.09032 17.1962 4.85857 19C5.03442 19.1758 5.27581 19.2625 5.51864 19.2319L7.49842 18.9818C7.99406 18.919 8.44146 19.2274 8.56396 19.7118L9.04351 21.6067C9.09703 21.8183 9.25667 21.9868 9.46743 22.046C10.2882 22.2764 11.1396 22.3995 12 22Z" />
                <circle cx="7.5" cy="10.5" r="1.5" fill="currentColor" />
                <circle cx="11.5" cy="7.5" r="1.5" fill="currentColor" />
                <circle cx="16.5" cy="9.5" r="1.5" fill="currentColor" />
                <circle cx="15.5" cy="14.5" r="1.5" fill="currentColor" />
              </svg>
              <span>{t('design')}</span>
            </a>

            <a href={`/admin/${vendorSlug}/settings`} class={`sidenav-link ${activeTab === 'settings' ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
              </svg>
              <span>{t('editInfo')}</span>
            </a>

            <a href={`/admin/${vendorSlug}/config`} class={`sidenav-link ${activeTab === 'config' ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
              </svg>
              <span>{t('settings')}</span>
            </a>

            <a href={`/admin/${vendorSlug}/qr`} class={`sidenav-link ${activeTab === 'qr' ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="3" y="14" width="7" height="7" />
                <path d="M14 14h3v3h-3z" />
                <path d="M21 14h-3v3h3z" />
                <path d="M14 21h7v-4h-7z" />
              </svg>
              <span>{t('qrAndLink')}</span>
            </a>

            <a id="sidenav-tickets-link" href={session && session.username === 'super' ? '/admin/super/tickets' : `/admin/${vendorSlug}/tickets`} class={`sidenav-link ${activeTab === 'tickets' ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              </svg>
              <span>{t('supportTickets')}</span>
            </a>

            {!TOTAL_FREE && (
              <a href={`/admin/${vendorSlug}/billing`} class={`sidenav-link ${activeTab === 'billing' ? 'active' : ''}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
                  <rect x="1" y="4" width="22" height="16" rx="2" ry="2" />
                  <line x1="1" y1="10" x2="23" y2="10" />
                </svg>
                <span>{t('payments')}</span>
                {hasRequiredPayment ? (
                  <span style="font-size: 0.625rem; background-color: #fee2e2; color: #b91c1c; padding: 0.15rem 0.5rem; border-radius: 9999px; font-weight: 600; margin-inline-start: auto; white-space: nowrap;">
                    {locale === 'fa' ? 'نیاز به پرداخت' : (locale === 'tr' ? 'Gerekli' : 'Required')}
                  </span>
                ) : hasPendingPayment ? (
                  <span style="font-size: 0.625rem; background-color: #fef3c7; color: #b45309; padding: 0.15rem 0.5rem; border-radius: 9999px; font-weight: 600; margin-inline-start: auto; white-space: nowrap;">
                    {locale === 'fa' ? 'در انتظار بررسی' : (locale === 'tr' ? 'Bekliyor' : 'Pending')}
                  </span>
                ) : null}
              </a>
            )}

            {INFO_CHANNEL_URL && (
              <a href={INFO_CHANNEL_URL} target="_blank" rel="noopener noreferrer" class="sidenav-link external-link">
                {INFO_CHANNEL_URL.includes('t.me') || INFO_CHANNEL_URL.includes('telegram') ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                  </svg>
                ) : INFO_CHANNEL_URL.includes('ble.ir') || INFO_CHANNEL_URL.includes('bale') ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    <path d="M12 7c-1.5 0-2.5 1-2.5 2.5v2.5h2.5c1.5 0 2.5-1 2.5-2.5S13.5 7 12 7z"></path>
                    <line x1="12" y1="15" x2="12" y2="7"></line>
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
                    <path d="m3 11 18-5v12L3 14v-3z"></path>
                    <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path>
                  </svg>
                )}
                <span>{t('infoChannel')}</span>
              </a>
            )}

            <div class="menu-divider"></div>

            <a href={`/${vendorSlug}`} target="_blank" class="sidenav-link external-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg text-gray">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
              <span>{t('viewLiveCatalog')}</span>
            </a>
          </>
        )}
      </nav>

      <div class="sidenav-footer">
        {session.username === 'super' && (
          <a href="/admin/super" class="sidenav-footer-link" style="color: #9f1239; font-weight: 500;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="footer-icon-svg" style="color: #9f1239;">
              <rect x="3" y="3" width="7" height="9" />
              <rect x="14" y="3" width="7" height="5" />
              <rect x="14" y="12" width="7" height="9" />
              <rect x="3" y="16" width="7" height="5" />
            </svg>
            <span>{t('superAdminPanel')}</span>
          </a>
        )}
        
        {hasMultipleVendors && (
          <a href="/admin" class="sidenav-footer-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="footer-icon-svg">
              <path d="M19 12H5" />
              <polyline points="12 19 5 12 12 5" />
            </svg>
            <span>{t('switchVendor')}</span>
          </a>
        )}
        
        <div class="user-meta-badge">
          <div class="user-avatar">
            {session.name.substring(0, 1)}
          </div>
          <div class="user-text-info">
            <span class="user-name-bold">{session.name}</span>
            <span class="user-role-label">{t('vendorManager')}</span>
          </div>
        </div>

        <a href="/api/auth/logout" class="sidenav-footer-link logout-link" style="margin-top: 0.5rem;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="footer-icon-svg">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          <span>{t('logout')}</span>
        </a>
      </div>
    </aside>

    <!-- Main Workspace Content Area -->
    <div class="admin-workspace">
      {isBillingBlocked && activeTab !== 'billing' ? (
        <!-- Blocked View for other pages -->
        <div style="max-width: 32rem; margin: 4rem auto; padding: 0 1.5rem; width: 100%;">
          <div class="admin-card" style="padding: 2.5rem; border-radius: 1.5rem; background: #ffffff; border: 1px solid #e5e5e5; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.5rem;">
            <div style="width: 3.5rem; height: 3.5rem; border-radius: 9999px; background-color: #fef2f2; display: flex; align-items: center; justify-content: center; color: #ef4444;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width: 1.75rem; height: 1.75rem;">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2" />
                <line x1="1" y1="10" x2="23" y2="10" />
              </svg>
            </div>
            <h1 style="font-size: 1.25rem; font-weight: 600; color: #171717; margin: 0;">{t('paymentRequired')}</h1>
            <p style="font-size: 0.875rem; color: #64748b; line-height: 1.6; margin: 0;">
              {locale === 'fa' 
                ? 'به دلیل عدم پرداخت هزینه اشتراک ماهانه، دسترسی شما به پنل موقتاً مسدود شده است. لطفاً هزینه اشتراک را پرداخت نمایید.' 
                : (locale === 'tr' 
                    ? 'Abonelik ücretinin ödenmemesi nedeniyle panel erişiminiz geçici olarak engellenmiştir. Lütfen abonelik ücretini ödeyin.'
                    : 'Due to unpaid monthly subscription, your panel access is temporarily blocked. Please pay the subscription fee to continue.')}
            </p>
            <a href={`/admin/${vendorSlug}/billing`} class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center; height: 2.75rem; width: 100%; border-radius: 0.75rem; font-weight: 600;">
              {t('payments')}
            </a>
          </div>
        </div>
      ) : activeTab === 'billing' ? (
        <!-- Redesigned Billing Page (Table View) -->
        <div style="width: 100%; display: flex; flex-direction: column; gap: 1.5rem;">
