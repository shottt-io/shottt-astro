        <div class="welcome-buttons">
          <button type="button" class="btn btn-secondary" id="welcome-prev-btn" style="visibility: hidden;">{t('prev')}</button>
          <button type="button" class="btn btn-primary" id="welcome-next-btn" data-start-text={t('startPanel')} data-next-text={t('next')}>{t('next')}</button>
        </div>
      </div>
    </div>
  </div>
</Layout>
)}

<script>
  // Mobile navigation drawer toggle logic
  const mobileNavToggle = document.getElementById('mobile-nav-toggle');
  const mobileNavClose = document.getElementById('mobile-nav-close');
  const sidenav = document.getElementById('admin-sidenav');
  const backdrop = document.getElementById('sidenav-backdrop');

  function openNav() {
    sidenav?.classList.add('active');
    backdrop?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeNav() {
    sidenav?.classList.remove('active');
    backdrop?.classList.remove('active');
    document.body.style.overflow = '';
  }

  mobileNavToggle?.addEventListener('click', openNav);
  mobileNavClose?.addEventListener('click', closeNav);
  backdrop?.addEventListener('click', closeNav);

  // Welcome modal logic
  const welcomeOverlay = document.getElementById('welcome-modal-overlay');
  const welcomeClose = document.getElementById('welcome-close-btn');
  const welcomePrev = document.getElementById('welcome-prev-btn') as HTMLButtonElement;
  const welcomeNext = document.getElementById('welcome-next-btn') as HTMLButtonElement;
  const welcomeSlides = document.querySelectorAll('.welcome-slide');
  const welcomeDots = document.querySelectorAll('.welcome-dot');
  
  let currentStep = 0;
  
  function showStep(index: number) {
    welcomeSlides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.add('active');
      } else {
        slide.classList.remove('active');
      }
    });
    
    welcomeDots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add('active');
      } else {
        dot.classList.remove('active');
      }
    });
    
    currentStep = index;
    
    if (welcomePrev) {
      if (currentStep === 0) {
        welcomePrev.style.visibility = 'hidden';
      } else {
        welcomePrev.style.visibility = 'visible';
      }
    }
    
    if (welcomeNext) {
      if (currentStep === welcomeSlides.length - 1) {
        welcomeNext.textContent = welcomeNext.getAttribute('data-start-text') || 'Start';
      } else {
        welcomeNext.textContent = welcomeNext.getAttribute('data-next-text') || 'Next';
      }
    }
  }
  
  function dismissWelcome() {
    const welcomeDontShowAgain = document.getElementById('welcome-dont-show-again') as HTMLInputElement;
    if (welcomeDontShowAgain && welcomeDontShowAgain.checked) {
      localStorage.setItem('shottt_welcome_seen', 'true');
    }
    if (welcomeOverlay) {
      welcomeOverlay.style.display = 'none';
      document.body.style.overflow = '';
    }
  }
  
  if (welcomeOverlay && !localStorage.getItem('shottt_welcome_seen')) {
    welcomeOverlay.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    showStep(0);
    
    welcomeNext?.addEventListener('click', () => {
      if (currentStep < welcomeSlides.length - 1) {
        showStep(currentStep + 1);
      } else {
        dismissWelcome();
      }
    });
    
    welcomePrev?.addEventListener('click', () => {
      if (currentStep > 0) {
        showStep(currentStep - 1);
      }
    });
    
    welcomeDots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        showStep(index);
      });
    });
    
    welcomeClose?.addEventListener('click', dismissWelcome);
  }

  // Lazy-load unread support tickets notification dot for sidenav
  const ticketsLink = document.getElementById('sidenav-tickets-link');
  if (ticketsLink) {
    const isSuper = ticketsLink.getAttribute('href')?.includes('/super/');
    const url = isSuper ? '/api/tickets/unread' : `/api/tickets/unread?vendorSlug=${window.location.pathname.split('/')[2]}`;
    
    fetch(url)
      .then(res => res.json())
      .then(data => {
        if (data.success && data.hasUnread) {
          if (!ticketsLink.querySelector('.sidenav-unread-dot')) {
            const dot = document.createElement('span');
            dot.className = 'sidenav-unread-dot';
            dot.style.cssText = 'width: 8px; height: 8px; background-color: #ef4444; border-radius: 50%; margin-right: auto;';
            ticketsLink.appendChild(dot);
          }
        }
      })
      .catch(err => console.error('Error fetching unread status:', err));
  }


  // Brand Header Small Language Switcher Logic
  const brandLangTrigger = document.getElementById('brand-lang-trigger');
  const brandLangMenu = document.getElementById('brand-lang-menu');
  const brandLangItems = document.querySelectorAll('#brand-lang-menu .lang-dropdown-item');

  brandLangTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = brandLangTrigger.getAttribute('aria-expanded') === 'true';
    brandLangTrigger.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
    brandLangMenu?.classList.toggle('show');
  });

  document.addEventListener('click', (e) => {
    if (brandLangTrigger && brandLangMenu && !brandLangTrigger.contains(e.target as Node) && !brandLangMenu.contains(e.target as Node)) {
      brandLangTrigger.setAttribute('aria-expanded', 'false');
      brandLangMenu.classList.remove('show');
    }
  });

  brandLangItems.forEach(item => {
    item.addEventListener('click', () => {
      const targetLang = item.getAttribute('data-lang');
      if (targetLang) {
        document.cookie = `lang=${targetLang}; path=/; max-age=31536000`;
        window.location.reload();
      }
    });
  });
</script>


