          <input type="checkbox" id="welcome-dont-show-again" class="checkbox-input" style="width: 1.125rem; height: 1.125rem; cursor: pointer; margin: 0;" />
          <span style="font-size: 0.8125rem; color: #525252;">{t('dontShowAgain')}</span>
