          <img src="/welcome-speed.jpeg" alt="speed" class="welcome-img" />
        </div>
      </div>

      <!-- Step 3: Analytics -->
      <div class="welcome-modal-body welcome-slide" data-step="2">
        <div class="welcome-text-side">
          <h3 class="welcome-step-title">{t('welcomeSlide3Title')}</h3>
          <p class="welcome-step-desc">{t('welcomeSlide3Desc')}</p>
