<script>
  // Copy to clipboard logic
  const copyBtns = document.querySelectorAll('.btn-copy-card');
  copyBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const textToCopy = btn.getAttribute('data-copy');
      if (textToCopy) {
        navigator.clipboard.writeText(textToCopy).then(() => {
          const originalText = btn.textContent;
          btn.textContent = btn.getAttribute('data-copied-text') || 'Copied! ✓';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.remove('copied');
          }, 2000);
        }).catch(() => {
          const lang = document.documentElement.lang || 'fa';
          const copyErrorMsg = lang === 'fa' ? 'کپی ناموفق بود. لطفاً کد را دستی کپی کنید.' : (lang === 'tr' ? 'Kopyalama başarısız oldu.' : 'Copy failed. Please copy manually.');
          window.showAlertDialog(copyErrorMsg, { type: 'error' });
        });
      }
    });
  });

  // Submit payment hash
  const paymentForm = document.getElementById('payment-hash-form');
  const paymentSubmitBtn = document.getElementById('btn-submit-payment-hash') as HTMLButtonElement;
  const paymentErrorBanner = document.getElementById('payment-error-banner');
  const paymentSpinner = document.getElementById('payment-submit-spinner');

  paymentForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (paymentErrorBanner) paymentErrorBanner.style.display = 'none';
    if (paymentSubmitBtn) paymentSubmitBtn.disabled = true;
    if (paymentSpinner) paymentSpinner.style.display = 'inline-block';

    const formData = new FormData(paymentForm as HTMLFormElement);
    const hash = 'bunq';
    const paidAt = formData.get('paidAt')?.toString().trim();
    const month = formData.get('month')?.toString().trim();
    const vendorSlug = paymentForm.getAttribute('data-vendor-slug');

    try {
      const response = await fetch('/api/vendor/submit-payment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hash, paidAt, vendorSlug, month }),
      });

      const data = await response.json();
      if (response.ok && data.success) {
        window.location.reload();
      } else {
        throw new Error(data.message || 'Error saving payment hash');
      }
    } catch (err: any) {
      if (paymentErrorBanner) {
        paymentErrorBanner.textContent = err.message || 'Error occurred';
        paymentErrorBanner.style.display = 'block';
      }
      if (paymentSubmitBtn) paymentSubmitBtn.disabled = false;
      if (paymentSpinner) paymentSpinner.style.display = 'none';
    }
  });

  // Toggle payment modal
  const paymentModalOverlay = document.getElementById('payment-modal-overlay');
  const closePaymentModalBtn = document.getElementById('btn-close-payment-modal');
  const triggerModalBtns = document.querySelectorAll('.btn-trigger-payment-modal');
  const inputPaymentDate = document.getElementById('input-payment-date') as HTMLInputElement;
  const inputPaymentMonth = document.getElementById('input-payment-month') as HTMLInputElement;

  function openPaymentModal(month: string, existingHash: string, existingDate: string) {
    if (inputPaymentMonth) {
      inputPaymentMonth.value = month || '';
    }
    const checkboxConfirm = document.getElementById('checkbox-payment-confirm') as HTMLInputElement;
    if (checkboxConfirm) {
      checkboxConfirm.checked = false;
    }
    if (inputPaymentDate) {
      const localDate = new Date();
      const yyyy = localDate.getFullYear();
      const mm = String(localDate.getMonth() + 1).padStart(2, '0');
      const dd = String(localDate.getDate()).padStart(2, '0');
      const todayLocal = `${yyyy}-${mm}-${dd}`;
      
      inputPaymentDate.value = (existingDate && existingDate !== '—') 
        ? existingDate 
        : todayLocal;
    }
    if (paymentErrorBanner) paymentErrorBanner.style.display = 'none';
    if (paymentModalOverlay) {
      paymentModalOverlay.style.display = 'flex';
    }
    document.body.style.overflow = 'hidden';
  }

  function closePaymentModal() {
    if (paymentModalOverlay) {
      paymentModalOverlay.style.display = 'none';
    }
    document.body.style.overflow = '';
  }

  triggerModalBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const month = btn.getAttribute('data-month') || '';
      const hash = btn.getAttribute('data-hash') || '';
      const date = btn.getAttribute('data-date') || '';
      
      // Open payment link in a new tab
      const vendorName = paymentForm?.getAttribute('data-vendor-name') || '';
      const paymentUrl = paymentForm?.getAttribute('data-payment-url') || '';
      const fee = paymentForm?.getAttribute('data-subscription-fee') || '10';
      if (paymentUrl) {
        const url = `${paymentUrl}?description=${encodeURIComponent(vendorName + ' shottt subscription')}&amount=${fee}`;
        window.open(url, '_blank');
      }

      openPaymentModal(month, hash, date);
    });
  });

  closePaymentModalBtn?.addEventListener('click', closePaymentModal);
  paymentModalOverlay?.addEventListener('click', (e) => {
    if (e.target === paymentModalOverlay) {
      closePaymentModal();
    }
  });
</script>

