---
import '../styles/global.css';
import { useTranslations } from '../utils/i18n';
import { SITE_URL } from '../config/region';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  favicon?: string;
  theme?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  localeOverride?: string;
}

const { 
  title, 
  ogImage, 
  canonicalUrl, 
  favicon, 
  theme = 'light',
  twitterCard = 'summary_large_image',
  localeOverride
} = Astro.props;

const { t, locale, dir } = useTranslations(Astro.cookies, Astro.request, localeOverride);

const description = Astro.props.description || t('digitalCatalog');

// Helper to convert relative URLs to absolute URLs
const makeAbsolute = (url?: string) => {
  if (!url) return undefined;
  if (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('data:')) {
    return url;
  }
  const cleanUrl = url.startsWith('/') ? url : `/${url}`;
  const base = SITE_URL ? (SITE_URL.endsWith('/') ? SITE_URL.slice(0, -1) : SITE_URL) : Astro.url.origin;
  return `${base}${cleanUrl}`;
};

// Fallback chain for Open Graph image: ogImage -> favicon -> default site logo
const rawImage = ogImage || favicon || '/logo.png';
const resolvedOgImage = makeAbsolute(rawImage);

let resolvedCanonicalUrl = canonicalUrl;
if (!resolvedCanonicalUrl) {
  if (SITE_URL) {
    const base = SITE_URL.endsWith('/') ? SITE_URL.slice(0, -1) : SITE_URL;
    resolvedCanonicalUrl = `${base}${Astro.url.pathname}${Astro.url.search}`;
  } else {
    resolvedCanonicalUrl = Astro.url.href;
  }
}

const ogLocaleMap = {
  fa: 'fa_IR',
  en: 'en_US',
  tr: 'tr_TR',
};
const ogLocale = ogLocaleMap[locale] || 'en_US';
const siteName = t('siteName');

const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!DOCTYPE html>
<html lang={locale} dir={dir}>
  <head>
    <!-- Google Analytics (GA4) -->
    {gaId && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId);
          window.trackEvent = function(name, params = {}) {
            gtag('event', name, params);
          };
        </script>
      </>
    )}
    <script is:inline>
      if (!window.trackEvent) {
        window.trackEvent = function() {};
      }

      // Universal click tracking for elements with [data-track-cta]
      document.addEventListener('click', function(e) {
        const el = e.target.closest('[data-track-cta]');
        if (el) {
          const ctaName = el.getAttribute('data-track-cta');
          window.trackEvent('cta_click', {
            cta_name: ctaName,
            page_location: window.location.href,
            page_title: document.title
          });
        }
      });
    </script>

    <meta charset="utf-8" />
    {favicon ? (
      <link rel="icon" href={favicon} />
    ) : (
      <>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
      </>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonicalUrl} />
    
    <!-- Open Graph / Facebook / Telegram / Instagram / WhatsApp / Bale -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta property="og:url" content={resolvedCanonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta property="twitter:card" content={twitterCard} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {resolvedOgImage && <meta property="twitter:image" content={resolvedOgImage} />}
  </head>
  <body class={theme === 'dark' ? 'theme-dark' : ''}>
    <div class="site-container animate-fade-in">
      <slot />
    </div>

    <!-- Global Custom Confirm Dialog -->
    <dialog 
      id="global-confirm-dialog" 
      class="custom-confirm-dialog" 
      style={`direction: ${dir};`}
      data-ok-text={t('confirm')}
      data-cancel-text={t('cancel')}
      data-got-it-text={t('gotIt')}
    >
      <div class="confirm-dialog-wrapper">
        <div class="confirm-dialog-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </div>
        <div class="confirm-dialog-content">
          <p id="global-confirm-message" class="confirm-dialog-message"></p>
        </div>
        <div class="confirm-dialog-actions">
          <button id="global-confirm-cancel-btn" class="confirm-btn confirm-btn-secondary">{t('cancel')}</button>
          <button id="global-confirm-ok-btn" class="confirm-btn confirm-btn-danger">{t('confirm')}</button>
        </div>
      </div>
    </dialog>

    <script is:inline>
      window.showConfirmDialog = function(message, options = {}) {
        const dialog = document.getElementById('global-confirm-dialog');
        const messageEl = document.getElementById('global-confirm-message');
        const cancelBtn = document.getElementById('global-confirm-cancel-btn');
        const okBtn = document.getElementById('global-confirm-ok-btn');
        const iconContainer = dialog?.querySelector('.confirm-dialog-icon');
        
        if (!dialog || !messageEl || !cancelBtn || !okBtn || !iconContainer) {
          if (options.isAlert) {
            window.alert(message);
            return Promise.resolve(true);
          }
          return Promise.resolve(window.confirm(message));
        }

        const defaultOkText = dialog.getAttribute('data-ok-text') || 'Confirm';
        const defaultCancelText = dialog.getAttribute('data-cancel-text') || 'Cancel';
        
        messageEl.textContent = message;
        okBtn.textContent = options.okText || defaultOkText;
        cancelBtn.textContent = options.cancelText || defaultCancelText;
        
        // Handle Dialog Type (success, error, warning, info)
        const type = options.type || (options.isAlert ? 'info' : 'warning');
        
        // Reset and set classes
        iconContainer.className = 'confirm-dialog-icon';
        iconContainer.classList.add(`type-${type}`);
        
        // Dynamic Icon Markup
        let iconHtml = '';
        if (type === 'success') {
          iconHtml = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
        } else if (type === 'error') {
          iconHtml = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`;
        } else if (type === 'info') {
          iconHtml = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`;
        } else { // warning
          iconHtml = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`;
        }
        iconContainer.innerHTML = iconHtml;

        // OK Button styles based on type
        if (options.okClass) {
          okBtn.className = `confirm-btn ${options.okClass}`;
        } else {
          if (type === 'success' || type === 'error' || type === 'info') {
            okBtn.className = 'confirm-btn confirm-btn-primary';
          } else {
            okBtn.className = 'confirm-btn confirm-btn-danger';
          }
        }

        // Toggle Cancel Button
        if (options.isAlert) {
          cancelBtn.style.display = 'none';
        } else {
          cancelBtn.style.display = 'inline-flex';
        }

        return new Promise((resolve) => {
          const handleCancel = () => {
            cleanup();
            resolve(false);
          };
          
          const handleOk = () => {
            cleanup();
            resolve(true);
          };
          
          const handleClose = () => {
            cleanup();
            resolve(false);
          };
          
          const cleanup = () => {
            cancelBtn.removeEventListener('click', handleCancel);
            okBtn.removeEventListener('click', handleOk);
            dialog.removeEventListener('close', handleClose);
            dialog.close();
          };
          
          cancelBtn.addEventListener('click', handleCancel);
          okBtn.addEventListener('click', handleOk);
          dialog.addEventListener('close', handleClose);
          
          dialog.showModal();
        });
      };

      window.showAlertDialog = function(message, options = {}) {
        const dialog = document.getElementById('global-confirm-dialog');
        const defaultGotItText = dialog ? (dialog.getAttribute('data-got-it-text') || 'Got it') : 'Got it';
        return window.showConfirmDialog(message, {
          ...options,
          isAlert: true,
          okText: options.okText || defaultGotItText
        });
      };
    </script>
  </body>
</html>

<style is:global>
  /* Local layout wrapper styles */
  .site-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
  }
</style>
