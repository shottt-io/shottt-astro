---
import Layout from '../layouts/Layout.astro';
import { db } from '../db/db';
import { vendors as vendorsTable } from '../db/schema';
import { sql } from 'drizzle-orm';

const randomVendors = await db
  .select({
    name: vendorsTable.name,
    slug: vendorsTable.slug,
    logo: vendorsTable.logo,
  })
  .from(vendorsTable)
  .orderBy(sql`random()`)
  .limit(10);

let marqueeItems = [...randomVendors];
while (marqueeItems.length > 0 && marqueeItems.length < 8) {
  marqueeItems = [...marqueeItems, ...randomVendors];
}
---

<Layout 
  title="شات | پلتفرم کاتالوگ دیجیتال و منوی آنلاین" 
  description="پلتفرم مستقل، رایگان و متمرکز بر سرعت برای ساخت کاتالوگ و منوی دیجیتال مجموعه‌های ایرانی"
  ogImage="/logo.png"
  twitterCard="summary"
>
  <main class="marketing-container">
    
    <div class="content-wrapper animate-slide-up">
      <!-- Big Centered Logo -->
      <div class="logo-container">
        <img src="/logo.png" alt="shottt logo" class="brand-logo-img" />
      </div>

      <!-- Core Messages -->
      <section class="message-section">
        <h1 class="main-statement">شات، صرفاً یک کاتالوگ و منوی دیجیتال ساده است.</h1>
        <p class="sub-statement">
          اگر به دنبال خدمات یا امکانات دیگری هستید، پیشنهاد می‌کنیم به سایر وب‌سایت‌ها سر بزنید؛ چرا که ما در شات خدمتی فراتر از این ارائه نمی‌دهیم.
        </p>
      </section>

      <!-- Actions -->
      <div class="action-section">
        <div class="badge-group">
          <button id="price-trigger" class="price-badge" aria-label="چرا رایگان؟">
            <span class="price-text">تعرفه: رایگان</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="info-icon">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </button>

          <button id="terms-trigger" class="price-badge" aria-label="شرایط ثبت‌نام">
            <span class="price-text">ثبت‌نام: رایگان و آنلاین</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="info-icon">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </button>
        </div>

        <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem; width: 100%; margin-top: 1.5rem;">
          <a href="/admin/register" class="admin-link" style="background-color: #171717; color: #ffffff; padding: 0.75rem 2rem; font-weight: 500; display: flex; align-items: center; gap: 0.5rem; justify-content: center; font-size: 0.9375rem; border-radius: 9999px; text-decoration: none; width: 100%; max-width: 24rem; box-sizing: border-box;">
            <span>ساخت فوری کاتالوگ دیجیتال ⚡</span>
          </a>
          
          <div style="display: flex; gap: 0.75rem; width: 100%; justify-content: center; flex-wrap: wrap;">
            <a href="/admin" class="admin-link admin-link-secondary" style="background-color: transparent; border: 1px solid #e4e4e7; color: #525252;">ورود به پنل مدیریت</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Info Dialog (Modal) -->
    <dialog id="info-dialog" closedby="any" class="custom-dialog">
      <div class="dialog-wrapper">
        <header class="dialog-header">
          <h2 class="dialog-title">چرا رایگان؟</h2>
          <button id="close-dialog" class="close-btn" aria-label="بستن">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>
        <div class="dialog-body">
          <p class="dialog-text">
            ما حدود ۱۰ سال در زمینه ارائه منوی دیجیتال، سیستم سفارش‌گیری، باشگاه مشتریان و خدمات متنوع دیگر فعالیت کردیم؛ اما در طول این سال‌ها با چالش‌ها و شرایطی مواجه شدیم که مسیر توسعه را بسیار دشوار کرد. در سال‌های اخیر تلاش کردیم با حداقل هزینه اشتراک خدماتمان را ادامه دهیم، اما مشکلات مداوم زیرساختی و اینترنت کشور همواره ما را با چالش‌های پایه‌ای و فرساینده روبه‌رو ساخت.
          </p>
          <p class="dialog-text" style="margin-top: 0.75rem;">
            از این رو، تصمیم گرفتیم به دلیل عدم توجیه اقتصادی، امکانات پلتفرم را محدود کنیم. در حال حاضر شات صرفاً بر پایه علاقه شخصی حفظ شده و با ساده‌ترین ابزارها ارائه می‌شود تا کمترین دغدغه فنی را برای شما و ما ایجاد کند. به همین دلیل، تصمیم گرفتیم بابت این امکانات محدود هیچ هزینه‌ای از مجموعه‌ها دریافت نکنیم. امیدواریم روزی شرایط بهبود یابد و امکان ارائه خدمات کامل‌تری فراهم شود. 🖤
          </p>
        </div>
      </div>
    </dialog>

    <!-- Terms Dialog (Modal) -->
    <dialog id="terms-dialog" closedby="any" class="custom-dialog">
      <div class="dialog-wrapper">
        <header class="dialog-header">
          <h2 class="dialog-title">شرایط و نحوه ثبت‌نام</h2>
          <button id="close-terms-dialog" class="close-btn" aria-label="بستن">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>
        <div class="dialog-body">
          <p class="dialog-text">
            عضویت و ایجاد کاتالوگ دیجیتال در شات کاملاً رایگان، آنلاین و آنی است. شما می‌توانید با زدن دکمه «ثبت‌نام مجموعه جدید»، نام مجموعه، آدرس اینترنتی دلخواه و اطلاعات ورود خود را مشخص کرده و بلافاصله مدیریت منوی خود را آغاز کنید. همچنین در صورت داشتن منوی دیجیتال دیگر، می‌توانید از کادر هوش مصنوعی در پایین همین صفحه استفاده کرده و کل محصولات خود را در کسری از ثانیه منتقل کنید.
          </p>
        </div>
      </div>
    </dialog>

    <!-- Random Collections Section -->
    {randomVendors.length > 0 && (
      <section class="collections-section animate-slide-up" style="animation-delay: 0.2s;">
        <h2 class="collections-title">برخی از مجموعه‌ها</h2>
        <div class="marquee-container">
          <div class="marquee-track">
            <div class="marquee-group">
              {marqueeItems.map((vendor) => (
                <a href={`/${vendor.slug}`} class="collection-card">
                  <img src={vendor.logo} alt={vendor.name} class="collection-logo" loading="lazy" />
                  <span class="collection-name">{vendor.name}</span>
                </a>
              ))}
            </div>
            {/* Duplicate group for seamless infinite looping */}
            <div class="marquee-group" aria-hidden="true">
              {marqueeItems.map((vendor) => (
                <a href={`/${vendor.slug}`} class="collection-card">
                  <img src={vendor.logo} alt={vendor.name} class="collection-logo" loading="lazy" />
                  <span class="collection-name">{vendor.name}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}
  </main>

  <script>
    const priceTrigger = document.getElementById('price-trigger');
    const dialog = document.getElementById('info-dialog') as HTMLDialogElement;
    const closeDialog = document.getElementById('close-dialog');

    if (priceTrigger && dialog) {
      priceTrigger.addEventListener('click', () => {
        dialog.showModal();
      });
    }

    if (closeDialog && dialog) {
      closeDialog.addEventListener('click', () => {
        dialog.close();
      });
    }

    // Fallback light-dismiss logic for browsers lacking native support for closedby="any" (e.g. Safari)
    if (dialog && !('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;

        const rect = dialog.getBoundingClientRect();
        const isDialogContent = (
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width
        );

        if (!isDialogContent) {
          dialog.close();
        }
      });
    }

    // Terms Dialog Logic
    const termsTrigger = document.getElementById('terms-trigger');
    const termsDialog = document.getElementById('terms-dialog') as HTMLDialogElement;
    const closeTermsDialog = document.getElementById('close-terms-dialog');

    if (termsTrigger && termsDialog) {
      termsTrigger.addEventListener('click', () => {
        termsDialog.showModal();
      });
    }

    if (closeTermsDialog && termsDialog) {
      closeTermsDialog.addEventListener('click', () => {
        termsDialog.close();
      });
    }

    // Fallback light-dismiss logic for terms dialog
    if (termsDialog && !('closedBy' in HTMLDialogElement.prototype)) {
      termsDialog.addEventListener('click', (event) => {
        if (event.target !== termsDialog) return;

        const rect = termsDialog.getBoundingClientRect();
        const isDialogContent = (
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width
        );

        if (!isDialogContent) {
          termsDialog.close();
        }
      });
    }

    // ── Homepage Analytics Tracking ──────────────────────────────────────
    // Fire-and-forget: track every page view and deduplicate unique visits
    // within a 1-hour window using sessionStorage (same logic as vendor pages).
    (function trackHomepageVisit() {
      const SESSION_KEY = 'hp_unique_visit_ts';
      const ONE_HOUR = 60 * 60 * 1000;

      const now = Date.now();
      const lastVisitStr = sessionStorage.getItem(SESSION_KEY);
      const lastVisit = lastVisitStr ? parseInt(lastVisitStr, 10) : 0;
      const isUnique = (now - lastVisit) > ONE_HOUR;

      if (isUnique) {
        sessionStorage.setItem(SESSION_KEY, String(now));
      }

      fetch('/api/analytics/homepage-track', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pageView: true, uniqueVisit: isUnique }),
      }).catch(() => {});
    })();
  </script>
</Layout>

