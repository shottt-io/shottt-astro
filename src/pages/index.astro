  }

  .close-btn:hover {
    color: #09090b;
    background: #e4e4e7;
  }

  .close-btn svg {
    width: 1rem;
    height: 1rem;
  }

  .dialog-body {
    line-height: 1.8;
  }

  .dialog-text {
    font-size: 0.875rem;
    font-weight: 400;
    color: #444446;
    text-align: justify;
  }

  /* Dialog open animation */
  .custom-dialog[open] {
    animation: dialog-show 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes dialog-show {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Media queries for smaller viewports */
  @media (max-width: 480px) {
    .content-wrapper {
      gap: 2rem;
