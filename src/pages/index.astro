---
import Layout from '../layouts/Layout.astro';
---

<Layout title="شات | پلتفرم کاتالوگ دیجیتال و منوی آنلاین" description="پلتفرم مستقل، رایگان و متمرکز بر سرعت برای ساخت کاتالوگ و منوی دیجیتال مجموعه‌های ایرانی">
  <main class="marketing-container">
    <!-- Header / Navbar -->
    <header class="marketing-header animate-fade-in">
      <div class="logo-brand">
        <img src="/logo.png" alt="shottt logo" class="brand-logo-img" />
      </div>
      <a href="/admin" class="admin-login-btn">
        <span>ورود به پنل مدیریت</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12 19 5 12 12 5" />
        </svg>
      </a>
    </header>

    <!-- Hero Section -->
    <section class="hero-section animate-slide-up">
      <h1 class="hero-title">کاتالوگ دیجیتال و منوی آنلاین،<br/><span class="accent-text">ساده و پایدار.</span></h1>
      <p class="hero-subtitle">
        یک پلتفرم مستقل، کاملاً رایگان و متمرکز بر سرعت؛ توسعه‌یافته برای کمک به صنف‌ها و مجموعه‌های ایرانی جهت ارائه بهتر خدمات در هر شرایط ارتباطی.
      </p>
    </section>

    <!-- Philosophy & Motivation -->
    <section class="philosophy-section animate-slide-up" style="animation-delay: 0.1s;">
      <div class="card-gradient">
        <h2 class="section-title">چرا پلتفرم شات رایگان است؟</h2>
        <p class="philosophy-text">
          این پروژه به صورت کاملاً شخصی و مستقل پیاده‌سازی شده و هیچ نهاد یا سازمان بزرگی پشت آن نیست. در شرایطی که کیفیت زیرساخت‌های اینترنت کشور با چالش‌ها و قطعی‌های مداوم همراه است، ارائه خدمات اشتراکی پولی و مدیریت مسائل پس از آن برای ما دغدغه‌ای حل‌نشدنی است. از این رو، تصمیم گرفتیم شات را به صورت کاملاً رایگان در اختیار کسب‌وکارهای ایرانی قرار دهیم تا کمکی کوچک برای تداوم و بهبود تجربه مشتریان شما باشد.
        </p>
      </div>
    </section>

    <!-- Essential Features Grid -->
    <section class="features-section animate-slide-up" style="animation-delay: 0.2s;">
      <h2 class="features-title">امکانات پلتفرم در یک نگاه</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feature-icon">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="9" cy="9" r="2"/>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
            </svg>
          </div>
          <h3 class="feature-name">کاتالوگ تصویری کامل</h3>
          <p class="feature-description">
            امکان تعریف محصولات در دسته‌بندی‌های منظم به همراه عکس باکیفیت، توضیحات، قیمت جدید و قدیم و نشان‌های اختصاصی.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feature-icon">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <h3 class="feature-name">سرعت بارگذاری بی‌نظیر</h3>
          <p class="feature-description">
            طراحی شده بدون فریم‌ورک‌های سنگین و کتابخانه‌های حجیم، جهت بارگذاری فوق‌العاده سریع حتی با ضعیف‌ترین سرعت اینترنت.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feature-icon">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="9" y1="9" x2="15" y2="9"/>
              <line x1="9" y1="13" x2="15" y2="13"/>
              <line x1="9" y1="17" x2="13" y2="17"/>
            </svg>
          </div>
          <h3 class="feature-name">پنل مدیریت مینیمال</h3>
          <p class="feature-description">
            یک داشبورد بسیار ساده برای به‌روزرسانی لحظه‌ای قیمت‌ها، وضعیت موجودی کالاها و غیرفعال‌سازی محصولات بدون پیچیدگی فنی.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feature-icon">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
              <line x1="12" y1="18" x2="12.01" y2="18"/>
            </svg>
          </div>
          <h3 class="feature-name">طراحی کاملاً ریسپانسیو</h3>
          <p class="feature-description">
            نمایش تمیز، منظم و سازگار در انواع نمایشگرها (به‌ویژه تلفن‌های همراه و تبلت‌ها) برای تجربه بصری راحت مشتریان شما.
          </p>
        </div>
      </div>
    </section>

    <!-- Platform Onboarding / Next steps -->
    <section class="onboarding-section animate-slide-up" style="animation-delay: 0.3s;">
      <div class="onboarding-card">
        <div class="onboarding-glow"></div>
        <div class="onboarding-content">
          <h2 class="onboarding-title">راه‌اندازی منو برای مجموعه شما</h2>
          <p class="onboarding-text">
            برای ایجاد کاتالوگ دیجیتال و اتصال دامنه اختصاصی به مجموعه‌تان، به زودی بستری را در همین صفحه معرفی و فعال خواهیم کرد. در حال حاضر امکان ثبت‌نام خودکار برقرار نیست، اما به زودی روش ثبت‌نام را به اشتراک خواهیم گذاشت.
          </p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="marketing-footer animate-fade-in" style="animation-delay: 0.4s;">
      <div class="footer-divider"></div>
      <p class="footer-brand">shottt • پلتفرم شخصی و مستقل کاتالوگ دیجیتال</p>
      <p class="footer-sub">طراحی شده بر پایه اصول سادگی، سرعت و پایداری</p>
    </footer>
  </main>
</Layout>

<style>
  .marketing-container {
    max-width: 44rem; /* 704px wide for a clean column layout */
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem 1.5rem;
    direction: rtl;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    background-color: #FFFFFF;
  }

  /* Header Styles */
  .marketing-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #f5f5f5;
  }

  .logo-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-logo-img {
    height: 2.25rem;
    width: auto;
    border-radius: 0.5rem;
  }

  .brand-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: #171717;
    letter-spacing: -0.03em;
    font-family: 'Outfit', sans-serif;
  }

  .admin-login-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #171717;
    color: #FFFFFF;
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.65rem 1.25rem;
    border-radius: 0.875rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 12px rgba(23, 23, 23, 0.08);
  }

  .admin-login-btn:hover {
    background-color: #333333;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(23, 23, 23, 0.15);
  }

  .arrow-icon {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .admin-login-btn:hover .arrow-icon {
    transform: translateX(-3px); /* Move left in RTL */
  }

  /* Hero Section */
  .hero-section {
    text-align: center;
    padding: 1.5rem 0 0.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-title {
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1.3;
    color: #0a0a0a;
    letter-spacing: -0.02em;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 2.75rem;
    }
  }

  .accent-text {
    background: linear-gradient(135deg, #171717 30%, #737373 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .hero-subtitle {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #525252;
    max-width: 32rem;
    font-weight: 300;
  }

  /* Philosophy Section */
  .philosophy-section {
    width: 100%;
  }

  .card-gradient {
    background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%);
    border: 1px solid #f0f0f0;
    border-radius: 1.75rem;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.01);
  }

  .section-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #171717;
  }

  .philosophy-text {
    font-size: 0.875rem;
    line-height: 1.8;
    color: #525252;
    font-weight: 300;
    text-align: justify;
  }

  /* Features Grid */
  .features-section {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .features-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #171717;
    padding-right: 0.5rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-card {
    background-color: #ffffff;
    border: 1px solid #f0f0f0;
    border-radius: 1.5rem;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.01);
  }

  .feature-card:hover {
    border-color: #d4d4d4;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.02);
  }

  .feature-icon-wrapper {
    width: 2.5rem;
    height: 2.5rem;
    background-color: #fafafa;
    border: 1px solid #f0f0f0;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #171717;
    margin-bottom: 0.25rem;
    transition: all 0.3s ease;
  }

  .feature-card:hover .feature-icon-wrapper {
    background-color: #171717;
    color: #FFFFFF;
    border-color: #171717;
  }

  .feature-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .feature-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #171717;
  }

  .feature-description {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #737373;
    font-weight: 300;
  }

  /* Onboarding / Register Notice */
  .onboarding-section {
    width: 100%;
  }

  .onboarding-card {
    position: relative;
    background-color: #171717;
    color: #FFFFFF;
    border-radius: 1.75rem;
    padding: 2.25rem 2rem;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .onboarding-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0) 60%);
    pointer-events: none;
  }

  .onboarding-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .onboarding-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .onboarding-text {
    font-size: 0.875rem;
    line-height: 1.8;
    color: #a3a3a3;
    font-weight: 300;
    text-align: justify;
  }

  /* Footer */
  .marketing-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    text-align: center;
  }

  .footer-divider {
    width: 100%;
    height: 1px;
    background-color: #f5f5f5;
    margin-bottom: 1.5rem;
  }

  .footer-brand {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #737373;
  }

  .footer-sub {
    font-size: 0.6875rem;
    font-weight: 300;
    color: #a3a3a3;
  }
</style>
