---
import Layout from '../layouts/Layout.astro';
import HomeIR from '../components/home/HomeIR.astro';
import HomeINT from '../components/home/HomeINT.astro';
import { TOTAL_FREE } from '../config/region';
import { useTranslations } from '../utils/i18n';



const { t } = useTranslations(Astro.cookies, Astro.request);
---

<Layout 
  title={t('seoTitle')}
  description={t('seoDescription')}
  ogImage="/logo.png"
  twitterCard="summary"
>
  {TOTAL_FREE ? <HomeIR /> : <HomeINT />}
</Layout>
