    margin: auto;
    outline: none;
  }

  /* Backdrop styling */
  .custom-dialog::backdrop {
    background-color: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* Content Wrapper inside dialog */
  .dialog-wrapper {
    background: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 1.5rem;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    direction: rtl;
    font-family: 'Estedad', system-ui, -apple-system, sans-serif;
  }

  .dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .dialog-title {
    font-size: 1rem;
    font-weight: 700;
    color: #09090b;
  }

  .close-btn {
    all: unset;
    cursor: pointer;
    display: flex;
