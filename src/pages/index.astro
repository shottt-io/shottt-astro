  /* Minimalist dialog modal design (White card with clean shadows) */
  .custom-dialog {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 28rem; /* 448px */
    width: calc(100% - 2.5rem);
    border-radius: 1.5rem;
