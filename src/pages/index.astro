---
import Layout from '../layouts/Layout.astro';
import { db } from '../db/db';
import { vendors as vendorsTable } from '../db/schema';

// Fetch all vendors dynamically from PostgreSQL at runtime
const vendors = await db.select().from(vendorsTable);
---

<Layout title="پلتفرم منوهای دیجیتال مدرن" description="کاتالوگ دیجیتال و منوهای مدرن مجموعه‌های برتر با طراحی ساده و زیبا">
  <main class="landing-main">
    <header class="landing-header">
      <div class="landing-logo-container">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 135 38" fill="none" class="landing-logo-svg">
          <!-- Logo Symbol (Lens/Aperture) -->
          <g transform="translate(4, 3)">
            <!-- Solid circle background -->
            <circle cx="16" cy="16" r="15" class="logo-symbol-circle-landing" />
            
            <!-- White lens details -->
            <circle cx="16" cy="16" r="7.5" stroke-width="1.8" fill="none" class="logo-symbol-details-landing" />
            <circle cx="16" cy="16" r="3.5" stroke-width="1.2" fill="none" class="logo-symbol-details-landing" />
            <line x1="10" y1="10" x2="13.5" y2="13.5" stroke-width="1.5" stroke-linecap="round" class="logo-symbol-details-landing" />
            <line x1="18.5" y1="18.5" x2="22" y2="22" stroke-width="1.5" stroke-linecap="round" class="logo-symbol-details-landing" />
          </g>

          <!-- Typography "shottt." -->
          <text x="42" y="27" class="logo-text-landing" letter-spacing="-0.04em">
            <tspan font-weight="300" opacity="0.8">sho</tspan><tspan font-weight="900" letter-spacing="-0.02em">ttt</tspan><tspan font-weight="900">.</tspan>
          </text>
        </svg>
      </div>
      <h1 class="landing-title">دایرکتوری مجموعه‌ها</h1>
      <p class="landing-subtitle">نمایشگاه کاتالوگ‌ها و منوهای دیجیتال مجموعه‌های برتر</p>
    </header>

    <div class="vendors-directory">
      {vendors.map((vendor) => (
        <a href={`/${vendor.slug}`} class="vendor-card-link">
          <article class="vendor-card">
            <div class="cover-wrapper image-zoom-container">
              <img src={vendor.logo} alt={vendor.name} class="vendor-cover" loading="lazy" />
              <div class="vendor-badge">{vendor.type}</div>
            </div>
            
            <div class="vendor-details">
              <h2 class="vendor-name">{vendor.name}</h2>
              <p class="vendor-slogan">{vendor.slogan}</p>
              <div class="enter-btn">
                <span>ورود به منو</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
                  <line x1="19" y1="12" x2="5" y2="12" />
                  <polyline points="12 19 5 12 12 5" />
                </svg>
              </div>
            </div>
          </article>
        </a>
      ))}
    </div>

    <footer class="landing-footer">
      <p>طراحی شده بر اساس مبانی سادگی و کارایی متریال دیزاین مدرن</p>
    </footer>
  </main>
</Layout>

<style>
  .landing-main {
    max-width: 42rem; /* max-w-2xl */
    margin: 0 auto;
    padding: 3rem 1.5rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    direction: rtl;
  }

  .landing-header {
    text-align: center;
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .landing-logo-container {
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #171717;
    margin-bottom: 0.5rem;
  }

  .landing-logo-svg {
    height: 2.25rem;
    width: 8rem; /* aspect ratio width matching 135/38 */
  }

  .logo-text-landing {
    font-family: 'Outfit', sans-serif;
    font-size: 26px;
    fill: #171717;
  }

  .logo-symbol-circle-landing {
    fill: #171717;
  }

  .logo-symbol-details-landing {
    stroke: #ffffff;
  }

  .landing-title {
    font-size: 1.5rem;
    font-weight: 500;
    color: #0a0a0a;
    letter-spacing: -0.02em;
  }

  .landing-subtitle {
    font-size: 0.8125rem;
    font-weight: 200;
    color: #737373;
    max-width: 20rem;
    line-height: 1.5;
  }

  .vendors-directory {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  .vendor-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .vendor-card {
    background-color: #FFFFFF;
    border-radius: 2rem;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cover-wrapper {
    position: relative;
    width: 100%;
    height: 14rem;
    border-radius: 2rem;
    overflow: hidden;
    background-color: #fafafa;
    display: flex;
  }

  .vendor-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vendor-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: rgba(255, 255, 255, 0.95);
    color: #171717;
    font-size: 0.6875rem;
    font-weight: 400;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .vendor-details {
    padding: 1.25rem 0.5rem 0.5rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .vendor-name {
    font-size: 1.25rem;
    font-weight: 500;
    color: #0a0a0a;
  }

  .vendor-slogan {
    font-size: 0.8125rem;
    font-weight: 200;
    color: #737373;
    line-height: 1.4;
  }

  .enter-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: #171717;
    margin-top: 0.5rem;
  }

  .arrow-icon {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform 0.3s ease;
  }

  .vendor-card-link:hover .arrow-icon {
    transform: translateX(-4px); /* Moves left in RTL */
  }

  .landing-footer {
    text-align: center;
    border-top: 1px solid #f5f5f5;
    padding-top: 1.5rem;
  }

  .landing-footer p {
    font-size: 0.6875rem;
    font-weight: 100;
    color: #a3a3a3;
    letter-spacing: 0.05em;
  }
</style>
