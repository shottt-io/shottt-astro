---
import Layout from '../layouts/Layout.astro';
import { db } from '../db/db';
import { vendors as vendorsTable } from '../db/schema';

// Fetch all vendors dynamically from PostgreSQL at runtime
const vendors = await db.select().from(vendorsTable);
---

<Layout title="پلتفرم منوهای دیجیتال مدرن" description="کاتالوگ دیجیتال و منوهای مدرن مجموعه‌های برتر با طراحی ساده و زیبا">
  <main class="landing-main">
    <header class="landing-header">
      <div class="landing-logo-container">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 170 60" fill="none" class="landing-logo-svg">
          <!-- Logo Mark Icon (Scaled and translated) -->
          <g transform="translate(10, 10)">
            <!-- Viewfinder corners -->
            <path d="M 10 15 V 10 H 15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M 30 15 V 10 H 25" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M 10 25 V 30 H 15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M 30 25 V 30 H 25" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            
            <!-- Camera lens / Shutter ring -->
            <circle cx="20" cy="20" r="7.5" stroke="currentColor" stroke-width="2.5" fill="none" />
            
            <!-- Shutter blades -->
            <path d="M 20 12.5 L 20 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <path d="M 13.5 24 L 17 21.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <path d="M 26.5 24 L 23 21.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            
            <!-- Inner core lens -->
            <circle cx="20" cy="20" r="2" fill="currentColor" />
          </g>

          <!-- Typography "shottt" -->
          <g stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none">
            <!-- s -->
            <path d="M 78 29 C 78 25, 66 25, 66 29 C 66 34, 78 34, 78 39 C 78 44, 66 44, 66 40" />
            
            <!-- h -->
            <path d="M 88 15 L 88 44" />
            <path d="M 88 29 C 91 25, 100 25, 100 30 L 100 44" />
            
            <!-- o -->
            <circle cx="112" cy="35" r="8.5" />
            
            <!-- t1, t2, t3 -->
            <path d="M 129 19 L 129 44" />
            <path d="M 139 19 L 139 44" />
            <path d="M 149 19 L 149 44" />
            
            <!-- Connected crossbar for all three t's -->
            <path d="M 124 27 L 154 27" />
          </g>
        </svg>
      </div>
      <h1 class="landing-title">دایرکتوری مجموعه‌ها</h1>
      <p class="landing-subtitle">نمایشگاه کاتالوگ‌ها و منوهای دیجیتال مجموعه‌های برتر</p>
    </header>

    <div class="vendors-directory">
      {vendors.map((vendor) => (
        <a href={`/${vendor.slug}`} class="vendor-card-link">
          <article class="vendor-card">
            <div class="cover-wrapper image-zoom-container">
              <img src={vendor.logo} alt={vendor.name} class="vendor-cover" loading="lazy" />
              <div class="vendor-badge">{vendor.type}</div>
            </div>
            
            <div class="vendor-details">
              <h2 class="vendor-name">{vendor.name}</h2>
              <p class="vendor-slogan">{vendor.slogan}</p>
              <div class="enter-btn">
                <span>ورود به منو</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
                  <line x1="19" y1="12" x2="5" y2="12" />
                  <polyline points="12 19 5 12 12 5" />
                </svg>
              </div>
            </div>
          </article>
        </a>
      ))}
    </div>

    <footer class="landing-footer">
      <p>طراحی شده بر اساس مبانی سادگی و کارایی متریال دیزاین مدرن</p>
    </footer>
  </main>
</Layout>

<style>
  .landing-main {
    max-width: 42rem; /* max-w-2xl */
    margin: 0 auto;
    padding: 3rem 1.5rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    direction: rtl;
  }

  .landing-header {
    text-align: center;
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .landing-logo-container {
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #171717;
    margin-bottom: 0.5rem;
  }

  .landing-logo-svg {
    height: 2.25rem;
    width: auto;
  }

  .landing-title {
    font-size: 1.5rem;
    font-weight: 500;
    color: #0a0a0a;
    letter-spacing: -0.02em;
  }

  .landing-subtitle {
    font-size: 0.8125rem;
    font-weight: 200;
    color: #737373;
    max-width: 20rem;
    line-height: 1.5;
  }

  .vendors-directory {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  .vendor-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .vendor-card {
    background-color: #FFFFFF;
    border-radius: 2rem;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cover-wrapper {
    position: relative;
    width: 100%;
    height: 14rem;
    border-radius: 2rem;
    overflow: hidden;
    background-color: #fafafa;
    display: flex;
  }

  .vendor-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vendor-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: rgba(255, 255, 255, 0.95);
    color: #171717;
    font-size: 0.6875rem;
    font-weight: 400;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .vendor-details {
    padding: 1.25rem 0.5rem 0.5rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .vendor-name {
    font-size: 1.25rem;
    font-weight: 500;
    color: #0a0a0a;
  }

  .vendor-slogan {
    font-size: 0.8125rem;
    font-weight: 200;
    color: #737373;
    line-height: 1.4;
  }

  .enter-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: #171717;
    margin-top: 0.5rem;
  }

  .arrow-icon {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform 0.3s ease;
  }

  .vendor-card-link:hover .arrow-icon {
    transform: translateX(-4px); /* Moves left in RTL */
  }

  .landing-footer {
    text-align: center;
    border-top: 1px solid #f5f5f5;
    padding-top: 1.5rem;
  }

  .landing-footer p {
    font-size: 0.6875rem;
    font-weight: 100;
    color: #a3a3a3;
    letter-spacing: 0.05em;
  }
</style>
