  /* Base Container (Full-screen pure white canvas) */
  .marketing-container {
    width: 100%;
    min-height: 100vh;
    background-color: #ffffff;
    color: #18181b;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
