---
import Layout from '../layouts/Layout.astro';
import Home from '../components/home/Home.astro';
import { useTranslations } from '../utils/i18n';

const { t } = useTranslations(Astro.cookies, Astro.request);
---

<Layout 
  title={t('seoTitle')}
  description={t('seoDescription')}
  ogImage="/logo.png"
  twitterCard="summary"
>
  <Home />
</Layout>
