---
import Layout from '../layouts/Layout.astro';
import { getLocale } from '../utils/i18n';

const currentLocale = getLocale(Astro.cookies, Astro.request);

type Locale = 'fa' | 'en' | 'tr';

const localTranslations = {
  fa: {
    title: "درباره ما | شات",
    heading: "درباره پلتفرم شات",
    subtitle: "منوی آنلاین و کاتالوگ دیجیتال ساده، سریع و پایدار",
    backHome: "بازگشت به خانه",
    p1: "شات یک پلتفرم هوشمند و سبک برای ایجاد کاتالوگ دیجیتال و منوی آنلاین است. ما این پلتفرم را با هدف کمک به کسب‌وکارهای مختلف (شامل کافه‌ها، رستوران‌ها، بوتیک‌ها، گالری‌ها و فروشگاه‌ها) برای ارائه زیباترین و سریع‌ترین تجربه معرفی محصولات به مشتریانشان توسعه داده‌ایم.",
    p2: "در شات، تمرکز اصلی ما بر روی سرعت بارگذاری فوق‌العاده، سادگی پنل مدیریت و پایداری کاتالوگ‌ها است. ما از افزودن ویژگی‌های سنگین و ماژول‌های پیچیده‌ای که سرعت باز شدن کاتالوگ را در موبایل مشتریان کند می‌کنند خودداری کرده‌ایم تا منوی شما همواره در کمتر از یک ثانیه لود شود.",
    p3: "تمام اطلاعات و تصاویر شما به صورت امن بر روی سرورهای ابری شات میزبانی می‌شوند تا پایداری و کارایی خدمات در ۲۴ ساعت شبانه‌روز تضمین گردد.",
    footerAbout: "درباره ما",
    footerContact: "تماس با ما",
    footerTerms: "قوانین و مقررات",
    footerPrivacy: "حریم خصوصی"
  },
  en: {
    title: "About Us | Shottt",
    heading: "About Shottt Platform",
    subtitle: "Simple, fast, and stable online menu & digital catalog creator",
    backHome: "Back to Home",
    p1: "Shottt is a lightweight and smart platform for creating digital catalogs and online menus. We developed this system with the goal of helping businesses (including cafes, restaurants, boutiques, galleries, and shops) present their products to customers in the most elegant and fastest way possible.",
    p2: "At Shottt, our primary focus is on loading speed, ease of management, and catalog stability. We avoid adding heavy modules and complex features that slow down page loads on mobile devices, ensuring your menu always loads in under a second.",
    p3: "All your data and images are securely hosted on Shottt's cloud servers to guarantee service stability and performance 24/7.",
    footerAbout: "About Us",
    footerContact: "Contact Us",
    footerTerms: "Terms of Service",
    footerPrivacy: "Privacy Policy"
  },
  tr: {
    title: "Hakkımızda | Shottt",
    heading: "Shottt Platformu Hakkında",
    subtitle: "Basit, hızlı ve kararlı çevrimiçi menü ve dijital katalog oluşturucu",
    backHome: "Ana Sayfaya Dön",
    p1: "Shottt, dijital kataloglar ve çevrimiçi menüler oluşturmak için hafif ve akıllı bir platformdur. Bu sistemi, işletmelerin (kafeler, restoranlar, butikler, galeriler ve mağazalar dahil) ürünlerini müşterilerine en şık ve en hızlı şekilde sunmalarına yardımcı olmak amacıyla geliştirdik.",
    p2: "Shottt'ta ana odağımız yükleme hızı, yönetim kolaylığı ve katalog kararlılığıdır. Mobil cihazlarda sayfa yüklemelerini yavaşlatan ağır modüller ve karmaşık özellikler eklemekten kaçınıyoruz, böylece menünüz her zaman bir saniyenin altında yüklenir.",
    p3: "Hizmet kararlılığını ve performansını 7/24 garanti etmek için tüm verileriniz ve resimleriniz Shottt'ın bulut sunucularında güvenli bir şekilde barındırılır.",
    footerAbout: "Hakkımızda",
    footerContact: "İletişim",
    footerTerms: "Kullanım Koşulları",
    footerPrivacy: "Gizlilik Politikası"
  }
};

const t = localTranslations[currentLocale as Locale] || localTranslations['en'];
---

<Layout title={t.title} description={t.subtitle}>
  <main class="marketing-container font-sans" style={`direction: ${currentLocale === 'fa' ? 'rtl' : 'ltr'};`}>
    <!-- Navigation -->
    <nav class="top-nav">
      <div class="top-nav-inner">
        <div class="lang-dropdown-container">
          <button class="lang-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="globe-icon">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>{currentLocale === 'fa' ? 'فارسی' : currentLocale === 'tr' ? 'Türkçe' : 'English'}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="lang-dropdown-menu">
            <button class={`lang-dropdown-item ${currentLocale === 'fa' ? 'active' : ''}`} data-lang="fa">فارسی</button>
            <button class={`lang-dropdown-item ${currentLocale === 'en' ? 'active' : ''}`} data-lang="en">English</button>
            <button class={`lang-dropdown-item ${currentLocale === 'tr' ? 'active' : ''}`} data-lang="tr">Türkçe</button>
          </div>
        </div>
        <div class="top-nav-actions">
          <a href="/" class="top-login-link">{t.backHome}</a>
        </div>
      </div>
    </nav>

    <div class="content-wrapper animate-slide-up">
      <!-- Big Centered Logo -->
      <div class="logo-container">
        <a href="/">
          <img src="/logo.png" alt="shottt logo" class="brand-logo-img" />
        </a>
      </div>

      <!-- About Content Card -->
      <div class="legal-card card-glass">
        <h1 class="legal-title">{t.heading}</h1>
        <p class="legal-subtitle">{t.subtitle}</p>
        
        <div class="legal-divider"></div>
        
        <div class="legal-text-content">
          <p>{t.p1}</p>
          <p>{t.p2}</p>
          <p>{t.p3}</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="home-footer">
      <div class="footer-nav-links">
        <a href="/about" class="footer-link">{t.footerAbout}</a>
        <span class="footer-bullet">•</span>
        <a href="/contact" class="footer-link">{t.footerContact}</a>
        <span class="footer-bullet">•</span>
        <a href="/terms" class="footer-link">{t.footerTerms}</a>
        <span class="footer-bullet">•</span>
        <a href="/privacy" class="footer-link">{t.footerPrivacy}</a>
      </div>
    </footer>
  </main>
</Layout>

<script is:inline>
  const langItems = document.querySelectorAll('.lang-dropdown-item');
  langItems.forEach(item => {
    item.addEventListener('click', () => {
      const targetLang = item.getAttribute('data-lang') || 'fa';
      document.cookie = `lang=${targetLang}; path=/; max-age=31536000`;
      window.location.reload();
    });
  });

  const trigger = document.querySelector('.lang-dropdown-trigger');
  const menu = document.querySelector('.lang-dropdown-menu');
  if (trigger && menu) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', !expanded);
      menu.classList.toggle('show');
    });
    document.addEventListener('click', () => {
      trigger.setAttribute('aria-expanded', 'false');
      menu.classList.remove('show');
    });
  }
</script>

<style>
  .font-sans {
    font-family: 'Estedad', system-ui, -apple-system, sans-serif;
  }

  .marketing-container {
    width: 100%;
    min-height: 100vh;
    overflow-x: hidden;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #fafafa;
    color: #18181b;
    padding: 0 0 4rem 0;
    gap: 2.5rem;
  }

  .top-nav {
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    padding: 1.5rem 2rem 0 2rem;
    box-sizing: border-box;
  }

  .top-nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .lang-dropdown-container {
    position: relative;
    display: inline-block;
  }

  .lang-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid #e4e4e7;
    border-radius: 9999px;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #27272a;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  .lang-dropdown-trigger:hover {
    background: #ffffff;
    border-color: #d4d4d8;
  }

  .globe-icon {
    width: 1rem;
    height: 1rem;
    color: #71717a;
  }

  .chevron-icon {
    width: 0.75rem;
    height: 0.75rem;
    color: #a1a1aa;
    transition: transform 0.2s ease;
  }

  .lang-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    inset-inline-start: 0;
    background: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 0.75rem;
    padding: 0.35rem;
    min-width: 8rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02);
    display: none;
    flex-direction: column;
    gap: 0.2rem;
    z-index: 50;
  }

  .lang-dropdown-menu.show {
    display: flex;
  }

  .lang-dropdown-item {
    background: none;
    border: none;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #3f3f46;
    text-align: start;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .lang-dropdown-item:hover {
    background: #f4f4f5;
    color: #18181b;
  }

  .lang-dropdown-item.active {
    background: #f4f4f5;
    color: #0284c7;
    font-weight: 600;
  }

  .top-login-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #27272a;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid #e4e4e7;
    border-radius: 9999px;
    padding: 0.5rem 1.25rem;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  .top-login-link:hover {
    background: #ffffff;
    border-color: #d4d4d8;
  }

  .content-wrapper {
    width: 100%;
    max-width: 48rem;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  .logo-container {
    margin-bottom: 2rem;
  }

  .brand-logo-img {
    height: 5rem;
    width: auto;
    object-fit: contain;
  }

  /* Glassmorphic Legal Card */
  .card-glass {
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(228, 228, 231, 0.6);
    border-radius: 1.5rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.02), 0 10px 10px -5px rgba(0, 0, 0, 0.01);
  }

  .legal-card {
    width: 100%;
    padding: 3rem;
    box-sizing: border-box;
  }

  .legal-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #18181b;
    margin: 0 0 0.5rem 0;
  }

  .legal-subtitle {
    font-size: 0.9375rem;
    color: #71717a;
    margin: 0;
  }

  .legal-divider {
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(228, 228, 231, 0.8), transparent);
    margin: 2rem 0;
  }

  .legal-text-content {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: #3f3f46;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: justify;
  }

  /* Footer */
  .home-footer {
    width: 100%;
    max-width: 64rem;
    margin-top: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .footer-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #71717a;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: #0284c7;
  }

  .footer-bullet {
    color: #d4d4d8;
    font-size: 0.75rem;
  }

  /* Animations */
  .animate-slide-up {
    animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .legal-card {
      padding: 2rem 1.5rem;
    }
    .legal-title {
      font-size: 1.5rem;
    }
  }
</style>
