---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db/db';
import { vendors as vendorsTable, menuItems as menuItemsTable, categories as categoriesTable } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { formatPriceWithUnit } from '../../utils/price';
import { SITE_URL } from '../../config/region';
import { useTranslations } from '../../utils/i18n';

const vendorSlug = Astro.params.vendor;
const productIdStr = Astro.params.product;

if (!vendorSlug || !productIdStr) {
  return new Response("Not Found", { status: 404 });
}

// Fetch the vendor first to ensure vendor exists
const vendorList = await db
  .select()
  .from(vendorsTable)
  .where(eq(vendorsTable.slug, vendorSlug))
  .limit(1);

if (vendorList.length === 0) {
  return new Response("Vendor Not Found", { status: 404 });
}
const vendor = vendorList[0];

const { t } = useTranslations(Astro.cookies, Astro.request, vendor.locale || undefined);

let dbProduct;
const isNumeric = /^\d+$/.test(productIdStr);

if (isNumeric) {
  // Query by numeric ID
  const id = parseInt(productIdStr, 10);
  const productList = await db
    .select()
    .from(menuItemsTable)
    .where(eq(menuItemsTable.id, id))
    .limit(1);

  if (productList.length === 0) {
    return new Response("Product Not Found", { status: 404 });
  }
  dbProduct = productList[0];

  // If the product has a slug defined, redirect (301) to the slug-based URL
  if (dbProduct.slug) {
    return Astro.redirect(`/${vendorSlug}/${dbProduct.slug}`, 301);
  }
} else {
  // Query by slug
  const productList = await db
    .select()
    .from(menuItemsTable)
    .where(eq(menuItemsTable.slug, productIdStr))
    .limit(1);

  if (productList.length === 0) {
    return new Response("Product Not Found", { status: 404 });
  }
  dbProduct = productList[0];
}

// Return 404 if product is inactive
if (dbProduct.status === 'inactive') {
  return new Response("Product Not Found", { status: 404 });
}

// Verify the product category belongs to the vendor
const categoryList = await db
  .select()
  .from(categoriesTable)
  .where(eq(categoriesTable.id, dbProduct.categoryId))
  .limit(1);

if (categoryList.length === 0 || categoryList[0].vendorId !== vendor.id || categoryList[0].status === 'inactive') {
  return new Response("Product Not Found", { status: 404 });
}

const product = {
  id: dbProduct.id.toString(),
  name: dbProduct.name,
  slug: dbProduct.slug || undefined,
  price: dbProduct.price,
  image: dbProduct.image || undefined,
  description: dbProduct.description || undefined,
  discount: dbProduct.discount ? {
    originalPrice: dbProduct.discount.originalPrice,
    discountText: dbProduct.discount.discountText,
  } : undefined,
  span2: dbProduct.span2,
  sections: dbProduct.sections,
  status: (categoryList[0].status === 'unavailable' || dbProduct.status === 'unavailable') ? 'unavailable' : dbProduct.status,
};

// Generate the canonical URL pointing to the slug version if it exists, otherwise to the ID version
const canonicalPath = `/${vendor.slug}/${product.slug || product.id}`;
const base = SITE_URL ? (SITE_URL.endsWith('/') ? SITE_URL.slice(0, -1) : SITE_URL) : Astro.url.origin;
const canonicalUrl = `${base}${canonicalPath}`;
---

<Layout 
  title={`${product.name} — ${vendor.name}`} 
  description={product.description || t('productDetailDesc').replace('{productName}', product.name).replace('{vendorName}', vendor.name)}
  ogImage={product.image || vendor.logo}
  canonicalUrl={canonicalUrl}
  favicon={vendor.logo}
  theme={vendor.theme}
  twitterCard={product.image ? 'summary_large_image' : 'summary'}
  localeOverride={vendor.locale || undefined}
>
  <main class="product-page-main">
    <div class="product-content-card">
      
      <!-- Minimalist Back Navigation Button (Floating top corner) -->
      <a href={`/${vendor.slug}`} class="back-nav-btn" aria-label={t('backToCatalog')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="back-arrow-svg">
          <!-- RTL Go Back Arrow (Points Right) -->
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>

      <!-- Natural Aspect Ratio Product Image (No Cropping) -->
      <div class="product-image-container animate-fade-in">
        {product.image ? (
          <>
            <img 
              src={product.image} 
              alt={product.name} 
              class="product-detail-image"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div class="product-fallback" style="display: none;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="fallback-icon">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <polyline points="21 15 16 10 5 21" />
              </svg>
            </div>
          </>
        ) : (
          <div class="product-no-image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="no-image-icon">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <polyline points="21 15 16 10 5 21" />
            </svg>
          </div>
        )}
      </div>

      <!-- Details Section with organic layouts -->
      <div class="product-info-section animate-slide-up">
        
        <div class="product-header-row">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <h1 class="product-detail-title">{product.name}</h1>
            {product.status === 'unavailable' && (
              <span class="detail-unavailable-badge">{t('outOfStock')}</span>
            )}
          </div>
          
          <div class="product-detail-prices" style={product.status === 'unavailable' ? 'opacity: 0.5;' : ''}>
            {product.discount ? (
              <>
                <span class="price-tag price-old detail-price-tag">{formatPriceWithUnit(product.discount.originalPrice)}</span>
                <span class="price-tag price-new detail-price-tag">{formatPriceWithUnit(product.price)}</span>
              </>
            ) : (
              <span class="price-tag detail-price-tag">{formatPriceWithUnit(product.price)}</span>
            )}
          </div>
        </div>

        <!-- Short Description -->
        {product.description && (
          <p class="product-detail-desc">{product.description}</p>
        )}

        <!-- Dynamic Product Sections (All fields are optional) -->
        {product.sections && product.sections.length > 0 && (
          <div class="dynamic-sections-container">
            {product.sections.map((section) => (
              <div class="product-dynamic-section">
                {section.title && <h2 class="section-title">{section.title}</h2>}
                {section.description && <p class="section-desc">{section.description}</p>}
                {section.chips && section.chips.length > 0 && (
                  <div class="section-chips-row">
                    {section.chips.map((chip) => (
                      <span class="chip-badge">{chip}</span>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        )}

      </div>

    </div>

    <!-- Product Page Footer -->
    <footer class="product-page-footer animate-fade-in" style="animation-delay: 0.15s;">
      <div class="footer-divider"></div>
      <a href="/" class="footer-platform-link">
        {t('developedWith')}
        <img src="/logo.png" alt="shottt" class="footer-logo-img" />
      </a>
    </footer>
  </main>

  <script is:inline>
    (function() {
      const backBtn = document.querySelector('.back-nav-btn');
      if (backBtn) {
        backBtn.addEventListener('click', (e) => {
          if (document.referrer && document.referrer.startsWith(window.location.origin)) {
            e.preventDefault();
            window.history.back();
          }
        });
      }
    })();
  </script>
</Layout>

<style>
  .product-page-main {
    background-color: var(--bg-primary, #FFFFFF);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 2rem 1rem;
    direction: inherit;
    transition: background-color 0.3s ease;
  }

  .product-content-card {
    max-width: 42rem; /* max-w-2xl equivalent */
    width: 100%;
    margin: 0 auto;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* Minimalist circular back navigation button */
  .back-nav-btn {
    position: absolute;
    top: 1.5rem;
    inset-inline-end: 1.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: var(--bg-secondary, #f5f5f5); /* bg-neutral-50 */
    color: var(--text-primary, #171717); /* neutral-900 */
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease;
  }

  .back-nav-btn:hover {
    background-color: var(--border-color, #e5e5e5);
    transform: scale(1.05);
  }

  .back-arrow-svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  [dir="ltr"] .back-arrow-svg {
    transform: scaleX(-1);
  }

  /* Image container supporting natural aspect ratio */
  .product-image-container {
    width: 100%;
    border-radius: 2rem; /* rounded-3xl equivalent */
    overflow: hidden;
    background-color: var(--bg-secondary, #fafafa);
    display: flex;
  }

  .product-detail-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .product-fallback {
    width: 100%;
    height: 300px;
    background-color: var(--bg-secondary, #f5f5f5);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted, #d4d4d4);
  }

  .fallback-icon {
    width: 2.5rem;
    height: 2.5rem;
  }

  .product-no-image {
    width: 100%;
    height: 250px;
    background-color: var(--bg-secondary, #f5f5f5);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary, #a3a3a3);
  }

  .no-image-icon {
    width: 2rem;
    height: 2rem;
  }

  /* Info styling and layout spacing */
  .product-info-section {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .product-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .product-detail-title {
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--title-color, #0a0a0a);
    line-height: 1.3;
  }

  .product-detail-prices {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .detail-price-tag {
    font-size: 1.125rem; /* Larger text on detail page */
  }

  .product-detail-desc {
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--text-secondary, #525252);
    line-height: 1.8;
  }

  /* Dynamic Sections styling */
  .dynamic-sections-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color, #f5f5f5);
  }

  .product-dynamic-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-title {
    font-size: 0.875rem; /* text-sm equivalent */
    font-weight: 500;
    color: var(--title-color, #0a0a0a);
  }

  .section-desc {
    font-size: 0.8125rem;
    font-weight: 300;
    color: var(--text-secondary, #525252);
    line-height: 1.7;
  }

  .section-chips-row {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  /* Metadata badge chips (rounded-xl) */
  .chip-badge {
    background-color: var(--bg-secondary, #f5f5f5);
    color: var(--text-secondary, #525252);
    font-size: 0.6875rem;
    padding: 0.25rem 0.625rem;
    border-radius: 0.75rem; /* rounded-xl */
    font-weight: 300;
  }

  .detail-unavailable-badge {
    background-color: var(--bg-secondary, #f5f5f5);
    color: var(--text-muted, #737373);
    font-size: 0.8125rem;
    padding: 0.25rem 0.625rem;
    border-radius: 0.5rem;
    font-weight: 500;
  }

  /* Product Page Footer Styles */
  .product-page-footer {
    padding: 3rem 0 1.5rem 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 42rem;
    margin: auto auto 0 auto;
    box-sizing: border-box;
  }

  .footer-divider {
    width: 100%;
    height: 1px;
    background-color: var(--border-color, #f5f5f5);
    margin-bottom: 0.5rem;
  }

  .footer-platform-link {
    font-size: 0.8125rem;
    font-weight: 300;
    color: var(--text-secondary, #a3a3a3);
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-logo-img {
    width: 3.25rem;
    height: 3.25rem;
    object-fit: contain;
    border-radius: 0.75rem;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .footer-platform-link:hover {
    color: var(--text-primary, #171717);
  }

  .footer-platform-link:hover .footer-logo-img {
    opacity: 1;
  }
</style>
