---
import Layout from '../../layouts/Layout.astro';
import { vendors } from '../../data/vendors';
import type { Vendor, MenuItem } from '../../data/vendors';

// Pre-render static paths for all products under all vendors (SSG)
export function getStaticPaths() {
  const paths: any[] = [];
  
  vendors.forEach((vendor) => {
    vendor.categories.forEach((category) => {
      category.items.forEach((item) => {
        paths.push({
          params: {
            vendor: vendor.slug,
            product: item.id
          },
          props: {
            vendor,
            product: item
          }
        });
      });
    });
  });

  return paths;
}

interface Props {
  vendor: Vendor;
  product: MenuItem;
}

const { vendor, product } = Astro.props;
---

<Layout 
  title={`${product.name} — ${vendor.name}`} 
  description={product.description || `جزئیات محصول ${product.name} در منوی دیجیتال ${vendor.name}`}
  ogImage={product.image}
>
  <main class="product-page-main">
    <div class="product-content-card">
      
      <!-- Minimalist Back Navigation Button (Floating top corner) -->
      <a href={`/${vendor.slug}`} class="back-nav-btn" aria-label="بازگشت به منوی اصلی">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="back-arrow-svg">
          <!-- RTL Go Back Arrow (Points Right) -->
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>

      <!-- Natural Aspect Ratio Product Image (No Cropping) -->
      <div class="product-image-container animate-fade-in">
        {product.image ? (
          <img 
            src={product.image} 
            alt={product.name} 
            class="product-detail-image"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <div class="product-fallback" style="display: none;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="fallback-icon">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <polyline points="21 15 16 10 5 21" />
            </svg>
          </div>
        ) : (
          <div class="product-no-image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="no-image-icon">
              <path d="M6 2v6c0 1.1.9 2 2 2h0c1.1 0 2-.9 2-2V2" />
              <line x1="8" x2="8" y1="2" y2="8" />
              <line x1="8" x2="8" y1="10" y2="22" />
              <path d="M16 2a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z" />
              <line x1="16" x2="16" y1="13" y2="22" />
            </svg>
          </div>
        )}
      </div>

      <!-- Details Section with organic layouts -->
      <div class="product-info-section animate-slide-up">
        
        <div class="product-header-row">
          <h1 class="product-detail-title">{product.name}</h1>
          
          <div class="product-detail-prices">
            {product.discount ? (
              <>
                <span class="price-tag price-old detail-price-tag">{product.discount.originalPrice}</span>
                <span class="price-tag price-new detail-price-tag">{product.priceFormatted}</span>
              </>
            ) : (
              <span class="price-tag detail-price-tag">{product.priceFormatted}</span>
            )}
          </div>
        </div>

        <!-- Short Description -->
        {product.description && (
          <p class="product-detail-desc">{product.description}</p>
        )}

        <!-- Dynamic Product Sections (All fields are optional) -->
        {product.sections && product.sections.length > 0 && (
          <div class="dynamic-sections-container">
            {product.sections.map((section) => (
              <div class="product-dynamic-section">
                {section.title && <h2 class="section-title">{section.title}</h2>}
                {section.description && <p class="section-desc">{section.description}</p>}
                {section.chips && section.chips.length > 0 && (
                  <div class="section-chips-row">
                    {section.chips.map((chip) => (
                      <span class="chip-badge">{chip}</span>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        )}

      </div>

    </div>
  </main>
</Layout>

<style>
  .product-page-main {
    background-color: #FFFFFF;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 2rem 1rem;
    direction: rtl;
  }

  .product-content-card {
    max-width: 42rem; /* max-w-2xl equivalent */
    width: 100%;
    margin: 0 auto;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* Minimalist circular back navigation button */
  .back-nav-btn {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: #f5f5f5; /* bg-neutral-50 */
    color: #171717; /* neutral-900 */
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease;
  }

  .back-nav-btn:hover {
    background-color: #e5e5e5;
    transform: scale(1.05);
  }

  .back-arrow-svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  /* Image container supporting natural aspect ratio */
  .product-image-container {
    width: 100%;
    border-radius: 2rem; /* rounded-3xl equivalent */
    overflow: hidden;
    background-color: #fafafa;
    display: flex;
  }

  .product-detail-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .product-fallback {
    width: 100%;
    height: 300px;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d4d4d4;
  }

  .fallback-icon {
    width: 2.5rem;
    height: 2.5rem;
  }

  .product-no-image {
    width: 100%;
    height: 250px;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a3a3a3;
  }

  .no-image-icon {
    width: 2rem;
    height: 2rem;
  }

  /* Info styling and layout spacing */
  .product-info-section {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .product-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .product-detail-title {
    font-size: 1.375rem;
    font-weight: 500;
    color: #0a0a0a;
    line-height: 1.3;
  }

  .product-detail-prices {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .detail-price-tag {
    font-size: 1.125rem; /* Larger text on detail page */
  }

  .product-detail-desc {
    font-size: 0.875rem;
    font-weight: 300;
    color: #525252;
    line-height: 1.8;
  }

  /* Dynamic Sections styling */
  .dynamic-sections-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #f5f5f5;
  }

  .product-dynamic-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-title {
    font-size: 0.875rem; /* text-sm equivalent */
    font-weight: 500;
    color: #0a0a0a;
  }

  .section-desc {
    font-size: 0.8125rem;
    font-weight: 300;
    color: #525252;
    line-height: 1.7;
  }

  .section-chips-row {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  /* Metadata badge chips (rounded-xl) */
  .chip-badge {
    background-color: #f5f5f5;
    color: #525252;
    font-size: 0.6875rem;
    padding: 0.25rem 0.625rem;
    border-radius: 0.75rem; /* rounded-xl */
    font-weight: 300;
  }
</style>
