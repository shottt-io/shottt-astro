---
import Layout from '../layouts/Layout.astro';
import { getLocale } from '../utils/i18n';
import { CONTACT_EMAIL } from '../config/contact';

const currentLocale = getLocale(Astro.cookies, Astro.request);

type Locale = 'fa' | 'en' | 'tr';

const localTranslations = {
  fa: {
    title: "قوانین و مقررات | شات",
    heading: "شرایط و قوانین استفاده از شات",
    subtitle: "توافق‌نامه استفاده از خدمات ساخت کاتالوگ دیجیتال و منوی آنلاین شات",
    backHome: "بازگشت به خانه",
    sec1Title: "۱. پذیرش شرایط استفاده",
    sec1Desc: "عضویت و استفاده شما از پلتفرم شات به منزله پذیرش کامل و بدون قید و شرط این قوانین و مقررات است. شات حق ویرایش این قوانین را در هر زمان برای خود محفوظ می‌دارد و ادامه استفاده شما به معنای پذیرش نسخه جدید قوانین خواهد بود.",
    sec2Title: "۲. شرایط اشتراک و پرداخت",
    sec2Desc: "استفاده از خدمات شات برای کاتالوگ‌های کوچک (تا ۱۵ محصول) کاملاً رایگان است. برای تعداد محصولات بیشتر، حق اشتراک ماهانه طبق تعرفه مشخص‌شده در سایت اعمال می‌شود. اولین ماه عضویت برای کاتالوگ‌های بزرگ‌تر نیز آزمایشی و رایگان است. فعال‌سازی نهایی پس از دوره آزمایشی منوط به ثبت اطلاعات تراکنش و تایید پرداخت در پنل مدیریت است.",
    sec3Title: "۳. قانون حق انصراف و عودت وجه",
    sec3Desc: "در صورتی که کاربر پس از خرید یا ارتقای اشتراک مایل به انصراف از خدمات باشد، تا ۷ روز پس از پرداخت فرصت دارد درخواست عودت وجه خود را ثبت کند؛ مشروط بر اینکه در این بازه، خدمات مورد استفاده تجاری و سوءاستفاده قرار نگرفته باشد. درخواست انصراف و عودت وجه از طریق مکاتبه با ایمیل پشتیبانی انجام می‌شود و مبلغ پرداختی ظرف ۴۸ تا ۷۲ ساعت کاری به حساب کاربر بازگردانده می‌شود.",
    sec4Title: "۴. تعهدات کاربر و محتوا",
    sec4Desc: "کاربر متعهد می‌شود از بارگذاری تصاویر و متون مغایر با قوانین جاری کشور، شئونات اخلاقی و قوانین کپی‌رایت خودداری کند. مسئولیت کامل محتوای منتشر شده در هر کاتالوگ یا منو بر عهده ثبت‌کننده آن مجموعه است و شات در قبال هرگونه سوءاستفاده یا تخلف کاربران مسئولیتی نمی‌پذیرد.",
    sec5Title: "۵. قطع خدمات و سلب مسئولیت",
    sec5Desc: "شات مجاز است در صورت تخلف کاربر از قوانین و مقررات یا عدم تمدید اشتراک در موعد مقرر، دسترسی وی به پنل مدیریت و کاتالوگ عمومی را بدون اطلاع قبلی مسدود کند. پلتفرم شات هیچ‌گونه مسئولیتی در قبال سود یا زیان مالی ناشی از قطعی‌های موقت سرور بر عهده نمی‌گیرد، هرچند همواره برای حفظ پایداری کامل خدمات تلاش می‌گردد.",
    footerAbout: "درباره ما",
    footerContact: "تماس با ما",
    footerTerms: "قوانین و مقررات",
    footerPrivacy: "حریم خصوصی"
  },
  en: {
    title: "Terms & Conditions | Shottt",
    heading: "Terms and Conditions of Use",
    subtitle: "Terms of service agreement for creating online menus & digital catalogs on Shottt",
    backHome: "Back to Home",
    sec1Title: "1. Acceptance of Terms",
    sec1Desc: "By registering and using Shottt, you accept these terms in full. Shottt reserves the right to modify these terms at any time. Your continued use of the platform represents your acceptance of the updated terms.",
    sec2Title: "2. Subscriptions & Payments",
    sec2Desc: "Using Shottt is completely free for small catalogs (up to 15 products). For larger catalogs, a subscription fee applies as detailed on the homepage. The first calendar month is free. Activation is subject to manual payment registration and verification.",
    sec3Title: "3. Cancellation & Refund Policy",
    sec3Desc: "Users have a 7-day cancellation period after paying for a subscription to request a full refund, provided the service has not been actively used for commercial transactions. Refund requests must be sent via email to support, and the refund will be processed within 48 to 72 business hours.",
    sec4Title: "4. User Content & Conduct",
    sec4Desc: "Users are solely responsible for all images, descriptions, and data uploaded to their catalogs. You must not upload copyrighted, illegal, or harmful content. Shottt assumes no liability for user-generated content.",
    sec5Title: "5. Service Suspension & Disclaimer",
    sec5Desc: "Shottt reserves the right to suspend accounts that violate the terms or fail to renew subscriptions. Shottt is provided 'as is' without warranties of any kind regarding uptime, though we always strive to maintain maximum server stability.",
    footerAbout: "About Us",
    footerContact: "Contact Us",
    footerTerms: "Terms of Service",
    footerPrivacy: "Privacy Policy"
  },
  tr: {
    title: "Kullanım Koşulları | Shottt",
    heading: "Kullanım Koşulları ve Kuralları",
    subtitle: "Shottt dijital katalog ve çevrimiçi menü oluşturma hizmet sözleşmesi",
    backHome: "Ana Sayfaya Dön",
    sec1Title: "1. Koşulların Kabulü",
    sec1Desc: "Shottt platformuna üye olarak ve kullanarak bu koşulları tamamen kabul etmiş olursunuz. Shottt, bu koşulları dilediği zaman değiştirme hakkını saklı tutar. Değişiklikleri takip etmek kullanıcının sorumluluğundadır.",
    sec2Title: "2. Abonelik ve Ödeme",
    sec2Desc: "Küçük kataloglar (15 ürüne kadar) için Shottt kullanımı tamamen ücretsizdir. Daha fazla ürün içeren kataloglar için web sitesinde belirtilen abonelik ücreti geçerlidir. İlk takvim ayı ücretsizdir. Abonelik aktivasyonu, ödemenin yönetici panelinden kaydedilmesi ve onaylanmasına tabidir.",
    sec3Title: "3. İptal ve İade Politikası",
    sec3Desc: "Kullanıcılar, abonelik ücreti ödedikten sonraki 7 gün içinde tam iade talebinde bulunabilirler. İade talebi için lütfen destek e-postası üzerinden bizimle iletişime geçin. İade tutarı 48 ila 72 iş saati içerisinde hesabınıza aktarılacaktır.",
    sec4Title: "4. Kullanıcı İçeriği",
    sec4Desc: "Kullanıcılar, kataloglarına yükledikleri tüm resim, açıklama ve verilerden kendileri sorumludur. Telif hakkı içeren veya yasa dışı içerikler yüklenemez. Shottt, kullanıcı tarafından oluşturulan içeriklerden sorumlu tutulamaz.",
    sec5Title: "5. Hizmet Durdurma ve Sorumluluk Reddi",
    sec5Desc: "Shottt, kuralları ihlal eden veya aboneliğini yenilemeyen hesapları askıya alma hakkını saklı tutar. Geçici kesintilerden kaynaklanabilecek olası kayıplardan Shottt sorumlu tutulamaz, ancak sistem kararlılığı en üst düzeyde tutulmaktadır.",
    footerAbout: "Hakkımızda",
    footerContact: "İletişim",
    footerTerms: "Kullanım Koşulları",
    footerPrivacy: "Gizlilik Politikası"
  }
};

const t = localTranslations[currentLocale as Locale] || localTranslations['en'];
---

<Layout title={t.title} description={t.subtitle}>
  <main class="marketing-container font-sans" style={`direction: ${currentLocale === 'fa' ? 'rtl' : 'ltr'};`}>
    <!-- Navigation -->
    <nav class="top-nav">
      <div class="top-nav-inner">
        <div class="lang-dropdown-container">
          <button class="lang-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="globe-icon">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>{currentLocale === 'fa' ? 'فارسی' : currentLocale === 'tr' ? 'Türkçe' : 'English'}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="lang-dropdown-menu">
            <button class={`lang-dropdown-item ${currentLocale === 'fa' ? 'active' : ''}`} data-lang="fa">فارسی</button>
            <button class={`lang-dropdown-item ${currentLocale === 'en' ? 'active' : ''}`} data-lang="en">English</button>
            <button class={`lang-dropdown-item ${currentLocale === 'tr' ? 'active' : ''}`} data-lang="tr">Türkçe</button>
          </div>
        </div>
        <div class="top-nav-actions">
          <a href="/" class="top-login-link">{t.backHome}</a>
        </div>
      </div>
    </nav>

    <div class="content-wrapper animate-slide-up">
      <!-- Big Centered Logo -->
      <div class="logo-container">
        <a href="/">
          <img src="/logo.png" alt="shottt logo" class="brand-logo-img" />
        </a>
      </div>

      <!-- Legal Card -->
      <div class="legal-card card-glass">
        <h1 class="legal-title">{t.heading}</h1>
        <p class="legal-subtitle">{t.subtitle}</p>
        
        <div class="legal-divider"></div>
        
        <div class="legal-text-content">
          <section class="legal-section">
            <h2>{t.sec1Title}</h2>
            <p>{t.sec1Desc}</p>
          </section>

          <section class="legal-section">
            <h2>{t.sec2Title}</h2>
            <p>{t.sec2Desc}</p>
          </section>

          <section class="legal-section">
            <h2>{t.sec3Title}</h2>
            <p>{t.sec3Desc}</p>
            <p style="font-weight: 500; color: #18181b;">
              {currentLocale === 'fa' ? 'ایمیل جهت ثبت درخواست عودت وجه:' : 'Email for refund requests:'} 
              <a href={`mailto:${CONTACT_EMAIL}`} style="color: #0284c7; text-decoration: none;">{CONTACT_EMAIL}</a>
            </p>
          </section>

          <section class="legal-section">
            <h2>{t.sec4Title}</h2>
            <p>{t.sec4Desc}</p>
          </section>

          <section class="legal-section">
            <h2>{t.sec5Title}</h2>
            <p>{t.sec5Desc}</p>
          </section>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="home-footer">
      <div class="footer-nav-links">
        <a href="/about" class="footer-link">{t.footerAbout}</a>
        <span class="footer-bullet">•</span>
        <a href="/contact" class="footer-link">{t.footerContact}</a>
        <span class="footer-bullet">•</span>
        <a href="/terms" class="footer-link">{t.footerTerms}</a>
        <span class="footer-bullet">•</span>
        <a href="/privacy" class="footer-link">{t.footerPrivacy}</a>
      </div>
    </footer>
  </main>
</Layout>

<script is:inline>
  const langItems = document.querySelectorAll('.lang-dropdown-item');
  langItems.forEach(item => {
    item.addEventListener('click', () => {
      const targetLang = item.getAttribute('data-lang') || 'fa';
      document.cookie = `lang=${targetLang}; path=/; max-age=31536000`;
      window.location.reload();
    });
  });

  const trigger = document.querySelector('.lang-dropdown-trigger');
  const menu = document.querySelector('.lang-dropdown-menu');
  if (trigger && menu) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', !expanded);
      menu.classList.toggle('show');
    });
    document.addEventListener('click', () => {
      trigger.setAttribute('aria-expanded', 'false');
      menu.classList.remove('show');
    });
  }
</script>

<style>
  .font-sans {
    font-family: 'Estedad', system-ui, -apple-system, sans-serif;
  }

  .marketing-container {
    width: 100%;
    min-height: 100vh;
    overflow-x: hidden;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #fafafa;
    color: #18181b;
    padding: 0 0 4rem 0;
    gap: 2.5rem;
  }

  .top-nav {
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    padding: 1.5rem 2rem 0 2rem;
    box-sizing: border-box;
  }

  .top-nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .lang-dropdown-container {
    position: relative;
    display: inline-block;
  }

  .lang-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid #e4e4e7;
    border-radius: 9999px;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #27272a;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  .lang-dropdown-trigger:hover {
    background: #ffffff;
    border-color: #d4d4d8;
  }

  .globe-icon {
    width: 1rem;
    height: 1rem;
    color: #71717a;
  }

  .chevron-icon {
    width: 0.75rem;
    height: 0.75rem;
    color: #a1a1aa;
    transition: transform 0.2s ease;
  }

  .lang-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    inset-inline-start: 0;
    background: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 0.75rem;
    padding: 0.35rem;
    min-width: 8rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02);
    display: none;
    flex-direction: column;
    gap: 0.2rem;
    z-index: 50;
  }

  .lang-dropdown-menu.show {
    display: flex;
  }

  .lang-dropdown-item {
    background: none;
    border: none;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #3f3f46;
    text-align: start;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .lang-dropdown-item:hover {
    background: #f4f4f5;
    color: #18181b;
  }

  .lang-dropdown-item.active {
    background: #f4f4f5;
    color: #0284c7;
    font-weight: 600;
  }

  .top-login-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #27272a;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid #e4e4e7;
    border-radius: 9999px;
    padding: 0.5rem 1.25rem;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  .top-login-link:hover {
    background: #ffffff;
    border-color: #d4d4d8;
  }

  .content-wrapper {
    width: 100%;
    max-width: 48rem;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  .logo-container {
    margin-bottom: 2rem;
  }

  .brand-logo-img {
    height: 5rem;
    width: auto;
    object-fit: contain;
  }

  /* Glassmorphic Legal Card */
  .card-glass {
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(228, 228, 231, 0.6);
    border-radius: 1.5rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.02), 0 10px 10px -5px rgba(0, 0, 0, 0.01);
  }

  .legal-card {
    width: 100%;
    padding: 3rem;
    box-sizing: border-box;
  }

  .legal-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #18181b;
    margin: 0 0 0.5rem 0;
  }

  .legal-subtitle {
    font-size: 0.9375rem;
    color: #71717a;
    margin: 0;
  }

  .legal-divider {
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(228, 228, 231, 0.8), transparent);
    margin: 2rem 0;
  }

  .legal-text-content {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: #3f3f46;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    text-align: justify;
  }

  .legal-section h2 {
    font-size: 1.1rem;
    font-weight: 750;
    color: #18181b;
    margin: 0 0 0.75rem 0;
  }

  .legal-section p {
    margin: 0;
    color: #3f3f46;
  }

  /* Footer */
  .home-footer {
    width: 100%;
    max-width: 64rem;
    margin-top: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .footer-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #71717a;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: #0284c7;
  }

  .footer-bullet {
    color: #d4d4d8;
    font-size: 0.75rem;
  }

  /* Animations */
  .animate-slide-up {
    animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .legal-card {
      padding: 2rem 1.5rem;
    }
    .legal-title {
      font-size: 1.5rem;
    }
  }
</style>
