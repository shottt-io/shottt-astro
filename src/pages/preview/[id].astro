---
import Layout from '../../layouts/Layout.astro';
import BrandHeader from '../../components/BrandHeader.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import MenuLayout from '../../components/MenuLayout.astro';
import { previews } from '../../utils/store';
import { useTranslations } from '../../utils/i18n';

const { id } = Astro.params;
if (!id) {
  return new Response("Not Found", { status: 404 });
}

const vendor = previews.get(id);
if (!vendor) {
  return new Response("Preview Session Expired or Not Found", { status: 404 });
}

const { t } = useTranslations(Astro.cookies, Astro.request, vendor.locale || undefined);

let globalItemIdx = 0;
const categories = vendor.categories.map((category) => ({
  id: category.id,
  name: category.name,
  status: category.status,
  items: category.items.map((item) => {
    let gridIndex = item.gridIndex;
    if (gridIndex === undefined || gridIndex === null) {
      if (globalItemIdx < 35) {
        gridIndex = globalItemIdx + 1; // 1-based index (0 is logo)
      }
    }
    globalItemIdx++;

    return {
      id: item.id,
      name: item.name,
      slug: item.slug,
      price: item.price,
      image: item.image,
      description: item.description,
      discount: item.discount,
      span2: item.span2,
      status: item.status,
      gridIndex: gridIndex,
    };
  }),
}));

// Multi-language banner messages
const bannerTitle = {
  fa: 'این پیش‌نمایش منوی شماست! برای ثبت و اختصاصی کردن آن ثبت‌نام کنید.',
  en: 'This is your menu preview! Register to claim and customize it.',
  tr: 'Bu sizin menü önizlemenizdir! Sahiplenmek ve özelleştirmek için kaydolun.',
}[vendor.locale || 'fa'];

const registerLabel = {
  fa: 'ثبت‌نام مجموعه ⚡',
  en: 'Register Now ⚡',
  tr: 'Şimdi Kaydol ⚡',
}[vendor.locale || 'fa'];

const changeDesignLabel = {
  fa: 'تغییر طرح ✨',
  en: 'Change Design ✨',
  tr: 'Tasarımı Değiştir ✨',
}[vendor.locale || 'fa'];
---

<Layout 
  title={`${vendor.name} — ${t('digitalCatalog')} (${t('preview') || 'Preview'})`} 
  description={`${vendor.type} ${vendor.name} - ${vendor.slogan}`}
  ogImage={vendor.logo}
  favicon={vendor.logo}
  theme={vendor.theme}
  twitterCard="summary"
  localeOverride={vendor.locale || undefined}
>
  <!-- Sticky Top Call-To-Action Banner -->
  <div class="preview-cta-banner">
    <div class="banner-content">
      <span class="banner-text">{bannerTitle}</span>
      <div class="banner-actions">
        <button 
          id="change-design-btn" 
          class="preview-design-btn"
          data-preview-id={id}
          data-current-layout={vendor.defaultLayout}
          data-current-theme={vendor.theme}
        >
          {changeDesignLabel}
        </button>
        <a href={`/admin/register?preview_id=${id}`} class="preview-register-btn">{registerLabel}</a>
      </div>
    </div>
  </div>

  <!-- AI Image Status Banner -->
  <div id="image-status-banner" class="image-status-banner" style="display: none;">
    <div class="status-banner-content">
      <span class="pulse-dot"></span>
      <span id="image-status-text"></span>
    </div>
  </div>

  <main class="menu-main-wrapper" id="page-main" data-vendor-slug="#">
    <!-- Brand Info Header -->
    <BrandHeader 
      name={vendor.name}
      type={vendor.type}
      slogan={vendor.slogan}
      logoIcon={vendor.logoIcon}
      logo={vendor.logo}
    />

    <!-- Frosted Glass Categories Sticky Bar -->
    <CategoryNav categories={categories} />

    <!-- Core Menu Items List (Pinterest Masonry, Compact List, or Card layout) -->
    <MenuLayout 
      categories={categories}
      layoutMode={vendor.defaultLayout as 'pinterest' | 'simple' | 'card'}
      vendorSlug="#"
      locale={vendor.locale || undefined}
      currency={vendor.currency}
      forceSkeletons={true}
    />

    <!-- Product Page Footer -->
    <footer class="product-page-footer">
      <div class="footer-divider"></div>
      <a href="/" class="footer-platform-link">
        {t('developedWith')}
        <img src="/logo.png" alt="shottt" class="footer-logo-img" />
      </a>
    </footer>
  </main>

  <style>
    .preview-cta-banner {
      background: linear-gradient(135deg, #18181b, #09090b);
      color: #ffffff;
      padding: 0.75rem 1rem;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .banner-content {
      max-width: 42rem;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.75rem;
      font-family: 'Estedad', system-ui, -apple-system, sans-serif;
    }

    .banner-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .banner-text {
      font-size: 0.8125rem;
      font-weight: 500;
      line-height: 1.4;
    }

    .preview-register-btn {
      background-color: #ffffff;
      color: #18181b;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.45rem 1rem;
      border-radius: 9999px;
      text-decoration: none;
      white-space: nowrap;
      transition: all 0.2s ease;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .preview-register-btn:hover {
      background-color: #f4f4f5;
      transform: scale(1.02);
    }

    .menu-main-wrapper {
      background-color: var(--bg-primary, #FFFFFF);
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      transition: background-color 0.3s ease;
    }

    /* Product Page Footer Styles */
    .product-page-footer {
      padding: 3rem 0 1.5rem 0;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      width: 100%;
      max-width: 42rem;
      margin: auto auto 0 auto;
      box-sizing: border-box;
    }

    .footer-divider {
      width: 100%;
      height: 1px;
      background-color: var(--border-color, #f5f5f5);
      margin-bottom: 0.5rem;
    }

    .footer-platform-link {
      font-size: 0.8125rem;
      font-weight: 300;
      color: var(--text-secondary, #a3a3a3);
      text-decoration: none;
      transition: color 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 1rem;
    }

    .footer-logo-img {
      width: 3.25rem;
      height: 3.25rem;
      object-fit: contain;
      border-radius: 0.75rem;
      opacity: 0.8;
      transition: opacity 0.2s ease;
    }

    .footer-platform-link:hover {
      color: var(--text-primary, #171717);
    }

    .footer-platform-link:hover .footer-logo-img {
      opacity: 1;
    }

    .preview-design-btn {
      background-color: transparent;
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.3);
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.45rem 1rem;
      border-radius: 9999px;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s ease;
    }

    .preview-design-btn:hover {
      background-color: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.6);
      transform: scale(1.02);
    }

    /* AI Image Status Banner Styles */
    .image-status-banner {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      padding: 0.625rem 1rem;
      position: sticky;
      top: 3.5rem;
      z-index: 999;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.02);
      transition: all 0.3s ease;
      color: #18181b;
    }

    [data-theme="dark"] .image-status-banner {
      background: rgba(24, 24, 27, 0.85);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      color: #ffffff;
    }

    .status-banner-content {
      max-width: 42rem;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.625rem;
      font-size: 0.75rem;
      font-weight: 500;
      font-family: 'Estedad', system-ui, -apple-system, sans-serif;
    }

    .pulse-dot {
      width: 0.5rem;
      height: 0.5rem;
      background-color: #10b981;
      border-radius: 50%;
      animation: pulse-animation 1.5s infinite ease-in-out;
      flex-shrink: 0;
    }

    @keyframes pulse-animation {
      0% {
        transform: scale(0.9);
        opacity: 0.6;
      }
      50% {
        transform: scale(1.2);
        opacity: 1;
      }
      100% {
        transform: scale(0.9);
        opacity: 0.6;
      }
    }
  </style>

  <!-- Client-side script to intercept details page clicks -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Intercept Details clicks
      const pageMain = document.getElementById('page-main');
      if (pageMain) {
        pageMain.addEventListener('click', (e) => {
          const anchor = e.target.closest('a');
          if (anchor) {
            if (anchor.classList.contains('preview-register-btn') || anchor.classList.contains('footer-platform-link')) {
              return;
            }
            e.preventDefault();
          }
        }, true);
      }

      // Handle Change Design Button Clicks
      const changeDesignBtn = document.getElementById('change-design-btn');
      if (changeDesignBtn) {
        changeDesignBtn.addEventListener('click', async () => {
          const layouts = ['pinterest', 'simple', 'card'];
          const themes = ['light', 'dark'];
          
          const currentLayout = changeDesignBtn.getAttribute('data-current-layout');
          const currentTheme = changeDesignBtn.getAttribute('data-current-theme');
          const id = changeDesignBtn.getAttribute('data-preview-id');
          
          // Cycle layouts sequentially to guarantee a change on every click
          const currentIndex = layouts.indexOf(currentLayout);
          const nextLayout = layouts[currentIndex === -1 ? 0 : (currentIndex + 1) % layouts.length];
          
          // Randomly choose dark/light theme (can be consecutive)
          const nextTheme = themes[Math.floor(Math.random() * themes.length)];
          
          changeDesignBtn.disabled = true;
          changeDesignBtn.style.opacity = '0.7';
          
          try {
            const res = await fetch('/api/ai/update-preview', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, layout: nextLayout, theme: nextTheme }),
            });
            if (res.ok) {
              window.location.reload();
            } else {
              throw new Error('Update failed');
            }
          } catch (err) {
            console.error(err);
            changeDesignBtn.disabled = false;
            changeDesignBtn.style.opacity = '1';
          }
        });
      }
    });
  </script>

  <!-- Client-side script to poll for AI generated images and perform canvas cropping -->
  <script is:inline define:vars={{ previewId: id, initialHasGridImage: !!vendor.gridImage, initialGridImageUrl: vendor.gridImage || null, currentLocale: vendor.locale || 'fa' }}>
    document.addEventListener('DOMContentLoaded', () => {
      console.log('[DEBUG] DOMContentLoaded initialized.');
      console.log('[DEBUG] Current configuration:', { previewId, initialHasGridImage, initialGridImageUrl, currentLocale });

      const banner = document.getElementById('image-status-banner');
      const bannerText = document.getElementById('image-status-text');
      console.log('[DEBUG] Status Banner elements:', { banner: !!banner, bannerText: !!bannerText });

      const messages = {
        fa: {
          preparing: '📸 عکاسی آیتم‌های منو توسط هوش مصنوعی در حال آماده‌سازی است...',
          processing: '✨ تصاویر هوش مصنوعی آماده شد! در حال اعمال روی منو...',
          success: '✅ تصاویر با موفقیت اعمال شدند.'
        },
        en: {
          preparing: '📸 AI menu item photography is being prepared...',
          processing: '✨ AI images ready! Slicing and applying to menu...',
          success: '✅ Images applied successfully.'
        },
        tr: {
          preparing: '📸 Yapay zeka menü fotoğrafları hazırlanıyor...',
          processing: '✨ Görseller hazır! Menüye uygulanıyor...',
          success: '✅ Görseller başarıyla uygulandı.'
        }
      }[currentLocale || 'fa'];

      // Function to load the grid image, crop it using canvas, and set image elements locally
      const cropAndApplyGridImage = (gridImageUrl, gridSize, items) => {
        console.log('[DEBUG] cropAndApplyGridImage started.', { gridImageUrl, gridSize, itemsCount: items.length });
        
        if (banner && bannerText) {
          banner.style.display = 'block';
          bannerText.textContent = messages.processing;
          console.log('[DEBUG] Updated banner text to processing.');
        }

        const img = new Image();
        img.crossOrigin = 'anonymous';
        
        img.onerror = (err) => {
          console.error('[DEBUG] [ERROR] Failed to load grid image element! URL:', gridImageUrl, 'Error:', err);
        };
        
        img.onload = () => {
          console.log('[DEBUG] Grid image loaded successfully.', { 
            naturalWidth: img.naturalWidth, 
            naturalHeight: img.naturalHeight,
            width: img.width,
            height: img.height
          });

          try {
            const effectiveGridSize = gridSize || 6;
            const tileSize = img.naturalWidth / effectiveGridSize;
            console.log('[DEBUG] Slicing configuration:', { effectiveGridSize, tileSize });

            // Crop and set Logo (always at gridIndex 0, which is col 0, row 0)
            console.log('[DEBUG] Starting Logo crop...');
            const logoCanvas = document.createElement('canvas');
            logoCanvas.width = 320;
            logoCanvas.height = 320;
            const logoCtx = logoCanvas.getContext('2d');
            logoCtx.drawImage(
              img,
              0, // col 0
              0, // row 0
              tileSize,
              tileSize,
              0,
              0,
              320,
              320
            );
            const logoDataUrl = logoCanvas.toDataURL('image/jpeg', 0.85);
            console.log('[DEBUG] Logo cropped. Data URL length:', logoDataUrl.length);

            const logoImg = document.querySelector('.logo-img');
            const logoBox = document.querySelector('.logo-box');
            console.log('[DEBUG] Logo elements in DOM:', { logoImg: !!logoImg, logoBox: !!logoBox });

            if (logoImg) {
              logoImg.src = logoDataUrl;
              logoImg.style.display = '';
              logoImg.style.opacity = '1';
              logoImg.classList.add('loaded');
              console.log('[DEBUG] Assigned Logo Data URL to logoImg.src.');
            }
            if (logoBox) {
              logoBox.style.display = 'none';
              console.log('[DEBUG] Hid logoBox.');
            }

            // Crop and set item images
            console.log('[DEBUG] Starting items crop loop...');
            for (const item of items) {
              console.log('[DEBUG] Processing item:', { id: item.id, name: item.name, gridIndex: item.gridIndex });
              if (item.gridIndex === null || item.gridIndex === undefined) {
                console.log('[DEBUG] Item skipped (no gridIndex).');
                continue;
              }

              const canvas = document.createElement('canvas');
              canvas.width = 320;
              canvas.height = 320;
              const ctx = canvas.getContext('2d');

              const col = item.gridIndex % effectiveGridSize;
              const row = Math.floor(item.gridIndex / effectiveGridSize);
              console.log('[DEBUG] Item crop coordinates:', { col, row, x: col * tileSize, y: row * tileSize, width: tileSize, height: tileSize });

              ctx.drawImage(
                img,
                col * tileSize,
                row * tileSize,
                tileSize,
                tileSize,
                0,
                0,
                320,
                320
              );

              const itemDataUrl = canvas.toDataURL('image/jpeg', 0.85);
              console.log('[DEBUG] Item canvas crop complete. Data URL length:', itemDataUrl.length);

              const itemContainer = document.querySelector(`[data-item-id="${item.id}"]`);
              console.log('[DEBUG] Target itemContainer found in DOM:', !!itemContainer);
              if (itemContainer) {
                const imgEl = itemContainer.querySelector('img');
                console.log('[DEBUG] Target image element in itemContainer found:', !!imgEl);
                if (imgEl) {
                  imgEl.src = itemDataUrl;
                  imgEl.style.display = '';
                  imgEl.style.opacity = '1';
                  imgEl.classList.add('loaded');
                  
                  const placeholder = imgEl.nextElementSibling;
                  console.log('[DEBUG] Target placeholder found:', !!placeholder);
                  if (placeholder) {
                    placeholder.style.display = 'none';
                  }
                  console.log('[DEBUG] Applied Data URL to item image.');
                }
              }
            }

            // Hide status banner
            if (banner) {
              bannerText.textContent = messages.success;
              console.log('[DEBUG] Updated banner text to success.');
              setTimeout(() => {
                banner.style.opacity = '0';
                setTimeout(() => {
                  banner.style.display = 'none';
                  console.log('[DEBUG] Hid status banner.');
                }, 300);
              }, 1000);
            }
          } catch (ex) {
            console.error('[DEBUG] [ERROR] Exception caught during canvas cropping:', ex);
          }
        };
        
        console.log('[DEBUG] Setting img.src to start loading grid image:', gridImageUrl);
        img.src = gridImageUrl;
      };

      if (initialHasGridImage && initialGridImageUrl) {
        console.log('[DEBUG] initialHasGridImage is true. Loading index data immediately...');
        fetch(`/api/ai/check-images?id=${previewId}`)
          .then(res => {
            console.log('[DEBUG] Index fetch response status:', res.status);
            return res.json();
          })
          .then(data => {
            console.log('[DEBUG] Index fetch parsed response:', data);
            if (data.success && data.gridImage) {
              cropAndApplyGridImage(data.gridImage, data.gridSize, data.items);
            } else {
              console.warn('[DEBUG] Index fetch response was unsuccessful or missing gridImage.', data);
            }
          })
          .catch(err => console.error('[DEBUG] [ERROR] Failed to load item coordinates:', err));
      } else {
        console.log('[DEBUG] initialHasGridImage is false. Starting polling check-images API...');
        if (banner && bannerText) {
          banner.style.display = 'block';
          bannerText.textContent = messages.preparing;
        }

        let isPolling = false;
        const pollInterval = setInterval(async () => {
          if (isPolling) {
            console.log('[DEBUG] Polling tick: already fetching, skipping...');
            return;
          }
          isPolling = true;
          console.log('[DEBUG] Polling tick: fetching `/api/ai/check-images`...');

          try {
            const res = await fetch(`/api/ai/check-images?id=${previewId}`);
            console.log('[DEBUG] Poll response status:', res.status);
            const data = await res.json();
            console.log('[DEBUG] Poll response parsed:', data);

            if (data.success && data.ready && data.gridImage) {
              console.log('[DEBUG] Polling successful. Stopping polling.');
              clearInterval(pollInterval);
              cropAndApplyGridImage(data.gridImage, data.gridSize, data.items);
            } else {
              console.log('[DEBUG] Grid not ready yet. Continuing polling.');
              isPolling = false;
            }
          } catch (err) {
            console.error('[DEBUG] [ERROR] Error polling check-images status:', err);
            isPolling = false;
          }
        }, 3000);
      }
    });
  </script>
</Layout>
