---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { db } from '../../../../db/db';
import { vendors as vendorsTable, categories as categoriesTable } from '../../../../db/schema';
import { eq, asc } from 'drizzle-orm';

const vendorSlug = Astro.params.vendor;
if (!vendorSlug) {
  return Astro.redirect('/admin');
}

// Fetch vendor
const vendorList = await db
  .select()
  .from(vendorsTable)
  .where(eq(vendorsTable.slug, vendorSlug))
  .limit(1);

if (vendorList.length === 0) {
  return new Response("مجموعه یافت نشد.", { status: 404 });
}
const vendor = vendorList[0];

// Fetch categories for this vendor
const dbCategories = await db
  .select()
  .from(categoriesTable)
  .where(eq(categoriesTable.vendorId, vendor.id))
  .orderBy(asc(categoriesTable.sortOrder));
---

<AdminLayout title="افزودن محصول جدید" activeTab="products" vendorSlug={vendorSlug}>
  <!-- Action Header -->
  <div class="admin-page-actions">
    <h1 class="page-title-bold">ثبت محصول جدید</h1>
    
    <a href={`/admin/${vendorSlug}/products`} class="btn btn-secondary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 0.875rem; height: 0.875rem;">
        <line x1="19" y1="12" x2="5" y2="12" />
        <polyline points="12 19 19 12 12 5" />
      </svg>
      <span>بازگشت به محصولات</span>
    </a>
  </div>

  <!-- Onboarding banner -->
  <div class="onboarding-banner">
    <div class="onboarding-icon-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.125rem; height: 1.125rem;">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="16" x2="12" y2="12" />
        <line x1="12" y1="8" x2="12.01" y2="8" />
      </svg>
    </div>
    <div class="onboarding-text-box">
      <span class="onboarding-title">راهنمای ثبت محصول موفق</span>
      <p class="onboarding-desc">تصویر محصول را آپلود کرده و برش دهید. بخش «تخفیف ویژه» با ایجاد تضاد قیمت قدیمی و جدید، مشتری را ترغیب به خرید می‌کند. سکشن‌های داینامیک در پایین فرم برای ثبت ویژگی‌ها، راهنماها، مشخصات فنی یا داستان برند محصول است.</p>
    </div>
  </div>

  {dbCategories.length === 0 ? (
    <div class="admin-card" style="text-align: center; padding: 3rem 1.5rem;">
      <p style="font-size: 0.875rem; color: #737373; margin-bottom: 1.5rem;">برای افزودن محصول، ابتدا باید حداقل یک دسته‌بندی ایجاد کنید.</p>
      <a href={`/admin/${vendorSlug}/categories`} class="btn btn-primary">مدیریت دسته‌بندی‌ها</a>
    </div>
  ) : (
    <div class="admin-card">
      <form id="new-product-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
        <input type="hidden" name="vendorId" value={vendor.id} />

        <div class="form-group">
          <label class="form-label">نام محصول *</label>
          <input type="text" name="name" class="form-input" placeholder="مثال: ساعت هوشمند سری ۸" required />
        </div>

        <div class="form-group">
          <label class="form-label">دسته‌بندی محصول *</label>
          <select name="categoryId" class="form-select" required>
            {dbCategories.map(cat => (
              <option value={cat.id}>{cat.name}</option>
            ))}
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">وضعیت محصول *</label>
          <div class="status-selector-container">
            <input type="hidden" name="status" id="status-field" value="available" />
            <div class="status-pills">
              <button type="button" class="status-pill-btn active" data-status="available">
                <span class="status-dot dot-available"></span>
                موجود
              </button>
              <button type="button" class="status-pill-btn" data-status="unavailable">
                <span class="status-dot dot-unavailable"></span>
                ناموجود
              </button>
              <button type="button" class="status-pill-btn" data-status="inactive">
                <span class="status-dot dot-inactive"></span>
                غیرفعال
              </button>
            </div>
            <p class="status-explanation" id="status-explanation">
              توضیح: محصول در کاتالوگ نمایش داده شده و قیمت آن فعال است.
            </p>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">قیمت محصول (به هزار تومان) *</label>
          <input type="text" name="price" class="form-input" placeholder="مثال: ۱۲۵" required />
        </div>

        <div class="form-group">
          <label class="form-label">توضیح کوتاه محصول</label>
          <textarea name="description" class="form-input" rows="3" placeholder="توضیح جذاب و کوتاهی درباره مشخصات و ویژگی‌های محصول..."></textarea>
        </div>

        <div class="form-group">
          <label class="form-label">تصویر محصول</label>
          <div class="image-upload-wrapper">
            <input type="file" id="product-file-input" accept="image/*" style="display: none;" />
            <input type="hidden" name="image" id="product-image-url-hidden" value="" />
            <div class="image-preview-container" id="product-preview-container">
              <img src="" id="product-preview" class="image-preview-box" style="display: none;" />
              <div style="display: flex; flex-direction: column; gap: 0.375rem; align-items: flex-start;">
                <button type="button" class="btn btn-secondary" id="btn-select-product-image">انتخاب تصویر محصول</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Cropper Modal -->
        <div id="cropper-modal" class="modal-overlay" style="display: none;">
          <div class="modal-content">
            <div class="modal-header">
              <span class="modal-title">برش و بهینه‌سازی تصویر محصول</span>
              <button type="button" class="modal-close" id="btn-close-cropper">✕</button>
            </div>
            <div class="modal-body" style="flex-direction: column; gap: 1rem; align-items: stretch; text-align: center;">
              <!-- Aspect Ratio Selector -->
              <div class="ratio-selector" style="display: flex; gap: 0.375rem; justify-content: center; width: 100%; flex-wrap: wrap;">
                <button type="button" class="btn btn-secondary btn-sm ratio-btn active" data-ratio="1" style="font-size: 0.6875rem; padding: 0.4rem 0.75rem;">۱:۱ (مربع)</button>
                <button type="button" class="btn btn-secondary btn-sm ratio-btn" data-ratio="0.75" style="font-size: 0.6875rem; padding: 0.4rem 0.75rem;">۳:۴ (عمودی)</button>
                <button type="button" class="btn btn-secondary btn-sm ratio-btn" data-ratio="1.3333" style="font-size: 0.6875rem; padding: 0.4rem 0.75rem;">۴:۳ (استاندارد)</button>
                <button type="button" class="btn btn-secondary btn-sm ratio-btn" data-ratio="1.7777" style="font-size: 0.6875rem; padding: 0.4rem 0.75rem;">۱۶:۹ (عریض)</button>
                <button type="button" class="btn btn-secondary btn-sm ratio-btn" data-ratio="NaN" style="font-size: 0.6875rem; padding: 0.4rem 0.75rem;">آزاد (کاستوم)</button>
              </div>

              <div class="cropper-container">
                <img id="cropper-image" src="" style="max-width: 100%; max-height: 320px; display: block;" />
              </div>

              <p style="font-size: 0.6875rem; color: #737373; line-height: 1.5; margin: 0; text-align: right; direction: rtl;">
                توضیح: به دلیل استفاده از حالت پینترستی در نمایش کاتالوگ، محدودیتی در نسبت ابعاد تصویر ندارید؛ اتفاقاً برای این نوع چیدمان، بهتر است عکس‌ها عمودی باشند تا زیباتر نمایش داده شوند. می‌توانید هر یک از نسبت‌های بالا یا کادر آزاد را برای محصول خود تنظیم کنید.
              </p>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-primary" id="btn-crop-save">برش و آپلود</button>
              <button type="button" class="btn btn-secondary" id="btn-crop-cancel">انصراف</button>
            </div>
          </div>
        </div>

        <!-- Layout Option Column Span (Checkbox) -->
        <label class="checkbox-group">
          <input type="checkbox" name="span2" class="checkbox-input" />
          <span class="form-label" style="margin-bottom: 0;">نمایش دو ستونه (بزرگتر در چیدمان پینترستی)</span>
        </label>

        <!-- Toggle Special Discount -->
        <label class="checkbox-group" style="margin-top: 0.5rem; margin-bottom: 0.5rem;">
          <input type="checkbox" id="toggle-discount" class="checkbox-input" />
          <span class="form-label" style="margin-bottom: 0; color: #171717; font-weight: 600;">افزودن تخفیف ویژه و پیشنهاد خرید</span>
        </label>

        <!-- Marketing discount card (Wrapper hidden by default) -->
        <div id="discount-section-wrapper" style="display: none; border: 1px solid #ffe4e6; border-radius: 1rem; padding: 1.25rem; background: #fff5f5; text-align: right; direction: rtl;">
          <div style="display: flex; gap: 0.5rem; align-items: center; color: #be123c; margin-bottom: 1rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1rem; height: 1rem;">
              <polyline points="23 18 13.5 8.5 8.5 13.5 1 6" />
              <polyline points="17 18 23 18 23 12" />
            </svg>
            <span style="font-size: 0.8125rem; font-weight: 600;">تنظیم تخفیف ویژه و پیشنهاد خرید</span>
          </div>
          
          <div class="form-group">
            <label class="form-label">قیمت اصلی و قبلی (خط خورده - به هزار تومان)</label>
            <input type="text" name="originalPrice" class="form-input" placeholder="مثال: ۱۵۰" />
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label">عنوان تخفیف / لیبل تشویقی</label>
            <input type="text" name="discountText" class="form-input" placeholder="مثال: آفر ویژه، پیشنهاد ویژه" />
          </div>
        </div>

        <!-- Toggle Advanced Sections -->
        <label class="checkbox-group" style="margin-top: 0.5rem; margin-bottom: 0.5rem;">
          <input type="checkbox" id="toggle-sections" class="checkbox-input" />
          <span class="form-label" style="margin-bottom: 0; color: #171717; font-weight: 600;">افزودن بخش‌های محتوای داینامیک به صفحه محصول</span>
        </label>

        <!-- Dynamic detail sections editor (Wrapper hidden by default) -->
        <div id="sections-section-wrapper" style="display: none; border: 1px solid #e5e5e5; border-radius: 1rem; padding: 1.25rem; background: #ffffff; text-align: right; margin-bottom: 0.5rem; direction: rtl;">
          <!-- Info Tooltip for advanced sections -->
          <div style="background-color: #f8fafc; border-right: 3px solid #3b82f6; border-radius: 0.5rem; padding: 0.875rem; font-size: 0.75rem; color: #334155; line-height: 1.6; margin-bottom: 1rem;">
            <strong>سکشن‌های محتوای داینامیک صفحه محصول:</strong> این بخش برای ساختاردهی و شخصی‌سازی چیدمان و محتوای صفحه این محصول کاربرد دارد. به جای جدول مشخصات فنی (Key-Value)، شما می‌توانید بلاک‌های محتوایی پویا مثل مشخصات فنی، راهنمای استفاده، داستان برند یا هر نوع محتوای اختصاصی دیگر را همراه با برچسب‌های مرتبط تعریف کنید تا در صفحه محصول نمایش داده شود.
          </div>

          <div class="form-group">
            <label class="form-label">سکشن‌های محتوای داینامیک</label>
            <div class="sections-editor-container" id="sections-editor">
              <!-- Render blocks here -->
            </div>
            <button type="button" class="btn btn-secondary btn-full" id="btn-add-section" style="margin-top: 0.5rem; font-size: 0.75rem;">
              + افزودن سکشن محتوای جدید
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-full" style="margin-top: 0.5rem; padding: 0.9rem;">
          ثبت محصول جدید
        </button>
      </form>
    </div>
  )}
</AdminLayout>

<script>
  // Handle Status Pill Selector
  const statusBtns = document.querySelectorAll('.status-pill-btn');
  const statusField = document.getElementById('status-field') as HTMLInputElement;
  const statusExplanation = document.getElementById('status-explanation');

  const statusExplanations: Record<string, string> = {
    available: 'توضیح: محصول در کاتالوگ نمایش داده شده و قیمت آن فعال است.',
    unavailable: 'توضیح: محصول در کاتالوگ نمایش داده می‌شود اما برچسب «ناموجود» خواهد خورد.',
    inactive: 'توضیح: محصول به طور کامل از کاتالوگ سمت مشتری مخفی می‌شود.'
  };

  statusBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      statusBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const status = btn.getAttribute('data-status') || 'available';
      if (statusField) statusField.value = status;
      if (statusExplanation) statusExplanation.textContent = statusExplanations[status];
    });
  });

  // Handle Product Image Upload & Cropper
  const selectProductImageBtn = document.getElementById('btn-select-product-image');
  const productImageFileInput = document.getElementById('product-file-input') as HTMLInputElement;
  const productPreview = document.getElementById('product-preview') as HTMLImageElement;
  const productImagePreviewContainer = document.getElementById('product-preview-container');
  const productImageUrlHidden = document.getElementById('product-image-url-hidden') as HTMLInputElement;

  const cropperModal = document.getElementById('cropper-modal') as HTMLDivElement;
  const cropperImage = document.getElementById('cropper-image') as HTMLImageElement;
  const closeCropperBtn = document.getElementById('btn-close-cropper');
  const cropCancelBtn = document.getElementById('btn-crop-cancel');
  const cropSaveBtn = document.getElementById('btn-crop-save');

  let cropper: any = null;

  selectProductImageBtn?.addEventListener('click', () => {
    productImageFileInput?.click();
  });

  productImageFileInput?.addEventListener('change', () => {
    const files = productImageFileInput.files;
    if (files && files.length > 0) {
      const file = files[0];
      const reader = new FileReader();
      reader.onload = () => {
        if (cropperImage) {
          cropperImage.src = reader.result as string;
          cropperModal.style.display = 'flex';
          
          if (cropper) {
            cropper.destroy();
          }
          // @ts-ignore
          cropper = new Cropper(cropperImage, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
          });

          // Reset ratio buttons to square (default)
          const ratioButtons = document.querySelectorAll('.ratio-btn');
          ratioButtons.forEach(b => b.classList.remove('active'));
          ratioButtons[0]?.classList.add('active');
        }
      };
      reader.readAsDataURL(file);
    }
  });

  // Handle Aspect Ratio Presets
  const ratioButtons = document.querySelectorAll('.ratio-btn');
  ratioButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      ratioButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      const ratio = parseFloat(btn.getAttribute('data-ratio') || 'NaN');
      if (cropper) {
        cropper.setAspectRatio(ratio);
      }
    });
  });

  function closeCropper() {
    cropperModal.style.display = 'none';
    if (cropper) {
      cropper.destroy();
      cropper = null;
    }
    productImageFileInput.value = '';
  }

  closeCropperBtn?.addEventListener('click', closeCropper);
  cropCancelBtn?.addEventListener('click', closeCropper);

  cropSaveBtn?.addEventListener('click', () => {
    if (!cropper) return;

    const canvas = cropper.getCroppedCanvas({
      width: 600,
      height: 600,
      imageSmoothingEnabled: true,
      imageSmoothingQuality: 'high',
    });

    cropSaveBtn.setAttribute('disabled', 'true');
    cropSaveBtn.textContent = 'در حال آپلود...';

    canvas.toBlob(async (blob) => {
      if (!blob) {
        alert('خطا در پردازش تصویر');
        cropSaveBtn.removeAttribute('disabled');
        cropSaveBtn.textContent = 'برش و آپلود';
        return;
      }

      const formData = new FormData();
      formData.append('file', blob, 'product.webp');

      try {
        const response = await fetch(`/api/upload?vendor=${getVendorSlug()}`, {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();
        if (data.success) {
          if (productPreview) {
            productPreview.src = data.url;
            productPreview.style.display = 'block';
          }
          if (productImageUrlHidden) {
            productImageUrlHidden.value = data.url;
          }
          closeCropper();
        } else {
          alert('خطا در آپلود تصویر: ' + (data.message || 'خطای نامشخص'));
        }
      } catch (err) {
        console.error(err);
        alert('خطا در ارتباط با سرور.');
      } finally {
        cropSaveBtn.removeAttribute('disabled');
        cropSaveBtn.textContent = 'برش و آپلود';
      }
    }, 'image/webp', 0.85);
  });

  const form = document.getElementById('new-product-form') as HTMLFormElement;
  const sectionsContainer = document.getElementById('sections-editor') as HTMLDivElement;
  const addSectionBtn = document.getElementById('btn-add-section');

  // Collapse / Expand Toggles
  const toggleDiscount = document.getElementById('toggle-discount') as HTMLInputElement;
  const discountWrapper = document.getElementById('discount-section-wrapper') as HTMLDivElement;
  toggleDiscount?.addEventListener('change', () => {
    discountWrapper.style.display = toggleDiscount.checked ? 'block' : 'none';
  });

  const toggleSections = document.getElementById('toggle-sections') as HTMLInputElement;
  const sectionsWrapper = document.getElementById('sections-section-wrapper') as HTMLDivElement;
  toggleSections?.addEventListener('change', () => {
    sectionsWrapper.style.display = toggleSections.checked ? 'block' : 'none';
  });

  // Add Section Event
  addSectionBtn?.addEventListener('click', () => {
    renderSectionBlock('', '', []);
  });

  function renderSectionBlock(title: string, desc: string, chips: string[]) {
    const block = document.createElement('div');
    block.className = 'section-block';
    const secId = 'sec-' + Math.random().toString(36).substring(2, 9);
    
    block.innerHTML = `
      <div class="section-block-header">
        <span class="section-block-title">سکشن محتوای جدید</span>
        <button type="button" class="btn-icon btn-icon-danger btn-remove-section" style="width: 1.5rem; height: 1.5rem; font-size: 0.6875rem;">✕</button>
      </div>
      <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        <input type="text" class="form-input sec-title-input" placeholder="عنوان سکشن (مثال: مشخصات فنی، راهنمای استفاده)" value="${title}" required style="padding: 0.5rem 0.75rem; font-size: 0.75rem;" />
        <textarea class="form-input sec-desc-input" placeholder="محتوای متنی این سکشن..." style="padding: 0.5rem 0.75rem; font-size: 0.75rem; resize: vertical;" rows="2">${desc}</textarea>
        
        <div>
          <label class="form-label" style="font-size: 0.6875rem;">برچسب‌ها / کلمات کلیدی مرتبط</label>
          <div class="chips-editor" id="chips-${secId}">
            ${chips.map(chip => `
              <span class="chip-tag">
                <span>${chip}</span>
                <span class="chip-remove">✕</span>
              </span>
            `).join('')}
          </div>
          <div class="chip-input-wrapper">
            <input type="text" class="form-input new-chip-input" placeholder="تگ جدید..." style="padding: 0.35rem 0.65rem; font-size: 0.6875rem; flex: 1;" />
            <button type="button" class="btn btn-secondary btn-add-chip-tag" style="padding: 0.35rem 0.75rem; font-size: 0.6875rem;">افزودن</button>
          </div>
        </div>
      </div>
    `;

    // Remove section
    block.querySelector('.btn-remove-section')?.addEventListener('click', () => block.remove());

    // Add Chip Tag
    const chipInput = block.querySelector('.new-chip-input') as HTMLInputElement;
    const chipAddBtn = block.querySelector('.btn-add-chip-tag');
    const chipsContainer = block.querySelector(`#chips-${secId}`) as HTMLDivElement;

    const addChipHandler = () => {
      const text = chipInput.value.trim();
      if (!text) return;
      
      const chipSpan = document.createElement('span');
      chipSpan.className = 'chip-tag';
      chipSpan.innerHTML = `
        <span>${text}</span>
        <span class="chip-remove">✕</span>
      `;
      
      chipSpan.querySelector('.chip-remove')?.addEventListener('click', () => chipSpan.remove());
      chipsContainer.appendChild(chipSpan);
      chipInput.value = '';
    };

    chipAddBtn?.addEventListener('click', addChipHandler);
    chipInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        addChipHandler();
      }
    });

    sectionsContainer.appendChild(block);
  }

  // Submit action
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    
    const name = (formData.get('name') as string).trim();
    const categoryId = parseInt(formData.get('categoryId') as string);
    const price = (formData.get('price') as string).trim();
    const description = (formData.get('description') as string).trim();
    const image = (formData.get('image') as string).trim();
    const span2 = formData.get('span2') === 'on';
    const status = (formData.get('status') as string || 'available').trim();

    // Discount (only send if checked)
    let discount = null;
    if (toggleDiscount && toggleDiscount.checked) {
      const origPrice = (formData.get('originalPrice') as string).trim();
      const discText = (formData.get('discountText') as string).trim();
      discount = origPrice ? { originalPrice: origPrice, discountText: discText } : null;
    }

    // Serialize dynamic sections (only send if checked)
    const sections: any[] = [];
    if (toggleSections && toggleSections.checked) {
      document.querySelectorAll('.section-block').forEach(block => {
        const titleInput = block.querySelector('.sec-title-input') as HTMLInputElement;
        const descInput = block.querySelector('.sec-desc-input') as HTMLTextAreaElement;
        
        const title = titleInput?.value.trim() || '';
        const description = descInput?.value.trim() || '';
        
        const chips: string[] = [];
        block.querySelectorAll('.chip-tag span:first-child').forEach(c => {
          if (c.textContent) chips.push(c.textContent.trim());
        });

        sections.push({ title, description, chips });
      });
    }

    const payload = {
      name,
      categoryId,
      price,
      description: description || null,
      image: image || null,
      span2,
      discount,
      sections,
      status
    };

    try {
      const response = await fetch('/api/menu-items', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (response.ok) {
        window.location.href = `/admin/${getVendorSlug()}/products`;
      } else {
        const error = await response.json();
        alert(error.message || 'خطا در ثبت محصول.');
      }
    } catch {
      alert('ارتباط با سرور برقرار نشد.');
    }
  });

  function getVendorSlug() {
    const parts = window.location.pathname.split('/');
    return parts[2]; // /admin/[vendorSlug]/products/new
  }
</script>
