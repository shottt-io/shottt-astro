---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { db } from '../../../../db/db';
import { 
  vendors as vendorsTable, 
  categories as categoriesTable, 
  menuItems as menuItemsTable 
} from '../../../../db/schema';
import { eq, asc } from 'drizzle-orm';
import { useTranslations, translations } from '../../../../utils/i18n';

const vendorSlug = Astro.params.vendor;
const productIdStr = Astro.params.productId;

if (!vendorSlug || !productIdStr) {
  return Astro.redirect('/admin');
}

const productId = parseInt(productIdStr);

const { t, locale } = useTranslations(Astro.cookies, Astro.request);

// Fetch vendor
const vendorList = await db
  .select()
  .from(vendorsTable)
  .where(eq(vendorsTable.slug, vendorSlug))
  .limit(1);

if (vendorList.length === 0) {
  return new Response(t('vendorNotFound'), { status: 404 });
}
const vendor = vendorList[0];
const currentCurrency = vendor.currency || translations[locale].currency;

// Fetch categories for this vendor
const dbCategories = await db
  .select()
  .from(categoriesTable)
  .where(eq(categoriesTable.vendorId, vendor.id))
  .orderBy(asc(categoriesTable.sortOrder));

// Fetch product
const productList = await db
  .select()
  .from(menuItemsTable)
  .where(eq(menuItemsTable.id, productId))
  .limit(1);

if (productList.length === 0) {
  return new Response(t('itemNotFound'), { status: 404 });
}
const product = productList[0];
---

<AdminLayout title={t('editProductPageTitle')} activeTab="products" vendorSlug={vendorSlug}>
  <!-- Action Header -->
  <div class="admin-page-actions">
    <h1 class="page-title-bold">{t('editProductPageTitle')}</h1>
    
    <a href={`/admin/${vendorSlug}/products`} class="btn btn-secondary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 0.875rem; height: 0.875rem;">
        <line x1="19" y1="12" x2="5" y2="12" />
        <polyline points="12 19 19 12 12 5" />
      </svg>
      <span>{t('backToProducts')}</span>
    </a>
  </div>

  <!-- Onboarding banner -->
  <div class="onboarding-banner">
    <div class="onboarding-icon-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.125rem; height: 1.125rem;">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="16" x2="12" y2="12" />
        <line x1="12" y1="8" x2="12.01" y2="8" />
      </svg>
    </div>
    <div class="onboarding-text-box">
      <span class="onboarding-title">{t('productEditOnboardingTitle')}</span>
      <p class="onboarding-desc">{t('productEditOnboardingDesc').replace('{name}', product.name)}</p>
    </div>
  </div>

  <div class="admin-card">
    <form id="edit-product-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
      <input type="hidden" name="itemId" id="field-item-id" value={product.id} />
      <input type="hidden" name="vendorId" value={vendor.id} />

      <div class="form-group">
        <label class="form-label">{t('productNameLabel')}</label>
        <input type="text" name="name" class="form-input" value={product.name} required />
      </div>

      <div class="form-group">
        <label class="form-label">{t('productCategoryLabel')}</label>
        <select name="categoryId" class="form-select" required>
          {dbCategories.map(cat => (
            <option value={cat.id} selected={cat.id === product.categoryId}>{cat.name}</option>
          ))}
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">{t('productStatusLabel')}</label>
        <div class="status-selector-container">
          <input type="hidden" name="status" id="status-field" value={product.status || 'available'} />
          <div class="status-pills">
            <button type="button" class={`status-pill-btn ${(!product.status || product.status === 'available') ? 'active' : ''}`} data-status="available">
              <span class="status-dot dot-available"></span>
              {t('statusAvailable')}
            </button>
            <button type="button" class={`status-pill-btn ${(product.status === 'unavailable') ? 'active' : ''}`} data-status="unavailable">
              <span class="status-dot dot-unavailable"></span>
              {t('statusUnavailable')}
            </button>
            <button type="button" class={`status-pill-btn ${(product.status === 'inactive') ? 'active' : ''}`} data-status="inactive">
              <span class="status-dot dot-inactive"></span>
              {t('statusInactive')}
            </button>
          </div>
          <p class="status-explanation" id="status-explanation">
            {(!product.status || product.status === 'available') && t('statusDescAvailable')}
            {(product.status === 'unavailable') && t('statusDescUnavailable')}
            {(product.status === 'inactive') && t('statusDescInactive')}
          </p>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">{locale === 'fa' ? `قیمت محصول (به ${currentCurrency}) *` : locale === 'tr' ? `Ürün Fiyatı (${currentCurrency} cinsinden) *` : `Product Price (in ${currentCurrency}) *`}</label>
        <input type="text" name="price" class="form-input" value={product.price} required />
      </div>

      <div class="form-group">
        <label class="form-label">{t('productDescLabel')}</label>
        <textarea name="description" class="form-input" rows="3" placeholder={t('productDescPlaceholder')}>{product.description}</textarea>
      </div>

      <div class="form-group">
        <label class="form-label">{t('productImageLabel')}</label>
        <div class="image-upload-wrapper">
          <input type="file" id="product-file-input" accept="image/*" style="display: none;" />
          <input type="hidden" name="image" id="product-image-url-hidden" value={product.image || ''} />
          <div class="image-preview-container" id="product-preview-container">
            <img src={product.image || ''} id="product-preview" class="image-preview-box" style={product.image ? 'display: block;' : 'display: none;'} />
            <div style="display: flex; flex-direction: column; gap: 0.375rem; align-items: flex-start;">
              <button type="button" class="btn btn-secondary" id="btn-select-product-image">{t('selectProductImageBtn')}</button>
              <button type="button" class="btn btn-danger" id="btn-remove-product-image" style={product.image ? 'display: block; font-size: 0.75rem; padding: 0.4rem 0.8rem;' : 'display: none; font-size: 0.75rem; padding: 0.4rem 0.8rem;'}>{t('removeProductImageBtn')}</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Cropper Modal -->
      <div id="cropper-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
          <div class="modal-header">
            <span class="modal-title">{t('cropProductImageTitle')}</span>
            <button type="button" class="modal-close" id="btn-close-cropper">✕</button>
          </div>
          <div class="modal-body" style="flex-direction: column; gap: 1rem; align-items: stretch; text-align: center;">
            <!-- Aspect Ratio Selector -->
            <div class="ratio-selector" style="display: flex; gap: 0.375rem; justify-content: center; width: 100%; flex-wrap: wrap;">
              <button type="button" class="btn btn-secondary btn-sm ratio-btn active" data-ratio="1" style="font-size: 0.6875rem; padding: 0.4rem 0.75rem;">{t('aspectSquare')}</button>
              <button type="button" class="btn btn-secondary btn-sm ratio-btn" data-ratio="0.75" style="font-size: 0.6875rem; padding: 0.4rem 0.75rem;">{t('aspectVertical')}</button>
              <button type="button" class="btn btn-secondary btn-sm ratio-btn" data-ratio="1.3333" style="font-size: 0.6875rem; padding: 0.4rem 0.75rem;">{t('aspectStandard')}</button>
              <button type="button" class="btn btn-secondary btn-sm ratio-btn" data-ratio="1.7777" style="font-size: 0.6875rem; padding: 0.4rem 0.75rem;">{t('aspectWide')}</button>
              <button type="button" class="btn btn-secondary btn-sm ratio-btn" data-ratio="NaN" style="font-size: 0.6875rem; padding: 0.4rem 0.75rem;">{t('aspectFree')}</button>
            </div>

            <div class="cropper-container">
              <img id="cropper-image" src="" style="max-width: 100%; max-height: 320px; display: block;" />
            </div>

            <p style="font-size: 0.6875rem; color: #737373; line-height: 1.5; margin: 0; text-align: start;">
              {t('aspectRatioGuide')}
            </p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-primary" id="btn-crop-save">{t('cropUpload')}</button>
            <button type="button" class="btn btn-secondary" id="btn-crop-cancel">{t('cancel')}</button>
          </div>
        </div>
      </div>

      <!-- Layout Option Column Span (Checkbox) -->
      <label class="checkbox-group">
        <input type="checkbox" name="span2" class="checkbox-input" checked={product.span2} />
        <span class="form-label" style="margin-bottom: 0;">{t('twoColumnsOption')}</span>
      </label>

      <!-- Toggle Special Discount -->
      <label class="checkbox-group" style="margin-top: 0.5rem; margin-bottom: 0.5rem;">
        <input type="checkbox" id="toggle-discount" class="checkbox-input" checked={!!product.discount} />
        <span class="form-label" style="margin-bottom: 0; color: #171717; font-weight: 600;">{t('specialDiscountTitle')}</span>
      </label>

      <!-- Marketing discount card (Wrapper hidden by default unless product has discount) -->
      <div id="discount-section-wrapper" style={`display: ${product.discount ? 'block' : 'none'}; border: 1px solid #ffe4e6; border-radius: 1rem; padding: 1.25rem; background: #fff5f5; text-align: start;`}>
        <div style="display: flex; gap: 0.5rem; align-items: center; color: #be123c; margin-bottom: 1rem;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1rem; height: 1rem;">
            <polyline points="23 18 13.5 8.5 8.5 13.5 1 6" />
            <polyline points="17 18 23 18 23 12" />
          </svg>
          <span style="font-size: 0.8125rem; font-weight: 600;">{t('specialDiscountSubtitle')}</span>
        </div>
        
        <div class="form-group">
          <label class="form-label">{locale === 'fa' ? `قیمت اصلی و قبلی (خط خورده - به ${currentCurrency})` : locale === 'tr' ? `Orijinal & Önceki Fiyat (üzeri çizili - ${currentCurrency} cinsinden)` : `Original & Previous Price (crossed out - in ${currentCurrency})`}</label>
          <input 
            type="text" 
            name="originalPrice" 
            class="form-input" 
            value={product.discount ? product.discount.originalPrice : ''} 
            placeholder={t('originalPricePlaceholder')} 
          />
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label">{t('discountTextLabel')}</label>
          <input 
            type="text" 
            name="discountText" 
            class="form-input" 
            value={product.discount ? product.discount.discountText : ''} 
            placeholder={t('discountTextPlaceholder')} 
          />
        </div>
      </div>

      <!-- Toggle Advanced Sections -->
      <label class="checkbox-group" style="margin-top: 0.5rem; margin-bottom: 0.5rem;">
        <input type="checkbox" id="toggle-sections" class="checkbox-input" checked={product.sections && product.sections.length > 0} />
        <span class="form-label" style="margin-bottom: 0; color: #171717; font-weight: 600;">{t('dynamicSectionsTitle')}</span>
      </label>

      <!-- Dynamic detail sections editor (Wrapper hidden by default unless product has sections) -->
      <div id="sections-section-wrapper" style={`display: ${product.sections && product.sections.length > 0 ? 'block' : 'none'}; border: 1px solid #e5e5e5; border-radius: 1rem; padding: 1.25rem; background: #ffffff; text-align: start; margin-bottom: 0.5rem;`}>
        <!-- Info Tooltip for advanced sections -->
        <div style="background-color: #f8fafc; border-right: 3px solid #3b82f6; border-radius: 0.5rem; padding: 0.875rem; font-size: 0.75rem; color: #334155; line-height: 1.6; margin-bottom: 1rem;" set:html={t('dynamicSectionsDesc')} />

        <div class="form-group">
          <label class="form-label">{t('dynamicSectionsLabel')}</label>
          <div class="sections-editor-container" id="sections-editor" data-existing={JSON.stringify(product.sections || [])}>
            <!-- Existing sections rendered here by script -->
          </div>
          <button type="button" class="btn btn-secondary btn-full" id="btn-add-section" style="margin-top: 0.5rem; font-size: 0.75rem;">
            {t('addSectionBtn')}
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-full" style="margin-top: 0.5rem; padding: 0.9rem;">
        {t('saveProductBtn')}
      </button>
    </form>
  </div>
</AdminLayout>

<script define:vars={{
  statusDescAvailable: t('statusDescAvailable'),
  statusDescUnavailable: t('statusDescUnavailable'),
  statusDescInactive: t('statusDescInactive'),
  uploading: t('uploading'),
  errorImageProcess: t('errorImageProcess'),
  errorUploadLogo: t('errorUploadLogo'),
  errorServerConnection: t('errorServerConnection'),
  newSectionBlockTitle: t('newSectionBlockTitle'),
  sectionTitlePlaceholder: t('sectionTitlePlaceholder'),
  sectionContentPlaceholder: t('sectionContentPlaceholder'),
  tagsLabel: t('tagsLabel'),
  tagPlaceholder: t('tagPlaceholder'),
  addTagBtn: t('addTagBtn'),
  errorProductSave: t('errorProductSave'),
  cropUpload: t('cropUpload'),
  removeProductImageBtnLabel: t('removeProductImageBtn')
}}>
  // Handle Status Pill Selector
  const statusBtns = document.querySelectorAll('.status-pill-btn');
  const statusField = document.getElementById('status-field');
  const statusExplanation = document.getElementById('status-explanation');

  const statusExplanations = {
    available: statusDescAvailable,
    unavailable: statusDescUnavailable,
    inactive: statusDescInactive
  };

  statusBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      statusBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const status = btn.getAttribute('data-status') || 'available';
      if (statusField) statusField.value = status;
      if (statusExplanation) statusExplanation.textContent = statusExplanations[status];
    });
  });

  // Handle Product Image Upload & Cropper
  const selectProductImageBtn = document.getElementById('btn-select-product-image');
  const productImageFileInput = document.getElementById('product-file-input');
  const productPreview = document.getElementById('product-preview');
  const productImagePreviewContainer = document.getElementById('product-preview-container');
  const productImageUrlHidden = document.getElementById('product-image-url-hidden');
  const removeProductImageBtn = document.getElementById('btn-remove-product-image');

  removeProductImageBtn?.addEventListener('click', () => {
    if (productPreview) {
      productPreview.src = '';
      productPreview.style.display = 'none';
    }
    if (productImageUrlHidden) {
      productImageUrlHidden.value = '';
    }
    if (removeProductImageBtn) {
      removeProductImageBtn.style.display = 'none';
    }
    productImageFileInput.value = '';
  });

  const cropperModal = document.getElementById('cropper-modal');
  const cropperImage = document.getElementById('cropper-image');
  const closeCropperBtn = document.getElementById('btn-close-cropper');
  const cropCancelBtn = document.getElementById('btn-crop-cancel');
  const cropSaveBtn = document.getElementById('btn-crop-save');

  let cropper = null;

  selectProductImageBtn?.addEventListener('click', () => {
    productImageFileInput?.click();
  });

  productImageFileInput?.addEventListener('change', () => {
    const files = productImageFileInput.files;
    if (files && files.length > 0) {
      const file = files[0];
      const reader = new FileReader();
      reader.onload = () => {
        if (cropperImage) {
          cropperImage.src = reader.result;
          cropperModal.style.display = 'flex';
          
          if (cropper) {
            cropper.destroy();
          }
          // @ts-ignore
          cropper = new Cropper(cropperImage, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
          });

          // Reset ratio buttons to square (default)
          const ratioButtons = document.querySelectorAll('.ratio-btn');
          ratioButtons.forEach(b => b.classList.remove('active'));
          ratioButtons[0]?.classList.add('active');
        }
      };
      reader.readAsDataURL(file);
    }
  });

  // Handle Aspect Ratio Presets
  const ratioButtons = document.querySelectorAll('.ratio-btn');
  ratioButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      ratioButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      const ratio = parseFloat(btn.getAttribute('data-ratio') || 'NaN');
      if (cropper) {
        cropper.setAspectRatio(ratio);
      }
    });
  });

  function closeCropper() {
    cropperModal.style.display = 'none';
    if (cropper) {
      cropper.destroy();
      cropper = null;
    }
    productImageFileInput.value = '';
  }

  closeCropperBtn?.addEventListener('click', closeCropper);
  cropCancelBtn?.addEventListener('click', closeCropper);

  cropSaveBtn?.addEventListener('click', () => {
    if (!cropper) return;

    const cropData = cropper.getData();
    const ratio = cropData.width / cropData.height;
    let targetWidth = 600;
    let targetHeight = 600;

    if (ratio > 1) {
      targetHeight = Math.round(600 / ratio);
    } else {
      targetWidth = Math.round(600 * ratio);
    }

    const canvas = cropper.getCroppedCanvas({
      width: targetWidth,
      height: targetHeight,
      imageSmoothingEnabled: true,
      imageSmoothingQuality: 'high',
    });

    cropSaveBtn.setAttribute('disabled', 'true');
    cropSaveBtn.textContent = uploading;

    canvas.toBlob(async (blob) => {
      if (!blob) {
        alert(errorImageProcess);
        cropSaveBtn.removeAttribute('disabled');
        cropSaveBtn.textContent = cropUpload;
        return;
      }

      const formData = new FormData();
      formData.append('file', blob, 'product.webp');

      try {
        const response = await fetch(`/api/upload?vendor=${getVendorSlug()}`, {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();
        if (data.success) {
          const finalUrl = data.url + '?ratio=' + ratio.toFixed(4);
          if (productPreview) {
            productPreview.src = finalUrl;
            productPreview.style.display = 'block';
          }
          if (productImageUrlHidden) {
            productImageUrlHidden.value = finalUrl;
          }
          if (removeProductImageBtn) {
            removeProductImageBtn.style.display = 'block';
            removeProductImageBtn.textContent = removeProductImageBtnLabel;
          }
          closeCropper();
        } else {
          alert(errorUploadLogo + ': ' + (data.message || ''));
        }
      } catch (err) {
        console.error(err);
        alert(errorServerConnection);
      } finally {
        cropSaveBtn.removeAttribute('disabled');
        cropSaveBtn.textContent = cropUpload;
      }
    }, 'image/webp', 0.85);
  });

  const form = document.getElementById('edit-product-form');
  const sectionsContainer = document.getElementById('sections-editor');
  const addSectionBtn = document.getElementById('btn-add-section');

  // Collapse / Expand Toggles
  const toggleDiscount = document.getElementById('toggle-discount');
  const discountWrapper = document.getElementById('discount-section-wrapper');
  toggleDiscount?.addEventListener('change', () => {
    discountWrapper.style.display = toggleDiscount.checked ? 'block' : 'none';
  });

  const toggleSections = document.getElementById('toggle-sections');
  const sectionsWrapper = document.getElementById('sections-section-wrapper');
  toggleSections?.addEventListener('change', () => {
    sectionsWrapper.style.display = toggleSections.checked ? 'block' : 'none';
  });

  // Load existing sections
  try {
    const existingData = JSON.parse(sectionsContainer.getAttribute('data-existing') || '[]');
    existingData.forEach((sec) => {
      renderSectionBlock(sec.title || '', sec.description || '', sec.chips || []);
    });
  } catch (e) {
    console.error('Error loading sections', e);
  }

  // Add Section Event
  addSectionBtn?.addEventListener('click', () => {
    renderSectionBlock('', '', []);
  });

  function renderSectionBlock(title, desc, chips) {
    const block = document.createElement('div');
    block.className = 'section-block';
    const secId = 'sec-' + Math.random().toString(36).substring(2, 9);
    
    block.innerHTML = `
      <div class="section-block-header">
        <span class="section-block-title">${newSectionBlockTitle}</span>
        <button type="button" class="btn-icon btn-icon-danger btn-remove-section" style="width: 1.5rem; height: 1.5rem; font-size: 0.6875rem;">✕</button>
      </div>
      <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        <input type="text" class="form-input sec-title-input" placeholder="${sectionTitlePlaceholder}" value="${title}" required style="padding: 0.5rem 0.75rem; font-size: 0.75rem;" />
        <textarea class="form-input sec-desc-input" placeholder="${sectionContentPlaceholder}" style="padding: 0.5rem 0.75rem; font-size: 0.75rem; resize: vertical;" rows="2">${desc}</textarea>
        
        <div>
          <label class="form-label" style="font-size: 0.6875rem;">${tagsLabel}</label>
          <div class="chips-editor" id="chips-${secId}">
            ${chips.map(chip => `
              <span class="chip-tag">
                <span>${chip}</span>
                <span class="chip-remove">✕</span>
              </span>
            `).join('')}
          </div>
          <div class="chip-input-wrapper">
            <input type="text" class="form-input new-chip-input" placeholder="${tagPlaceholder}" style="padding: 0.35rem 0.65rem; font-size: 0.6875rem; flex: 1;" />
            <button type="button" class="btn btn-secondary btn-add-chip-tag" style="padding: 0.35rem 0.75rem; font-size: 0.6875rem;">${addTagBtn}</button>
          </div>
        </div>
      </div>
    `;

    // Remove section
    block.querySelector('.btn-remove-section')?.addEventListener('click', () => block.remove());

    // Add Chip Tag
    const chipInput = block.querySelector('.new-chip-input');
    const chipAddBtn = block.querySelector('.btn-add-chip-tag');
    const chipsContainer = block.querySelector(`#chips-${secId}`);

    const addChipHandler = () => {
      const text = chipInput.value.trim();
      if (!text) return;
      
      const chipSpan = document.createElement('span');
      chipSpan.className = 'chip-tag';
      chipSpan.innerHTML = `
        <span>${text}</span>
        <span class="chip-remove">✕</span>
      `;
      
      chipSpan.querySelector('.chip-remove')?.addEventListener('click', () => chipSpan.remove());
      chipsContainer.appendChild(chipSpan);
      chipInput.value = '';
    };

    chipAddBtn?.addEventListener('click', addChipHandler);
    chipInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        addChipHandler();
      }
    });

    // Bind existing chips close event
    block.querySelectorAll('.chip-remove').forEach(removeBtn => {
      removeBtn.addEventListener('click', () => {
        removeBtn.closest('.chip-tag')?.remove();
      });
    });

    sectionsContainer.appendChild(block);
  }

  // Submit action
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    
    const id = formData.get('itemId');
    const name = formData.get('name').trim();
    const categoryId = parseInt(formData.get('categoryId'));
    const price = formData.get('price').trim();
    const description = formData.get('description').trim();
    const image = formData.get('image').trim();
    const span2 = formData.get('span2') === 'on';
    const status = (formData.get('status') || 'available').trim();

    // Discount (only send if checked)
    let discount = null;
    if (toggleDiscount && toggleDiscount.checked) {
      const origPrice = formData.get('originalPrice').trim();
      const discText = formData.get('discountText').trim();
      discount = origPrice ? { originalPrice: origPrice, discountText: discText } : null;
    }

    // Serialize dynamic sections (only send if checked)
    const sections = [];
    if (toggleSections && toggleSections.checked) {
      document.querySelectorAll('.section-block').forEach(block => {
        const titleInput = block.querySelector('.sec-title-input');
        const descInput = block.querySelector('.sec-desc-input');
        
        const title = titleInput?.value.trim() || '';
        const description = descInput?.value.trim() || '';
        
        const chips = [];
        block.querySelectorAll('.chip-tag span:first-child').forEach(c => {
          if (c.textContent) chips.push(c.textContent.trim());
        });

        sections.push({ title, description, chips });
      });
    }

    const payload = {
      id,
      name,
      categoryId,
      price,
      description: description || null,
      image: image || null,
      span2,
      discount,
      sections,
      status
    };

    try {
      const response = await fetch('/api/menu-items', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (response.ok) {
        window.location.href = `/admin/${getVendorSlug()}/products`;
      } else {
        const error = await response.json();
        alert(error.message || errorProductSave);
      }
    } catch {
      alert(errorServerConnection);
    }
  });

  function getVendorSlug() {
    const parts = window.location.pathname.split('/');
    return parts[2]; // /admin/[vendorSlug]/products/[productId]
  }
</script>
