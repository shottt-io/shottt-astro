---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { db } from '../../../../db/db';
import { 
  vendors as vendorsTable, 
  categories as categoriesTable, 
  menuItems as menuItemsTable 
} from '../../../../db/schema';
import { eq, asc } from 'drizzle-orm';

const vendorSlug = Astro.params.vendor;
if (!vendorSlug) {
  return Astro.redirect('/admin');
}

// Fetch vendor
const vendorList = await db
  .select()
  .from(vendorsTable)
  .where(eq(vendorsTable.slug, vendorSlug))
  .limit(1);

if (vendorList.length === 0) {
  return new Response("مجموعه یافت نشد.", { status: 404 });
}
const vendor = vendorList[0];

// Fetch categories for this vendor
const dbCategories = await db
  .select()
  .from(categoriesTable)
  .where(eq(categoriesTable.vendorId, vendor.id))
  .orderBy(asc(categoriesTable.sortOrder));

// Fetch all products for the categories
const items = await db
  .select({
    id: menuItemsTable.id,
    categoryId: menuItemsTable.categoryId,
    name: menuItemsTable.name,
    price: menuItemsTable.price,
    image: menuItemsTable.image,
    span2: menuItemsTable.span2,
    status: menuItemsTable.status,
  })
  .from(menuItemsTable)
  .innerJoin(categoriesTable, eq(menuItemsTable.categoryId, categoriesTable.id))
  .where(eq(categoriesTable.vendorId, vendor.id))
  .orderBy(asc(categoriesTable.sortOrder), asc(menuItemsTable.sortOrder), asc(menuItemsTable.id));
---

<AdminLayout title="مدیریت محصولات" activeTab="products" vendorSlug={vendorSlug}>
  <!-- Onboarding / Marketing Banner -->
  <div class="onboarding-banner">
    <div class="onboarding-icon-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.125rem; height: 1.125rem;">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="16" x2="12" y2="12" />
        <line x1="12" y1="8" x2="12.01" y2="8" />
      </svg>
    </div>
    <div class="onboarding-text-box">
      <span class="onboarding-title">راهنمای بهینه‌سازی فروش محصولات</span>
      <p class="onboarding-desc">محصولات خود را با تصاویر باکیفیت و توضیحات وسوسه‌انگیز ثبت کنید. شما می‌توانید برای کالاها تخفیف ویژه تعریف کنید تا لیبل برجسته بخورند. آیتم‌های پرفروش‌تر خود را به صورت «دو ستونه» (بزرگتر در چیدمان پینترستی) تعریف کنید تا توجه بیشتری را به خود جلب کنند.</p>
    </div>
  </div>

  <div class="admin-page-actions" style="flex-direction: column; align-items: stretch; gap: 1rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; direction: rtl; width: 100%;">
      <h1 class="page-title-bold">محصولات مجموعه</h1>
      
      <a href={`/admin/${vendorSlug}/products/new`} class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 0.875rem; height: 0.875rem;">
          <line x1="12" y1="5" x2="12" y2="19" />
          <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        <span>افزودن محصول جدید</span>
      </a>
    </div>

    {dbCategories.length > 0 && (
      <div style="display: flex; gap: 0.5rem; align-items: center; justify-content: flex-start; direction: rtl;">
        <span style="font-size: 0.75rem; color: #737373; font-weight: 500;">فیلتر بر اساس گروه:</span>
        <select id="category-filter" class="form-select" style="max-width: 15rem; padding: 0.5rem 2rem 0.5rem 1rem; font-size: 0.8125rem; border-radius: 0.5rem; background-position: left 0.75rem center;">
          <option value="all">همه دسته‌بندی‌ها</option>
          {dbCategories.map(cat => (
            <option value={cat.id}>{cat.name}</option>
          ))}
        </select>
      </div>
    )}
  </div>

  <div id="products-list-wrapper">
    {items.length === 0 ? (
      <div class="admin-card" style="text-align: center; color: #a3a3a3; padding: 4rem 0; font-size: 0.875rem;">
        هنوز هیچ محصولی ثبت نکرده‌اید. با کلیک بر روی دکمه فوق، اولین محصول خود را ایجاد کنید.
      </div>
    ) : (
      dbCategories.map(cat => {
        const catItems = items.filter(item => item.categoryId === cat.id);
        if (catItems.length === 0) return null;
        return (
          <div class="category-products-group" data-category-id={cat.id}>
            <div class="category-group-header">
              <h2 class="category-group-title">{cat.name}</h2>
            </div>
            <div class="category-products-list">
              {catItems.map((item, idx) => (
                <div class="admin-list-item product-item-row" data-category-id={item.categoryId}>
                  <div class="item-right-details">
                    {item.image && (
                      <img 
                        src={item.image} 
                        alt={item.name} 
                        class="item-thumb" 
                        loading="lazy"
                      />
                    )}
                    <div class="item-title-desc">
                      <div style="display: flex; gap: 0.5rem; align-items: center;">
                        <span class="item-name-bold">{item.name}</span>
                        {item.status === 'unavailable' && (
                          <span class="status-badge status-badge-unavailable">ناموجود</span>
                        )}
                        {item.status === 'inactive' && (
                          <span class="status-badge status-badge-inactive">غیرفعال</span>
                        )}
                      </div>
                      <span class="item-desc-sub">{item.price} هزار تومان {item.span2 && ' • دو ستونه'}</span>
                    </div>
                  </div>
                  
                  <div class="item-left-controls">
                    <!-- Move Up -->
                    <button 
                      class="btn-icon btn-move-product" 
                      data-id={item.id} 
                      data-direction="up" 
                      disabled={idx === 0}
                      style={idx === 0 ? "opacity: 0.3; cursor: not-allowed;" : ""}
                      title="انتقال به بالا"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="list-icon-svg">
                        <polyline points="18 15 12 9 6 15" />
                      </svg>
                    </button>
                    
                    <!-- Move Down -->
                    <button 
                      class="btn-icon btn-move-product" 
                      data-id={item.id} 
                      data-direction="down" 
                      disabled={idx === catItems.length - 1}
                      style={idx === catItems.length - 1 ? "opacity: 0.3; cursor: not-allowed;" : ""}
                      title="انتقال به پایین"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="list-icon-svg">
                        <polyline points="6 9 12 15 18 9" />
                      </svg>
                    </button>

                    <!-- Edit Button (Links to edit page) -->
                    <a href={`/admin/${vendorSlug}/products/${item.id}`} class="btn-icon" title="ویرایش محصول">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="list-icon-svg">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4z" />
                      </svg>
                    </a>
                    
                    <!-- Delete Button -->
                    <button class="btn-icon btn-icon-danger btn-delete-product" data-id={item.id} data-name={item.name} title="حذف">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="list-icon-svg">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                        <line x1="10" y1="11" x2="10" y2="17" />
                        <line x1="14" y1="11" x2="14" y2="17" />
                      </svg>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );
      })
    )}
  </div>
</AdminLayout>

<script>
  // Filter products by category
  const filterSelect = document.getElementById('category-filter') as HTMLSelectElement;
  filterSelect?.addEventListener('change', () => {
    const selectedCat = filterSelect.value;
    const groups = document.querySelectorAll('.category-products-group');
    groups.forEach(group => {
      const catId = group.getAttribute('data-category-id');
      if (selectedCat === 'all' || catId === selectedCat) {
        (group as HTMLElement).style.display = 'block';
      } else {
        (group as HTMLElement).style.display = 'none';
      }
    });
  });

  // Reorder products action (Move Up/Down)
  document.querySelectorAll('.btn-move-product').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const direction = btn.getAttribute('data-direction');

      try {
        const response = await fetch('/api/menu-items', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, direction, action: 'reorder' })
        });
        if (response.ok) {
          window.location.reload();
        } else {
          alert('خطا در جابجایی محصول.');
        }
      } catch {
        alert('ارتباط با سرور برقرار نشد.');
      }
    });
  });

  // Delete product action
  document.querySelectorAll('.btn-delete-product').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      
      const confirmed = await window.showConfirmDialog(
        `آیا از حذف محصول «${name}» مطمئن هستید؟`,
        { okText: 'حذف شود', cancelText: 'انصراف', okClass: 'confirm-btn-danger' }
      );
      if (!confirmed) return;

      try {
        const response = await fetch('/api/menu-items', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id })
        });
        if (response.ok) {
          window.location.reload();
        } else {
          alert('خطا در حذف محصول.');
        }
      } catch {
        alert('ارتباط با سرور برقرار نشد.');
      }
    });
  });
</script>
