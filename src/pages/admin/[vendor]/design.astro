---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db/db';
import { vendors as vendorsTable, categories as categoriesTable, menuItems as menuItemsTable } from '../../../db/schema';
import { eq, inArray } from 'drizzle-orm';

const vendorSlug = Astro.params.vendor;
if (!vendorSlug) {
  return Astro.redirect('/admin');
}

// Fetch vendor settings
const vendorList = await db
  .select()
  .from(vendorsTable)
  .where(eq(vendorsTable.slug, vendorSlug))
  .limit(1);

if (vendorList.length === 0) {
  return new Response("مجموعه یافت نشد.", { status: 404 });
}
const vendor = vendorList[0];

// Fetch categories for this vendor to retrieve all menu items
const categories = await db
  .select()
  .from(categoriesTable)
  .where(eq(categoriesTable.vendorId, vendor.id));

const categoryIds = categories.map(c => c.id);
let items = [];
if (categoryIds.length > 0) {
  items = await db
    .select()
    .from(menuItemsTable)
    .where(inArray(menuItemsTable.categoryId, categoryIds));
}

const totalItems = items.length;
const itemsWithImage = items.filter(item => item.image && item.image.trim() !== '').length;
const itemsWithDesc = items.filter(item => item.description && item.description.trim() !== '').length;

const imagePercent = totalItems > 0 ? Math.round((itemsWithImage / totalItems) * 100) : 0;
const descPercent = totalItems > 0 ? Math.round((itemsWithDesc / totalItems) * 100) : 0;
---

<AdminLayout title="طراحی و قالب کاتالوگ" activeTab="design" vendorSlug={vendorSlug}>
  <!-- Onboarding banner -->
  <div class="onboarding-banner">
    <div class="onboarding-icon-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.125rem; height: 1.125rem;">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="16" x2="12" y2="12" />
        <line x1="12" y1="8" x2="12.01" y2="8" />
      </svg>
    </div>
    <div class="onboarding-text-box">
      <span class="onboarding-title">راهنمای انتخاب قالب مناسب</span>
      <p class="onboarding-desc">چیدمان کاتالوگ هویت بصری کسب‌وکار شما را شکل می‌دهد. اگر کیفیت عکاسی محصولات بالا است و تصاویر حرف اول را می‌زنند (مانند بوتیک‌ها، گالری‌های هنری و مجموعه‌های لوکس)، حالت پینترستی بهترین انتخاب است. اگر کاتالوگی طولانی با تنوع محصول زیاد دارید، حالت ساده دسترسی را سریع‌تر می‌کند.</p>
    </div>
  </div>

  <div class="admin-page-actions">
    <h1 class="page-title-bold">چیدمان و قالب نمایش کاتالوگ</h1>
  </div>

  <div class="admin-card">
    <form id="design-settings-form" style="display: flex; flex-direction: column; gap: 1.5rem;" data-total-items={totalItems} data-image-percent={imagePercent} data-desc-percent={descPercent}>
      <input type="hidden" id="selected-layout" name="defaultLayout" value={vendor.defaultLayout} />
      
      <div class="form-group">
        <label class="form-label">قالب نمایش محصولات را انتخاب کنید:</label>
        
        <div class="layout-radio-group">
          <!-- Option A: Pinterest (Masonry) -->
          <div class={`layout-radio-card ${vendor.defaultLayout === 'pinterest' ? 'active' : ''}`} data-layout="pinterest">
            <input 
              type="radio" 
              name="layout-opt" 
              class="layout-radio-input" 
              checked={vendor.defaultLayout === 'pinterest'} 
            />
            <span class="layout-card-title">کاتالوگ عکس‌محور (ماسونری)</span>
            <div class="layout-card-body-row">
              <p class="layout-card-desc">اگر عکاسی و تصاویر باکیفیت برای شما اهمیت بالایی دارد و مایلید عکس‌های محصولات کاتالوگ شما بیشترین میزان خودنمایی را داشته باشند.</p>
              <!-- Graphic Mockup -->
              <div class="layout-preview-mockup">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; width: 85%; height: 90%;">
                  <div style="border: 1px dashed #d4d4d4; border-radius: 6px; height: 2.5rem; background: #fdfdfd;"></div>
                  <div style="border: 1px dashed #d4d4d4; border-radius: 6px; height: 3.5rem; background: #fdfdfd;"></div>
                  <div style="border: 1px dashed #d4d4d4; border-radius: 6px; height: 3rem; background: #fdfdfd; transform: translateY(-0.8rem);"></div>
                  <div style="border: 1px dashed #d4d4d4; border-radius: 6px; height: 2.2rem; background: #fdfdfd;"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Option B: Simple List -->
          <div class={`layout-radio-card ${vendor.defaultLayout === 'simple' ? 'active' : ''}`} data-layout="simple">
            <input 
              type="radio" 
              name="layout-opt" 
              class="layout-radio-input" 
              checked={vendor.defaultLayout === 'simple'} 
            />
            <span class="layout-card-title">ساده و متنی (کامپکت)</span>
            <div class="layout-card-body-row">
              <p class="layout-card-desc">نمایش منظم، متنی و جمع‌وجور؛ مناسب برای کاتالوگ‌های شلوغ یا زمانی که دسترسی سریع مشتری به نام و قیمت محصولات اولویت اول است.</p>
              <!-- Graphic Mockup -->
              <div class="layout-preview-mockup">
                <div style="display: flex; flex-direction: column; gap: 8px; width: 85%; height: 90%; justify-content: center;">
                  <div style="border: 1px dashed #d4d4d4; border-radius: 6px; height: 1.4rem; background: #fdfdfd; display: flex; align-items: center; justify-content: space-between; padding: 0 6px;"><div style="display: flex; align-items: center; gap: 4px;"><div style="width: 0.8rem; height: 0.8rem; border-radius: 3px; background: #e5e5e5;"></div><div style="width: 2.5rem; height: 4px; background: #e5e5e5; border-radius: 2px;"></div></div><div style="width: 1.2rem; height: 4px; background: #e5e5e5; border-radius: 2px;"></div></div>
                  <div style="border: 1px dashed #d4d4d4; border-radius: 6px; height: 1.4rem; background: #fdfdfd; display: flex; align-items: center; justify-content: space-between; padding: 0 6px;"><div style="display: flex; align-items: center; gap: 4px;"><div style="width: 0.8rem; height: 0.8rem; border-radius: 3px; background: #e5e5e5;"></div><div style="width: 3rem; height: 4px; background: #e5e5e5; border-radius: 2px;"></div></div><div style="width: 1rem; height: 4px; background: #e5e5e5; border-radius: 2px;"></div></div>
                  <div style="border: 1px dashed #d4d4d4; border-radius: 6px; height: 1.4rem; background: #fdfdfd; display: flex; align-items: center; justify-content: space-between; padding: 0 6px;"><div style="display: flex; align-items: center; gap: 4px;"><div style="width: 0.8rem; height: 0.8rem; border-radius: 3px; background: #e5e5e5;"></div><div style="width: 2.2rem; height: 4px; background: #e5e5e5; border-radius: 2px;"></div></div><div style="width: 1.4rem; height: 4px; background: #e5e5e5; border-radius: 2px;"></div></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Option C: Card Layout -->
          <div class={`layout-radio-card ${vendor.defaultLayout === 'card' ? 'active' : ''}`} data-layout="card">
            <input 
              type="radio" 
              name="layout-opt" 
              class="layout-radio-input" 
              checked={vendor.defaultLayout === 'card'} 
            />
            <span class="layout-card-title">نمایش کارتی</span>
            <div class="layout-card-body-row">
              <p class="layout-card-desc">نمایش کامل جزئیات در دید اول؛ در این حالت تصاویر محصولات کمی بزرگ‌تر بوده و عنوان، قیمت و توضیحات متنی محصول به صورت یکجا نمایش داده می‌شوند.</p>
              <!-- Graphic Mockup -->
              <div class="layout-preview-mockup">
                <div style="display: flex; flex-direction: column; gap: 8px; width: 85%; height: 90%; justify-content: center;">
                  <div style="border: 1px dashed #d4d4d4; border-radius: 6px; height: 2.1rem; background: #fdfdfd; display: flex; align-items: center; padding: 0 6px; gap: 6px;">
                    <div style="width: 1.5rem; height: 1.5rem; border-radius: 4px; background: #e5e5e5; flex-shrink: 0;"></div>
                    <div style="display: flex; flex-direction: column; gap: 4px; width: 100%;">
                      <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                        <div style="width: 2.5rem; height: 4px; background: #d4d4d4; border-radius: 2px;"></div>
                        <div style="width: 1rem; height: 4px; background: #d4d4d4; border-radius: 2px;"></div>
                      </div>
                      <div style="width: 80%; height: 3px; background: #e5e5e5; border-radius: 1px;"></div>
                    </div>
                  </div>
                  <div style="border: 1px dashed #d4d4d4; border-radius: 6px; height: 2.1rem; background: #fdfdfd; display: flex; align-items: center; padding: 0 6px; gap: 6px;">
                    <div style="width: 1.5rem; height: 1.5rem; border-radius: 4px; background: #e5e5e5; flex-shrink: 0;"></div>
                    <div style="display: flex; flex-direction: column; gap: 4px; width: 100%;">
                      <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                        <div style="width: 3rem; height: 4px; background: #d4d4d4; border-radius: 2px;"></div>
                        <div style="width: 0.8rem; height: 4px; background: #d4d4d4; border-radius: 2px;"></div>
                      </div>
                      <div style="width: 70%; height: 3px; background: #e5e5e5; border-radius: 1px;"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Suggestion Banner for Layout selection -->
        <div id="layout-suggestion-banner" class="suggestion-banner" style="display: none;">
          <div class="suggestion-icon-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width: 1.25rem; height: 1.25rem;">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="16" x2="12" y2="12" />
              <line x1="12" y1="8" x2="12.01" y2="8" />
            </svg>
          </div>
          <div class="suggestion-text-box">
            <span class="suggestion-title">پیشنهاد بهبود طراحی کاتالوگ</span>
            <p id="layout-suggestion-text" class="suggestion-desc"></p>
          </div>
        </div>
      </div>

      <!-- Theme Selection Group -->
      <div class="form-group" style="margin-top: 1rem; border-top: 1px solid #f5f5f5; padding-top: 1.5rem;">
        <label class="form-label">تم رنگی کاتالوگ را انتخاب کنید:</label>
        <input type="hidden" id="selected-theme" name="theme" value={vendor.theme} />
        
        <div class="theme-radio-group">
          <!-- Light Theme Option -->
          <div class={`theme-radio-card ${vendor.theme === 'light' ? 'active' : ''}`} data-theme="light">
            <input 
              type="radio" 
              name="theme-opt" 
              class="theme-radio-input" 
              checked={vendor.theme === 'light'} 
            />
            <span class="theme-card-title">تم روشن (Light)</span>
            <div class="theme-card-body-row">
              <p class="theme-card-desc">طراحی کلاسیک، روشن و تمیز با پس‌زمینه سفید. گزینه‌ای عالی برای خوانایی حداکثری در محیط‌های پرنور.</p>
              <!-- Theme Preview Mockup -->
              <div class="theme-preview-mockup">
                <div class="phone-frame-mockup light-preview-theme">
                  <div class="phone-notch"></div>
                  <div class="phone-header">
                    <div class="phone-logo"></div>
                    <div class="phone-text"></div>
                  </div>
                  <div class="phone-nav">
                    <div class="phone-nav-item active"></div>
                    <div class="phone-nav-item"></div>
                    <div class="phone-nav-item"></div>
                  </div>
                  <div class="phone-body">
                    <div class="phone-card"></div>
                    <div class="phone-card"></div>
                    <div class="phone-card"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Dark Theme Option -->
          <div class={`theme-radio-card ${vendor.theme === 'dark' ? 'active' : ''}`} data-theme="dark">
            <input 
              type="radio" 
              name="theme-opt" 
              class="theme-radio-input" 
              checked={vendor.theme === 'dark'} 
            />
            <span class="theme-card-title">تم تاریک (Dark)</span>
            <div class="theme-card-body-row">
              <p class="theme-card-desc">طراحی تیره، مدرن و لوکس با رنگ زمینه مشکی. فوق‌العاده برای فضاهای مدرن، نمایش در شب و کاهش خستگی چشم خریداران.</p>
              <!-- Theme Preview Mockup -->
              <div class="theme-preview-mockup">
                <div class="phone-frame-mockup dark-preview-theme">
                  <div class="phone-notch"></div>
                  <div class="phone-header">
                    <div class="phone-logo"></div>
                    <div class="phone-text"></div>
                  </div>
                  <div class="phone-nav">
                    <div class="phone-nav-item active"></div>
                    <div class="phone-nav-item"></div>
                    <div class="phone-nav-item"></div>
                  </div>
                  <div class="phone-body">
                    <div class="phone-card"></div>
                    <div class="phone-card"></div>
                    <div class="phone-card"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-full" style="margin-top: 1.5rem; padding: 0.9rem;">
        ذخیره تغییرات قالب نمایش
      </button>
    </form>
  </div>
</AdminLayout>

<script>
  // UI interaction for layout radio cards
  const layoutCards = document.querySelectorAll('.layout-radio-card');
  const layoutInputHidden = document.getElementById('selected-layout') as HTMLInputElement;
  const suggestionBanner = document.getElementById('layout-suggestion-banner');
  const suggestionText = document.getElementById('layout-suggestion-text');
  const designForm = document.getElementById('design-settings-form');
  
  const imagePercent = parseInt(designForm?.getAttribute('data-image-percent') || '0', 10);
  const descPercent = parseInt(designForm?.getAttribute('data-desc-percent') || '0', 10);

  function checkLayoutRecommendation(layout: string) {
    if (!suggestionBanner || !suggestionText) return;

    if (layout === 'pinterest') {
      if (imagePercent < 60) {
        suggestionText.textContent = `با توجه به اینکه تنها ${imagePercent}٪ از محصولات شما دارای عکس هستند، پیشنهاد می‌شود از قالب «ساده و متنی (کامپکت)» استفاده کنید. در قالب پینترستی (ماسونری)، عدم وجود عکس برای اکثر محصولات باعث ایجاد فضاهای خالی بزرگ و نامنظم و در نتیجه افت کیفیت بصری کاتالوگ می‌شود.`;
        suggestionBanner.style.display = 'flex';
      } else {
        suggestionBanner.style.display = 'none';
      }
    } else if (layout === 'card') {
      if (imagePercent < 40 || descPercent < 40) {
        let reason = '';
        if (imagePercent < 40 && descPercent < 40) {
          reason = `تنها ${imagePercent}٪ محصولات شما دارای عکس و ${descPercent}٪ دارای توضیحات هستند.`;
        } else if (imagePercent < 40) {
          reason = `تنها ${imagePercent}٪ محصولات شما دارای عکس هستند.`;
        } else {
          reason = `تنها ${descPercent}٪ محصولات شما دارای توضیحات هستند.`;
        }
        suggestionText.textContent = `با توجه به اینکه ${reason} پیشنهاد می‌شود از قالب «ساده و متنی (کامپکت)» استفاده کنید. قالب کارتی برای داشتن ظاهر شکیل نیاز به وجود عکس و توضیحات متنی در اکثر محصولات دارد، در غیر این صورت فضاها خالی و رها شده به نظر می‌رسند.`;
        suggestionBanner.style.display = 'flex';
      } else {
        suggestionBanner.style.display = 'none';
      }
    } else {
      suggestionBanner.style.display = 'none';
    }
  }

  layoutCards.forEach(card => {
    card.addEventListener('click', () => {
      // Clear previous active
      layoutCards.forEach(c => {
        c.classList.remove('active');
        const radio = c.querySelector('.layout-radio-input') as HTMLInputElement;
        if (radio) radio.checked = false;
      });

      // Select current
      card.classList.add('active');
      const radio = card.querySelector('.layout-radio-input') as HTMLInputElement;
      if (radio) radio.checked = true;

      const layoutVal = card.getAttribute('data-layout') || 'pinterest';
      layoutInputHidden.value = layoutVal;
      checkLayoutRecommendation(layoutVal);
    });
  });

  // Initial check on load
  if (layoutInputHidden) {
    checkLayoutRecommendation(layoutInputHidden.value);
  }

  // UI interaction for theme radio cards
  const themeCards = document.querySelectorAll('.theme-radio-card');
  const themeInputHidden = document.getElementById('selected-theme') as HTMLInputElement;

  themeCards.forEach(card => {
    card.addEventListener('click', () => {
      // Clear previous active
      themeCards.forEach(c => {
        c.classList.remove('active');
        const radio = c.querySelector('.theme-radio-input') as HTMLInputElement;
        if (radio) radio.checked = false;
      });

      // Select current
      card.classList.add('active');
      const radio = card.querySelector('.theme-radio-input') as HTMLInputElement;
      if (radio) radio.checked = true;

      const themeVal = card.getAttribute('data-theme') || 'light';
      themeInputHidden.value = themeVal;
    });
  });

  // Submit form
  const form = document.getElementById('design-settings-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const layout = layoutInputHidden.value;
    const theme = themeInputHidden.value;

    try {
      const response = await fetch('/api/vendors', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: getVendorSlug(), defaultLayout: layout, theme: theme })
      });

      if (response.ok) {
        alert('طراحی و چیدمان کاتالوگ با موفقیت به‌روزرسانی شد.');
        window.location.reload();
      } else {
        alert('خطا در ذخیره‌سازی اطلاعات.');
      }
    } catch {
      alert('ارتباط با سرور برقرار نشد.');
    }
  });

  function getVendorSlug() {
    const parts = window.location.pathname.split('/');
    return parts[2]; // /admin/[vendorSlug]/design
  }
</script>

<style>
  .layout-radio-group, .theme-radio-group {
    display: grid !important;
    grid-template-columns: 1fr !important; /* Stacked under each other on small mobile screens */
    gap: 1rem !important;
    margin-top: 0.5rem !important;
    direction: rtl !important;
    width: 100% !important;
  }

  /* Medium screens (tablets) - side-by-side layouts & themes */
  @media (min-width: 768px) {
    .layout-radio-group {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    .theme-radio-group {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  /* Large screens (desktop) - layouts side-by-side in 3 cols, themes in 2 cols */
  @media (min-width: 1024px) {
    .layout-radio-group {
      grid-template-columns: repeat(3, 1fr) !important;
    }
    .theme-radio-group {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  .layout-radio-card, .theme-radio-card {
    display: flex !important;
    flex-direction: column !important; /* Stack title and body row vertically */
    align-items: stretch !important;
    gap: 0.75rem !important;
    padding: 1.25rem !important;
    border: 1px solid #e5e5e5 !important;
    border-radius: 1rem !important;
    cursor: pointer !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    background: #ffffff !important;
    position: relative !important;
    text-align: right !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .layout-radio-card:hover, .theme-radio-card:hover {
    border-color: #a3a3a3 !important;
  }

  .layout-radio-card.active, .theme-radio-card.active {
    border-color: #171717 !important;
    background-color: #fafafa !important;
    box-shadow: 0 0 0 1px #171717 !important;
  }

  .layout-radio-input, .theme-radio-input {
    position: absolute !important;
    top: 1.25rem !important;
    right: 1.25rem !important; /* Move radio dot to top-right */
    left: auto !important;
    margin: 0 !important;
  }

  .layout-card-title, .theme-card-title {
    font-size: 0.875rem !important;
    font-weight: 600 !important;
    color: #171717 !important;
    padding-right: 1.75rem !important; /* Space for radio dot */
    display: block !important;
    width: 100% !important;
  }

  .layout-card-body-row, .theme-card-body-row {
    display: flex !important;
    flex-direction: row !important; /* Horizontal row (description right, mockup left) */
    align-items: center !important;
    justify-content: space-between !important;
    gap: 1.5rem !important;
    width: 100% !important;
  }

  .layout-card-desc, .theme-card-desc {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    font-size: 0.75rem !important;
    color: #737373 !important;
    line-height: 1.6 !important;
    margin: 0 !important;
  }

  /* Preview Mockup Adjustments */
  .layout-preview-mockup, .theme-preview-mockup {
    width: 8rem !important; /* Compact fixed width on the left to fit alongside text in columns */
    height: 7.5rem !important;
    flex-shrink: 0 !important;
    background-color: #fafafa !important;
    border-radius: 0.75rem !important;
    border: 1px dashed #e5e5e5 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: hidden !important;
  }

  .layout-radio-card.active .layout-preview-mockup,
  .theme-radio-card.active .theme-preview-mockup {
    border-color: #a3a3a3 !important;
    background-color: #ffffff !important;
  }

  .theme-preview-mockup {
    height: 8rem !important; /* Specific theme mockup height */
    padding: 0 !important;
    border-style: solid !important;
    background-color: #f5f5f5 !important;
  }

  .theme-radio-card.active .theme-preview-mockup {
    border-color: #171717 !important;
  }

  /* Vector phone mockup */
  .phone-frame-mockup {
    width: 6rem;
