---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db/db';
import { 
  vendors as vendorsTable, 
  categories as categoriesTable 
} from '../../../db/schema';
import { eq, asc } from 'drizzle-orm';

const vendorSlug = Astro.params.vendor;
if (!vendorSlug) {
  return Astro.redirect('/admin');
}

// Fetch vendor to get ID
const vendorList = await db
  .select()
  .from(vendorsTable)
  .where(eq(vendorsTable.slug, vendorSlug))
  .limit(1);

if (vendorList.length === 0) {
  return new Response("مجموعه یافت نشد.", { status: 404 });
}
const vendor = vendorList[0];

// Fetch categories for this vendor sorted by sort_order
const dbCategories = await db
  .select()
  .from(categoriesTable)
  .where(eq(categoriesTable.vendorId, vendor.id))
  .orderBy(asc(categoriesTable.sortOrder));
---

<AdminLayout title="مدیریت دسته‌بندی‌ها" activeTab="categories" vendorSlug={vendorSlug}>
  <!-- Marketing Onboarding Banner -->
  <div class="onboarding-banner">
    <div class="onboarding-icon-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.125rem; height: 1.125rem;">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="16" x2="12" y2="12" />
        <line x1="12" y1="8" x2="12.01" y2="8" />
      </svg>
    </div>
    <div class="onboarding-text-box">
      <span class="onboarding-title">راهنمای سازماندهی منو</span>
      <p class="onboarding-desc">دسته‌بندی‌ها (مانند نوشیدنی‌های گرم، کیک‌ها یا غذاهای اصلی) پایه اصلی دسترسی مشتری به محصولات شما هستند. با مرتب‌سازی دسته‌ها، ترتیب نمایش آن‌ها در نسخه عمومی منو را تغییر دهید. دسته‌های جذاب‌تر را بالاتر قرار دهید تا فروش آن‌ها افزایش یابد.</p>
    </div>
  </div>

  <div class="admin-page-actions">
    <h1 class="page-title-bold">دسته‌بندی‌های منو</h1>
    
    <button class="btn btn-primary" id="btn-add-category">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 0.875rem; height: 0.875rem;">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
      <span>افزودن دسته‌بندی جدید</span>
    </button>
  </div>

  <div class="admin-list-container">
    {dbCategories.length === 0 ? (
      <div class="admin-card" style="text-align: center; color: #a3a3a3; padding: 3rem 0; font-size: 0.875rem;">
        هنوز هیچ دسته‌بندی ایجاد نکرده‌اید. برای چیدمان محصولات خود، یک دسته‌بندی جدید اضافه کنید.
      </div>
    ) : (
      dbCategories.map((category, idx) => (
        <div class="admin-list-item">
          <div class="item-right-details">
            <div class="item-title-desc">
              <span class="item-name-bold">{category.name}</span>
            </div>
            
            <!-- Inline Status Selector -->
            <div class="category-status-pills" data-id={category.id}>
              <button 
                type="button" 
                class={`cat-status-pill ${(!category.status || category.status === 'available') ? 'active' : ''}`} 
                data-status="available" 
                title="موجود در منو"
              >
                موجود
              </button>
              <button 
                type="button" 
                class={`cat-status-pill ${(category.status === 'unavailable') ? 'active' : ''}`} 
                data-status="unavailable" 
                title="ناموجود"
              >
                ناموجود
              </button>
              <button 
                type="button" 
                class={`cat-status-pill ${(category.status === 'inactive') ? 'active' : ''}`} 
                data-status="inactive" 
                title="غیرفعال (مخفی)"
              >
                غیرفعال
              </button>
            </div>
          </div>
          
          <div class="item-left-controls">
            <!-- Move Up -->
            <button 
              class="btn-icon btn-move-category" 
              data-id={category.id} 
              data-direction="up" 
              disabled={idx === 0}
              style={idx === 0 ? "opacity: 0.3; cursor: not-allowed;" : ""}
              title="انتقال به بالا"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="list-icon-svg">
                <polyline points="18 15 12 9 6 15" />
              </svg>
            </button>
            
            <!-- Move Down -->
            <button 
              class="btn-icon btn-move-category" 
              data-id={category.id} 
              data-direction="down" 
              disabled={idx === dbCategories.length - 1}
              style={idx === dbCategories.length - 1 ? "opacity: 0.3; cursor: not-allowed;" : ""}
              title="انتقال به پایین"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="list-icon-svg">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>
            
            <!-- Rename -->
            <button class="btn-icon btn-edit-category" data-id={category.id} data-name={category.name} title="تغییر نام">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="list-icon-svg">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4z" />
              </svg>
            </button>
            
            <!-- Delete -->
            <button class="btn-icon btn-icon-danger btn-delete-category" data-id={category.id} data-name={category.name} title="حذف">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="list-icon-svg">
                <polyline points="3 6 5 6 21 6" />
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                <line x1="10" y1="11" x2="10" y2="17" />
                <line x1="14" y1="11" x2="14" y2="17" />
              </svg>
            </button>
          </div>
        </div>
      ))
    )}
  </div>
</AdminLayout>

<script>
  // Change Category Status Action
  document.querySelectorAll('.cat-status-pill').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.closest('.category-status-pills')?.getAttribute('data-id');
      const status = btn.getAttribute('data-status');
      if (!id || !status) return;

      try {
        const response = await fetch('/api/categories', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, status, action: 'update_status' })
        });
        if (response.ok) {
          // Instantly toggle active classes in UI
          const container = btn.closest('.category-status-pills');
          container?.querySelectorAll('.cat-status-pill').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        } else {
          alert('خطا در به‌روزرسانی وضعیت.');
        }
      } catch {
        alert('ارتباط با سرور برقرار نشد.');
      }
    });
  });

  // Add Category Action
  const addCategoryBtn = document.getElementById('btn-add-category');
  addCategoryBtn?.addEventListener('click', async () => {
    const name = prompt('نام دسته‌بندی جدید را وارد کنید:');
    if (!name || !name.trim()) return;

    try {
      const response = await fetch('/api/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name.trim(), vendorSlug: getVendorSlug() })
      });
      if (response.ok) window.location.reload();
      else alert('خطا در ثبت اطلاعات.');
    } catch {
      alert('ارتباط با سرور برقرار نشد.');
    }
  });

  // Rename Category Action
  document.querySelectorAll('.btn-edit-category').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const oldName = btn.getAttribute('data-name');
      const newName = prompt('نام جدید دسته‌بندی را وارد کنید:', oldName || '');
      if (!newName || !newName.trim() || newName.trim() === oldName) return;

      try {
        const response = await fetch('/api/categories', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, name: newName.trim(), action: 'rename' })
        });
        if (response.ok) window.location.reload();
        else alert('خطا در به‌روزرسانی.');
      } catch {
        alert('ارتباط با سرور برقرار نشد.');
      }
    });
  });

  // Delete Category Action
  document.querySelectorAll('.btn-delete-category').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      if (!confirm(`آیا از حذف دسته‌بندی «${name}» و تمام محصولات موجود در آن مطمئن هستید؟ این عمل غیرقابل بازگشت است.`)) return;

      try {
        const response = await fetch('/api/categories', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id })
        });
        if (response.ok) window.location.reload();
        else alert('خطا در حذف.');
      } catch {
        alert('ارتباط با سرور برقرار نشد.');
      }
    });
  });

  // Reorder Categories Action (Move Up/Down)
  document.querySelectorAll('.btn-move-category').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const direction = btn.getAttribute('data-direction');

      try {
        const response = await fetch('/api/categories', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, direction, action: 'reorder' })
        });
        if (response.ok) window.location.reload();
        else alert('خطا در جابجایی.');
      } catch {
        alert('ارتباط با سرور برقرار نشد.');
      }
    });
  });

  function getVendorSlug() {
    const parts = window.location.pathname.split('/');
    return parts[2]; // /admin/[vendorSlug]/categories
  }
</script>
