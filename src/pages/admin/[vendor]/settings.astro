---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db/db';
import { vendors as vendorsTable } from '../../../db/schema';
import { eq } from 'drizzle-orm';
import { useTranslations } from '../../../utils/i18n';
import { DEFAULT_LOCALE } from '../../../config/region';

const vendorSlug = Astro.params.vendor;
if (!vendorSlug) {
  return Astro.redirect('/admin');
}

const { t, locale, dir } = useTranslations(Astro.cookies, Astro.request);

// Fetch vendor settings
const vendorList = await db
  .select()
  .from(vendorsTable)
  .where(eq(vendorsTable.slug, vendorSlug))
  .limit(1);

if (vendorList.length === 0) {
  return new Response(t('vendorNotFound'), { status: 404 });
}
const vendor = vendorList[0];

// Use slogan as the unified description since they are the same
const unifiedSlogan = vendor.slogan || vendor.description;
---

<AdminLayout title={t('editInfo')} activeTab="settings" vendorSlug={vendorSlug}>
  <!-- Onboarding banner -->
  <div class="onboarding-banner">
    <div class="onboarding-icon-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.125rem; height: 1.125rem;">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="16" x2="12" y2="12" />
        <line x1="12" y1="8" x2="12.01" y2="8" />
      </svg>
    </div>
    <div class="onboarding-text-box">
      <span class="onboarding-title">{t('onboardingTitle')}</span>
      <p class="onboarding-desc">{t('onboardingDesc')}</p>
    </div>
  </div>

  <div class="admin-page-actions">
    <h1 class="page-title-bold">{t('editInfo')}</h1>
  </div>

  <div class="admin-card">
    <form 
      id="general-settings-form" 
      style="display: flex; flex-direction: column; gap: 1.25rem;"
      data-success-msg={t('successSettingsSaved')}
      data-error-msg={t('errorSavingSettings')}
      data-conn-error-msg={t('errorServerConnection')}
    >
      <div class="form-group">
        <label class="form-label">{t('shopName')}</label>
        <input type="text" name="name" class="form-input" value={vendor.name} required />
      </div>

      <div class="form-group">
        <label class="form-label">{t('shopType')}</label>
        <select name="type" class="form-select" required>
          <option value="کافه" selected={vendor.type === 'کافه' || vendor.type === 'کافه تخصصی' || vendor.type === 'کافه گالری'}>{t('typeCafe')}</option>
          <option value="رستوران" selected={vendor.type === 'رستوران' || vendor.type === 'رستوران مدرن'}>{t('typeRestaurant')}</option>
          <option value="کافه رستوران" selected={vendor.type === 'کافه رستوران' || vendor.type === 'رستوران مدرن فرانسوی-ایرانی'}>{t('typeCafeRestaurant')}</option>
          <option value="نان و شیرینی" selected={vendor.type === 'نان و شیرینی' || vendor.type === 'بوتیک قنادی فرانسوی' || vendor.type === 'قنادی و بوتیک شیرینی'}>{t('typeBakery')}</option>
          <option value="پوشاک و اکسسوری" selected={vendor.type === 'پوشاک و اکسسوری'}>{t('typeClothing')}</option>
          <option value="گالری و آثار هنری" selected={vendor.type === 'گالری و آثار هنری'}>{t('typeGallery')}</option>
          <option value="فروشگاه دیجیتال" selected={vendor.type === 'فروشگاه دیجیتال'}>{t('typeDigital')}</option>
          <option value="آرایشی و بهداشتی" selected={vendor.type === 'آرایشی و بهداشتی'}>{t('typeCosmetics')}</option>
          <option value="آجیل و خشکبار" selected={vendor.type === 'آجیل و خشکبار'}>{t('typeNuts')}</option>
          <option value="آبمیوه بستنی" selected={vendor.type === 'آبمیوه بستنی'}>{t('typeIceCream')}</option>
          <option value="سایر" selected={vendor.type === 'سایر'}>{t('typeOther')}</option>
          {vendor.type && !['کافه', 'کافه تخصصی', 'کافه گالری', 'رستوران', 'رستوران مدرن', 'کافه رستوران', 'رستوران مدرن فرانسوی-ایرانی', 'نان و شیرینی', 'بوتیک قنادی فرانسوی', 'قنادی و بوتیک شیرینی', 'پوشاک و اکسسوری', 'گالری و آثار هنری', 'فروشگاه دیجیتال', 'آرایشی و بهداشتی', 'آجیل و خشکبار', 'آبمیوه بستنی', 'سایر'].includes(vendor.type) && (
            <option value={vendor.type} selected>{vendor.type}</option>
          )}
        </select>
      </div>



      <div class="form-group">
        <label class="form-label">{t('sloganLabel')}</label>
        <input 
          type="text" 
          name="slogan" 
          class="form-input" 
          value={unifiedSlogan} 
          placeholder={t('sloganPlaceholder')} 
          required 
        />
      </div>

      <div class="form-group">
        <label class="form-label">{t('shopLogo')}</label>
        <div class="image-upload-wrapper">
          <input type="file" id="logo-file-input" accept="image/*" style="display: none;" />
          <input type="hidden" name="logo" id="logo-url-hidden" value={vendor.logo} />
          <div class="image-preview-container" id="logo-preview-container">
            <img src={vendor.logo} id="logo-preview" class="image-preview-box" style={vendor.logo ? 'display: block;' : 'display: none;'} />
            <div style="display: flex; flex-direction: column; gap: 0.375rem; align-items: flex-start;">
              <button type="button" class="btn btn-secondary" id="btn-select-logo">{t('selectLogo')}</button>
              <button type="button" class="btn btn-danger" id="btn-remove-logo" style={vendor.logo ? 'display: block; font-size: 0.75rem; padding: 0.4rem 0.8rem;' : 'display: none; font-size: 0.75rem; padding: 0.4rem 0.8rem;'}>{t('removeLogo')}</button>
              <span style="font-size: 0.6875rem; color: #737373;">{t('squareAspect')}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Cropper Modal -->
      <div id="cropper-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
          <div class="modal-header">
            <span class="modal-title">{t('cropLogo')}</span>
            <button type="button" class="modal-close" id="btn-close-cropper">✕</button>
          </div>
          <div class="modal-body modal-body-cropper">
            <div class="cropper-container">
              <img id="cropper-image" src="" style="max-width: 100%; max-height: 350px; display: block;" />
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-primary" id="btn-crop-save" data-uploading-text={t('uploading')} data-crop-text={t('cropUpload')} data-process-error={t('errorImageProcess')} data-upload-error={t('errorUploadLogo')}>{t('cropUpload')}</button>
            <button type="button" class="btn btn-secondary" id="btn-crop-cancel">{t('cancel')}</button>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-full" style="margin-top: 1.5rem; padding: 0.9rem;">
        {t('saveSettings')}
      </button>
    </form>
  </div>
</AdminLayout>

<script>
  // Handle Logo Upload & Cropper
  const selectLogoBtn = document.getElementById('btn-select-logo');
  const logoFileInput = document.getElementById('logo-file-input') as HTMLInputElement;
  const logoPreview = document.getElementById('logo-preview') as HTMLImageElement;
  const logoUrlHidden = document.getElementById('logo-url-hidden') as HTMLInputElement;
  const removeLogoBtn = document.getElementById('btn-remove-logo');

  removeLogoBtn?.addEventListener('click', () => {
    if (logoPreview) {
      logoPreview.src = '';
      logoPreview.style.display = 'none';
    }
    if (logoUrlHidden) {
      logoUrlHidden.value = '';
    }
    if (removeLogoBtn) {
      removeLogoBtn.style.display = 'none';
    }
    logoFileInput.value = '';
  });

  const cropperModal = document.getElementById('cropper-modal') as HTMLDivElement;
  const cropperImage = document.getElementById('cropper-image') as HTMLImageElement;
  const closeCropperBtn = document.getElementById('btn-close-cropper');
  const cropCancelBtn = document.getElementById('btn-crop-cancel');
  const cropSaveBtn = document.getElementById('btn-crop-save') as HTMLButtonElement;

  let cropper: any = null;

  selectLogoBtn?.addEventListener('click', () => {
    logoFileInput?.click();
  });

  logoFileInput?.addEventListener('change', () => {
    const files = logoFileInput.files;
    if (files && files.length > 0) {
      const file = files[0];
      const reader = new FileReader();
      reader.onload = () => {
        if (cropperImage) {
          cropperImage.src = reader.result as string;
          cropperModal.style.display = 'flex';
          
          if (cropper) {
            cropper.destroy();
          }
          // @ts-ignore
          cropper = new Cropper(cropperImage, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
          });
        }
      };
      reader.readAsDataURL(file);
    }
  });

  function closeCropper() {
    cropperModal.style.display = 'none';
    if (cropper) {
      cropper.destroy();
      cropper = null;
    }
    logoFileInput.value = '';
  }

  closeCropperBtn?.addEventListener('click', closeCropper);
  cropCancelBtn?.addEventListener('click', closeCropper);

  cropSaveBtn?.addEventListener('click', () => {
    if (!cropper) return;

    const canvas = cropper.getCroppedCanvas({
      width: 600,
      height: 600,
      imageSmoothingEnabled: true,
      imageSmoothingQuality: 'high',
    });

    const uploadingText = cropSaveBtn.getAttribute('data-uploading-text') || 'Uploading...';
    const cropText = cropSaveBtn.getAttribute('data-crop-text') || 'Crop & Upload';
    const processError = cropSaveBtn.getAttribute('data-process-error') || 'Error processing image';
    const uploadErrorStr = cropSaveBtn.getAttribute('data-upload-error') || 'Error uploading logo';

    cropSaveBtn.setAttribute('disabled', 'true');
    cropSaveBtn.textContent = uploadingText;

    canvas.toBlob(async (blob) => {
      if (!blob) {
        alert(processError);
        cropSaveBtn.removeAttribute('disabled');
        cropSaveBtn.textContent = cropText;
        return;
      }

      const formData = new FormData();
      formData.append('file', blob, 'logo.webp');

      try {
        const response = await fetch(`/api/upload?vendor=${getVendorSlug()}`, {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();
        if (data.success) {
          logoPreview.src = data.url;
          logoPreview.style.display = 'block';
          logoUrlHidden.value = data.url;
          if (removeLogoBtn) {
            removeLogoBtn.style.display = 'block';
          }
          closeCropper();
        } else {
          alert(uploadErrorStr + ': ' + (data.message || ''));
        }
      } catch (err) {
        console.error(err);
        alert(uploadErrorStr);
      } finally {
        cropSaveBtn.removeAttribute('disabled');
        cropSaveBtn.textContent = cropText;
      }
    }, 'image/webp', 0.85);
  });

  // Handle settings form submit
  const form = document.getElementById('general-settings-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    
    const name = (formData.get('name') as string).trim();
    const type = (formData.get('type') as string).trim();
    const slogan = (formData.get('slogan') as string).trim();
    const logo = (formData.get('logo') as string).trim();

    const successMsg = form.getAttribute('data-success-msg') || 'Saved';
    const errorMsg = form.getAttribute('data-error-msg') || 'Error';
    const connError = form.getAttribute('data-conn-error-msg') || 'Connection Error';

    // Dynamically assign logoIcon based on the selected vendor type
    let logoIcon = 'store';
    if (type.includes('کافه') || type.toLowerCase().includes('cafe') || type.toLowerCase().includes('kafe')) {
      logoIcon = 'coffee';
    } else if (type.includes('رستوران') || type.toLowerCase().includes('restaurant') || type.toLowerCase().includes('restoran')) {
      logoIcon = 'utensils';
    } else if (type.includes('قنادی') || type.includes('شیرینی') || type.toLowerCase().includes('pastry') || type.toLowerCase().includes('bakery')) {
      logoIcon = 'cake';
    } else if (type.includes('پوشاک') || type.includes('لباس') || type.toLowerCase().includes('clothing')) {
      logoIcon = 'shirt';
    } else if (type.includes('گالری') || type.includes('هنر') || type.toLowerCase().includes('gallery')) {
      logoIcon = 'palette';
    } else if (type.includes('دیجیتال') || type.toLowerCase().includes('digital')) {
      logoIcon = 'laptop';
    } else if (type.includes('آرایشی') || type.toLowerCase().includes('cosmetics')) {
      logoIcon = 'sparkles';
    }

    // Slogan and description are unified as requested
    const payload = {
      slug: getVendorSlug(),
      name,
      type,
      slogan,
      description: slogan, // Save same value to description in DB
      logoIcon,
      logo
    };

    try {
      const response = await fetch('/api/vendors', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (response.ok) {
        alert(successMsg);
        window.location.reload();
      } else {
        alert(errorMsg);
      }
    } catch {
      alert(connError);
    }
  });

  function getVendorSlug() {
    const parts = window.location.pathname.split('/');
    return parts[2]; // /admin/[vendorSlug]/settings
  }
</script>

