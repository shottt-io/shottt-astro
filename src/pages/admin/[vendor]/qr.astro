---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db/db';
import { vendors as vendorsTable } from '../../../db/schema';
import { eq } from 'drizzle-orm';
import { SITE_URL } from '../../../config/region';
import { useTranslations } from '../../../utils/i18n';

const vendorSlug = Astro.params.vendor;
if (!vendorSlug) {
  return Astro.redirect('/admin');
}

// Fetch vendor settings
const vendorList = await db
  .select()
  .from(vendorsTable)
  .where(eq(vendorsTable.slug, vendorSlug))
  .limit(1);

const { t, locale, dir } = useTranslations(Astro.cookies, Astro.request);

if (vendorList.length === 0) {
  return new Response(t('vendorNotFound'), { status: 404 });
}
const vendor = vendorList[0];

// Build direct link using SITE_URL if configured, otherwise fallback to request URL origin
let customerUrl = SITE_URL 
  ? `${SITE_URL.endsWith('/') ? SITE_URL.slice(0, -1) : SITE_URL}/${vendorSlug}`
  : new URL(`/${vendorSlug}`, Astro.url).toString();

if (!SITE_URL && Astro.url.hostname !== 'localhost' && Astro.url.hostname !== '127.0.0.1') {
  customerUrl = customerUrl.replace(/^http:/, 'https:');
}
---

<AdminLayout title={t('qrPageTitle')} activeTab="qr" vendorSlug={vendorSlug}>
  <!-- Local QRCode library -->
  <script src="/js/qrcode.min.js" is:inline></script>

  <!-- Onboarding banner -->
  <div class="onboarding-banner">
    <div class="onboarding-icon-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.125rem; height: 1.125rem;">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="16" x2="12" y2="12" />
        <line x1="12" y1="8" x2="12.01" y2="8" />
      </svg>
    </div>
    <div class="onboarding-text-box">
      <span class="onboarding-title">{t('qrOnboardingTitle')}</span>
      <p class="onboarding-desc">{t('qrOnboardingDesc')}</p>
    </div>
  </div>

  <div class="admin-page-actions">
    <h1 class="page-title-bold">{t('qrPageTitle')}</h1>
  </div>

  <div class="qr-grid-container">
    <!-- Link Card -->
    <div class="admin-card text-right-align">
      <div style="width: 100%;">
        <h2 class="card-section-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="card-title-icon">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
          <span>{t('directLinkTitle')}</span>
        </h2>
        <p class="card-section-desc">{t('directLinkDesc')}</p>
      </div>

      <div class="form-group" style="margin-top: 1.5rem; margin-bottom: 0; width: 100%;">
        <label class="form-label">{t('catalogUrlLabel')}</label>
        <div class="copy-url-wrapper">
          <input type="text" id="customer-url-input" class="form-input ltr-input" value={customerUrl} readonly />
          <button type="button" id="btn-copy-url" class="btn btn-primary btn-full" style="padding: 0.85rem; font-weight: 500;">{t('copyLinkBtn')}</button>
        </div>
      </div>
    </div>

    <!-- QR Code Card -->
    <div class="admin-card qr-card-align">
      <div style="width: 100%;">
        <h2 class="card-section-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="card-title-icon">
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
            <path d="M14 14h3v3h-3z" />
            <path d="M21 14h-3v3h3z" />
            <path d="M14 21h7v-4h-7z" />
          </svg>
          <span>{t('qrCodeTitle')}</span>
        </h2>
        <p class="card-section-desc">{t('qrCodeDesc')}</p>
      </div>

      <!-- High-res QR Render Container -->
      <div class="qr-render-box">
        <img id="qr-preview" style="width: 100%; height: 100%; display: none; border-radius: 0.5rem;" alt="QR Code Preview" />
        <div id="qr-loading" class="qr-loading-text">{t('generatingQr')}</div>
      </div>

      <button type="button" id="btn-download-qr" class="btn btn-primary btn-full" style="padding: 0.85rem; font-weight: 500;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.125rem; height: 1.125rem;">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        <span>{t('downloadQrBtn')}</span>
      </button>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ locale, clientTranslations: {
  copied: t('copied'),
  linkCopiedAlert: t('linkCopiedAlert'),
  ok: t('ok'),
  linkCopyErrorAlert: t('linkCopyErrorAlert'),
  qrGenError: t('qrGenError')
} }}>
  const copyBtn = document.getElementById('btn-copy-url');
  const urlInput = document.getElementById('customer-url-input');

  copyBtn?.addEventListener('click', async () => {
    if (!urlInput) return;
    try {
      await navigator.clipboard.writeText(urlInput.value);
      
      const originalText = copyBtn.innerText;
      copyBtn.innerText = clientTranslations.copied;
      copyBtn.style.backgroundColor = '#16a34a';
      
      // Custom visual alert dialog defined in layout
      // @ts-ignore
      if (window.showAlertDialog) {
        // @ts-ignore
        await window.showAlertDialog(clientTranslations.linkCopiedAlert, {
          type: 'success',
          okText: clientTranslations.ok
        });
      }
      
      setTimeout(() => {
        copyBtn.innerText = originalText;
        copyBtn.style.backgroundColor = '';
      }, 2000);

    } catch (err) {
      console.error('Failed to copy text: ', err);
      // @ts-ignore
      if (window.showAlertDialog) {
        // @ts-ignore
        await window.showAlertDialog(clientTranslations.linkCopyErrorAlert, {
          type: 'error',
          okText: clientTranslations.ok
        });
      }
    }
  });

  function generateQRCode() {
    const qrPreview = document.getElementById('qr-preview');
    const qrLoading = document.getElementById('qr-loading');
    const url = urlInput?.value;

    if (!url) return;

    // @ts-ignore
    if (typeof QRCode !== 'undefined') {
      // @ts-ignore
      QRCode.toDataURL(url, {
        width: 600,
        margin: 2,
        color: {
          dark: '#171717',
          light: '#ffffff'
        }
      }, (err, dataUrl) => {
        if (err) {
          console.error(err);
          if (qrLoading) qrLoading.textContent = clientTranslations.qrGenError;
          return;
        }
        if (qrPreview) {
          qrPreview.src = dataUrl;
          qrPreview.style.display = 'block';
        }
        if (qrLoading) {
          qrLoading.style.display = 'none';
        }
      });
    } else {
      // Retry in 100ms in case CDN is loading asynchronously
      setTimeout(generateQRCode, 100);
    }
  }

  // Trigger QR generation
  generateQRCode();

  const downloadBtn = document.getElementById('btn-download-qr');
  downloadBtn?.addEventListener('click', () => {
    const qrPreview = document.getElementById('qr-preview');
    if (!qrPreview || !qrPreview.src) return;

    const slug = getVendorSlug();
    const link = document.createElement('a');
    link.download = `${slug}-qr-code.png`;
    link.href = qrPreview.src;
    link.click();
  });

  function getVendorSlug() {
    const parts = window.location.pathname.split('/');
    return parts[2]; // /admin/[vendorSlug]/qr
  }
</script>

<style>
  .qr-grid-container {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .text-right-align {
    text-align: start;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .qr-card-align {
    text-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .card-section-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #171717;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-title-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: #171717;
  }

  .card-section-desc {
    font-size: 0.75rem;
    color: #737373;
    line-height: 1.6;
  }

  .copy-url-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
    width: 100%;
  }

  .ltr-input {
    direction: ltr;
    font-weight: 500;
    background-color: #fafafa;
    border-color: #e5e5e5;
    font-family: monospace !important;
    text-align: left;
    flex-grow: 1;
  }

  .qr-render-box {
    background: #ffffff;
    padding: 1rem;
    border-radius: 1.25rem;
    border: 1px solid #f0f0f0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 220px;
    height: 220px;
    position: relative;
    box-sizing: border-box;
  }

  .qr-loading-text {
    font-size: 0.8125rem;
    color: #a3a3a3;
  }

  @media (max-width: 768px) {
    .qr-grid-container {
      grid-template-columns: 1fr;
    }
  }
</style>
