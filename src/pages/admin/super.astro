---
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../utils/auth';
import { db } from '../../db/db';
import { 
  vendors as vendorsTable, 
  users as usersTable, 
  vendorUsers as vendorUsersTable 
} from '../../db/schema';
import { eq, desc } from 'drizzle-orm';
import { useTranslations } from '../../utils/i18n';
import '../../styles/admin.css';

// 1. Session verification
const session = getSession(Astro.cookies);
if (!session || session.username !== 'super') {
  return Astro.redirect('/admin/login');
}

const { t, locale, dir } = useTranslations(Astro.cookies, Astro.request);

// 2. Fetch all vendors
const vendorsList = await db
  .select()
  .from(vendorsTable)
  .orderBy(desc(vendorsTable.createdAt));

const formatPersianDate = (date: Date | null | undefined) => {
  if (!date) return t('unknownDate');
  // Format based on locale!
  if (locale === 'fa') {
    return new Date(date).toLocaleDateString('fa-IR', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  } else {
    return new Date(date).toLocaleDateString(locale === 'tr' ? 'tr-TR' : 'en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  }
};

// 3. Fetch all users and map their assigned vendor IDs
const usersList = await db
  .select({
    id: usersTable.id,
    name: usersTable.name,
    username: usersTable.username,
    phone: usersTable.phone,
  })
  .from(usersTable)
  .orderBy(usersTable.id);

const usersData = await Promise.all(
  usersList.map(async (user) => {
    const userVendors = await db
      .select({ vendorId: vendorUsersTable.vendorId })
      .from(vendorUsersTable)
      .where(eq(vendorUsersTable.userId, user.id));
    
    return {
      ...user,
      vendorIds: userVendors.map((v) => v.vendorId),
    };
  })
);

// Map vendor IDs to names for easy display
const vendorMap = new Map(vendorsList.map((v) => [v.id, v.name]));
---

<Layout title={`${t('superAdminPanel')} — ${t('dashboard')}`} description={t('superSubTitle')}>
  <div class="admin-layout-container" style={`direction: ${dir};`}>
    <!-- Mobile Header -->
    <header class="admin-mobile-header">
      <button class="hamburger-btn" id="mobile-nav-toggle" aria-label={t('dashboard')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="nav-icon-svg">
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
      </button>
      <span class="mobile-page-title">{t('superTitle')}</span>
      <div class="mobile-header-avatar">
        {session.name.substring(0, 1)}
      </div>
    </header>

    <!-- Navigation Backdrop (Mobile) -->
    <div class="admin-sidenav-backdrop" id="sidenav-backdrop"></div>

    <!-- Super Admin Navigation Sidebar -->
    <aside class="admin-sidenav" id="admin-sidenav">
      <div class="platform-brand">
        <img src="/logo.png" alt="shottt" class="platform-logo-img" />
        
        <!-- Brand small language switcher -->
        <div class="lang-dropdown-container">
          <button type="button" class="brand-lang-trigger" id="brand-lang-trigger" aria-haspopup="listbox" aria-expanded="false">
            <span>{locale.toUpperCase()}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="lang-dropdown-menu" id="brand-lang-menu">
            <button type="button" class={`lang-dropdown-item ${locale === 'fa' ? 'active' : ''}`} data-lang="fa">فارسی</button>
            <button type="button" class={`lang-dropdown-item ${locale === 'en' ? 'active' : ''}`} data-lang="en">English</button>
            <button type="button" class={`lang-dropdown-item ${locale === 'tr' ? 'active' : ''}`} data-lang="tr">Türkçe</button>
          </div>
        </div>
      </div>

      <div class="sidenav-header">
        <div class="brand-badge-wrapper">
          <div class="brand-avatar" style="background-color: #be123c;">
            {t('superTitle').substring(0, 1)}
          </div>
          <div class="brand-meta">
            <h2 class="brand-title-name">{t('superTitle')}</h2>
            <p class="brand-sub-title">{t('superSubTitle')}</p>
          </div>
        </div>
        <button class="btn-icon mobile-close-nav-btn" id="mobile-nav-close" aria-label={t('cancel')}>✕</button>
      </div>

      <nav class="sidenav-menu">
        <button class="sidenav-link active" id="tab-btn-vendors" style="background: none; border: none; text-align: inherit; width: 100%; cursor: pointer;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
            <rect x="3" y="3" width="7" height="9" />
            <rect x="14" y="3" width="7" height="5" />
            <rect x="14" y="12" width="7" height="9" />
            <rect x="3" y="16" width="7" height="5" />
          </svg>
          <span>{t('vendors')} ({vendorsList.length})</span>
        </button>

        <button class="sidenav-link" id="tab-btn-users" style="background: none; border: none; text-align: inherit; width: 100%; cursor: pointer;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
          <span>{t('users')} ({usersData.length})</span>
        </button>

        <button class="sidenav-link" id="tab-btn-analytics" style="background: none; border: none; text-align: inherit; width: 100%; cursor: pointer;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
          </svg>
          <span>{t('globalAnalytics')}</span>
        </button>

        <a id="sidenav-tickets-link" href="/admin/super/tickets" class="sidenav-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
          </svg>
          <span>{t('supportTickets')}</span>
        </a>

        <div class="menu-divider"></div>

        <a href="/admin" class="sidenav-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          <span>{t('backToPersonalDashboard')}</span>
        </a>
      </nav>

      <div class="sidenav-footer">


        <div class="user-meta-badge">
          <div class="user-avatar" style="background-color: #e5e5e5; color: #171717;">
            {session.name.substring(0, 1)}
          </div>
          <div class="user-text-info">
            <span class="user-name-bold">{session.name}</span>
            <span class="user-role-label">{t('superAdminLabel')}</span>
          </div>
        </div>

        <a href="/api/auth/logout" class="sidenav-footer-link logout-link" style="margin-top: 0.5rem;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="footer-icon-svg">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          <span>{t('logout')}</span>
        </a>
      </div>
    </aside>

    <!-- Main Workspace Content -->
    <div class="admin-workspace" style="width: 100%; padding: 2.5rem 1.5rem;">
      
      <!-- TAB 1: VENDORS/COLLECTIONS -->
      <div id="tab-content-vendors" class="tab-content">
        <div class="admin-page-actions">
          <h1 class="page-title-bold">{t('manageVendors')}</h1>
          <button class="btn btn-primary" id="btn-open-new-vendor">
            <span>{t('createVendor')}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1rem; height: 1rem;">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
        </div>

        <div class="vendors-table-container">
          {vendorsList.length === 0 ? (
            <div style="text-align: center; color: #737373; padding: 3rem 1rem;">
              {t('noVendors')}
            </div>
          ) : (
            <table class="vendors-table">
              <thead>
                <tr>
                  <th style="width: 50px;">{t('logoLabel')}</th>
                  <th class="sortable-header" data-sort="name" data-dir="" style="cursor: pointer; position: relative;">
                    {t('shopNameCol')} <span class="sort-icon">⇅</span>
                  </th>
                  <th class="sortable-header" data-sort="slug" data-dir="" style="cursor: pointer; position: relative;">
                    {t('typeSlugCol')} <span class="sort-icon">⇅</span>
                  </th>
                  <th>{t('cityCol')}</th>
                  <th class="sortable-header" data-sort="created" data-dir="desc" style="cursor: pointer; position: relative;">
                    {t('registerDateCol')} <span class="sort-icon">▼</span>
                  </th>
                  <th class="sortable-header" data-sort="active" data-dir="" style="cursor: pointer; position: relative;">
                    {t('lastActiveCol')} <span class="sort-icon">⇅</span>
                  </th>
                  <th style="width: 240px; text-align: center;">{t('actionsCol')}</th>
                </tr>
              </thead>
              <tbody id="vendors-table-body">
                {vendorsList.map((v) => (
                  <tr 
                    data-name={v.name} 
                    data-slug={v.slug} 
                    data-created={v.createdAt ? new Date(v.createdAt).getTime() : 0} 
                    data-active={v.lastActiveAt ? new Date(v.lastActiveAt).getTime() : 0}
                  >
                    <td>
                      <img src={v.logo} alt={v.name} style="width: 40px; height: 40px; border-radius: 0.375rem; object-fit: cover;" />
                    </td>
                    <td>
                      <span style="font-weight: 600; color: #171717;">{v.name}</span>
                    </td>
                    <td>
                      <span style="display: block; font-size: 0.75rem; color: #737373;">
                        {v.type} • <code>{v.slug}</code>
                      </span>
                    </td>
                    <td>
                      <span style="font-size: 0.75rem; color: #737373;">{v.city || '—'}</span>
                    </td>
                    <td>
                      <span class="local-date" data-date={v.createdAt ? new Date(v.createdAt).toISOString() : ''} style="font-size: 0.75rem; color: #525252;">{formatPersianDate(v.createdAt)}</span>
                    </td>
                    <td>
                      <span class="local-date" data-date={v.lastActiveAt ? new Date(v.lastActiveAt).toISOString() : ''} style="font-size: 0.75rem; color: #525252;">{formatPersianDate(v.lastActiveAt)}</span>
                    </td>
                    <td style="text-align: center;">
                      <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                        <a href={`/admin/${v.slug}/products`} class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.3rem 0.6rem;">
                          {t('shopPanelBtn')}
                        </a>
                        <a href={`/${v.slug}`} target="_blank" class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.3rem 0.6rem;">
                          {t('viewCatalogBtn')}
                        </a>
                        <button class="btn-icon btn-icon-danger btn-delete-vendor" data-id={v.id} data-name={v.name} title={t('deleteVendorTooltip')}>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="list-icon-svg">
                            <polyline points="3 6 5 6 21 6" />
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                            <line x1="10" y1="11" x2="10" y2="17" />
                            <line x1="14" y1="11" x2="14" y2="17" />
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      </div>

      <!-- TAB 2: USERS -->
      <div id="tab-content-users" class="tab-content" style="display: none;">
        <div class="admin-page-actions">
          <h1 class="page-title-bold">{t('manageUserAccess')}</h1>
          <button class="btn btn-primary" id="btn-open-new-user">
            <span>{t('createUser')}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1rem; height: 1rem;">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
        </div>

        <div class="admin-list-container">
          {usersData.map((u) => {
            const userVendorsText = u.vendorIds.map((id) => vendorMap.get(id)).filter(Boolean).join(locale === 'fa' ? '، ' : ', ');
            const isSuperUser = u.username === 'super';
            
            return (
              <div class="admin-list-item">
                <div class="item-right-details">
                  <div class="user-avatar" style="background-color: #f5f5f5; color: #171717; width: 2.5rem; height: 2.5rem; font-size: 0.9rem;">
                    {u.name.substring(0, 1)}
                  </div>
                  <div class="item-title-desc">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                      <span class="item-name-bold">{u.name}</span>
                      {isSuperUser && <span style="font-size: 0.625rem; background-color: #ffe4e6; color: #9f1239; padding: 0.1rem 0.4rem; border-radius: 9999px; font-weight: 500;">{t('superAdminBadge')}</span>}
                    </div>
                    <span class="item-desc-sub">
                      {t('usernameColon')}<code>{u.username}</code> 
                      {u.phone && ` • ${t('phoneColon')}${u.phone}`}
                      {userVendorsText ? ` • ${t('accessColon')}${userVendorsText}` : ` • ${t('noAccess')}`}
                    </span>
                  </div>
                </div>

                <div class="item-left-controls">
                  <button 
                    class="btn btn-secondary btn-edit-user" 
                    data-id={u.id} 
                    data-name={u.name} 
                    data-username={u.username} 
                    data-phone={u.phone || ''}
                    data-vendors={JSON.stringify(u.vendorIds)}
                    style="font-size: 0.75rem; padding: 0.4rem 0.8rem;"
                  >
                    {t('editBtn')}
                  </button>
                  
                  {!isSuperUser && (
                    <button class="btn-icon btn-icon-danger btn-delete-user" data-id={u.id} data-name={u.name} title={t('deleteUserTooltip')}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="list-icon-svg">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                        <line x1="10" y1="11" x2="10" y2="17" />
                        <line x1="14" y1="11" x2="14" y2="17" />
                      </svg>
                    </button>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- TAB 3: ANALYTICS -->
      <div id="tab-content-analytics" class="tab-content" style="display: none;">
        <!-- CDN for ApexCharts -->
        <script is:inline src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

        <div class="admin-page-actions" style="margin-bottom: 2rem;">
          <h1 class="page-title-bold">{t('globalAnalytics')}</h1>
          <div class="range-selector">
            <button class="range-btn" data-range="today">{t('today')}</button>
            <button class="range-btn active" data-range="7">{t('last7days')}</button>
            <button class="range-btn" data-range="30">{t('last30days')}</button>
          </div>
        </div>

        <!-- KPI Cards -->
        <div class="super-kpi-grid">
          <div class="super-kpi-card">
            <div class="super-kpi-icon-box" style="background:#eef2ff; color:#4f46e5;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:1.75rem;height:1.75rem;">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
            </div>
            <div class="super-kpi-content">
              <span class="super-kpi-label">{t('hpViews')}</span>
              <h3 class="super-kpi-value" id="s-kpi-hp-views">-</h3>
            </div>
          </div>

          <div class="super-kpi-card">
            <div class="super-kpi-icon-box" style="background:#f0fdf4; color:#16a34a;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:1.75rem;height:1.75rem;">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
              </svg>
            </div>
            <div class="super-kpi-content">
              <span class="super-kpi-label">{t('hpUnique')}</span>
              <h3 class="super-kpi-value" id="s-kpi-hp-unique">-</h3>
            </div>
          </div>

          <div class="super-kpi-card">
            <div class="super-kpi-icon-box" style="background:#fef3c7; color:#d97706;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:1.75rem;height:1.75rem;">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </div>
            <div class="super-kpi-content">
              <span class="super-kpi-label">{t('catalogViews')}</span>
              <h3 class="super-kpi-value" id="s-kpi-vendor-views">-</h3>
            </div>
          </div>

          <div class="super-kpi-card">
            <div class="super-kpi-icon-box" style="background:#fdf4ff; color:#9333ea;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:1.75rem;height:1.75rem;">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            </div>
            <div class="super-kpi-content">
              <span class="super-kpi-label">{t('catalogUnique')}</span>
              <h3 class="super-kpi-value" id="s-kpi-vendor-unique">-</h3>
            </div>
          </div>
        </div>

        <!-- Loading Skeleton -->
        <div id="super-analytics-skeleton">
          <div style="height:350px;background:linear-gradient(90deg,#f5f5f5 25%,#fafafa 50%,#f5f5f5 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:1.25rem;border:1px solid #f5f5f5;"></div>
          <div style="height:320px;background:linear-gradient(90deg,#f5f5f5 25%,#fafafa 50%,#f5f5f5 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:1.25rem;border:1px solid #f5f5f5;"></div>
          <div style="height:300px;background:linear-gradient(90deg,#f5f5f5 25%,#fafafa 50%,#f5f5f5 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:1.25rem;border:1px solid #f5f5f5;"></div>
        </div>

        <!-- Charts -->
        <div id="super-analytics-content" style="display:none;flex-direction:column;gap:1.5rem;">

          <!-- Homepage Visits Line Chart -->
          <div class="admin-card" style="padding:1.75rem;">
            <div style="margin-bottom:1.5rem;">
              <h3 style="font-size:1.125rem;font-weight:600;color:#171717;">{t('hpTrend')}</h3>
              <p style="font-size:0.8125rem;color:#a3a3a3;margin-top:0.25rem;">{t('totalVsUnique')}</p>
            </div>
            <div id="s-chart-homepage"></div>
          </div>

          <!-- Vendor Visits Area Chart -->
          <div class="admin-card" style="padding:1.75rem;">
            <div style="margin-bottom:1.5rem;">
              <h3 style="font-size:1.125rem;font-weight:600;color:#171717;">{t('catalogTrend')}</h3>
              <p style="font-size:0.8125rem;color:#a3a3a3;margin-top:0.25rem;">{t('totalViewsAllShops')}</p>
            </div>
            <div id="s-chart-vendors"></div>
          </div>

          <!-- Top Vendors Bar Chart -->
          <div class="admin-card" style="padding:1.75rem;">
            <div style="margin-bottom:1.5rem;">
              <h3 style="font-size:1.125rem;font-weight:600;color:#171717;">{t('top10Shops')}</h3>
              <p style="font-size:0.8125rem;color:#a3a3a3;margin-top:0.25rem;">{t('topShopsDesc')}</p>
            </div>
            <div id="s-chart-top-vendors"></div>
          </div>

        </div>
      </div>
      
    </div>
  </div>

  <!-- MODAL: NEW VENDOR -->
  <div id="modal-new-vendor" class="modal-overlay" style="display: none;">
    <div class="modal-content" style="max-width: 28rem;">
      <div class="modal-header">
        <span class="modal-title">{t('createVendor')}</span>
        <button type="button" class="modal-close btn-close-modal-vendor">✕</button>
      </div>
      <form id="form-new-vendor">
        <div class="modal-body">
          <div id="error-vendor-form" class="error-banner"></div>

          <div class="form-group">
            <label class="form-label">{t('shopNameInput')}</label>
            <input type="text" name="name" class="form-input" placeholder={t('shopNamePlaceholder')} required />
          </div>

          <div class="form-group">
            <label class="form-label">{t('englishSlugInput')}</label>
            <input type="text" name="slug" class="form-input" placeholder="cafe-lumiere" required style="direction: ltr; text-align: left;" />
            <span style="font-size: 0.65rem; color: #737373;">{t('englishSlugDesc')}</span>
          </div>

          <div class="form-group">
            <label class="form-label">{t('typeInput')}</label>
            <select name="type" class="form-select" required>
              <option value="کافه">{t('typeCafe')}</option>
              <option value="رستوران">{t('typeRestaurant')}</option>
              <option value="کافه رستوران">{t('typeCafeRestaurant')}</option>
              <option value="نان و شیرینی">{t('typeBakery')}</option>
              <option value="پوشاک و اکسسوری">{t('typeClothing')}</option>
              <option value="فروشگاه دیجیتال">{t('typeDigital')}</option>
              <option value="سایر">{t('typeOther')}</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">{t('cityInput')}</label>
            <input type="text" name="city" class="form-input" placeholder={t('cityPlaceholder')} />
          </div>

          <div class="form-group">
            <label class="form-label">{t('fillModeInput')}</label>
            <select name="mode" id="select-vendor-mode" class="form-select" required>
              <option value="empty">{t('emptyMode')}</option>
              <option value="package">{t('packageMode')}</option>
              <option value="menno">{t('mennoMode')}</option>
            </select>
          </div>

          <!-- Mode package selector -->
          <div class="form-group" id="group-package-type" style="display: none;">
            <label class="form-label">{t('selectPackage')}</label>
            <select name="packageType" class="form-select">
              <option value="cafe">{t('packageCafe')}</option>
              <option value="restaurant">{t('packageRestaurant')}</option>
              <option value="pastry">{t('packagePastry')}</option>
            </select>
          </div>

          <!-- Mode Menno.pro selector -->
          <div class="form-group" id="group-menno-vendor" style="display: none;">
            <label class="form-label">{t('mennoId')}</label>
            <input type="text" name="mennoVendor" class="form-input" placeholder="maghzook" style="direction: ltr; text-align: left;" />
            <span style="font-size: 0.65rem; color: #737373;">{t('mennoDesc')}</span>
          </div>

          <!-- Progress Bar Container -->
          <div class="form-group" id="group-vendor-progress" style="display: none; margin-top: 1rem; padding: 1rem; background: #fafafa; border: 1px solid #e5e5e5; border-radius: 0.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; font-size: 0.8125rem;">
              <span id="txt-vendor-progress-step" style="font-weight: 500; color: #171717;">{t('connectingServer')}</span>
              <span id="txt-vendor-progress-percent" style="color: #737373; font-weight: 600;">0%</span>
            </div>
            <div style="width: 100%; height: 6px; background-color: #e5e5e5; border-radius: 9999px; overflow: hidden;">
              <div id="bar-vendor-progress" style="width: 0%; height: 100%; background-color: #0284c7; border-radius: 9999px; transition: width 0.3s ease;"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer" style="padding-top: 1rem;">
          <button type="submit" class="btn btn-primary" id="btn-submit-vendor" style="min-width: 8rem;">
            <span id="txt-submit-vendor">{t('btnSubmitVendor')}</span>
            <svg id="spinner-submit-vendor" class="spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none; width: 0.875rem; height: 0.875rem; animation: rotate 1.5s linear infinite;">
              <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
              <path d="M4 12a8 8 0 0 1 8-8"></path>
            </svg>
          </button>
          <button type="button" class="btn btn-secondary btn-close-modal-vendor">{t('btnCancel')}</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: NEW/EDIT USER -->
  <div id="modal-user" class="modal-overlay" style="display: none;">
    <div class="modal-content" style="max-width: 28rem;">
      <div class="modal-header">
        <span class="modal-title" id="txt-user-modal-title">{t('createUser')}</span>
        <button type="button" class="modal-close btn-close-modal-user">✕</button>
      </div>
      <form id="form-user">
        <input type="hidden" name="id" id="input-user-id" />
        <div class="modal-body">
          <div id="error-user-form" class="error-banner"></div>

          <div class="form-group">
            <label class="form-label">{t('userInputName')}</label>
            <input type="text" name="name" id="input-user-name" class="form-input" placeholder={t('managerNamePlaceholder')} required />
          </div>

          <div class="form-group">
            <label class="form-label">{t('userInputUsername')}</label>
            <input type="text" name="username" id="input-user-username" class="form-input" placeholder="ahmadi" required style="direction: ltr; text-align: left;" />
            <span style="font-size: 0.65rem; color: #737373;">{t('usernameDesc')}</span>
          </div>

          <div class="form-group">
            <label class="form-label">{t('phoneInput')}</label>
            <input type="text" name="phone" id="input-user-phone" class="form-input" placeholder="09123456789" style="direction: ltr; text-align: left;" />
          </div>

          <div class="form-group">
            <label class="form-label" id="label-user-password">{t('passwordInput')}</label>
            <input type="password" name="password" id="input-user-password" class="form-input" placeholder="••••••••" required />
            <span style="font-size: 0.65rem; color: #737373;" id="tip-user-password">{t('passwordDesc')}</span>
          </div>

          <div class="form-group">
            <label class="form-label">{t('shopAccess')}</label>
            <div style="max-height: 10rem; overflow-y: auto; border: 1px solid #e5e5e5; border-radius: 0.75rem; padding: 0.75rem; background-color: #fafafa; display: flex; flex-direction: column; gap: 0.5rem;">
              {vendorsList.map((v) => (
                <label class="checkbox-group" style="margin: 0; font-size: 0.8125rem;">
                  <input type="checkbox" name="vendorIds" value={v.id} class="checkbox-input user-vendor-checkbox" />
                  <span>{v.name} ({v.type})</span>
                </label>
              ))}
              {vendorsList.length === 0 && <span style="font-size: 0.75rem; color: #a3a3a3; text-align: center;">{t('noShopsFound')}</span>}
            </div>
          </div>
        </div>
        <div class="modal-footer" style="padding-top: 1rem;">
          <button type="submit" class="btn btn-primary" id="btn-submit-user">{t('btnSaveUser')}</button>
          <button type="button" class="btn btn-secondary btn-close-modal-user">{t('btnCancel')}</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script define:vars={{
  locale: locale,
  hpViewsLabel: t('hpViews'),
  hpUniqueLabel: t('hpUnique'),
  catalogViewsLabel: t('catalogViews'),
  catalogUniqueLabel: t('catalogUnique'),
  totalViewsAllShopsLabel: t('totalViewsAllShops'),
  txtSubmitVendorCreating: t('txtSubmitVendorCreating'),
  btnSubmitVendorLabel: t('btnSubmitVendor'),
  connectingServer: t('connectingServer'),
  vendorCreatedSuccess: t('vendorCreatedSuccess'),
  deleteVendorConfirm: t('deleteVendorConfirm'),
  deleteBtn: t('deleteBtn'),
  btnCancel: t('btnCancel'),
  vendorDeletedSuccess: t('vendorDeletedSuccess'),
  errorDelete: t('errorDelete'),
  errorServerConnection: t('errorServerConnection'),
  userModalCreateTitle: t('userModalCreateTitle'),
  passwordLabelCreate: t('passwordLabelCreate'),
  passwordDescCreate: t('passwordDescCreate'),
  userModalEditTitle: t('userModalEditTitle'),
  passwordLabelEdit: t('passwordLabelEdit'),
  passwordPlaceholderEdit: t('passwordPlaceholderEdit'),
  passwordDescEdit: t('passwordDescEdit'),
  userUpdatedSuccess: t('userUpdatedSuccess'),
  userCreatedSuccess: t('userCreatedSuccess'),
  errorUserSave: t('errorUserSave'),
  deleteUserConfirm: t('deleteUserConfirm'),
  userDeletedSuccess: t('userDeletedSuccess'),
  chartTotalViewsFormat: t('chartTotalViewsFormat')
}}>
  // Mobile navigation drawer toggle logic
  const mobileNavToggle = document.getElementById('mobile-nav-toggle');
  const mobileNavClose = document.getElementById('mobile-nav-close');
  const sidenav = document.getElementById('admin-sidenav');
  const backdrop = document.getElementById('sidenav-backdrop');

  function openNav() {
    sidenav?.classList.add('active');
    backdrop?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeNav() {
    sidenav?.classList.remove('active');
    backdrop?.classList.remove('active');
    document.body.style.overflow = '';
  }

  mobileNavToggle?.addEventListener('click', openNav);
  mobileNavClose?.addEventListener('click', closeNav);
  backdrop?.addEventListener('click', closeNav);

  // Tab Navigation Switching
  const tabBtnVendors = document.getElementById('tab-btn-vendors');
  const tabBtnUsers = document.getElementById('tab-btn-users');
  const tabBtnAnalytics = document.getElementById('tab-btn-analytics');
  const tabContentVendors = document.getElementById('tab-content-vendors');
  const tabContentUsers = document.getElementById('tab-content-users');
  const tabContentAnalytics = document.getElementById('tab-content-analytics');

  let analyticsLoaded = false;
  let activeAnalyticsRange = '7';
  let sHomepageChart = null;
  let sVendorsChart = null;
  let sTopVendorsChart = null;

  function switchTab(activeTab) {
    tabBtnVendors?.classList.remove('active');
    tabBtnUsers?.classList.remove('active');
    tabBtnAnalytics?.classList.remove('active');
    if (tabContentVendors) tabContentVendors.style.display = 'none';
    if (tabContentUsers) tabContentUsers.style.display = 'none';
    if (tabContentAnalytics) tabContentAnalytics.style.display = 'none';

    if (activeTab === 'vendors') {
      tabBtnVendors?.classList.add('active');
      if (tabContentVendors) tabContentVendors.style.display = 'block';
    } else if (activeTab === 'users') {
      tabBtnUsers?.classList.add('active');
      if (tabContentUsers) tabContentUsers.style.display = 'block';
    } else {
      tabBtnAnalytics?.classList.add('active');
      if (tabContentAnalytics) tabContentAnalytics.style.display = 'block';
      if (!analyticsLoaded) {
        loadSuperAnalytics(activeAnalyticsRange);
        analyticsLoaded = true;
      }
    }
    closeNav();
  }

  tabBtnVendors?.addEventListener('click', () => switchTab('vendors'));
  tabBtnUsers?.addEventListener('click', () => switchTab('users'));
  tabBtnAnalytics?.addEventListener('click', () => switchTab('analytics'));

  // Range filter buttons for super analytics
  document.querySelectorAll('#tab-content-analytics .range-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#tab-content-analytics .range-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeAnalyticsRange = btn.getAttribute('data-range') || '7';
      analyticsLoaded = false;
      loadSuperAnalytics(activeAnalyticsRange);
      analyticsLoaded = true;
    });
  });

  function formatDateSuper(dateStr) {
    try {
      const parts = dateStr.split('-');
      const dateObj = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
      return new Intl.DateTimeFormat(locale === 'fa' ? 'fa-IR' : locale === 'tr' ? 'tr-TR' : 'en-US', { month: 'numeric', day: 'numeric' }).format(dateObj);
    } catch(e) {
      return dateStr;
    }
  }

  function animateValue(id, end) {
    const el = document.getElementById(id);
    if (!el) return;
    const duration = 700;
    const start = 0;
    const startTime = performance.now();
    function tick(now) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(start + (end - start) * eased).toLocaleString(locale);
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  async function loadSuperAnalytics(range) {
    const skeleton = document.getElementById('super-analytics-skeleton');
    const content = document.getElementById('super-analytics-content');
    if (skeleton) skeleton.style.display = 'flex';
    if (content) content.style.display = 'none';

    try {
      const res = await fetch(`/api/super/analytics?range=${range}`);
      const json = await res.json();
      if (!json.success) return;

      const { homepage, vendors: vendorData, vendorSummary } = json.data;

      // KPIs
      const hpViews = homepage.reduce((a, d) => a + d.pageViews, 0);
      const hpUnique = homepage.reduce((a, d) => a + d.uniqueVisits, 0);
      const vViews = vendorData.reduce((a, d) => a + d.pageViews, 0);
      const vUnique = vendorData.reduce((a, d) => a + d.uniqueVisits, 0);
      animateValue('s-kpi-hp-views', hpViews);
      animateValue('s-kpi-hp-unique', hpUnique);
      animateValue('s-kpi-vendor-views', vViews);
      animateValue('s-kpi-vendor-unique', vUnique);

      const isSingleDay = range === 'today';
      const hpCategories = homepage.map((d) => formatDateSuper(d.date));
      const hpViewing = homepage.map((d) => d.pageViews);
      const hpUniqueArr = homepage.map((d) => d.uniqueVisits);
      const hpMax = Math.max(...hpViewing, ...hpUniqueArr, 1);

      const homepageOptions = {
        series: [
          { name: hpViewsLabel, data: hpViewing },
          { name: hpUniqueLabel, data: hpUniqueArr }
        ],
        chart: { height: 320, type: 'area', fontFamily: 'Estedad, sans-serif', toolbar: { show: false }, zoom: { enabled: false } },
        colors: ['#4f46e5', '#059669'],
        fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.35, opacityTo: 0.02, stops: [0, 90, 100] } },
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 2 },
        markers: { size: isSingleDay ? 5 : 0, hover: { size: 7 } },
        xaxis: { categories: hpCategories, labels: { style: { colors: '#737373', fontSize: '11px' } }, axisBorder: { show: false }, axisTicks: { show: false } },
        yaxis: { opposite: locale === 'fa', min: 0, tickAmount: Math.min(4, hpMax), labels: { formatter: (v) => Math.round(v).toLocaleString(locale), style: { colors: '#737373', fontSize: '11px' } } },
        grid: { borderColor: '#f5f5f5', strokeDashArray: 4 },
        tooltip: { inverseOrder: true, style: { fontSize: '12px', fontFamily: 'Estedad, sans-serif' } },
        legend: { position: 'top', horizontalAlign: 'right', fontFamily: 'Estedad, sans-serif', labels: { colors: '#171717' } }
      };
      if (sHomepageChart) {
        sHomepageChart.updateOptions(homepageOptions);
      } else {
        sHomepageChart = new window.ApexCharts(document.querySelector('#s-chart-homepage'), homepageOptions);
        sHomepageChart.render();
      }

      // Vendor visits chart
      const vCategories = vendorData.map((d) => formatDateSuper(d.date));
      const vViewArr = vendorData.map((d) => d.pageViews);
      const vUniqueArr = vendorData.map((d) => d.uniqueVisits);
      const vMax = Math.max(...vViewArr, ...vUniqueArr, 1);

      const vendorsOptions = {
        series: [
          { name: catalogViewsLabel, data: vViewArr },
          { name: catalogUniqueLabel, data: vUniqueArr }
        ],
        chart: { height: 320, type: 'area', fontFamily: 'Estedad, sans-serif', toolbar: { show: false }, zoom: { enabled: false } },
        colors: ['#f59e0b', '#9333ea'],
        fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.35, opacityTo: 0.02, stops: [0, 90, 100] } },
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 2 },
        markers: { size: isSingleDay ? 5 : 0, hover: { size: 7 } },
        xaxis: { categories: vCategories, labels: { style: { colors: '#737373', fontSize: '11px' } }, axisBorder: { show: false }, axisTicks: { show: false } },
        yaxis: { opposite: locale === 'fa', min: 0, tickAmount: Math.min(4, vMax), labels: { formatter: (v) => Math.round(v).toLocaleString(locale), style: { colors: '#737373', fontSize: '11px' } } },
        grid: { borderColor: '#f5f5f5', strokeDashArray: 4 },
        tooltip: { inverseOrder: true, style: { fontSize: '12px', fontFamily: 'Estedad, sans-serif' } },
        legend: { position: 'top', horizontalAlign: 'right', fontFamily: 'Estedad, sans-serif', labels: { colors: '#171717' } }
      };
      if (sVendorsChart) {
        sVendorsChart.updateOptions(vendorsOptions);
      } else {
        sVendorsChart = new window.ApexCharts(document.querySelector('#s-chart-vendors'), vendorsOptions);
        sVendorsChart.render();
      }

      // Top vendors bar chart
      const topNames = vendorSummary.map((v) => v.name);
      const topViews = vendorSummary.map((v) => v.totalPageViews);
      const topMax = Math.max(...topViews, 1);

      const topVendorsOptions = {
        series: [{ name: totalViewsAllShopsLabel, data: topViews }],
        chart: { type: 'bar', height: Math.max(220, vendorSummary.length * 40), fontFamily: 'Estedad, sans-serif', toolbar: { show: false } },
        plotOptions: { bar: { borderRadius: 5, horizontal: true, barHeight: '55%', distributed: false } },
        colors: ['#6366f1'],
        dataLabels: {
          enabled: true, textAnchor: 'start',
          style: { colors: ['#ffffff'], fontSize: '11px', fontFamily: 'Estedad, sans-serif' },
          formatter: (val) => val.toLocaleString(locale) + ' ' + chartTotalViewsFormat,
          offsetX: 10
        },
        xaxis: {
          categories: topNames,
          min: 0,
          tickAmount: Math.min(5, topMax),
          labels: { formatter: (v) => Math.round(v).toLocaleString(locale), style: { colors: '#737373', fontSize: '11px' } },
          axisBorder: { show: false }, axisTicks: { show: false }
        },
        yaxis: { opposite: locale === 'fa', labels: { style: { colors: '#171717', fontSize: '11px', fontWeight: 500 } } },
        grid: { borderColor: '#f5f5f5', strokeDashArray: 4, xaxis: { lines: { show: true } }, yaxis: { lines: { show: false } } },
        tooltip: { style: { fontSize: '12px', fontFamily: 'Estedad, sans-serif' } }
      };
      if (sTopVendorsChart) {
        sTopVendorsChart.updateOptions(topVendorsOptions);
      } else {
        sTopVendorsChart = new window.ApexCharts(document.querySelector('#s-chart-top-vendors'), topVendorsOptions);
        sTopVendorsChart.render();
      }

      if (skeleton) skeleton.style.display = 'none';
      if (content) { content.style.display = 'flex'; }
    } catch(e) {
      console.error('Super analytics load error:', e);
    }
  }

  // Vendor Mode Fields Toggle
  const selectVendorMode = document.getElementById('select-vendor-mode');
  const groupPackageType = document.getElementById('group-package-type');
  const groupMennoVendor = document.getElementById('group-menno-vendor');

  selectVendorMode?.addEventListener('change', () => {
    const val = selectVendorMode.value;
    if (val === 'package') {
      groupPackageType.style.display = 'block';
      groupMennoVendor.style.display = 'none';
    } else if (val === 'menno') {
      groupPackageType.style.display = 'none';
      groupMennoVendor.style.display = 'block';
    } else {
      groupPackageType.style.display = 'none';
      groupMennoVendor.style.display = 'none';
    }
  });

  // Open/Close Vendor Modal
  const modalNewVendor = document.getElementById('modal-new-vendor');
  const btnOpenNewVendor = document.getElementById('btn-open-new-vendor');
  const btnCloseModalVendors = document.querySelectorAll('.btn-close-modal-vendor');
  const formNewVendor = document.getElementById('form-new-vendor');
  const errorVendorForm = document.getElementById('error-vendor-form');

  const btnSubmitVendor = document.getElementById('btn-submit-vendor');
  const txtSubmitVendor = document.getElementById('txt-submit-vendor');
  const spinnerSubmitVendor = document.getElementById('spinner-submit-vendor');

  btnOpenNewVendor?.addEventListener('click', () => {
    formNewVendor.reset();
    selectVendorMode.dispatchEvent(new Event('change'));
    errorVendorForm.style.display = 'none';
    modalNewVendor.style.display = 'flex';
  });

  btnCloseModalVendors.forEach(b => b.addEventListener('click', () => {
    modalNewVendor.style.display = 'none';
  }));

  // Progress DOM References
  const groupVendorProgress = document.getElementById('group-vendor-progress');
  const txtVendorProgressStep = document.getElementById('txt-vendor-progress-step');
  const txtVendorProgressPercent = document.getElementById('txt-vendor-progress-percent');
  const barVendorProgress = document.getElementById('bar-vendor-progress');

  // Create Vendor Submit Handler
  formNewVendor?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorVendorForm.style.display = 'none';

    // Show loading spinner and disable submit buttons
    btnSubmitVendor.disabled = true;
    txtSubmitVendor.textContent = txtSubmitVendorCreating;
    spinnerSubmitVendor.style.display = 'inline-block';

    // Initialize progress bar
    if (groupVendorProgress) groupVendorProgress.style.display = 'block';
    if (txtVendorProgressStep) txtVendorProgressStep.textContent = connectingServer;
    if (txtVendorProgressPercent) txtVendorProgressPercent.textContent = '0%';
    if (barVendorProgress) {
      barVendorProgress.style.width = '0%';
      barVendorProgress.style.backgroundColor = '#0284c7';
    }

    const formData = new FormData(formNewVendor);
    const slug = formData.get('slug').toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '').trim();
    const payload = {
      name: formData.get('name'),
      slug,
      type: formData.get('type'),
      mode: formData.get('mode'),
      packageType: formData.get('packageType'),
      mennoVendor: formData.get('mennoVendor'),
      city: formData.get('city'),
    };

    try {
      const response = await fetch('/api/super/vendors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        const errData = await response.json().catch(() => ({}));
        throw new Error(errData.message || errorServerConnection);
      }

      const reader = response.body?.getReader();
      if (!reader) {
        throw new Error('Streaming not supported');
      }

      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          if (!line.trim()) continue;
          
          try {
            const data = JSON.parse(line);
            
            if (data.status === 'progress') {
              if (txtVendorProgressStep) txtVendorProgressStep.textContent = data.message;
              if (txtVendorProgressPercent) txtVendorProgressPercent.textContent = `${data.progress}%`;
              if (barVendorProgress) barVendorProgress.style.width = `${data.progress}%`;
            } else if (data.status === 'error') {
              throw new Error(data.message);
            } else if (data.status === 'success') {
              if (txtVendorProgressStep) txtVendorProgressStep.textContent = data.message;
              if (txtVendorProgressPercent) txtVendorProgressPercent.textContent = locale === 'fa' ? '۱۰۰٪' : '100%';
              if (barVendorProgress) {
                barVendorProgress.style.width = '100%';
                barVendorProgress.style.backgroundColor = '#16a34a'; // Green color for success
              }
              alert(vendorCreatedSuccess);
              window.location.reload();
              return;
            }
          } catch (err) {
            throw new Error(err.message || 'Error processing data');
          }
        }
      }
    } catch (err) {
      errorVendorForm.textContent = err.message || errorServerConnection;
      errorVendorForm.style.display = 'block';
      if (groupVendorProgress) groupVendorProgress.style.display = 'none';
    } finally {
      btnSubmitVendor.disabled = false;
      txtSubmitVendor.textContent = btnSubmitVendorLabel;
      spinnerSubmitVendor.style.display = 'none';
    }
  });

  // Delete Vendor Handler
  const deleteVendorButtons = document.querySelectorAll('.btn-delete-vendor');
  deleteVendorButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      const confirmed = await window.showConfirmDialog(
        deleteVendorConfirm.replace('{name}', name),
        { okText: deleteBtn, cancelText: btnCancel, okClass: 'confirm-btn-danger' }
      );
      if (confirmed) {
        try {
          const res = await fetch(`/api/super/vendors?id=${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (res.ok && data.success) {
            alert(vendorDeletedSuccess);
            window.location.reload();
          } else {
            alert(data.message || errorDelete);
          }
        } catch {
          alert(errorServerConnection);
        }
      }
    });
  });

  // User Modal Management
  const modalUser = document.getElementById('modal-user');
  const btnOpenNewUser = document.getElementById('btn-open-new-user');
  const btnCloseModalUsers = document.querySelectorAll('.btn-close-modal-user');
  const formUser = document.getElementById('form-user');
  const errorUserForm = document.getElementById('error-user-form');

  const txtUserModalTitle = document.getElementById('txt-user-modal-title');
  const inputUserId = document.getElementById('input-user-id');
  const inputUserName = document.getElementById('input-user-name');
  const inputUserUsername = document.getElementById('input-user-username');
  const inputUserPhone = document.getElementById('input-user-phone');
  const inputUserPassword = document.getElementById('input-user-password');
  const labelUserPassword = document.getElementById('label-user-password');
  const tipUserPassword = document.getElementById('tip-user-password');

  btnOpenNewUser?.addEventListener('click', () => {
    formUser.reset();
    inputUserId.value = '';
    if (inputUserPhone) inputUserPhone.value = '';
    txtUserModalTitle.textContent = userModalCreateTitle;
    labelUserPassword.textContent = passwordLabelCreate;
    inputUserPassword.required = true;
    inputUserPassword.placeholder = '••••••••';
    tipUserPassword.textContent = passwordDescCreate;
    errorUserForm.style.display = 'none';

    // Uncheck all vendor checkboxes
    document.querySelectorAll('.user-vendor-checkbox').forEach((cb) => {
      cb.checked = false;
    });

    modalUser.style.display = 'flex';
  });

  btnCloseModalUsers.forEach(b => b.addEventListener('click', () => {
    modalUser.style.display = 'none';
  }));

  // Edit User Trigger
  const editUserButtons = document.querySelectorAll('.btn-edit-user');
  editUserButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      formUser.reset();
      errorUserForm.style.display = 'none';
      
      const id = btn.getAttribute('data-id') || '';
      const name = btn.getAttribute('data-name') || '';
      const username = btn.getAttribute('data-username') || '';
      const phone = btn.getAttribute('data-phone') || '';
      const vendorIds = JSON.parse(btn.getAttribute('data-vendors') || '[]');

      inputUserId.value = id;
      inputUserName.value = name;
      inputUserUsername.value = username;
      if (inputUserPhone) inputUserPhone.value = phone;
      
      txtUserModalTitle.textContent = userModalEditTitle;
      labelUserPassword.textContent = passwordLabelEdit;
      inputUserPassword.required = false;
      inputUserPassword.placeholder = passwordPlaceholderEdit;
      tipUserPassword.textContent = passwordDescEdit;

      // Select checkboxes based on vendorIds
      document.querySelectorAll('.user-vendor-checkbox').forEach((cb) => {
        cb.checked = vendorIds.includes(parseInt(cb.value, 10));
      });

      modalUser.style.display = 'flex';
    });
  });

  // Create/Edit User Submit Handler
  formUser?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorUserForm.style.display = 'none';

    const id = inputUserId.value;
    const isEdit = !!id;

    const formData = new FormData(formUser);
    
    // Collect vendorIds
    const vendorIds = [];
    document.querySelectorAll('.user-vendor-checkbox:checked').forEach((cb) => {
      vendorIds.push(parseInt(cb.value, 10));
    });

    const payload = {
      id: isEdit ? id : undefined,
      name: formData.get('name'),
      username: formData.get('username'),
      password: formData.get('password'),
      phone: formData.get('phone'),
      vendorIds,
    };

    try {
      const url = '/api/super/users';
      const method = isEdit ? 'PATCH' : 'POST';
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await response.json();
      if (response.ok && result.success) {
        alert(isEdit ? userUpdatedSuccess : userCreatedSuccess);
        window.location.reload();
      } else {
        errorUserForm.textContent = result.message || errorUserSave;
        errorUserForm.style.display = 'block';
      }
    } catch {
      errorUserForm.textContent = errorServerConnection;
      errorUserForm.style.display = 'block';
    }
  });

  // Delete User Handler
  const deleteUserButtons = document.querySelectorAll('.btn-delete-user');
  deleteUserButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      const confirmed = await window.showConfirmDialog(
        deleteUserConfirm.replace('{name}', name),
        { okText: deleteBtn, cancelText: btnCancel, okClass: 'confirm-btn-danger' }
      );
      if (confirmed) {
        try {
          const res = await fetch(`/api/super/users?id=${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (res.ok && data.success) {
            alert(userDeletedSuccess);
            window.location.reload();
          } else {
            alert(data.message || errorDelete);
          }
        } catch {
          alert(errorServerConnection);
        }
      }
    });
  });

  // Table sorting logic
  const tableBody = document.getElementById('vendors-table-body');
  const headers = document.querySelectorAll('.sortable-header');

  headers.forEach(header => {
    header.addEventListener('click', () => {
      const sortBy = header.getAttribute('data-sort');
      if (!sortBy || !tableBody) return;

      const currentDir = header.getAttribute('data-dir') || '';
      let newDir = 'asc';
      if (currentDir === '') {
        newDir = sortBy === 'created' || sortBy === 'active' ? 'desc' : 'asc';
      } else {
        newDir = currentDir === 'asc' ? 'desc' : 'asc';
      }

      // Reset all headers
      headers.forEach(h => {
        h.setAttribute('data-dir', '');
        const icon = h.querySelector('.sort-icon');
        if (icon) {
          icon.textContent = '⇅';
        }
      });

      header.setAttribute('data-dir', newDir);
      const icon = header.querySelector('.sort-icon');
      if (icon) {
        icon.textContent = newDir === 'asc' ? '▲' : '▼';
      }

      const rows = Array.from(tableBody.querySelectorAll('tr'));
      rows.sort((a, b) => {
        let valA, valB;
        if (sortBy === 'name' || sortBy === 'slug') {
          valA = (a.getAttribute(`data-${sortBy}`) || '').toLowerCase();
          valB = (b.getAttribute(`data-${sortBy}`) || '').toLowerCase();
          return newDir === 'asc' ? valA.localeCompare(valB, locale) : valB.localeCompare(valA, locale);
        } else {
          valA = parseInt(a.getAttribute(`data-${sortBy}`) || '0', 10);
          valB = parseInt(b.getAttribute(`data-${sortBy}`) || '0', 10);
          return newDir === 'asc' ? valA - valB : valB - valA;
        }
      });

      tableBody.innerHTML = '';
      rows.forEach(row => tableBody.appendChild(row));
    });
  });

  // Lazy-load unread support tickets notification dot for sidenav
  const ticketsLink = document.getElementById('sidenav-tickets-link');
  if (ticketsLink) {
    fetch('/api/tickets/unread')
      .then(res => res.json())
      .then(data => {
        if (data.success && data.hasUnread) {
          if (!ticketsLink.querySelector('.sidenav-unread-dot')) {
            const dot = document.createElement('span');
            dot.className = 'sidenav-unread-dot';
            dot.style.cssText = 'width: 8px; height: 8px; background-color: #ef4444; border-radius: 50%; margin-right: auto;';
            ticketsLink.appendChild(dot);
          }
        }
      })
      .catch(err => console.error('Error fetching unread status:', err));
  }

  // Localize dates to system timezone
  document.querySelectorAll('.local-date').forEach((el) => {
    const dateStr = el.getAttribute('data-date');
    if (dateStr) {
      const date = new Date(dateStr);
      if (locale === 'fa') {
        el.textContent = date.toLocaleDateString('fa-IR', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
      } else {
        el.textContent = date.toLocaleDateString(locale === 'tr' ? 'tr-TR' : 'en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
      }
    }
  });

  // Brand Header Small Language Switcher Logic
  const brandLangTrigger = document.getElementById('brand-lang-trigger');
  const brandLangMenu = document.getElementById('brand-lang-menu');
  const brandLangItems = document.querySelectorAll('#brand-lang-menu .lang-dropdown-item');

  brandLangTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = brandLangTrigger.getAttribute('aria-expanded') === 'true';
    brandLangTrigger.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
    brandLangMenu?.classList.toggle('show');
  });

  document.addEventListener('click', (e) => {
    if (brandLangTrigger && brandLangMenu && !brandLangTrigger.contains(e.target as Node) && !brandLangMenu.contains(e.target as Node)) {
      brandLangTrigger.setAttribute('aria-expanded', 'false');
      brandLangMenu.classList.remove('show');
    }
  });

  brandLangItems.forEach(item => {
    item.addEventListener('click', () => {
      const targetLang = item.getAttribute('data-lang');
      if (targetLang) {
        document.cookie = `lang=${targetLang}; path=/; max-age=31536000`;
        window.location.reload();
      }
    });
  });
</script>

