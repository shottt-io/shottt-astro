---
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../utils/auth';
import { db } from '../../db/db';
import { 
  vendors as vendorsTable, 
  users as usersTable, 
  vendorUsers as vendorUsersTable 
} from '../../db/schema';
import { eq } from 'drizzle-orm';
import '../../styles/admin.css';

// 1. Session verification
const session = getSession(Astro.cookies);
if (!session || session.username !== 'super') {
  return Astro.redirect('/admin/login');
}

// 2. Fetch all vendors
const vendorsList = await db
  .select()
  .from(vendorsTable)
  .orderBy(vendorsTable.name);

// 3. Fetch all users and map their assigned vendor IDs
const usersList = await db
  .select({
    id: usersTable.id,
    name: usersTable.name,
    username: usersTable.username,
  })
  .from(usersTable)
  .orderBy(usersTable.id);

const usersData = await Promise.all(
  usersList.map(async (user) => {
    const userVendors = await db
      .select({ vendorId: vendorUsersTable.vendorId })
      .from(vendorUsersTable)
      .where(eq(vendorUsersTable.userId, user.id));
    
    return {
      ...user,
      vendorIds: userVendors.map((v) => v.vendorId),
    };
  })
);

// Map vendor IDs to names for easy display
const vendorMap = new Map(vendorsList.map((v) => [v.id, v.name]));
---

<Layout title="پنل سازمانی — مدیریت کل" description="مدیریت همه‌جانبه مجموعه‌ها، کاربران و هماهنگ‌سازی">
  <div class="admin-layout-container" style="direction: rtl;">
    <!-- Mobile Header -->
    <header class="admin-mobile-header">
      <button class="hamburger-btn" id="mobile-nav-toggle" aria-label="منوی ناوبری">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="nav-icon-svg">
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
      </button>
      <span class="mobile-page-title">مدیریت سازمان</span>
      <div class="mobile-header-avatar">
        {session.name.substring(0, 1)}
      </div>
    </header>

    <!-- Navigation Backdrop (Mobile) -->
    <div class="admin-sidenav-backdrop" id="sidenav-backdrop"></div>

    <!-- Super Admin Navigation Sidebar -->
    <aside class="admin-sidenav" id="admin-sidenav">
      <div class="platform-brand">
        <img src="/logo.png" alt="shottt" class="platform-logo-img" />
      </div>

      <div class="sidenav-header">
        <div class="brand-badge-wrapper">
          <div class="brand-avatar" style="background-color: #be123c;">
            س
          </div>
          <div class="brand-meta">
            <h2 class="brand-title-name">پنل سازمانی</h2>
            <p class="brand-sub-title">مدیریت کل سیستم</p>
          </div>
        </div>
        <button class="btn-icon mobile-close-nav-btn" id="mobile-nav-close" aria-label="بستن منو">✕</button>
      </div>

      <nav class="sidenav-menu">
        <button class="sidenav-link active" id="tab-btn-vendors" style="background: none; border: none; text-align: right; width: 100%; cursor: pointer;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
            <rect x="3" y="3" width="7" height="9" />
            <rect x="14" y="3" width="7" height="5" />
            <rect x="14" y="12" width="7" height="9" />
            <rect x="3" y="16" width="7" height="5" />
          </svg>
          <span>مجموعه‌ها ({vendorsList.length})</span>
        </button>

        <button class="sidenav-link" id="tab-btn-users" style="background: none; border: none; text-align: right; width: 100%; cursor: pointer;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
          <span>کاربران ({usersData.length})</span>
        </button>

        <div class="menu-divider"></div>

        <a href="/admin" class="sidenav-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          <span>بازگشت به داشبورد فردی</span>
        </a>
      </nav>

      <div class="sidenav-footer">
        <div class="user-meta-badge">
          <div class="user-avatar" style="background-color: #e5e5e5; color: #171717;">
            {session.name.substring(0, 1)}
          </div>
          <div class="user-text-info">
            <span class="user-name-bold">{session.name}</span>
            <span class="user-role-label">مدیر ارشد سیستم</span>
          </div>
        </div>

        <a href="/api/auth/logout" class="sidenav-footer-link logout-link" style="margin-top: 0.5rem;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="footer-icon-svg">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          <span>خروج از حساب</span>
        </a>
      </div>
    </aside>

    <!-- Main Workspace Content -->
    <div class="admin-workspace" style="width: 100%; padding: 2.5rem 1.5rem;">
      
      <!-- TAB 1: VENDORS/COLLECTIONS -->
      <div id="tab-content-vendors" class="tab-content">
        <div class="admin-page-actions">
          <h1 class="page-title-bold">مدیریت مجموعه‌ها</h1>
          <button class="btn btn-primary" id="btn-open-new-vendor">
            <span>ایجاد مجموعه جدید</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1rem; height: 1rem;">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
        </div>

        <div class="admin-list-container">
          {vendorsList.length === 0 ? (
            <div class="admin-card" style="text-align: center; color: #737373; padding: 3rem 1rem;">
              هیچ مجموعه‌ای یافت نشد. برای شروع یک مجموعه جدید ایجاد کنید.
            </div>
          ) : (
            vendorsList.map((v) => (
              <div class="admin-list-item">
                <div class="item-right-details">
                  <img src={v.logo} alt={v.name} class="item-thumb" style="border-radius: 0.5rem; object-fit: cover;" />
                  <div class="item-title-desc">
                    <span class="item-name-bold">{v.name}</span>
                    <span class="item-desc-sub">{v.type} • شناسه: <code style="background: #f5f5f5; padding: 0.1rem 0.3rem; border-radius: 0.25rem;">{v.slug}</code></span>
                  </div>
                </div>

                <div class="item-left-controls">
                  <a href={`/admin/${v.slug}/products`} class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.4rem 0.8rem;">
                    پنل مجموعه
                  </a>
                  <button class="btn-icon btn-icon-danger btn-delete-vendor" data-id={v.id} data-name={v.name} title="حذف مجموعه">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="list-icon-svg">
                      <polyline points="3 6 5 6 21 6" />
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                      <line x1="10" y1="11" x2="10" y2="17" />
                      <line x1="14" y1="11" x2="14" y2="17" />
                    </svg>
                  </button>
                </div>
              </div>
            ))
          )}
        </div>
      </div>

      <!-- TAB 2: USERS -->
      <div id="tab-content-users" class="tab-content" style="display: none;">
        <div class="admin-page-actions">
          <h1 class="page-title-bold">مدیریت دسترسی کاربران</h1>
          <button class="btn btn-primary" id="btn-open-new-user">
            <span>ایجاد کاربر جدید</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1rem; height: 1rem;">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
        </div>

        <div class="admin-list-container">
          {usersData.map((u) => {
            const userVendorsText = u.vendorIds.map((id) => vendorMap.get(id)).filter(Boolean).join('، ');
            const isSuperUser = u.username === 'super';
            
            return (
              <div class="admin-list-item">
                <div class="item-right-details">
                  <div class="user-avatar" style="background-color: #f5f5f5; color: #171717; width: 2.5rem; height: 2.5rem; font-size: 0.9rem;">
                    {u.name.substring(0, 1)}
                  </div>
                  <div class="item-title-desc">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                      <span class="item-name-bold">{u.name}</span>
                      {isSuperUser && <span style="font-size: 0.625rem; background-color: #ffe4e6; color: #9f1239; padding: 0.1rem 0.4rem; border-radius: 9999px; font-weight: 500;">مدیر کل</span>}
                    </div>
                    <span class="item-desc-sub">
                      نام کاربری: <code>{u.username}</code> 
                      {userVendorsText ? ` • دسترسی‌ها: ${userVendorsText}` : ' • فاقد دسترسی به مجموعه‌ها'}
                    </span>
                  </div>
                </div>

                <div class="item-left-controls">
                  <button 
                    class="btn btn-secondary btn-edit-user" 
                    data-id={u.id} 
                    data-name={u.name} 
                    data-username={u.username} 
                    data-vendors={JSON.stringify(u.vendorIds)}
                    style="font-size: 0.75rem; padding: 0.4rem 0.8rem;"
                  >
                    ویرایش
                  </button>
                  
                  {!isSuperUser && (
                    <button class="btn-icon btn-icon-danger btn-delete-user" data-id={u.id} data-name={u.name} title="حذف کاربر">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="list-icon-svg">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                        <line x1="10" y1="11" x2="10" y2="17" />
                        <line x1="14" y1="11" x2="14" y2="17" />
                      </svg>
                    </button>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
      
    </div>
  </div>

  <!-- MODAL: NEW VENDOR -->
  <div id="modal-new-vendor" class="modal-overlay" style="display: none;">
    <div class="modal-content" style="max-width: 28rem;">
      <div class="modal-header">
        <span class="modal-title">ایجاد مجموعه جدید</span>
        <button type="button" class="modal-close btn-close-modal-vendor">✕</button>
      </div>
      <form id="form-new-vendor">
        <div class="modal-body" style="display: flex; flex-direction: column; gap: 1rem;">
          <div id="error-vendor-form" class="error-banner"></div>

          <div class="form-group">
            <label class="form-label">نام مجموعه *</label>
            <input type="text" name="name" class="form-input" placeholder="مثال: کافه لومیر" required />
          </div>

          <div class="form-group">
            <label class="form-label">آیدی انگلیسی مجموعه (URL Slug) *</label>
            <input type="text" name="slug" class="form-input" placeholder="مثال: cafe-lumiere" required style="direction: ltr; text-align: left;" />
            <span style="font-size: 0.65rem; color: #737373;">حروف کوچک انگلیسی، بدون فاصله و کاراکترهای خاص</span>
          </div>

          <div class="form-group">
            <label class="form-label">نوع مجموعه *</label>
            <select name="type" class="form-select" required>
              <option value="کافه">کافه</option>
              <option value="رستوران">رستوران</option>
              <option value="کافه رستوران">کافه رستوران</option>
              <option value="نان و شیرینی">نان و شیرینی (قنادی)</option>
              <option value="پوشاک و اکسسوری">پوشاک و اکسسوری</option>
              <option value="فروشگاه دیجیتال">فروشگاه دیجیتال</option>
              <option value="سایر">سایر موارد</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">حالت پر کردن محتوا *</label>
            <select name="mode" id="select-vendor-mode" class="form-select" required>
              <option value="empty">خام (بدون منو و محصول)</option>
              <option value="package">پکیج آماده محصولات پیش‌فرض</option>
              <option value="menno">درون‌ریزی خودکار از menno.pro</option>
            </select>
          </div>

          <!-- Mode package selector -->
          <div class="form-group" id="group-package-type" style="display: none;">
            <label class="form-label">انتخاب پکیج محصولات آماده *</label>
            <select name="packageType" class="form-select">
              <option value="cafe">محصولات آماده کافه گالری</option>
              <option value="restaurant">محصولات آماده رستوران فرانسوی</option>
              <option value="pastry">محصولات آماده بوتیک قنادی</option>
            </select>
          </div>

          <!-- Mode Menno.pro selector -->
          <div class="form-group" id="group-menno-vendor" style="display: none;">
            <label class="form-label">شناسه مجموعه در menno.pro *</label>
            <input type="text" name="mennoVendor" class="form-input" placeholder="مثال: maghzook" style="direction: ltr; text-align: left;" />
            <span style="font-size: 0.65rem; color: #737373;">سرور به طور خودکار اطلاعات را دریافت و عکس‌ها را بر روی سرور خودمان ذخیره می‌کند.</span>
          </div>
        </div>
        <div class="modal-footer" style="padding-top: 1rem;">
          <button type="submit" class="btn btn-primary" id="btn-submit-vendor" style="min-width: 8rem;">
            <span id="txt-submit-vendor">ایجاد مجموعه</span>
            <svg id="spinner-submit-vendor" class="spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none; width: 0.875rem; height: 0.875rem; animation: rotate 1.5s linear infinite;">
              <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
              <path d="M4 12a8 8 0 0 1 8-8"></path>
            </svg>
          </button>
          <button type="button" class="btn btn-secondary btn-close-modal-vendor">انصراف</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: NEW/EDIT USER -->
  <div id="modal-user" class="modal-overlay" style="display: none;">
    <div class="modal-content" style="max-width: 28rem;">
      <div class="modal-header">
        <span class="modal-title" id="txt-user-modal-title">ایجاد کاربر جدید</span>
        <button type="button" class="modal-close btn-close-modal-user">✕</button>
      </div>
      <form id="form-user">
        <input type="hidden" name="id" id="input-user-id" />
        <div class="modal-body" style="display: flex; flex-direction: column; gap: 1rem;">
          <div id="error-user-form" class="error-banner"></div>

          <div class="form-group">
            <label class="form-label">نام کاربر *</label>
            <input type="text" name="name" id="input-user-name" class="form-input" placeholder="مثال: علی احمدی" required />
          </div>

          <div class="form-group">
            <label class="form-label">نام کاربری *</label>
            <input type="text" name="username" id="input-user-username" class="form-input" placeholder="مثال: ahmadi" required style="direction: ltr; text-align: left;" />
            <span style="font-size: 0.65rem; color: #737373;">حروف انگلیسی، عدد و کاراکترهای مجاز</span>
          </div>

          <div class="form-group">
            <label class="form-label" id="label-user-password">رمز عبور *</label>
            <input type="password" name="password" id="input-user-password" class="form-input" placeholder="••••••••" required />
            <span style="font-size: 0.65rem; color: #737373;" id="tip-user-password">حداقل ۶ کاراکتر</span>
          </div>

          <div class="form-group">
            <label class="form-label">دسترسی به مجموعه‌ها</label>
            <div style="max-height: 10rem; overflow-y: auto; border: 1px solid #e5e5e5; border-radius: 0.75rem; padding: 0.75rem; background-color: #fafafa; display: flex; flex-direction: column; gap: 0.5rem; text-align: right;">
              {vendorsList.map((v) => (
                <label class="checkbox-group" style="margin: 0; font-size: 0.8125rem;">
                  <input type="checkbox" name="vendorIds" value={v.id} class="checkbox-input user-vendor-checkbox" />
                  <span>{v.name} ({v.type})</span>
                </label>
              ))}
              {vendorsList.length === 0 && <span style="font-size: 0.75rem; color: #a3a3a3; text-align: center;">هیچ مجموعه‌ای برای تخصیص یافت نشد</span>}
            </div>
          </div>
        </div>
        <div class="modal-footer" style="padding-top: 1rem;">
          <button type="submit" class="btn btn-primary" id="btn-submit-user">ذخیره کاربر</button>
          <button type="button" class="btn btn-secondary btn-close-modal-user">انصراف</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Mobile navigation drawer toggle logic
  const mobileNavToggle = document.getElementById('mobile-nav-toggle');
  const mobileNavClose = document.getElementById('mobile-nav-close');
  const sidenav = document.getElementById('admin-sidenav');
  const backdrop = document.getElementById('sidenav-backdrop');

  function openNav() {
    sidenav?.classList.add('active');
    backdrop?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeNav() {
    sidenav?.classList.remove('active');
    backdrop?.classList.remove('active');
    document.body.style.overflow = '';
  }

  mobileNavToggle?.addEventListener('click', openNav);
  mobileNavClose?.addEventListener('click', closeNav);
  backdrop?.addEventListener('click', closeNav);

  // Tab Navigation Switching
  const tabBtnVendors = document.getElementById('tab-btn-vendors');
  const tabBtnUsers = document.getElementById('tab-btn-users');
  const tabContentVendors = document.getElementById('tab-content-vendors');
  const tabContentUsers = document.getElementById('tab-content-users');

  function switchTab(activeTab: 'vendors' | 'users') {
    if (activeTab === 'vendors') {
      tabBtnVendors?.classList.add('active');
      tabBtnUsers?.classList.remove('active');
      if (tabContentVendors) tabContentVendors.style.display = 'block';
      if (tabContentUsers) tabContentUsers.style.display = 'none';
    } else {
      tabBtnVendors?.classList.remove('active');
      tabBtnUsers?.classList.add('active');
      if (tabContentVendors) tabContentVendors.style.display = 'none';
      if (tabContentUsers) tabContentUsers.style.display = 'block';
    }
    // Close mobile nav drawer when tab is switched
    closeNav();
  }

  tabBtnVendors?.addEventListener('click', () => switchTab('vendors'));
  tabBtnUsers?.addEventListener('click', () => switchTab('users'));

  // Vendor Mode Fields Toggle
  const selectVendorMode = document.getElementById('select-vendor-mode') as HTMLSelectElement;
  const groupPackageType = document.getElementById('group-package-type') as HTMLDivElement;
  const groupMennoVendor = document.getElementById('group-menno-vendor') as HTMLDivElement;

  selectVendorMode?.addEventListener('change', () => {
    const val = selectVendorMode.value;
    if (val === 'package') {
      groupPackageType.style.display = 'block';
      groupMennoVendor.style.display = 'none';
    } else if (val === 'menno') {
      groupPackageType.style.display = 'none';
      groupMennoVendor.style.display = 'block';
    } else {
      groupPackageType.style.display = 'none';
      groupMennoVendor.style.display = 'none';
    }
  });

  // Open/Close Vendor Modal
  const modalNewVendor = document.getElementById('modal-new-vendor') as HTMLDivElement;
  const btnOpenNewVendor = document.getElementById('btn-open-new-vendor');
  const btnCloseModalVendors = document.querySelectorAll('.btn-close-modal-vendor');
  const formNewVendor = document.getElementById('form-new-vendor') as HTMLFormElement;
  const errorVendorForm = document.getElementById('error-vendor-form') as HTMLDivElement;

  const btnSubmitVendor = document.getElementById('btn-submit-vendor') as HTMLButtonElement;
  const txtSubmitVendor = document.getElementById('txt-submit-vendor') as HTMLSpanElement;
  const spinnerSubmitVendor = document.getElementById('spinner-submit-vendor') as SVGElement;

  btnOpenNewVendor?.addEventListener('click', () => {
    formNewVendor.reset();
    selectVendorMode.dispatchEvent(new Event('change'));
    errorVendorForm.style.display = 'none';
    modalNewVendor.style.display = 'flex';
  });

  btnCloseModalVendors.forEach(b => b.addEventListener('click', () => {
    modalNewVendor.style.display = 'none';
  }));

  // Create Vendor Submit Handler
  formNewVendor?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorVendorForm.style.display = 'none';

    // Show loading spinner
    btnSubmitVendor.disabled = true;
    txtSubmitVendor.textContent = 'در حال ایجاد و بارگذاری...';
    spinnerSubmitVendor.style.display = 'inline-block';

    const formData = new FormData(formNewVendor);
    const slug = (formData.get('slug') as string).toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '').trim();
    const payload = {
      name: formData.get('name'),
      slug,
      type: formData.get('type'),
      mode: formData.get('mode'),
      packageType: formData.get('packageType'),
      mennoVendor: formData.get('mennoVendor'),
    };

    try {
      const response = await fetch('/api/super/vendors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await response.json();
      if (response.ok && result.success) {
        alert('مجموعه جدید با موفقیت ثبت شد.');
        window.location.reload();
      } else {
        errorVendorForm.textContent = result.message || 'خطا در ثبت مجموعه';
        errorVendorForm.style.display = 'block';
      }
    } catch {
      errorVendorForm.textContent = 'خطا در برقراری ارتباط با سرور. لطفاً دوباره تلاش کنید.';
      errorVendorForm.style.display = 'block';
    } finally {
      btnSubmitVendor.disabled = false;
      txtSubmitVendor.textContent = 'ایجاد مجموعه';
      spinnerSubmitVendor.style.display = 'none';
    }
  });

  // Delete Vendor Handler
  const deleteVendorButtons = document.querySelectorAll('.btn-delete-vendor');
  deleteVendorButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      if (confirm(`آیا از حذف کامل مجموعه "${name}" به همراه تمام محصولات و دسته‌بندی‌های آن مطمئن هستید؟ این عمل غیرقابل بازگشت است.`)) {
        try {
          const res = await fetch(`/api/super/vendors?id=${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (res.ok && data.success) {
            alert('مجموعه با موفقیت حذف شد.');
            window.location.reload();
          } else {
            alert(data.message || 'خطا در حذف مجموعه');
          }
        } catch {
          alert('خطا در ارتباط با سرور.');
        }
      }
    });
  });

  // User Modal Management
  const modalUser = document.getElementById('modal-user') as HTMLDivElement;
  const btnOpenNewUser = document.getElementById('btn-open-new-user');
  const btnCloseModalUsers = document.querySelectorAll('.btn-close-modal-user');
  const formUser = document.getElementById('form-user') as HTMLFormElement;
  const errorUserForm = document.getElementById('error-user-form') as HTMLDivElement;

  const txtUserModalTitle = document.getElementById('txt-user-modal-title') as HTMLSpanElement;
  const inputUserId = document.getElementById('input-user-id') as HTMLInputElement;
  const inputUserName = document.getElementById('input-user-name') as HTMLInputElement;
  const inputUserUsername = document.getElementById('input-user-username') as HTMLInputElement;
  const inputUserPassword = document.getElementById('input-user-password') as HTMLInputElement;
  const labelUserPassword = document.getElementById('label-user-password') as HTMLLabelElement;
  const tipUserPassword = document.getElementById('tip-user-password') as HTMLSpanElement;

  btnOpenNewUser?.addEventListener('click', () => {
    formUser.reset();
    inputUserId.value = '';
    txtUserModalTitle.textContent = 'ایجاد کاربر جدید';
    labelUserPassword.textContent = 'رمز عبور *';
    inputUserPassword.required = true;
    inputUserPassword.placeholder = '••••••••';
    tipUserPassword.textContent = 'حداقل ۶ کاراکتر';
    errorUserForm.style.display = 'none';

    // Uncheck all vendor checkboxes
    document.querySelectorAll('.user-vendor-checkbox').forEach((cb: any) => {
      cb.checked = false;
    });

    modalUser.style.display = 'flex';
  });

  btnCloseModalUsers.forEach(b => b.addEventListener('click', () => {
    modalUser.style.display = 'none';
  }));

  // Edit User Trigger
  const editUserButtons = document.querySelectorAll('.btn-edit-user');
  editUserButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      formUser.reset();
      errorUserForm.style.display = 'none';
      
      const id = btn.getAttribute('data-id') || '';
      const name = btn.getAttribute('data-name') || '';
      const username = btn.getAttribute('data-username') || '';
      const vendorIds = JSON.parse(btn.getAttribute('data-vendors') || '[]');

      inputUserId.value = id;
      inputUserName.value = name;
      inputUserUsername.value = username;
      
      txtUserModalTitle.textContent = 'ویرایش کاربر';
      labelUserPassword.textContent = 'رمز عبور جدید (اختیاری)';
      inputUserPassword.required = false;
      inputUserPassword.placeholder = 'خالی بگذارید تا تغییر نکند';
      tipUserPassword.textContent = 'در صورت عدم تمایل به تغییر، خالی بگذارید';

      // Select checkboxes based on vendorIds
      document.querySelectorAll('.user-vendor-checkbox').forEach((cb: any) => {
        cb.checked = vendorIds.includes(parseInt(cb.value, 10));
      });

      modalUser.style.display = 'flex';
    });
  });

  // Create/Edit User Submit Handler
  formUser?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorUserForm.style.display = 'none';

    const id = inputUserId.value;
    const isEdit = !!id;

    const formData = new FormData(formUser);
    
    // Collect vendorIds
    const vendorIds: number[] = [];
    document.querySelectorAll('.user-vendor-checkbox:checked').forEach((cb: any) => {
      vendorIds.push(parseInt(cb.value, 10));
    });

    const payload = {
      id: isEdit ? id : undefined,
      name: formData.get('name'),
      username: formData.get('username'),
      password: formData.get('password'),
      vendorIds,
    };

    try {
      const url = '/api/super/users';
      const method = isEdit ? 'PATCH' : 'POST';
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await response.json();
      if (response.ok && result.success) {
        alert(isEdit ? 'اطلاعات کاربر با موفقیت به‌روزرسانی شد.' : 'کاربر جدید با موفقیت ایجاد شد.');
        window.location.reload();
      } else {
        errorUserForm.textContent = result.message || 'خطا در ذخیره‌سازی اطلاعات کاربر';
        errorUserForm.style.display = 'block';
      }
    } catch {
      errorUserForm.textContent = 'خطا در ارتباط با سرور. لطفاً دوباره تلاش کنید.';
      errorUserForm.style.display = 'block';
    }
  });

  // Delete User Handler
  const deleteUserButtons = document.querySelectorAll('.btn-delete-user');
  deleteUserButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      if (confirm(`آیا از حذف کامل حساب کاربری "${name}" مطمئن هستید؟`)) {
        try {
          const res = await fetch(`/api/super/users?id=${id}`, { method: 'DELETE' });
          const data = await res.json();
          if (res.ok && data.success) {
            alert('کاربر با موفقیت حذف شد.');
            window.location.reload();
          } else {
            alert(data.message || 'خطا در حذف کاربر');
          }
        } catch {
          alert('خطا در ارتباط با سرور.');
        }
      }
    });
  });
</script>

