---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../utils/i18n';
import { IS_IRAN_SERVER } from '../../config/region';
import '../../styles/admin.css';

const domainName = Astro.url.host;
const { t, locale, dir } = useTranslations(Astro.cookies, Astro.request);

---

<Layout title={t('registerSeoTitle')} description={t('registerSeoDesc')}>
  <div class="auth-page-container" style={`direction: ${dir};`}>
    <!-- Language & Home Navigation Top Bar -->
    <nav class="auth-top-nav">
      <div class="lang-dropdown-container">
        <button type="button" class="lang-dropdown-trigger" id="login-lang-trigger" aria-haspopup="listbox" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="globe-icon">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span>{locale === 'fa' ? 'فارسی' : locale === 'en' ? 'English' : 'Türkçe'}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="lang-dropdown-menu" id="login-lang-menu">
          <button type="button" class={`lang-dropdown-item ${locale === 'fa' ? 'active' : ''}`} data-lang="fa">فارسی</button>
          <button type="button" class={`lang-dropdown-item ${locale === 'en' ? 'active' : ''}`} data-lang="en">English</button>
          <button type="button" class={`lang-dropdown-item ${locale === 'tr' ? 'active' : ''}`} data-lang="tr">Türkçe</button>
        </div>
      </div>
      <a href="/" class="auth-top-btn">
        <span>{t('backToHome')}</span>
      </a>
    </nav>

    <main class="login-wrapper" id="register-container">
    <div class="login-container animate-slide-up">
      {!IS_IRAN_SERVER && (
        <div class="iran-server-banner" style={`direction: ${dir}; text-align: ${dir === 'rtl' ? 'right' : 'left'};`}>
          <div class="iran-server-banner-content">
            <p class="iran-server-banner-text" set:html={t('iranServerNoticeRegister')} />
          </div>
        </div>
      )}


      <header class="login-header">

        <div class="login-logo-container">
          <img src="/logo.png" alt="shottt" class="login-logo-img" />
        </div>
        <h1 class="login-title">{t('registerTitle')}</h1>
        <p class="login-subtitle">{t('registerSubtitle')}</p>
      </header>

      <div class="admin-card">
        <div id="error-banner" class="error-banner"></div>
        
        <form 
          id="register-form" 
          class="login-form"
          data-registering-text={t('registering')}
          data-register-text={t('registerBtn')}
          data-reserved-slug-msg={t('errorReservedSlug')}
          data-reserved-username-msg={t('errorReservedUsername')}
          data-mismatch-msg={t('errorPasswordMismatch')}
          data-failed-msg={t('errorRegisterFailed')}
          data-error-msg={t('loginError')}
          data-show-text={t('show')}
          data-hide-text={t('hide')}
        >
          <input type="hidden" name="timezone" id="timezone-input" value="Asia/Tehran" />
          <div class="form-group">
            <label for="name" class="form-label">{t('shopName')}</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              class="form-input" 
              placeholder={t('shopNamePlaceholder')} 
              required 
            />
          </div>

          <div class="form-group">
            <label for="slug" class="form-label">{t('shopUrlSlug')}</label>
            <div style="position: relative; display: flex; align-items: center; width: 100%;">
              <span class="slug-prefix" style={`direction: ltr; display: inline-block; text-align: left; position: absolute; ${dir === 'rtl' ? 'left: 1rem;' : 'right: 1rem;'} font-size: 0.875rem; color: #a3a3a3; user-select: none;`}>{domainName}/</span>
              <input 
                type="text" 
                id="slug" 
                name="slug" 
                class="form-input" 
                placeholder="lumiere" 
                required 
                style={`direction: ltr; padding-left: ${dir === 'rtl' ? ((domainName.length + 1) * 0.5 + 0.75) + 'rem;' : '1rem;'} padding-right: ${dir === 'ltr' ? ((domainName.length + 1) * 0.5 + 0.75) + 'rem;' : '1rem;'} text-align: left; width: 100%;`}
              />
            </div>
            <span style="font-size: 0.75rem; color: #737373; margin-top: 0.5rem; line-height: 1.6; display: block; text-align: justify;">
              {t('shopUrlSlugDesc').replace('{domain}', domainName + '/lumiere')}
            </span>
          </div>

          <div class="form-group">
            <label for="type" class="form-label">{t('shopType')}</label>
            <select name="type" id="type" class="form-select" required style={dir === 'ltr' ? 'background-position: right 1rem center; padding-right: 2.5rem; padding-left: 1rem;' : ''}>
              <option value="" disabled selected>{t('selectOption')}</option>
              <option value="کافه">{t('typeCafe')}</option>
              <option value="رستوران">{t('typeRestaurant')}</option>
              <option value="کافه رستوران">{t('typeCafeRestaurant')}</option>
              <option value="نان و شیرینی">{t('typeBakery')}</option>
              <option value="پوشاک و اکسسوری">{t('typeClothing')}</option>
              <option value="گالری و آثار هنری">{t('typeGallery')}</option>
              <option value="فروشگاه دیجیتال">{t('typeDigital')}</option>
              <option value="آرایشی و بهداشتی">{t('typeCosmetics')}</option>
              <option value="آبمیوه بستنی">{t('typeIceCream')}</option>
              <option value="سایر">{t('typeOther')}</option>
            </select>
          </div>

          <div class="form-group">
            <label for="city" class="form-label">{t('shopCity')}</label>
            <input 
              type="text" 
              id="city" 
              name="city" 
              class="form-input" 
              placeholder={t('cityPlaceholder')} 
              required 
            />
          </div>

          <div class="form-group" style="margin-top: 1.5rem; border-top: 1px solid #f5f5f5; padding-top: 1.25rem;">
            <label for="userName" class="form-label">{t('managerName')}</label>
            <input 
              type="text" 
              id="userName" 
              name="userName" 
              class="form-input" 
              placeholder={t('managerNamePlaceholder')} 
              required 
            />
          </div>

          <div class="form-group">
            <label for="phone" class="form-label">{t('managerPhone')}</label>
            <input 
              type="tel" 
              id="phone" 
              name="phone" 
              class="form-input" 
              placeholder="09123456789" 
              required 
              style="direction: ltr; text-align: left;"
            />
          </div>

          <div class="form-group">
            <label for="username" class="form-label">{t('managerUsername')}</label>
            <input 
              type="text" 
              id="username" 
              name="username" 
              class="form-input" 
              placeholder="admin" 
              required 
              style="direction: ltr; text-align: left;"
              autocomplete="username"
            />
          </div>

          <div class="form-group">
            <label for="password" class="form-label">{t('passwordLabel')}</label>
            <div style="position: relative; display: flex; align-items: center; width: 100%;">
              <input 
                type="password" 
                id="password" 
                name="password" 
                class="form-input" 
                placeholder="••••••••" 
                required 
                style={`direction: ltr; padding-left: 1rem; padding-right: 3.5rem; text-align: left; width: 100%;`}
                autocomplete="new-password"
              />
              <button type="button" class="toggle-password-btn" data-target="password" style={`position: absolute; ${dir === 'rtl' ? 'right: 0.75rem;' : 'left: 0.75rem;'} background: none; border: none; cursor: pointer; color: #737373; font-size: 0.75rem; font-weight: 500; user-select: none;`}>
                {t('show')}
              </button>
            </div>
          </div>

          <div class="form-group">
            <label for="passwordConfirm" class="form-label">{t('passwordConfirmLabel')}</label>
            <div style="position: relative; display: flex; align-items: center; width: 100%;">
              <input 
                type="password" 
                id="passwordConfirm" 
                name="passwordConfirm" 
                class="form-input" 
                placeholder="••••••••" 
                required 
                style={`direction: ltr; padding-left: 1rem; padding-right: 3.5rem; text-align: left; width: 100%;`}
                autocomplete="new-password"
              />
              <button type="button" class="toggle-password-btn" data-target="passwordConfirm" style={`position: absolute; ${dir === 'rtl' ? 'right: 0.75rem;' : 'left: 0.75rem;'} background: none; border: none; cursor: pointer; color: #737373; font-size: 0.75rem; font-weight: 500; user-select: none;`}>
                {t('show')}
              </button>
            </div>
          </div>

          <button type="submit" id="submit-btn" class="btn btn-primary btn-full" style="margin-top: 1rem;">
            <span id="btn-text">{t('registerBtn')}</span>
            <svg id="loading-spinner" class="spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none; width: 1rem; height: 1rem; animation: rotate 1.5s linear infinite;">
              <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
              <path d="M4 12a8 8 0 0 1 8-8"></path>
            </svg>
          </button>
        </form>
      </div>

      <div class="login-footer">
        <a href="/admin/login" class="back-link">
          <span>{t('alreadyRegistered')}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="back-icon" style="transform: scaleX(-1);">
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </div>
  </main>
  </div>
</Layout>

<script>
  const form = document.getElementById('register-form') as HTMLFormElement;
  const errorBanner = document.getElementById('error-banner') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;
  const spinner = document.getElementById('loading-spinner') as SVGElement;
  const slugInput = document.getElementById('slug') as HTMLInputElement;

  // Set client timezone
  const tzInput = document.getElementById('timezone-input') as HTMLInputElement;
  if (tzInput) {
    try {
      const systemTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (systemTimezone) {
        tzInput.value = systemTimezone;
      }
    } catch (e) {
      console.warn('Could not detect system timezone:', e);
    }
  }

  // Restrict slug input keys to valid slug format
  slugInput?.addEventListener('input', () => {
    const startVal = slugInput.value;
    const cleanVal = startVal.toLowerCase()
      .replace(/[^a-z0-9-]/g, '') // remove invalid chars
      .replace(/-+/g, '-'); // prevent multiple hyphens
    
    if (slugInput.value !== cleanVal) {
      slugInput.value = cleanVal;
    }
  });

  // Password visibility toggle logic
  const showText = form?.getAttribute('data-show-text') || 'Show';
  const hideText = form?.getAttribute('data-hide-text') || 'Hide';

  document.querySelectorAll('.toggle-password-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;
      const input = document.getElementById(targetId) as HTMLInputElement;
      if (!input) return;

      if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = hideText;
      } else {
        input.type = 'password';
        btn.textContent = showText;
      }
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const registeringText = form.getAttribute('data-registering-text') || 'Registering...';
    const registerText = form.getAttribute('data-register-text') || 'Register';
    const reservedSlugMsg = form.getAttribute('data-reserved-slug-msg') || 'Reserved URL slug';
    const reservedUsernameMsg = form.getAttribute('data-reserved-username-msg') || 'Reserved username';
    const mismatchMsg = form.getAttribute('data-mismatch-msg') || 'Passwords do not match';
    const failedMsg = form.getAttribute('data-failed-msg') || 'Registration failed';
    const errorMsg = form.getAttribute('data-error-msg') || 'Server error';

    // Reset state
    errorBanner.style.display = 'none';
    errorBanner.textContent = '';
    submitBtn.disabled = true;
    btnText.textContent = registeringText;
    spinner.style.display = 'inline-block';

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    // Front-end reserved keywords check
    const RESERVED_KEYWORDS = [
      'admin', 'api', 'dashboard', 'auth', 'login', 'register', 
      'static', 'assets', 'super', 'vendors', 'products', 'tickets', 
      'categories', 'menu', 'preview', 'shottt', 'root', 'administrator', 
      'manager', 'user', 'settings', 'config', 'profile', 'logout',
      'help', 'support', 'billing', 'db', 'database', 'system'
    ];

    const slug = (document.getElementById('slug') as HTMLInputElement).value.trim().toLowerCase();
    const username = (document.getElementById('username') as HTMLInputElement).value.trim().toLowerCase();

    if (RESERVED_KEYWORDS.includes(slug)) {
      errorBanner.textContent = reservedSlugMsg;
      errorBanner.style.display = 'block';
      submitBtn.disabled = false;
      btnText.textContent = registerText;
      spinner.style.display = 'none';
      return;
    }

    if (RESERVED_KEYWORDS.includes(username)) {
      errorBanner.textContent = reservedUsernameMsg;
      errorBanner.style.display = 'block';
      submitBtn.disabled = false;
      btnText.textContent = registerText;
      spinner.style.display = 'none';
      return;
    }

    // Front-end password check
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const passwordConfirm = (document.getElementById('passwordConfirm') as HTMLInputElement).value;

    if (password !== passwordConfirm) {
      errorBanner.textContent = mismatchMsg;
      errorBanner.style.display = 'block';
      submitBtn.disabled = false;
      btnText.textContent = registerText;
      spinner.style.display = 'none';
      return;
    }

    try {
      const response = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await response.json();

      if (response.ok && result.success) {
        // Redirect to admin landing
        window.location.href = '/admin';
      } else {
        errorBanner.textContent = result.message || failedMsg;
        errorBanner.style.display = 'block';
        submitBtn.disabled = false;
        btnText.textContent = registerText;
        spinner.style.display = 'none';
      }
    } catch (err) {
      errorBanner.textContent = errorMsg;
      errorBanner.style.display = 'block';
      submitBtn.disabled = false;
      btnText.textContent = registerText;
      spinner.style.display = 'none';
    }
  });

  // Language Switcher Logic
  const langTrigger = document.getElementById('login-lang-trigger');
  const langMenu = document.getElementById('login-lang-menu');
  const langItems = document.querySelectorAll('#login-lang-menu .lang-dropdown-item');

  langTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = langTrigger.getAttribute('aria-expanded') === 'true';
    langTrigger.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
    langMenu?.classList.toggle('show');
  });

  document.addEventListener('click', (e) => {
    if (langTrigger && langMenu && !langTrigger.contains(e.target as Node) && !langMenu.contains(e.target as Node)) {
      langTrigger.setAttribute('aria-expanded', 'false');
      langMenu.classList.remove('show');
    }
  });

  langItems.forEach(item => {
    item.addEventListener('click', () => {
      const targetLang = item.getAttribute('data-lang');
      if (targetLang) {
        document.cookie = `lang=${targetLang}; path=/; max-age=31536000`;
        window.location.reload();
      }
    });
  });
</script>

<style>
  .login-wrapper {
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    width: 100%;
    box-sizing: border-box;
    flex: 1;
  }

  .login-container {
    max-width: 26rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .login-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .login-logo-container {
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #171717;
    margin-bottom: 0.5rem;
  }

  .login-logo-img {
    height: 2.5rem;
    width: auto;
  }

  .login-title {
    font-size: 1.375rem;
    font-weight: 500;
    color: #0a0a0a;
  }

  .login-subtitle {
    font-size: 0.8125rem;
    font-weight: 200;
    color: #737373;
  }

  .slug-prefix {
    pointer-events: none;
  }

  .login-footer {
    text-align: center;
    margin-top: 0.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: #737373;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #171717;
  }

  .back-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  @keyframes rotate {
    100% { transform: rotate(360deg); }
  }
  
  .spinner {
    animation: rotate 1s linear infinite;
  }
</style>
