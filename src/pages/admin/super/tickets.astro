---
import Layout from '../../../layouts/Layout.astro';
import { getSession } from '../../../utils/auth';
import { db } from '../../../db/db';
import { 
  vendors as vendorsTable, 
  users as usersTable, 
  tickets as ticketsTable 
} from '../../../db/schema';
import { eq, desc } from 'drizzle-orm';
import { useTranslations } from '../../../utils/i18n';
import '../../../styles/admin.css';

// 1. Session verification
const session = getSession(Astro.cookies);
if (!session || session.username !== 'super') {
  return Astro.redirect('/admin/login');
}

// 2. Query all tickets with vendor and user details
const ticketsList = await db
  .select({
    id: ticketsTable.id,
    title: ticketsTable.title,
    status: ticketsTable.status,
    messages: ticketsTable.messages,
    seenByVendor: ticketsTable.seenByVendor,
    seenBySuper: ticketsTable.seenBySuper,
    createdAt: ticketsTable.createdAt,
    updatedAt: ticketsTable.updatedAt,
    vendorName: vendorsTable.name,
    vendorSlug: vendorsTable.slug,
    userName: usersTable.name,
    userUsername: usersTable.username
  })
  .from(ticketsTable)
  .innerJoin(vendorsTable, eq(ticketsTable.vendorId, vendorsTable.id))
  .innerJoin(usersTable, eq(ticketsTable.userId, usersTable.id))
  .orderBy(desc(ticketsTable.updatedAt));

const { t, locale, dir } = useTranslations(Astro.cookies, Astro.request);
---

<Layout title={`${t('ticketsTitle')}`} description={t('ticketsDesc')}>
  <div class="admin-layout-container" style={`direction: ${dir};`}>
    <!-- Mobile Header -->
    <header class="admin-mobile-header">
      <button class="hamburger-btn" id="mobile-nav-toggle" aria-label={t('navigationMenu')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="nav-icon-svg">
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
      </button>
      <span class="mobile-page-title">{t('systemSupport')}</span>
      <div class="mobile-header-avatar">
        {session.name.substring(0, 1)}
      </div>
    </header>

    <!-- Navigation Backdrop (Mobile) -->
    <div class="admin-sidenav-backdrop" id="sidenav-backdrop"></div>

    <!-- Super Admin Navigation Sidebar -->
    <aside class="admin-sidenav" id="admin-sidenav">
      <div class="platform-brand">
        <img src="/logo.png" alt="shottt" class="platform-logo-img" />
        
        <!-- Brand small language switcher -->
        <div class="lang-dropdown-container">
          <button type="button" class="brand-lang-trigger" id="brand-lang-trigger" aria-haspopup="listbox" aria-expanded="false">
            <span>{locale.toUpperCase()}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="lang-dropdown-menu" id="brand-lang-menu">
            <button type="button" class={`lang-dropdown-item ${locale === 'fa' ? 'active' : ''}`} data-lang="fa">فارسی</button>
            <button type="button" class={`lang-dropdown-item ${locale === 'en' ? 'active' : ''}`} data-lang="en">English</button>
            <button type="button" class={`lang-dropdown-item ${locale === 'tr' ? 'active' : ''}`} data-lang="tr">Türkçe</button>
          </div>
        </div>
      </div>

      <div class="sidenav-header">
        <div class="brand-badge-wrapper">
          <div class="brand-avatar" style="background-color: #be123c;">
            {t('superLetter')}
          </div>
          <div class="brand-meta">
            <h2 class="brand-title-name">{t('superTitle')}</h2>
            <p class="brand-sub-title">{t('superSubTitle')}</p>
          </div>
        </div>
        <button class="btn-icon mobile-close-nav-btn" id="mobile-nav-close" aria-label={t('cancel')}>✕</button>
      </div>

      <nav class="sidenav-menu">
        <a href="/admin/super" class="sidenav-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
            <rect x="3" y="3" width="7" height="9" />
            <rect x="14" y="3" width="7" height="5" />
            <rect x="14" y="12" width="7" height="9" />
            <rect x="3" y="16" width="7" height="5" />
          </svg>
          <span>{t('vendors')}</span>
        </a>

        <a href="/admin/super?tab=users" class="sidenav-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
          <span>{t('users')}</span>
        </a>

        <a id="sidenav-tickets-link" href="/admin/super/tickets" class="sidenav-link active">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
          </svg>
          <span>{t('supportTickets')}</span>
        </a>

        <div class="menu-divider"></div>

        <a href="/admin" class="sidenav-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-svg">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          <span>{t('backToPersonalDashboard')}</span>
        </a>
      </nav>

      <div class="sidenav-footer">


        <div class="user-meta-badge">
          <div class="user-avatar" style="background-color: #e5e5e5; color: #171717;">
            {session.name.substring(0, 1)}
          </div>
          <div class="user-text-info">
            <span class="user-name-bold">{session.name}</span>
            <span class="user-role-label">{t('superAdminLabel')}</span>
          </div>
        </div>

        <a href="/api/auth/logout" class="sidenav-footer-link logout-link" style="margin-top: 0.5rem;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="footer-icon-svg">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          <span>{t('logout')}</span>
        </a>
      </div>
    </aside>

    <!-- Main Workspace Content -->
    <div class="admin-workspace" style="width: 100%; padding: 2.5rem 1.5rem;">
      <div class="admin-page-actions">
        <h1 class="page-title-bold">{t('manageTickets')}</h1>
        
        <!-- Filter Pills -->
        <div class="status-filter-pills" id="filter-pills-container">
          <button class="filter-pill active" data-filter="all">{t('filterAll')}</button>
          <button class="filter-pill" data-filter="open">{t('filterOpen')}</button>
          <button class="filter-pill" data-filter="answered">{t('filterAnswered')}</button>
          <button class="filter-pill" data-filter="closed">{t('filterClosed')}</button>
        </div>
      </div>

      <!-- Tickets Split Workspace -->
      <div class="tickets-workspace-container" id="tickets-workspace">
        <!-- Left Pane: Tickets List -->
        <div class="tickets-list-pane">
          <div class="tickets-list-scroll">
            {ticketsList.length === 0 ? (
              <div class="empty-tickets-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="empty-icon">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
                <span>{t('noTicketsFound')}</span>
              </div>
            ) : (
              ticketsList.map((ticket) => {
                const formattedDate = new Date(ticket.updatedAt).toLocaleDateString(locale === 'fa' ? 'fa-IR' : (locale === 'tr' ? 'tr-TR' : 'en-US'), {
                  hour: '2-digit',
                  minute: '2-digit',
                  month: 'short',
                  day: 'numeric'
                });

                let statusText = t('filterOpen');
                let statusClass = 'status-open';
                if (ticket.status === 'answered') {
                  statusText = t('filterAnswered');
                  statusClass = 'status-answered';
                } else if (ticket.status === 'closed') {
                  statusText = t('filterClosed');
                  statusClass = 'status-closed';
                }

                return (
                  <div class="ticket-list-item" data-id={ticket.id} data-status={ticket.status} data-ticket={JSON.stringify(ticket)}>
                    <div class="ticket-item-top">
                      <span class="ticket-item-title">{ticket.title}</span>
                      <span class={`status-badge ${statusClass}`}>{statusText}</span>
                    </div>
                    <div style="font-size: 0.6875rem; color: #171717; margin-top: 0.125rem; font-weight: 500;">
                      {t('vendorLabel')}{ticket.vendorName} ({ticket.userName})
                    </div>
                    <div class="ticket-item-bottom" style="margin-top: 0.25rem;">
                       <span class="ticket-item-date local-ticket-date" data-date={ticket.updatedAt ? new Date(ticket.updatedAt).toISOString() : ''}>{formattedDate}</span>
                       <span class="ticket-item-preview">
                        {ticket.messages[ticket.messages.length - 1]?.message || ''}
                      </span>
                    </div>
                  </div>
                );
              })
            )}
          </div>
        </div>

        <!-- Right Pane: Chat Thread -->
        <div class="tickets-chat-pane empty" id="chat-pane">
          <div class="chat-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="chat-placeholder-icon">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 8v4M12 16h.01" />
            </svg>
            <span>{t('selectTicketPlaceholder')}</span>
          </div>

          <div class="active-chat-container" style="display: none;" id="chat-container">
            <!-- Chat Header -->
            <div class="chat-header">
              <div class="chat-header-right">
                <button class="btn-icon mobile-back-btn" id="btn-chat-back" title="Back">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1.25rem; height: 1.25rem;">
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </button>
                <div class="chat-title-info">
                  <h3 class="chat-title" id="active-ticket-title">-</h3>
                  <div class="chat-subtitle">
                    <span>{t('ticketIdLabel')}</span><code id="active-ticket-id">#</code>
                    <span class="dot-separator">•</span>
                    <span>{t('vendorLabel')}</span><strong id="active-ticket-vendor">-</strong>
                  </div>
                </div>
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <select id="select-active-status" class="form-select" style="font-size: 0.75rem; padding: 0.35rem 2rem 0.35rem 0.75rem; width: auto; border-radius: 0.5rem; height: auto; min-height: unset; background-position: left 0.5rem center;">
                  <option value="open">{t('filterOpen')}</option>
                  <option value="answered">{t('filterAnswered')}</option>
                  <option value="closed">{t('filterClosed')}</option>
                </select>
              </div>
            </div>

            <!-- Scrollable Messages Area -->
            <div class="chat-messages-body" id="chat-messages-box"></div>

            <!-- Chat Input Form -->
            <form class="chat-input-footer" id="form-chat-reply">
              <div class="attachment-preview-bar" id="attachment-preview" style="display: none;">
                <div class="preview-img-wrapper">
                  <img id="img-preview-src" src="" alt="preview" />
                  <button type="button" class="btn-remove-preview" id="btn-clear-attachment" title={t('errorAttachment')}>✕</button>
                </div>
              </div>

              <div class="chat-input-wrapper">
                <label class="btn-icon btn-attach" title={t('attachmentLabel')}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.25rem; height: 1.25rem;">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <polyline points="21 15 16 10 5 21" />
                  </svg>
                  <input type="file" id="input-reply-file" accept="image/*" class="visually-hidden" />
                </label>
                
                <textarea 
                  id="textarea-reply-message" 
                  placeholder={t('typeReplyPlaceholder')} 
                  required 
                  rows="1"
                ></textarea>
                
                <button type="submit" class="btn btn-primary btn-chat-send" id="btn-send-reply">
                  <span>{t('btnSendReply')}</span>
                  <svg class="spinner" id="reply-spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none; width: 0.875rem; height: 0.875rem; animation: rotate 1.5s linear infinite; margin-right: 0.25rem;">
                    <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                    <path d="M4 12a8 8 0 0 1 8-8"></path>
                  </svg>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- LIGHTBOX: FULL IMAGE PREVIEW -->
  <div id="image-lightbox" class="lightbox-overlay" style="display: none;">
    <button type="button" class="lightbox-close" id="btn-close-lightbox">✕</button>
    <img id="lightbox-img" src="" alt={t('attachmentZoomed')} />
  </div>
</Layout>

<style is:global>
  /* Force Estedad font on all elements in the super-admin support panel */
  .admin-layout-container, 
  .admin-layout-container * {
    font-family: 'Estedad', system-ui, -apple-system, sans-serif !important;
  }
</style>

<style is:global>
  /* Status Filters */
  .status-filter-pills {
    display: flex;
    gap: 0.375rem;
  }

  .filter-pill {
    background-color: #f5f5f5;
    color: #525252;
    border: 1px solid #e5e5e5;
    padding: 0.375rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-pill:hover {
    background-color: #e5e5e5;
    color: #171717;
  }

  .filter-pill.active {
    background-color: #171717;
    color: #ffffff;
    border-color: #171717;
  }

  /* Ticketing split workspace CSS (copied and refined from vendor tickets) */
  .tickets-workspace-container {
    display: grid;
    grid-template-columns: 20rem 1fr;
    gap: 0;
    height: 70vh;
    min-height: 520px;
    background: #ffffff;
    border: 1px solid #f0f0f0;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.01);
    margin-top: 1rem;
  }

  .tickets-list-pane {
    border-left: 1px solid #f0f0f0;
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #ffffff;
  }

  .tickets-list-scroll {
    flex-grow: 1;
    overflow-y: auto;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .empty-tickets-state {
    padding: 3rem 1rem;
    text-align: center;
    color: #a3a3a3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }

  .empty-icon {
    width: 2.25rem;
    height: 2.25rem;
    color: #cbd5e1;
  }

  .ticket-list-item {
    padding: 1rem;
    border: 1px solid #f0f0f0;
    border-radius: 0.875rem;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    text-align: right;
  }

  .ticket-list-item:hover {
    border-color: #d4d4d4;
    background-color: #fafafa;
  }

  .ticket-list-item.active {
    border-color: #171717;
    background-color: #fafafa;
    box-shadow: 0 0 0 1px #171717;
  }

  .ticket-item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .ticket-item-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #171717;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .status-badge {
    font-size: 0.625rem;
    font-weight: 600;
    padding: 0.15rem 0.4rem;
    border-radius: 9999px;
    white-space: nowrap;
  }

  .status-open {
    background-color: #fef3c7;
    color: #b45309;
  }

  .status-answered {
    background-color: #dbeafe;
    color: #1d4ed8;
  }

  .status-closed {
    background-color: #f3f4f6;
    color: #4b5563;
  }

  .ticket-item-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: #737373;
    gap: 1rem;
  }

  .ticket-item-date {
    flex-shrink: 0;
  }

  .ticket-item-preview {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 400;
  }

  .tickets-chat-pane {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    background-color: #fafafa;
  }

  .tickets-chat-pane.empty {
    justify-content: center;
    align-items: center;
  }

  .tickets-chat-pane:not(.empty) .chat-placeholder {
    display: none;
  }

  .chat-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: #a3a3a3;
    font-size: 0.8125rem;
  }

  .chat-placeholder-icon {
    width: 3rem;
    height: 3rem;
    color: #cbd5e1;
  }

  .active-chat-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    background-color: #fafafa;
  }

  .chat-header {
    background-color: #ffffff;
    border-bottom: 1px solid #f0f0f0;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .chat-header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-back-btn {
    display: none;
  }

  .chat-title-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    text-align: right;
  }

  .chat-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #171717;
  }

  .chat-subtitle {
    font-size: 0.6875rem;
    color: #737373;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .dot-separator {
    color: #cbd5e1;
  }

  .chat-messages-body {
    flex-grow: 1;
    overflow-y: auto;
    min-height: 0; /* Constraints height to force scroll bar */
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    scroll-behavior: smooth;
  }

  .chat-msg-row {
    display: flex;
    width: 100%;
  }

  .chat-msg-row.sent {
    justify-content: flex-start; /* Right in RTL (For Super admin, Sent means sent by Super, i.e. super is right bubble) */
  }

  .chat-msg-row.received {
    justify-content: flex-end; /* Left in RTL (For Super admin, Received means from vendor manager, i.e. user is left bubble) */
  }

  .chat-msg-bubble {
    max-width: 70%;
    padding: 0.875rem 1rem;
    border-radius: 1.125rem;
    position: relative;
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    text-align: right;
  }

  .sent .chat-msg-bubble {
    background-color: #171717;
    color: #ffffff;
    border-top-right-radius: 0.25rem;
  }

  .received .chat-msg-bubble {
    background-color: #ffffff;
    color: #171717;
    border-top-left-radius: 0.25rem;
    border: 1px solid #f0f0f0;
  }

  .chat-msg-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.125rem;
  }

  .chat-msg-sender {
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .sent .chat-msg-sender {
    color: #a3a3a3;
  }

  .received .chat-msg-sender {
    color: #171717;
  }

  .support-badge {
    background-color: #ffe4e6;
    color: #9f1239;
    font-size: 0.5625rem;
    font-weight: 600;
    padding: 0.05rem 0.3rem;
    border-radius: 9999px;
    margin-right: 0.25rem;
  }

  .chat-msg-time {
    font-size: 0.625rem;
  }

  .sent .chat-msg-time {
    color: #737373;
  }

  .received .chat-msg-time {
    color: #a3a3a3;
  }

  .chat-msg-text {
    font-size: 0.8125rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .chat-msg-attachment {
    margin-top: 0.375rem;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
    cursor: pointer;
    background-color: #fafafa;
    display: inline-block;
    max-width: 120px;
  }

  .chat-msg-attachment img {
    width: 120px;
    height: 90px;
    object-fit: cover;
    display: block;
    transition: transform 0.2s ease;
  }

  .chat-msg-attachment img:hover {
    transform: scale(1.02);
  }

  .chat-input-footer {
    background-color: #ffffff;
    border-top: 1px solid #f0f0f0;
    padding: 0.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .attachment-preview-bar {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f5f5f5;
  }

  .preview-img-wrapper {
    position: relative;
    width: 60px;
    height: 60px;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid #e5e5e5;
  }

  .preview-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .btn-remove-preview {
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    border: none;
    background-color: rgba(0, 0, 0, 0.7);
    color: #ffffff;
    font-size: 0.625rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-attach {
    cursor: pointer;
    background-color: #f5f5f5;
    color: #737373;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .btn-attach:hover {
    background-color: #e5e5e5;
    color: #171717;
  }

  .chat-input-wrapper textarea {
    flex-grow: 1;
    border: 1px solid #e5e5e5;
    border-radius: 0.75rem;
    background-color: #fafafa;
    padding: 0.625rem 0.875rem;
    font-size: 0.8125rem;
    outline: none;
    resize: none;
    max-height: 80px;
    min-height: 38px;
    font-family: inherit;
    line-height: 1.5;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .chat-input-wrapper textarea:focus {
    border-color: #171717;
    background-color: #ffffff;
  }

  .btn-chat-send {
    padding: 0.625rem 1.25rem;
    height: 38px;
    flex-shrink: 0;
  }

  .lightbox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(5px);
    z-index: 150;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .lightbox-img {
    max-width: 95vw;
    max-height: 90vh;
    border-radius: 0.5rem;
    object-fit: contain;
    animation: zoomInLightbox 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes zoomInLightbox {
    from { transform: scale(0.95); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background: rgba(255,255,255,0.1);
    border: none;
    color: #ffffff;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    font-size: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .lightbox-close:hover {
    background: rgba(255,255,255,0.25);
  }

  @keyframes rotate {
    100% { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .tickets-workspace-container {
      grid-template-columns: 1fr;
      height: 75vh;
    }

    .tickets-list-pane {
      display: flex;
    }

    .tickets-chat-pane {
      display: none;
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 10;
      height: 100%;
    }

    .tickets-workspace-container.chat-active .tickets-list-pane {
      display: none;
    }

    .tickets-workspace-container.chat-active .tickets-chat-pane {
      display: flex;
    }

    .mobile-back-btn {
      display: flex;
      margin-left: 0.5rem;
    }
  }

  /* LTR overrides for super admin support panel */
  [dir="ltr"] .tickets-workspace-container {
    direction: ltr;
  }
  [dir="ltr"] .tickets-list-pane {
    border-left: none;
    border-right: 1px solid #f0f0f0;
  }
  [dir="ltr"] .ticket-list-item {
    text-align: left;
  }
  [dir="ltr"] .chat-title-info {
    text-align: left;
  }
  [dir="ltr"] .chat-msg-bubble {
    text-align: left;
  }
  [dir="ltr"] .sent .chat-msg-bubble {
    border-top-right-radius: 1.125rem;
    border-top-left-radius: 0.25rem;
  }
  [dir="ltr"] .received .chat-msg-bubble {
    border-top-left-radius: 1.125rem;
    border-top-right-radius: 0.25rem;
  }
  [dir="ltr"] .chat-msg-row.sent {
    justify-content: flex-end;
  }
  [dir="ltr"] .chat-msg-row.received {
    justify-content: flex-start;
  }
  [dir="ltr"] .mobile-back-btn svg {
    transform: rotate(180deg);
  }
  [dir="ltr"] .form-select {
    background-position: right 0.5rem center;
  }
</style>

<script define:vars={{ locale, clientTranslations: {
  ticketStatusOpen: t('ticketStatusOpen'),
  ticketStatusAnswered: t('ticketStatusAnswered'),
  ticketStatusClosed: t('ticketStatusClosed'),
  systemSupport: t('systemSupport'),
  uploadError: t('uploadError'),
  errorServerConnection: t('errorServerConnection'),
  replyError: t('replyError'),
  errorTicketStatusUpdate: t('errorTicketStatusUpdate'),
  ticketStatusUpdatedSuccess: t('ticketStatusUpdatedSuccess')
} }}>
  // Script manages super admin ticket controls, message replies, status toggling, and client filters
  const workspace = document.getElementById('tickets-workspace');
  const chatPane = document.getElementById('chat-pane');
  const chatContainer = document.getElementById('chat-container');
  const listItems = document.querySelectorAll('.ticket-list-item');
  const filterPills = document.querySelectorAll('.filter-pill');

  // Helper to format ticket dates
  function formatTicketDate(date) {
    if (locale === 'fa') {
      return date.toLocaleDateString('fa-IR', {
        hour: '2-digit',
        minute: '2-digit',
        month: 'short',
        day: 'numeric'
      });
    } else {
      return date.toLocaleDateString(locale === 'tr' ? 'tr-TR' : 'en-US', {
        hour: '2-digit',
        minute: '2-digit',
        month: 'short',
        day: 'numeric'
      });
    }
  }

  // Localize dates on page load
  document.querySelectorAll('.local-ticket-date').forEach((el) => {
    const dateStr = el.getAttribute('data-date');
    if (dateStr) {
      el.textContent = formatTicketDate(new Date(dateStr));
    }
  });

  let activeTicketId = null;
  let activeTicketData = null;

  // Attachment elements
  const replyFileInput = document.getElementById('input-reply-file');
  const replyPreviewBar = document.getElementById('attachment-preview');
  const replyPreviewImg = document.getElementById('img-preview-src');
  const replyClearBtn = document.getElementById('btn-clear-attachment');
  let replyAttachmentUrl = null;

  // Detail pane elements
  const activeTicketTitle = document.getElementById('active-ticket-title');
  const activeTicketIdCode = document.getElementById('active-ticket-id');
  const activeTicketVendor = document.getElementById('active-ticket-vendor');
  const selectActiveStatus = document.getElementById('select-active-status');
  const chatMessagesBox = document.getElementById('chat-messages-box');
  const replyForm = document.getElementById('form-chat-reply');
  const btnSendReply = document.getElementById('btn-send-reply');
  const replySpinner = document.getElementById('reply-spinner');
  const textareaReply = document.getElementById('textarea-reply-message');

  // Lightbox elements
  const imageLightbox = document.getElementById('image-lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const btnCloseLightbox = document.getElementById('btn-close-lightbox');

  // Auto-resize reply box
  textareaReply?.addEventListener('input', () => {
    textareaReply.style.height = 'auto';
    textareaReply.style.height = `${Math.min(textareaReply.scrollHeight, 80)}px`;
  });

  // Client-side status filtering
  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');

      const filter = pill.getAttribute('data-filter') || 'all';
      listItems.forEach((item) => {
        const itemStatus = item.getAttribute('data-status');
        if (filter === 'all' || itemStatus === filter) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });

  // Open Chat listener
  listItems.forEach(item => {
    item.addEventListener('click', () => {
      listItems.forEach(i => i.classList.remove('active'));
      item.classList.add('active');

      const ticketData = JSON.parse(item.getAttribute('data-ticket') || '{}');
      openTicketChat(ticketData);
    });
  });

  function openTicketChat(ticket) {
    activeTicketId = ticket.id;
    activeTicketData = ticket;

    // Mark as seen/read
    if (!ticket.seenBySuper) {
      fetch('/api/tickets/seen', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ticketId: ticket.id })
      }).then(res => res.json()).then(data => {
        if (data.success) {
          ticket.seenBySuper = true;
          const listItem = document.querySelector(`.ticket-list-item[data-id="${ticket.id}"]`);
          if (listItem) {
            const tData = JSON.parse(listItem.getAttribute('data-ticket') || '{}');
            tData.seenBySuper = true;
            listItem.setAttribute('data-ticket', JSON.stringify(tData));
          }
          refreshSidenavDot();
        }
      }).catch(err => console.error('Error marking seen:', err));
    }

    workspace?.classList.add('chat-active');
    chatPane?.classList.remove('empty');
    if (chatContainer) chatContainer.style.display = 'flex';

    if (activeTicketTitle) activeTicketTitle.textContent = ticket.title;
    if (activeTicketIdCode) activeTicketIdCode.textContent = `#${ticket.id}`;
    if (activeTicketVendor) {
      activeTicketVendor.textContent = `${ticket.vendorName} (${ticket.userName})`;
    }

    if (selectActiveStatus) {
      selectActiveStatus.value = ticket.status;
    }

    renderMessages(ticket.messages);
    clearReplyAttachment();
  }

  function renderMessages(messages) {
    if (!chatMessagesBox) return;
    chatMessagesBox.innerHTML = '';

    messages.forEach((msg) => {
      const dateText = formatTicketDate(new Date(msg.createdAt));

      // Determine sender layout:
      // For Super admin panel, Sent (right) means sent by super admin. Received (left) means sent by vendor user.
      const isSuper = msg.senderUsername === 'super';
      const rowClass = isSuper ? 'sent' : 'received';
      const senderLabel = msg.senderName || msg.senderUsername;
      const systemSupportLabel = clientTranslations.systemSupport;
      const supportBadgeHtml = isSuper ? `<span class="support-badge">${systemSupportLabel}</span>` : '';

      let attachmentHtml = '';
      if (msg.attachmentUrl) {
        attachmentHtml = `
          <div class="chat-msg-attachment" data-url="${msg.attachmentUrl}">
            <img src="${msg.attachmentUrl}" alt="Attachment" loading="lazy" />
          </div>
        `;
      }

      const msgHtml = `
        <div class="chat-msg-row ${rowClass}">
          <div class="chat-msg-bubble">
            <div class="chat-msg-header">
              <span class="chat-msg-sender">${senderLabel} ${supportBadgeHtml}</span>
              <span class="chat-msg-time">${dateText}</span>
            </div>
            <div class="chat-msg-text">${escapeHtml(msg.message)}</div>
            ${attachmentHtml}
          </div>
        </div>
      `;
      chatMessagesBox.insertAdjacentHTML('beforeend', msgHtml);
    });

    // Attachment clicks
    chatMessagesBox.querySelectorAll('.chat-msg-attachment').forEach(box => {
      box.addEventListener('click', () => {
        const url = box.getAttribute('data-url');
        if (url && imageLightbox && lightboxImg) {
          lightboxImg.src = url;
          imageLightbox.style.display = 'flex';
        }
      });
    });

    chatMessagesBox.scrollTop = chatMessagesBox.scrollHeight;
  }

  function escapeHtml(str) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Mobile Back Button
  document.getElementById('btn-chat-back')?.addEventListener('click', () => {
    workspace?.classList.remove('chat-active');
  });

  // Reply Image attachment handlers
  replyFileInput?.addEventListener('change', async () => {
    const file = replyFileInput.files?.[0];
    if (!file) return;

    replyPreviewImg.src = URL.createObjectURL(file);
    if (replyPreviewBar) replyPreviewBar.style.display = 'block';

    const formData = new FormData();
    formData.append('file', file);

    try {
      if (btnSendReply) btnSendReply.disabled = true;
      const res = await fetch('/api/tickets/upload', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      if (res.ok && data.success) {
        replyAttachmentUrl = data.url;
      } else {
        await window.showAlertDialog(data.message || clientTranslations.uploadError, { type: 'error' });
        clearReplyAttachment();
      }
    } catch {
      await window.showAlertDialog(clientTranslations.errorServerConnection, { type: 'error' });
      clearReplyAttachment();
    } finally {
      if (btnSendReply) btnSendReply.disabled = false;
    }
  });

  replyClearBtn?.addEventListener('click', clearReplyAttachment);

  function clearReplyAttachment() {
    replyAttachmentUrl = null;
    if (replyFileInput) replyFileInput.value = '';
    if (replyPreviewBar) replyPreviewBar.style.display = 'none';
  }

  // Send Reply Action
  replyForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const textVal = textareaReply.value.trim();
    if (!textVal || !activeTicketId) return;

    if (btnSendReply) btnSendReply.disabled = true;
    if (replySpinner) replySpinner.style.display = 'inline-block';

    try {
      const response = await fetch('/api/tickets/reply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ticketId: activeTicketId,
          message: textVal,
          attachmentUrl: replyAttachmentUrl || undefined
        })
      });

      const data = await response.json();
      if (response.ok && data.success) {
        textareaReply.value = '';
        textareaReply.style.height = 'auto';

        activeTicketData.messages = data.messages;
        activeTicketData.status = data.status; // should be 'answered'

        // Update active dropdown status
        if (selectActiveStatus) selectActiveStatus.value = data.status;

        // Update list item
        const listItem = document.querySelector(`.ticket-list-item[data-id="${activeTicketId}"]`);
        if (listItem) {
          listItem.setAttribute('data-ticket', JSON.stringify(activeTicketData));
          listItem.setAttribute('data-status', data.status);
          
          const preview = listItem.querySelector('.ticket-item-preview');
          if (preview) preview.textContent = textVal;

          const badge = listItem.querySelector('.status-badge');
          if (badge) {
            badge.className = 'status-badge status-answered';
            badge.textContent = clientTranslations.ticketStatusAnswered;
          }

          const dateEl = listItem.querySelector('.ticket-item-date');
          if (dateEl) {
            const now = new Date();
            dateEl.textContent = formatTicketDate(now);
            dateEl.setAttribute('data-date', now.toISOString());
          }
        }

        renderMessages(data.messages);
        clearReplyAttachment();
      } else {
        await window.showAlertDialog(data.message || clientTranslations.replyError, { type: 'error' });
      }
    } catch {
      await window.showAlertDialog(clientTranslations.errorServerConnection, { type: 'error' });
    } finally {
      if (btnSendReply) btnSendReply.disabled = false;
      if (replySpinner) replySpinner.style.display = 'none';
    }
  });

  // Change Ticket Status Dropdown Action
  selectActiveStatus?.addEventListener('change', async () => {
    if (!activeTicketId) return;
    const newStatus = selectActiveStatus.value;

    try {
      const response = await fetch('/api/tickets/status', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ticketId: activeTicketId,
          status: newStatus
        })
      });

      const data = await response.json();
      if (response.ok && data.success) {
        // Update local object
        activeTicketData.status = newStatus;

        // Update list item status
        const listItem = document.querySelector(`.ticket-list-item[data-id="${activeTicketId}"]`);
        if (listItem) {
          listItem.setAttribute('data-ticket', JSON.stringify(activeTicketData));
          listItem.setAttribute('data-status', newStatus);

          const badge = listItem.querySelector('.status-badge');
          if (badge) {
            badge.className = 'status-badge';
            if (newStatus === 'answered') {
              badge.classList.add('status-answered');
              badge.textContent = clientTranslations.ticketStatusAnswered;
            } else if (newStatus === 'closed') {
              badge.classList.add('status-closed');
              badge.textContent = clientTranslations.ticketStatusClosed;
            } else {
              badge.classList.add('status-open');
              badge.textContent = clientTranslations.ticketStatusOpen;
            }
          }

          const dateEl = listItem.querySelector('.ticket-item-date');
          if (dateEl) {
            const now = new Date();
            dateEl.textContent = formatTicketDate(now);
            dateEl.setAttribute('data-date', now.toISOString());
          }
        }

        // Apply filters in case status filter is active
        const activeFilterPill = document.querySelector('.filter-pill.active');
        if (activeFilterPill) {
          activeFilterPill.dispatchEvent(new Event('click'));
        }

        await window.showAlertDialog(data.message || clientTranslations.ticketStatusUpdatedSuccess, { type: 'success' });
      } else {
        await window.showAlertDialog(data.message || clientTranslations.errorTicketStatusUpdate, { type: 'error' });
        // Revert dropdown value
        selectActiveStatus.value = activeTicketData.status;
      }
    } catch {
      await window.showAlertDialog(clientTranslations.errorServerConnection, { type: 'error' });
      selectActiveStatus.value = activeTicketData.status;
    }
  });

  // Lightbox Close
  btnCloseLightbox?.addEventListener('click', () => {
    if (imageLightbox) imageLightbox.style.display = 'none';
  });
  imageLightbox?.addEventListener('click', (e) => {
    if (e.target === imageLightbox) {
      imageLightbox.style.display = 'none';
    }
  });

  function refreshSidenavDot() {
    const ticketsLink = document.getElementById('sidenav-tickets-link');
    if (!ticketsLink) return;
    
    fetch('/api/tickets/unread')
      .then(res => res.json())
      .then(data => {
        const dot = ticketsLink.querySelector('.sidenav-unread-dot');
        if (data.success && data.hasUnread) {
          if (!dot) {
            const newDot = document.createElement('span');
            newDot.className = 'sidenav-unread-dot';
            newDot.style.cssText = 'width: 8px; height: 8px; background-color: #ef4444; border-radius: 50%; margin-right: auto;';
            ticketsLink.appendChild(newDot);
          }
        } else {
          if (dot) dot.remove();
        }
      })
      .catch(err => console.error('Error checking unread status:', err));
  }

  // Brand Header Small Language Switcher Logic
  const brandLangTrigger = document.getElementById('brand-lang-trigger');
  const brandLangMenu = document.getElementById('brand-lang-menu');
  const brandLangItems = document.querySelectorAll('#brand-lang-menu .lang-dropdown-item');

  brandLangTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = brandLangTrigger.getAttribute('aria-expanded') === 'true';
    brandLangTrigger.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
    brandLangMenu?.classList.toggle('show');
  });

  document.addEventListener('click', (e) => {
    if (brandLangTrigger && brandLangMenu && !brandLangTrigger.contains(e.target) && !brandLangMenu.contains(e.target)) {
      brandLangTrigger.setAttribute('aria-expanded', 'false');
      brandLangMenu.classList.remove('show');
    }
  });

  brandLangItems.forEach(item => {
    item.addEventListener('click', () => {
      const targetLang = item.getAttribute('data-lang');
      if (targetLang) {
        document.cookie = `lang=${targetLang}; path=/; max-age=31536000`;
        window.location.reload();
      }
    });
  });

  // Initial lazy check
  refreshSidenavDot();
</script>
