---
import Layout from '../layouts/Layout.astro';
import BrandHeader from '../components/BrandHeader.astro';
import CategoryNav from '../components/CategoryNav.astro';
import MenuLayout from '../components/MenuLayout.astro';
import { db } from '../db/db';
import { vendors as vendorsTable, categories as categoriesTable, menuItems as menuItemsTable } from '../db/schema';
import { eq, asc, and, ne } from 'drizzle-orm';

const vendorSlug = Astro.params.vendor;
if (!vendorSlug) {
  return new Response("Not Found", { status: 404 });
}

// Fetch the vendor from PostgreSQL
const vendorList = await db
  .select()
  .from(vendorsTable)
  .where(eq(vendorsTable.slug, vendorSlug))
  .limit(1);

if (vendorList.length === 0) {
  return new Response("Vendor Not Found", { status: 404 });
}

const vendor = vendorList[0];

// Fetch categories for this vendor sorted by sort_order (exclude inactive categories)
const dbCategories = await db
  .select()
  .from(categoriesTable)
  .where(
    and(
      eq(categoriesTable.vendorId, vendor.id),
      ne(categoriesTable.status, 'inactive')
    )
  )
  .orderBy(asc(categoriesTable.sortOrder));

// Fetch all menu items for the categories and map to UI schema
const categories = await Promise.all(
  dbCategories.map(async (category) => {
    const items = await db
      .select()
      .from(menuItemsTable)
      .where(
        and(
          eq(menuItemsTable.categoryId, category.id),
          ne(menuItemsTable.status, 'inactive')
        )
      )
      .orderBy(asc(menuItemsTable.sortOrder), asc(menuItemsTable.id));

    return {
      id: category.id.toString(),
      name: category.name,
      status: category.status,
      items: items.map((item) => ({
        id: item.id.toString(),
        name: item.name,
        slug: item.slug || undefined,
        price: item.price,
        image: item.image || undefined,
        description: item.description || undefined,
        discount: item.discount ? {
          originalPrice: item.discount.originalPrice,
          discountText: item.discount.discountText,
        } : undefined,
        span2: item.span2,
        sections: item.sections,
        status: (category.status === 'unavailable' || item.status === 'unavailable') ? 'unavailable' : item.status,
      })),
    };
  })
);
---

<Layout 
  title={`${vendor.name} — کاتالوگ دیجیتال`} 
  description={`${vendor.type} ${vendor.name} - ${vendor.slogan}. ${vendor.description}`}
  ogImage={vendor.coverImage}
>
  <main class="menu-main-wrapper" id="page-main" style="opacity: 0;">
    <!-- Brand Info Header -->
    <BrandHeader 
      name={vendor.name}
      type={vendor.type}
      slogan={vendor.slogan}
      logoIcon={vendor.logoIcon}
      logo={vendor.logo}
    />

    <!-- Frosted Glass Categories Sticky Bar -->
    <CategoryNav categories={categories} />

    <!-- Core Menu Items List (Pinterest Masonry or Compact List layout) -->
    <MenuLayout 
      categories={categories}
      layoutMode={vendor.defaultLayout as 'pinterest' | 'simple'}
      vendorSlug={vendor.slug}
    />

    <!-- Product Page Footer -->
    <footer class="product-page-footer" style="animation-delay: 0.15s;">
      <div class="footer-divider"></div>
      <a href="/" class="footer-platform-link">
        توسعه پیدا کرده با <span>shottt</span>
      </a>
    </footer>
  </main>
</Layout>

<style>
  .menu-main-wrapper {
    background-color: #FFFFFF;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-main-wrapper.page-ready {
    opacity: 1;
  }

  /* Product Page Footer Styles */
  .product-page-footer {
    margin-top: auto;
    padding: 3rem 0 1.5rem 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .footer-divider {
    width: 100%;
    height: 1px;
    background-color: #f5f5f5;
    margin-bottom: 0.5rem;
  }

  .footer-platform-link {
    font-size: 0.75rem;
    font-weight: 300;
    color: #a3a3a3;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-platform-link span {
    font-weight: 700;
    font-family: 'Outfit', sans-serif;
    color: #737373;
  }

  .footer-platform-link:hover {
    color: #171717;
  }
  
  .footer-platform-link:hover span {
    color: #171717;
  }
</style>

<script>
  // Wait for first images to load before revealing the page
  // This prevents the layout jump caused by images loading after content renders
  (function () {
    const main = document.getElementById('page-main');
    if (!main) return;

    // Collect the first few images visible in the viewport
    const allImgs = Array.from(main.querySelectorAll('img'));
    const firstImgs = allImgs.slice(0, 6); // Wait for up to 6 initial images

    function revealPage() {
      main.classList.add('page-ready');
    }

    if (firstImgs.length === 0) {
      // No images — reveal immediately with a short grace period
      setTimeout(revealPage, 80);
      return;
    }

    // Timeout fallback: reveal after 900ms no matter what
    const fallbackTimer = setTimeout(revealPage, 900);

    let loadedCount = 0;
    const needed = firstImgs.length;

    function onImageSettled() {
      loadedCount++;
      if (loadedCount >= needed) {
        clearTimeout(fallbackTimer);
        revealPage();
      }
    }

    firstImgs.forEach((img) => {
      if (img.complete) {
        onImageSettled();
      } else {
        img.addEventListener('load', onImageSettled, { once: true });
        img.addEventListener('error', onImageSettled, { once: true });
      }
    });
  })();
</script>
