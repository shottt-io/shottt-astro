---
import Layout from '../layouts/Layout.astro';
import BrandHeader from '../components/BrandHeader.astro';
import CategoryNav from '../components/CategoryNav.astro';
import MenuLayout from '../components/MenuLayout.astro';
import { db } from '../db/db';
import { vendors as vendorsTable, categories as categoriesTable, menuItems as menuItemsTable } from '../db/schema';
import { eq, asc, and, ne } from 'drizzle-orm';

const vendorSlug = Astro.params.vendor;
if (!vendorSlug) {
  return new Response("Not Found", { status: 404 });
}

// Fetch the vendor from PostgreSQL
const vendorList = await db
  .select()
  .from(vendorsTable)
  .where(eq(vendorsTable.slug, vendorSlug))
  .limit(1);

if (vendorList.length === 0) {
  return new Response("Vendor Not Found", { status: 404 });
}

const vendor = vendorList[0];

import { useTranslations } from '../utils/i18n';
const { t } = useTranslations(Astro.cookies, Astro.request, vendor.locale || undefined);

// Fetch categories for this vendor sorted by sort_order (exclude inactive categories)
const dbCategories = await db
  .select()
  .from(categoriesTable)
  .where(
    and(
      eq(categoriesTable.vendorId, vendor.id),
      ne(categoriesTable.status, 'inactive')
    )
  )
  .orderBy(asc(categoriesTable.sortOrder));

// Fetch all menu items for the categories and map to UI schema
const categories = await Promise.all(
  dbCategories.map(async (category) => {
    const items = await db
      .select()
      .from(menuItemsTable)
      .where(
        and(
          eq(menuItemsTable.categoryId, category.id),
          ne(menuItemsTable.status, 'inactive')
        )
      )
      .orderBy(asc(menuItemsTable.sortOrder), asc(menuItemsTable.id));

    return {
      id: category.id.toString(),
      name: category.name,
      status: category.status,
      items: items.map((item) => ({
        id: item.id.toString(),
        name: item.name,
        slug: item.slug || undefined,
        price: item.price,
        image: item.image || undefined,
        description: item.description || undefined,
        discount: item.discount ? {
          originalPrice: item.discount.originalPrice,
          discountText: item.discount.discountText,
        } : undefined,
        span2: item.span2,
        sections: item.sections,
        status: (category.status === 'unavailable' || item.status === 'unavailable') ? 'unavailable' : item.status,
      })),
    };
  })
);
---

<Layout 
  title={`${vendor.name} — ${t('digitalCatalog')}`} 
  description={`${vendor.type} ${vendor.name} - ${vendor.slogan}. ${vendor.description}`}
  ogImage={vendor.logo}
  favicon={vendor.logo}
  theme={vendor.theme}
  twitterCard="summary"
  localeOverride={vendor.locale || undefined}
>
  <main class="menu-main-wrapper" id="page-main" data-vendor-slug={vendor.slug}>
    <!-- Brand Info Header -->
    <BrandHeader 
      name={vendor.name}
      type={vendor.type}
      slogan={vendor.slogan}
      logoIcon={vendor.logoIcon}
      logo={vendor.logo}
    />

    <!-- Frosted Glass Categories Sticky Bar -->
    <CategoryNav categories={categories} />

    <!-- Core Menu Items List (Pinterest Masonry, Compact List, or Card layout) -->
    <MenuLayout 
      categories={categories}
      layoutMode={vendor.defaultLayout as 'pinterest' | 'simple' | 'card'}
      vendorSlug={vendor.slug}
      locale={vendor.locale || undefined}
    />

    <!-- Product Page Footer -->
    <footer class="product-page-footer" style="animation-delay: 0.15s;">
      <div class="footer-divider"></div>
      <a href="/" class="footer-platform-link">
        {t('developedWith')}
        <img src="/logo.png" alt="shottt" class="footer-logo-img" />
      </a>
    </footer>
  </main>

  <!-- Client-side Analytics Tracker Script -->
  <script is:inline>
    (function() {
      // Safety Check: Exit silently if essential browser APIs are missing (e.g. old browsers or crawlers)
      if (typeof window === 'undefined' || typeof window.IntersectionObserver === 'undefined' || typeof window.fetch === 'undefined') {
        return;
      }

      // 1. Get vendor slug from main container
      const pageMain = document.getElementById('page-main');
      if (!pageMain) return;
      const vendorSlug = pageMain.getAttribute('data-vendor-slug');
      if (!vendorSlug) return;

      // Safe localStorage wrapper
      const storage = {
        get(key) {
          try { return localStorage.getItem(key); } catch(e) { return null; }
        },
        set(key, val) {
          try { localStorage.setItem(key, val); } catch(e) {}
        },
        remove(key) {
          try { localStorage.removeItem(key); } catch(e) {}
        }
      };

      // 2. Initialize or retrieve the 1-hour session
      const SESSION_DURATION = 1 * 60 * 60 * 1000; // 1 hour in ms
      const sessionKey = 'shottt_session_id';
      const expiryKey = 'shottt_session_expiry';
      const visitKey = 'shottt_visit_sent_' + vendorSlug;
      const impressionsKey = 'shottt_sent_imps_' + vendorSlug;

      let sessionId = storage.get(sessionKey);
      let sessionExpiry = storage.get(expiryKey);
      
      const now = Date.now();

      if (!sessionId || !sessionExpiry || now > parseInt(sessionExpiry, 10)) {
        // Create new session
        sessionId = Math.random().toString(36).substring(2, 15);
        storage.set(sessionKey, sessionId);
        storage.set(expiryKey, (now + SESSION_DURATION).toString());
        storage.remove(visitKey);
        storage.remove(impressionsKey);
      }

      // 3. Track unique visit & total page view
      let pageView = true;
      let uniqueVisit = false;
      
      const visitSent = storage.get(visitKey);
      if (visitSent !== 'true') {
        uniqueVisit = true;
        storage.set(visitKey, 'true');
      }

      // 4. Track Impressions
      const getSentImpressions = () => {
        try {
          const data = storage.get(impressionsKey);
          return data ? JSON.parse(data) : [];
        } catch (e) {
          return [];
        }
      };

      const addSentImpression = (itemId) => {
        const list = getSentImpressions();
        if (!list.includes(itemId)) {
          list.push(itemId);
          storage.set(impressionsKey, JSON.stringify(list));
        }
      };

      // Queue and Batching variables
      let pendingPageView = pageView;
      let pendingUniqueVisit = uniqueVisit;
      const pendingImpressions = new Set();

      function sendBatch() {
        if (!pendingPageView && !pendingUniqueVisit && pendingImpressions.size === 0) {
          return;
        }

        const payload = {
          vendorSlug: vendorSlug,
          pageView: pendingPageView,
          uniqueVisit: pendingUniqueVisit,
          impressions: Array.from(pendingImpressions)
        };

        // Reset queue before sending to prevent duplicates in case of fast triggers
        pendingPageView = false;
        pendingUniqueVisit = false;
        pendingImpressions.clear();

        fetch('/api/analytics/track', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload),
          keepalive: true // Crucial to ensure request completes on page unload
        }).catch(err => console.error('Failed to send analytics batch:', err));
      }

      // Send batch every 10 seconds
      const batchInterval = setInterval(sendBatch, 10000);

      // Send batch when page is closed/hidden
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') {
          sendBatch();
        }
      });

      // 5. Setup IntersectionObserver for items
      const visibleTimeouts = new Map();

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const itemId = entry.target.getAttribute('data-item-id');
          if (!itemId) return;

          if (entry.isIntersecting) {
            // Set 800ms timer
            const timeoutId = setTimeout(() => {
              const sent = getSentImpressions();
              if (!sent.includes(itemId)) {
                pendingImpressions.add(itemId);
                addSentImpression(itemId);
                // Trigger batch send earlier if queue is large
                if (pendingImpressions.size >= 10) {
                  sendBatch();
                }
              }
            }, 800);
            visibleTimeouts.set(itemId, timeoutId);
          } else {
            // Cancel timer if it goes out of view before 800ms
            if (visibleTimeouts.has(itemId)) {
              clearTimeout(visibleTimeouts.get(itemId));
              visibleTimeouts.delete(itemId);
            }
          }
        });
      }, {
        threshold: 0.3 // 30% of item visible
      });

      // Observe all product card elements
      const observeItems = () => {
        const elements = document.querySelectorAll('[data-item-id]');
        elements.forEach(el => observer.observe(el));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', observeItems);
      } else {
        observeItems();
      }

      // Also support observing new elements if layout changes or lazy-loads
      if (typeof window.MutationObserver !== 'undefined') {
        const mutationObserver = new MutationObserver(() => {
          observeItems();
        });
        mutationObserver.observe(document.body, { childList: true, subtree: true });
      }
    })();
  </script>
</Layout>

<style>
  .menu-main-wrapper {
    background-color: var(--bg-primary, #FFFFFF);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    transition: background-color 0.3s ease;
  }

  /* Product Page Footer Styles */
  .product-page-footer {
    padding: 3rem 0 1.5rem 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 42rem;
    margin: auto auto 0 auto;
    box-sizing: border-box;
  }

  .footer-divider {
    width: 100%;
    height: 1px;
    background-color: var(--border-color, #f5f5f5);
    margin-bottom: 0.5rem;
  }

  .footer-platform-link {
    font-size: 0.8125rem;
    font-weight: 300;
    color: var(--text-secondary, #a3a3a3);
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-logo-img {
    width: 3.25rem;
    height: 3.25rem;
    object-fit: contain;
    border-radius: 0.75rem;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .footer-platform-link:hover {
    color: var(--text-primary, #171717);
  }

  .footer-platform-link:hover .footer-logo-img {
    opacity: 1;
  }
</style>


