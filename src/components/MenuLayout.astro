    font-weight: 400;
  }

  .price-container {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    margin-right: auto;
  }

  .price-tag {
    font-size: 0.75rem;
    font-weight: 400;
    color: #262626;
  }

  .text-left {
    justify-content: flex-end;
  }

  /* --- MODE B: ULTRA-COMPACT LIST VIEW --- */
  .compact-list {
    display: flex;
    flex-direction: column;
    padding: 0 1.25rem;
  }

  .list-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.625rem 0;
    border-bottom: 1px solid #f5f5f5;
    text-decoration: none;
    color: inherit;
  }

  .list-row:last-child {
    border-bottom: none;
  }

  .list-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0; /* Allow title to truncate */
    flex: 1 1 auto;
  }

  .mini-thumb-wrapper {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #f5f5f5;
    background-image: linear-gradient(90deg, #f5f5f5 0px, #fbfbfb 20px, #f5f5f5 40px);
    background-size: 200% 100%;
    animation: shimmer-pulse 1.6s infinite ease-in-out;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .mini-thumb-wrapper {
      width: 3.25rem;
      height: 3.25rem;
    }
  }

  .mini-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mini-thumb.loaded {
    opacity: 1;
  }

  .mini-fallback {
    min-height: 100%;
  }

  .mini-thumb-placeholder {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a3a3a3;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .mini-thumb-placeholder {
      width: 3.25rem;
      height: 3.25rem;
    }
  }

  .mini-placeholder-icon {
    width: 1rem;
    height: 1rem;
  }

  .list-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0; /* Allow title to truncate */
    flex: 1 1 auto;
    padding-left: 0.5rem;
  }

  .list-title {
    font-size: 0.8125rem;
    font-weight: 300;
    color: #171717;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .list-discount-badge {
    align-self: flex-start;
    background-color: #fff1f2;
    color: #9f1239;
    font-size: 0.5rem;
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
    font-weight: 400;
  }

  .list-left {
    flex-shrink: 0;
  }
</style>

<script>
  function balanceMasonryColumns() {
    const grids = document.querySelectorAll('.pinterest-grid');
    grids.forEach((grid) => {
      const columns = grid.querySelectorAll('.pinterest-column');
      if (columns.length < 2) return;
      
      const rightCol = columns[0];
      const leftCol = columns[1];
      
      // Save all existing cards from both columns
      const cards = Array.from(grid.querySelectorAll('.product-card'));
      if (cards.length === 0) return;

      // Sort cards to match their original SSR order
      cards.sort((a, b) => {
        const orderA = parseInt(a.getAttribute('data-sort-order') || '0');
        const orderB = parseInt(b.getAttribute('data-sort-order') || '0');
        return orderA - orderB;
      });
      
      // Measure all card heights first while they are fully rendered in the DOM
      const cardHeights = cards.map((card) => card.offsetHeight || 0);
      
      // Remove all cards from DOM temporarily to reset column heights to 0
      cards.forEach((card) => card.remove());
      
      // Distribute cards based on virtual accumulated heights (including column gaps)
      let rightHeight = 0;
      let leftHeight = 0;
      const gap = 20; // 1.25rem gap is 20px

      cards.forEach((card, index) => {
        // Remove animation class to prevent flickering/re-animating on shift
        card.classList.remove('animate-slide-up');
        
        const cardHeight = cardHeights[index];
        
        if (rightHeight <= leftHeight) {
          const currentCount = rightCol.childElementCount;
          rightCol.appendChild(card);
          rightHeight += cardHeight + (currentCount > 0 ? gap : 0);
        } else {
          const currentCount = leftCol.childElementCount;
          leftCol.appendChild(card);
          leftHeight += cardHeight + (currentCount > 0 ? gap : 0);
        }
      });
    });
  }

  let resizeTimeout = null;
  function debouncedBalance() {
    if (resizeTimeout) {
      clearTimeout(resizeTimeout);
    }
    resizeTimeout = setTimeout(balanceMasonryColumns, 10);
  }

  // Set up event listeners
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', balanceMasonryColumns);
  } else {
    balanceMasonryColumns();
  }

  window.addEventListener('load', balanceMasonryColumns);
  window.addEventListener('resize', debouncedBalance);
</script>

