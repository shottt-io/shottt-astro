  .product-image-full {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-image-full.loaded {
    opacity: 1;
  }

  .full-fallback {
    min-height: 15rem;
  }

  .no-image-wrapper-full {
    width: 100%;
    height: 12rem;
    background-color: #f5f5f5;
    border-radius: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a3a3a3;
  }

  .product-card {
    background-color: #FFFFFF;
    border-radius: 0;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    overflow: hidden;
    text-decoration: none; /* Reset anchor tag decoration */
    color: inherit;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    border-radius: 1.5rem;
    overflow: hidden;
    background: #f5f5f5;
    background-image: linear-gradient(90deg, #f5f5f5 0px, #fbfbfb 40px, #f5f5f5 80px);
    background-size: 200% 100%;
