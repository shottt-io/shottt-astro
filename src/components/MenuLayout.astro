  .no-image-wrapper {
    width: 100%;
    height: 8rem;
    background-color: #f5f5f5;
    border-radius: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a3a3a3;
  }

  .no-image-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .discount-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background-color: rgba(255, 255, 255, 0.95);
    color: #9f1239;
    font-size: 0.5rem;
    padding: 0.25rem 0.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(254, 226, 226, 0.4);
    font-weight: 400;
  }

  @media (min-width: 640px) {
