---
import type { Category, MenuItem } from '../data/vendors';
import SectionDivider from './SectionDivider.astro';

interface Props {
  categories: Category[];
  layoutMode: 'pinterest' | 'simple';
  vendorSlug: string;
}

const { categories, layoutMode, vendorSlug } = Astro.props;

// Layout block structure to support full-width spanning featured items
interface LayoutBlock {
  type: 'grid' | 'full';
  items: MenuItem[];
}

function getLayoutBlocks(items: MenuItem[]): LayoutBlock[] {
  const blocks: LayoutBlock[] = [];
  let currentGridItems: MenuItem[] = [];

  items.forEach((item) => {
    if (item.span2) {
      if (currentGridItems.length > 0) {
        blocks.push({ type: 'grid', items: currentGridItems });
        currentGridItems = [];
      }
      blocks.push({ type: 'full', items: [item] });
    } else {
      currentGridItems.push(item);
    }
  });

  if (currentGridItems.length > 0) {
    blocks.push({ type: 'grid', items: currentGridItems });
  }

  return blocks;
}

function getImageAspectRatio(imageUrl: string | undefined): string {
  if (!imageUrl) return '1';
  try {
    const url = new URL(imageUrl, 'http://localhost');
    const ratio = url.searchParams.get('ratio');
    if (ratio) {
      const parsed = parseFloat(ratio);
      if (!isNaN(parsed) && parsed > 0) {
        return parsed.toString();
      }
    }
  } catch (e) {}
  return '1';
}
---

<div class="menu-layout-container">
  {categories.map((category) => {
    const layoutBlocks = getLayoutBlocks(category.items);

    return (
      <section id={category.id} class="menu-section">
        <SectionDivider name={category.name} />

        {layoutMode === 'pinterest' ? (
          /* Mode A: Pinterest Masonry with Column Span 2 support */
          <div class="masonry-layout-blocks">
            {layoutBlocks.map((block) => {
              if (block.type === 'full') {
                const item = block.items[0];
                return (
                  <div class="full-width-block">
                    <a
                      href={`/${vendorSlug}/${item.slug || item.id}`}
                      class={`product-card-full animate-slide-up ${item.status === 'unavailable' ? 'is-unavailable' : ''}`}
                      data-item-id={item.id}
                    >
                      {item.image ? (
                        <div class="image-wrapper-full image-zoom-container">
                          <img
                            src={item.image}
                            alt={item.name}
                            class="product-image-full"
                            loading="lazy"
                            onload="this.classList.add('loaded')"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                          />
                          <div class="fallback-placeholder full-fallback" style="display: none;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="fallback-icon">
                              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                              <circle cx="8.5" cy="8.5" r="1.5" />
                              <polyline points="21 15 16 10 5 21" />
                            </svg>
                          </div>
                          {item.status === 'unavailable' ? (
                            <div class="status-badge-out-of-stock">
                              ناموجود
                            </div>
                          ) : item.discount && (
                            <div class="discount-badge">
                              {item.discount.discountText}
                            </div>
                          )}
                        </div>
                      ) : (
                        <div class="no-image-wrapper-full">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="no-image-icon">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                            <circle cx="8.5" cy="8.5" r="1.5" />
                            <polyline points="21 15 16 10 5 21" />
                          </svg>
                        </div>
                      )}
                      
                      <div class="product-details">
                        <h3 class="product-title title-full">{item.name}</h3>
                        <div class="price-container">
                          {item.discount ? (
                            <>
                              <span class="price-tag price-old">{item.discount.originalPrice}</span>
                              <span class="price-tag price-new">{item.price}</span>
                            </>
                          ) : (
                            <span class="price-tag">{item.price}</span>
                          )}
                        </div>
                      </div>
                    </a>
                  </div>
                );
              } else {
                const rightColItems = block.items.filter((_, i) => i % 2 === 0);
                const leftColItems = block.items.filter((_, i) => i % 2 !== 0);
                return (
                  <div class="pinterest-grid">
                    {/* Right Column */}
                    <div class="pinterest-column">
                      {rightColItems.map((item, index) => (
                        <a
                          href={`/${vendorSlug}/${item.slug || item.id}`}
                          class={`product-card animate-slide-up ${item.status === 'unavailable' ? 'is-unavailable' : ''}`}
                          data-sort-order={index * 2}
                          data-item-id={item.id}
                        >
                          {item.image ? (
                            <div class="image-wrapper image-zoom-container" style={`aspect-ratio: ${getImageAspectRatio(item.image)};`}>
                              <img
                                src={item.image}
                                alt={item.name}
                                class="product-image"
                                loading="lazy"
                                onload="this.classList.add('loaded')"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                              />
                              <div class="fallback-placeholder" style="display: none;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="fallback-icon">
                                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                  <circle cx="8.5" cy="8.5" r="1.5" />
                                  <polyline points="21 15 16 10 5 21" />
                                </svg>
                              </div>
                              {item.status === 'unavailable' ? (
                                <div class="status-badge-out-of-stock">
                                  ناموجود
                                </div>
                              ) : item.discount && (
                                <div class="discount-badge">
                                  {item.discount.discountText}
                                </div>
                              )}
                            </div>
                          ) : (
                            <div class="no-image-wrapper">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="no-image-icon">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                <circle cx="8.5" cy="8.5" r="1.5" />
                                <polyline points="21 15 16 10 5 21" />
                              </svg>
                            </div>
                          )}
                          
                          <div class="product-details">
                            <h3 class="product-title">{item.name}</h3>
                            <div class="price-container">
                              {item.discount ? (
                                <>
                                  <span class="price-tag price-old">{item.discount.originalPrice}</span>
                                  <span class="price-tag price-new">{item.price}</span>
                                </>
                              ) : (
                                <span class="price-tag">{item.price}</span>
                              )}
                            </div>
                          </div>
                        </a>
                      ))}
                    </div>

                    {/* Left Column */}
                    <div class="pinterest-column">
                      {leftColItems.map((item, index) => (
                        <a
                          href={`/${vendorSlug}/${item.slug || item.id}`}
                          class={`product-card animate-slide-up ${item.status === 'unavailable' ? 'is-unavailable' : ''}`}
                          data-sort-order={index * 2 + 1}
                          data-item-id={item.id}
                        >
                          {item.image ? (
                            <div class="image-wrapper image-zoom-container" style={`aspect-ratio: ${getImageAspectRatio(item.image)};`}>
                              <img
                                src={item.image}
                                alt={item.name}
                                class="product-image"
                                loading="lazy"
                                onload="this.classList.add('loaded')"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                              />
                              <div class="fallback-placeholder" style="display: none;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="fallback-icon">
                                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                  <circle cx="8.5" cy="8.5" r="1.5" />
                                  <polyline points="21 15 16 10 5 21" />
                                </svg>
                              </div>
                              {item.status === 'unavailable' ? (
                                <div class="status-badge-out-of-stock">
                                  ناموجود
                                </div>
                              ) : item.discount && (
                                <div class="discount-badge">
                                  {item.discount.discountText}
                                </div>
                              )}
                            </div>
                          ) : (
                            <div class="no-image-wrapper">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="no-image-icon">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                <circle cx="8.5" cy="8.5" r="1.5" />
                                <polyline points="21 15 16 10 5 21" />
                              </svg>
                            </div>
                          )}
                          
                          <div class="product-details">
                            <h3 class="product-title">{item.name}</h3>
                            <div class="price-container">
                              {item.discount ? (
                                <>
                                  <span class="price-tag price-old">{item.discount.originalPrice}</span>
                                  <span class="price-tag price-new">{item.price}</span>
                                </>
                              ) : (
                                <span class="price-tag">{item.price}</span>
                              )}
                            </div>
                          </div>
                        </a>
                      ))}
                    </div>
                  </div>
                );
              }
            })}
          </div>
        ) : (
          /* Mode B: Ultra-Compact List View */
          <div class="compact-list">
            {category.items.map((item) => (
              <a
                href={`/${vendorSlug}/${item.slug || item.id}`}
                class={`list-row animate-slide-up ${item.status === 'unavailable' ? 'is-unavailable' : ''}`}
                data-item-id={item.id}
              >
                <div class="list-right">
                  {item.image ? (
                    <div class="mini-thumb-wrapper">
                      <img
                        src={item.image}
                        alt={item.name}
                        class="mini-thumb"
                        loading="lazy"
                        onload="this.classList.add('loaded')"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                      />
                      <div class="fallback-placeholder mini-fallback" style="display: none;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="fallback-icon">
                          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                          <circle cx="8.5" cy="8.5" r="1.5" />
                          <polyline points="21 15 16 10 5 21" />
                        </svg>
                      </div>
                    </div>
                  ) : (
                    <div class="mini-thumb-placeholder">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="mini-placeholder-icon">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <polyline points="21 15 16 10 5 21" />
                      </svg>
                    </div>
                  )}
                  
                  <div class="list-info">
                    <div style="display: flex; align-items: center; gap: 0.375rem;">
                      <h3 class="list-title">{item.name}</h3>
                      {item.status === 'unavailable' && (
                        <span class="compact-unavailable-badge">ناموجود</span>
                      )}
                    </div>
                    {item.discount && item.status !== 'unavailable' && (
                      <span class="list-discount-badge">{item.discount.discountText}</span>
                    )}
                  </div>
                </div>
                
                <div class="list-left">
                  <div class="price-container text-left">
                    {item.discount ? (
                      <>
                        <span class="price-tag price-old">{item.discount.originalPrice}</span>
                        <span class="price-tag price-new">{item.price}</span>
                      </>
                    ) : (
                      <span class="price-tag">{item.price}</span>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </section>
    );
  })}
</div>

<style>
  .menu-layout-container {
    max-width: 42rem; /* max-w-2xl */
    margin: 0 auto;
    padding-bottom: 5rem;
    direction: rtl;
  }

  .is-unavailable {
    opacity: 0.6;
    filter: grayscale(30%);
  }

  .status-badge-out-of-stock {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background-color: rgba(64, 64, 64, 0.85);
    color: #ffffff;
    font-size: 0.5625rem;
    padding: 0.25rem 0.5rem;
    border-radius: 9999px;
    font-weight: 500;
    z-index: 2;
    letter-spacing: 0.025em;
  }

  .compact-unavailable-badge {
    background-color: #f5f5f5;
    color: #737373;
    font-size: 0.625rem;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-weight: 500;
    white-space: nowrap;
  }

  .menu-section {
    scroll-margin-top: 5rem; /* Ensure section doesn't hide behind category header */
  }

  .masonry-layout-blocks {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* --- MODE A: PINTEREST STYLE MASONRY --- */
  .pinterest-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding: 0 1rem;
  }

  .pinterest-column {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Full-width block (col-span 2) */
  .full-width-block {
    padding: 0 1rem;
    width: 100%;
  }

  .product-card-full {
    background-color: #FFFFFF;
    border-radius: 0;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .image-wrapper-full {
    position: relative;
    width: 100%;
    height: 15rem; /* Bold, taller featured image height */
    border-radius: 2rem; /* rounded-3xl equivalent */
    overflow: hidden;
    background: #f5f5f5;
    background-image: linear-gradient(90deg, #f5f5f5 0px, #fbfbfb 40px, #f5f5f5 80px);
    background-size: 200% 100%;
    animation: shimmer-pulse 1.6s infinite ease-in-out;
