---
interface Props {
  name: string;
  type: string;
  slogan: string;
  logoIcon: string;
}

const { name, type, slogan, logoIcon } = Astro.props;
---

<header class="brand-header">
  <div class="header-content">
    <!-- Right side: Logo & Brand Info (RTL) -->
    <div class="brand-info">
      <div class="logo-box">
        {logoIcon === 'coffee' && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="logo-svg">
            <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
            <line x1="6" x2="6" y1="2" y2="4" />
            <line x1="10" x2="10" y1="2" y2="4" />
            <line x1="14" x2="14" y1="2" y2="4" />
          </svg>
        )}
        {logoIcon === 'utensils' && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="logo-svg">
            <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
            <line x1="7" x2="7" y1="2" y2="11" />
            <line x1="12" x2="12" y1="15" y2="22" />
            <line x1="17" x2="17" y1="15" y2="22" />
            <path d="M21 2v6c0 1.1-.9 2-2 2h-2V2Z" />
            <line x1="7" x2="7" y1="15" y2="22" />
          </svg>
        )}
        {logoIcon === 'cake' && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="logo-svg">
            <path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8" />
            <path d="M4 16h16" />
            <path d="M10 11V7.5a1.5 1.5 0 1 1 3 0V11" />
            <path d="M12 4.5V3" />
            <path d="M8 21h8" />
          </svg>
        )}
      </div>
      
      <div class="brand-text">
        <h1 class="brand-name">{name}</h1>
        <div class="brand-sub">
          <span class="brand-type">{type}</span>
          <span class="divider-bullet">•</span>
          <span class="brand-slogan">{slogan}</span>
        </div>
      </div>
    </div>
    
    <!-- Left side: Empty (backend handles view toggles) -->
    <div class="header-left"></div>
  </div>
</header>

<style>
  .brand-header {
    background-color: #FFFFFF;
    padding: 1.75rem 1rem;
  }

  .header-content {
    max-width: 42rem; /* max-w-2xl equivalent (672px) */
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-info {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .logo-box {
    width: 2.5rem; /* w-10 */
    height: 2.5rem; /* h-10 */
    border-radius: 0.75rem; /* rounded-xl */
    background-color: #171717; /* bg-neutral-900 */
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    flex-shrink: 0;
  }

  .logo-svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .brand-name {
    font-size: 1.125rem;
    font-weight: 500;
    color: #0a0a0a; /* text-neutral-950 */
    line-height: 1.2;
  }

  .brand-sub {
    font-weight: 100;
    font-size: 0.5rem; /* text-[8px] */
    color: #a3a3a3; /* text-neutral-400 */
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .brand-sub {
      font-size: 0.5625rem; /* sm:text-[9px] */
    }
  }

  .divider-bullet {
    color: #e5e5e5;
  }

  .brand-slogan {
    font-weight: 200;
  }

  .header-left {
    display: flex;
    align-items: center;
  }
</style>
