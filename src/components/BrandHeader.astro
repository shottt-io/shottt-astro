---
interface Props {
  name: string;
  type: string;
  slogan: string;
  logoIcon: string;
  logo?: string | null;
}

const { name, type, slogan, logoIcon, logo } = Astro.props;
---

<header class="brand-header">
  <div class="header-content">
    <!-- Right side: Logo & Brand Info (RTL) -->
    <div class="brand-info">
      {logo ? (
        <img src={logo} alt={name} class="logo-img" />
      ) : (
        <div class="logo-box">
          <span class="logo-text-fallback">{name.substring(0, 1)}</span>
        </div>
      )}
      
      <div class="brand-text">
        <h1 class="brand-name">{name}</h1>
        {slogan && (
          <div class="brand-sub">
            <span class="brand-slogan">{slogan}</span>
          </div>
        )}
      </div>
    </div>
    
    <!-- Left side: Empty (backend handles view toggles) -->
    <div class="header-left"></div>
  </div>
</header>

<style>
  .brand-header {
    background-color: var(--bg-primary, #FFFFFF);
    padding: 1.75rem 1rem;
    transition: background-color 0.3s ease;
  }

  .header-content {
    max-width: 42rem; /* max-w-2xl equivalent (672px) */
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo-box {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 1rem;
    background-color: var(--text-primary, #171717); /* bg-neutral-900 */
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bg-primary, #FFFFFF);
    flex-shrink: 0;
  }

  .logo-img {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 1rem;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border-color, #e5e5e5);
  }

  .logo-text-fallback {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--bg-primary, #FFFFFF);
    text-transform: uppercase;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--title-color, #0a0a0a); /* text-neutral-950 */
    line-height: 1.2;
  }

  .brand-sub {
    font-weight: 300;
    font-size: 0.8125rem;
    color: var(--text-secondary, #737373); /* text-neutral-400 */
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .brand-sub {
      font-size: 0.875rem;
    }
  }

  .divider-bullet {
    color: #e5e5e5;
  }

  .brand-slogan {
    font-weight: 200;
  }

  .header-left {
    display: flex;
    align-items: center;
  }
</style>
