---
interface Props {
  name: string;
  type: string;
  slogan: string;
  logoIcon: string;
  logo?: string | null;
}

const { name, type, slogan, logoIcon, logo } = Astro.props;
---

<header class="brand-header">
  <div class="header-content">
    <!-- Right side: Logo & Brand Info (RTL) -->
    <div class="brand-info">
      {logo ? (
        <img src={logo} alt={name} class="logo-img" />
      ) : (
        <div class="logo-box">
          {logoIcon === 'coffee' && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="logo-svg">
              <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
              <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
              <line x1="6" x2="6" y1="2" y2="4" />
              <line x1="10" x2="10" y1="2" y2="4" />
              <line x1="14" x2="14" y1="2" y2="4" />
            </svg>
          )}
          {logoIcon === 'utensils' && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="logo-svg">
              <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
              <line x1="7" x2="7" y1="2" y2="11" />
              <line x1="12" x2="12" y1="15" y2="22" />
              <line x1="17" x2="17" y1="15" y2="22" />
              <path d="M21 2v6c0 1.1-.9 2-2 2h-2V2Z" />
              <line x1="7" x2="7" y1="15" y2="22" />
            </svg>
          )}
          {logoIcon === 'cake' && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="logo-svg">
              <path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8" />
              <path d="M4 16h16" />
              <path d="M10 11V7.5a1.5 1.5 0 1 1 3 0V11" />
              <path d="M12 4.5V3" />
              <path d="M8 21h8" />
            </svg>
          )}
          {logoIcon === 'shirt' && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="logo-svg">
              <path d="M20.38 3.46L16 6.14V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2.14L3.62 3.46a2 2 0 0 0-2.38.9L.08 6.78a2 2 0 0 0 .61 2.76L4 11.2V20a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8.8l3.31-2.22a2 2 0 0 0 .61-2.76l-1.16-2.42a2 2 0 0 0-2.38-.9z" />
            </svg>
          )}
          {logoIcon === 'palette' && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="logo-svg">
              <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 14.7255 3.09032 17.1962 4.85857 19C5.03442 19.1758 5.27581 19.2625 5.51864 19.2319L7.49842 18.9818C7.99406 18.919 8.44146 19.2274 8.56396 19.7118L9.04351 21.6067C9.09703 21.8183 9.25667 21.9868 9.46743 22.046C10.2882 22.2764 11.1396 22.3995 12 22Z" />
              <circle cx="7.5" cy="10.5" r="1.5" fill="currentColor" />
              <circle cx="11.5" cy="7.5" r="1.5" fill="currentColor" />
              <circle cx="16.5" cy="9.5" r="1.5" fill="currentColor" />
              <circle cx="15.5" cy="14.5" r="1.5" fill="currentColor" />
            </svg>
          )}
          {logoIcon === 'laptop' && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="logo-svg">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
              <line x1="2" y1="20" x2="22" y2="20" />
              <line x1="12" y1="17" x2="12" y2="20" />
            </svg>
          )}
          {logoIcon === 'sparkles' && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="logo-svg">
              <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-.767a.5.5 0 0 1 0-.992l6.135-.767A2 2 0 0 0 8.5 7.112l.767-6.135a.5.5 0 0 1 .992 0l.767 6.135a2 2 0 0 0 1.437 1.425l6.135.767a.5.5 0 0 1 0 .992l-6.135.767a2 2 0 0 0-1.437 1.425l-.767 6.135a.5.5 0 0 1-.992 0z" />
              <path d="M20 3a.5.5 0 0 0-.39-.11l-1.534.192a.5.5 0 0 1-.359-.358l-.192-1.534a.5.5 0 0 0-.99 0L16.343 2.73a.5.5 0 0 1-.359.358L14.45 3.28a.5.5 0 0 0 0 .99l1.534.192a.5.5 0 0 1 .359.358l.192 1.534a.5.5 0 0 0 .99 0l.192-1.534a.5.5 0 0 1 .359-.358l1.534-.192A.5.5 0 0 0 20 3z" />
            </svg>
          )}
          {(logoIcon === 'store' || !['coffee', 'utensils', 'cake', 'shirt', 'palette', 'laptop', 'sparkles'].includes(logoIcon)) && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="logo-svg">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
          )}
        </div>
      )}
      
      <div class="brand-text">
        <h1 class="brand-name">{name}</h1>
        {slogan && (
          <div class="brand-sub">
            <span class="brand-slogan">{slogan}</span>
          </div>
        )}
      </div>
    </div>
    
    <!-- Left side: Empty (backend handles view toggles) -->
    <div class="header-left"></div>
  </div>
</header>

<style>
  .brand-header {
    background-color: #FFFFFF;
    padding: 1.75rem 1rem;
  }

  .header-content {
    max-width: 42rem; /* max-w-2xl equivalent (672px) */
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-info {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .logo-box {
    width: 2.5rem; /* w-10 */
    height: 2.5rem; /* h-10 */
    border-radius: 0.75rem; /* rounded-xl */
    background-color: #171717; /* bg-neutral-900 */
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    flex-shrink: 0;
  }

  .logo-img {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid #e5e5e5;
  }

  .logo-svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .brand-name {
    font-size: 1.125rem;
    font-weight: 500;
    color: #0a0a0a; /* text-neutral-950 */
    line-height: 1.2;
  }

  .brand-sub {
    font-weight: 300;
    font-size: 0.75rem;
    color: #a3a3a3; /* text-neutral-400 */
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .brand-sub {
      font-size: 0.8125rem;
    }
  }

  .divider-bullet {
    color: #e5e5e5;
  }

  .brand-slogan {
    font-weight: 200;
  }

  .header-left {
    display: flex;
    align-items: center;
  }
</style>
