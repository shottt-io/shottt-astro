---
import { db } from '../../db/db';
import { vendors as vendorsTable } from '../../db/schema';
import { sql } from 'drizzle-orm';
import { useTranslations } from '../../utils/i18n';
import { TOTAL_FREE, SUBSCRIPTION_FEE } from '../../config/region';
import { formatSubscriptionFee } from '../../utils/billing';

const enableConvertPaper = import.meta.env.ENABLE_CONVERT_PAPER === 'true' || process.env.ENABLE_CONVERT_PAPER === 'true';

let randomVendors: Array<{ name: string; slug: string; logo: string }> = [];
try {
  randomVendors = await db
    .select({
      name: vendorsTable.name,
      slug: vendorsTable.slug,
      logo: vendorsTable.logo,
    })
    .from(vendorsTable)
    .orderBy(sql`random()`)
    .limit(10);
} catch (e) {
  console.warn("Could not load vendors from database:", e);
}

let marqueeItems = [...randomVendors];
while (marqueeItems.length > 0 && marqueeItems.length < 8) {
  marqueeItems = [...marqueeItems, ...randomVendors];
}

const { t, locale, dir } = useTranslations(Astro.cookies, Astro.request);

const irTranslations = {
  fa: {
    mainStatement: "شات، صرفاً یک کاتالوگ و منوی دیجیتال ساده است.",
    subStatement: "اگر به دنبال خدمات یا امکانات دیگری هستید، پیشنهاد می‌کنیم به سایر وب‌سایت‌ها سر بزنید؛ چرا که ما در شات خدمتی فراتر از این ارائه نمی‌دهیم.",
    pricingBadge: TOTAL_FREE ? "تعرفه: رایگان" : `اشتراک: ${formatSubscriptionFee(SUBSCRIPTION_FEE, 'fa')}`,
    termsBadge: TOTAL_FREE ? "ثبت‌نام: رایگان و آنلاین" : "ماه اول رایگان / شروع بدون پرداخت",
    createBtn: "ثبت‌نام مجموعه جدید ⚡",
    loginBtn: "ورود به پنل مدیریت",
    whyFreeTitle: TOTAL_FREE ? "چرا رایگان؟" : "تعرفه و شرایط اشتراک",
    whyFreeP1: TOTAL_FREE 
      ? "ما حدود ۱۰ سال در زمینه ارائه منوی دیجیتال، سیستم سفارش‌گیری، باشگاه مشتریان و خدمات متنوع دیگر فعالیت کردیم؛ اما در طول این سال‌ها با چالش‌ها و شرایطی مواجه شدیم که مسیر توسعه را بسیار دشوار کرد. در سال‌های اخیر تلاش کردیم با حداقل هزینه اشتراک خدماتمان را ادامه دهیم، اما مشکلات مداوم زیرساختی و اینترنت کشور همواره ما را با چالش‌های پایه‌ای و فرساینده روبه‌رو ساخت."
      : "شات با دریافت هزینه اشتراک ارائه می‌شود. هزینه اشتراک به صورت یورو محاسبه شده و در ابتدای هر ماه میلادی پرداخت می‌گردد. همچنین برای شروع کار و ثبت‌نام، اولین ماه میلادی عضویت شما کاملاً رایگان خواهد بود و نیاز به هیچ پرداختی ندارید.",
    whyFreeP2: TOTAL_FREE 
      ? "از این رو، تصمیم گرفتیم به دلیل عدم توجیه اقتصادی، امکانات پلتفرم را محدود کنیم. در حال حاضر شات صرفاً بر پایه علاقه شخصی حفظ شده و با ساده‌ترین ابزارها ارائه می‌شود تا کمترین دغدغه فنی را برای شما و ما ایجاد کند. به همین دلیل، تصمیم گرفتیم بابت این امکانات محدود هیچ هزینه‌ای از مجموعه‌ها دریافت نکنیم. امیدواریم روزی شرایط بهبود یابد و امکان ارائه خدمات کامل‌تری فراهم شود. 🖤"
      : "برای فعال‌سازی و تایید پرداخت، پس از واریز مبلغ به شماره کارت مشخص شده در پنل مدیریت، کافیست کد رهگیری یا هش تراکنش خود را ثبت کنید تا توسط مدیران تایید شود.",
    termsTitle: "شرایط و نحوه ثبت‌نام",
    termsDesc: TOTAL_FREE
      ? "عضویت و ایجاد کاتالوگ دیجیتال در شات کاملاً رایگان، آنلاین و آنی است. شما می‌توانید با زدن دکمه «ثبت‌نام مجموعه جدید»، نام مجموعه، آدرس اینترنتی دلخواه و اطلاعات ورود خود را مشخص کرده و بلافاصله مدیریت منوی خود را آغاز کنید. همچنین در صورت داشتن منوی دیجیتال دیگر، می‌توانید از کادر هوش مصنوعی در پایین همین صفحه استفاده کرده و کل محصولات خود را در کسری از ثانیه منتقل کنید."
      : `عضویت و ایجاد کاتالوگ دیجیتال در شات آنلاین و آنی است. اولین ماه میلادی عضویت شما کاملاً رایگان است و نیاز به پرداخت ندارد. از ماه‌های بعد، هزینه اشتراک معادل ${formatSubscriptionFee(SUBSCRIPTION_FEE, 'fa')} می‌باشد. شما می‌توانید با زدن دکمه «ثبت‌نام مجموعه جدید»، نام مجموعه، آدرس اینترنتی دلخواه و اطلاعات ورود خود را مشخص کرده و بلافاصله مدیریت منوی خود را آغاز کنید.`,
    someCollections: "برخی از مجموعه‌ها",
  },
  en: {
    mainStatement: "Shottt is simply a clean digital catalog and menu.",
    subStatement: "If you are looking for other complex services, we suggest checking other websites; because at Shottt, we do not offer any services beyond this.",
    pricingBadge: TOTAL_FREE ? "Pricing: Free" : `Subscription: ${formatSubscriptionFee(SUBSCRIPTION_FEE, 'en')}`,
    termsBadge: TOTAL_FREE ? "Registration: Free & Online" : "First month free / Start free",
    createBtn: "Register Now ⚡",
    loginBtn: "Log in to Dashboard",
    whyFreeTitle: TOTAL_FREE ? "Why is it Free?" : "Subscription & Terms",
    whyFreeP1: TOTAL_FREE 
      ? "We operated for about 10 years in the field of digital menus, ordering systems, customer clubs, and various other services. However, over the years we faced challenges and conditions that made development very difficult. In recent years, we tried to continue our services with minimal subscription costs, but continuous infrastructure and internet issues always presented base and exhausting challenges."
      : "Shottt is provided on a monthly subscription basis. The subscription fee is calculated in Euros and paid at the start of each calendar month. Additionally, your first calendar month is completely free upon registration, with no payment required to start.",
    whyFreeP2: TOTAL_FREE 
      ? "Therefore, we decided to limit the platform's features due to lack of economic justification. Currently, Shottt is maintained purely as a personal hobby and is provided with the simplest tools to create the minimum technical concern for you and us. For this reason, we decided not to charge any fees for these limited features. We hope conditions improve one day so we can provide fuller services. 🖤"
      : "To activate and verify your payment, after transferring the amount to the card number specified in the management panel, simply submit your transaction reference/hash for review by administrators.",
    termsTitle: "Registration & Terms",
    termsDesc: TOTAL_FREE
      ? "Membership and creating a digital catalog on Shottt is completely free, online, and instant. You can register your store, set a custom URL, configure login info, and immediately start managing your menu. You can also import items in seconds."
      : `Membership and creating a digital catalog on Shottt is online and instant. Your first calendar month is completely free and requires no payment to start. In subsequent months, a subscription fee of ${formatSubscriptionFee(SUBSCRIPTION_FEE, 'en')} applies. You can register your store, set a custom URL, configure login info, and immediately start managing your menu.`,
    someCollections: "Some of our shops",
  },
  tr: {
    mainStatement: "Shottt sadece temiz bir dijital katalog ve menüdür.",
    subStatement: "Başka karmaşık hizmetler arıyorsanız, diğer web sitelerini kontrol etmenizi öneririz; çünkü Shottt'ta bunun ötesinde herhangi bir hizmet sunmuyoruz.",
    pricingBadge: TOTAL_FREE ? "Fiyatlandırma: Ücretsiz" : `Abonelik: ${formatSubscriptionFee(SUBSCRIPTION_FEE, 'tr')}`,
    termsBadge: TOTAL_FREE ? "Kayıt: Ücretsiz & Çevrimiçi" : "İlk ay ücretsiz / Ödemesiz başlangıç",
    createBtn: "Hemen Kayıt Ol ⚡",
    loginBtn: "Yönetici Paneline Giriş Yap",
    whyFreeTitle: TOTAL_FREE ? "Neden Ücretsiz?" : "Abonelik & Koşullar",
    whyFreeP1: TOTAL_FREE 
      ? "Dijital menüler, sipariş sistemleri, müşteri kulüpleri ve diğer çeşitli hizmetler alanında yaklaşık 10 yıl faaliyet gösterdik. Ancak yıllar geçtikçe geliştirilmesini çok zorlaştıran zorluklarla ve koşullarla karşılaştık. Son yıllarda hizmetlerimize asgari abonelik maliyetleriyle devam etmeye çalıştık, ancak sürekli altyapı ve internet sorunları her zaman temel ve yorucu zorluklar çıkardı."
      : "Shottt, aylık abonelik esasına göre sunulmaktadır. Abonelik ücreti Euro cinsinden hesaplanır ve her takvim ayının başında ödenir. Ayrıca, kayıt olduğunuz ilk takvim ayı tamamen ücretsizdir ve başlamak için herhangi bir ödeme yapmanız gerekmez.",
    whyFreeP2: TOTAL_FREE 
      ? "Bu nedenle, ekonomik gerekçelerin olmaması nedeniyle platformun özelliklerini sınırlandırmaya karar verdik. Şu anda Shottt tamamen kişisel bir hobi olarak sürdürülmekte ve siz ve bizim için minimum teknik endişe yaratacak en basit araçlarla sunulmaktadır. Bu nedenle, bu sınırlı özellikler için herhangi bir ücret talep etmemeye karar verdik. Bir gün koşulların iyileşmesini ve daha kapsamlı hizmetler sunabilmeyi umuyoruz. 🖤"
      : "Ödemenizi onaylamak ve aktifleştirmek için, yönetim panelinde belirtilen kart numarasına tutarı transfer ettikten sonra işlem referansını/kodunu yöneticilerin onayına sunmanız yeterlidir.",
    termsTitle: "Kayıt & Koşullar",
    termsDesc: TOTAL_FREE
      ? "Shottt'ta üyelik ve dijital katalog oluşturmak tamamen ücretsiz, çevrimiçi ve anındadır. Mağazanızı kaydedebilir, özel bir URL belirleyebilir, giriş bilgilerinizi yapılandırabilir ve hemen menünüzü yönetmeye başlayabilirsiniz. Ürünlerinizi saniyeler içinde içe aktarabilirsiniz."
      : `Shottt'ta üyelik ve dijital katalog oluşturmak çevrimiçi ve anındadır. İlk takvim ayınız tamamen ücretsizdir ve başlamak için herhangi bir ödeme gerektirmez. Sonraki aylarda ${formatSubscriptionFee(SUBSCRIPTION_FEE, 'tr')} tutarında abonelik ücreti uygulanır. Mağazanızı kaydedebilir, özel bir URL belirleyebilir, giriş bilgilerinizi yapılandırabilir ve hemen menünüzü yönetmeye başlayabilirsiniz.`,
    someCollections: "Bazı işletmelerimiz",
  }
};

const localT = irTranslations[locale] || irTranslations['fa'];
---

<main class="marketing-container font-ir" style={`direction: ${dir};`}>
  <!-- Language Selector Top Bar -->
  <nav class="top-nav-bar">
    <div class="lang-dropdown-container">
      <button class="lang-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="globe-icon">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span>{locale === 'fa' ? 'فارسی' : locale === 'tr' ? 'Türkçe' : 'English'}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <div class="lang-dropdown-menu">
        <button class={`lang-dropdown-item ${locale === 'fa' ? 'active' : ''}`} data-lang="fa">فارسی</button>
        <button class={`lang-dropdown-item ${locale === 'en' ? 'active' : ''}`} data-lang="en">English</button>
        <button class={`lang-dropdown-item ${locale === 'tr' ? 'active' : ''}`} data-lang="tr">Türkçe</button>
      </div>
    </div>
    <a href="/admin" class="top-login-link">{localT.loginBtn}</a>
  </nav>

  <div class="content-wrapper animate-slide-up">
    <!-- Big Centered Logo -->
    <div class="logo-container">
      <img src="/logo.png" alt="shottt logo" class="brand-logo-img" />
    </div>

    <!-- Core Messages -->
    <section class="message-section">
      <h1 class="main-statement">{localT.mainStatement}</h1>
      <p class="sub-statement">{localT.subStatement}</p>
    </section>

    <!-- Actions -->
    <div class="action-section">
      <div class="badge-group">
        <button id="price-trigger" class="price-badge" aria-label={localT.whyFreeTitle}>
          <span class="price-text">{localT.pricingBadge}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="info-icon">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
        </button>

        <button id="terms-trigger" class="price-badge" aria-label={localT.termsTitle}>
          <span class="price-text">{localT.termsBadge}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="info-icon">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
        </button>
      </div>

      <div class="action-buttons-wrap">
        <a href="/admin/register" class="admin-link-main">
          <span>{localT.createBtn}</span>
        </a>
        {enableConvertPaper && (
          <button id="ai-dialog-trigger" class="ai-trigger-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1.1rem; height: 1.1rem; margin-inline-end: 0.5rem;">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span>{t('aiTriggerBtn')}</span>
          </button>
        )}
      </div>
    </div>
  </div>

  <!-- Info Dialog (Modal) -->
  <dialog id="info-dialog" closedby="any" class="custom-dialog">
    <div class="dialog-wrapper">
      <header class="dialog-header">
        <h2 class="dialog-title">{localT.whyFreeTitle}</h2>
        <button id="close-dialog" class="close-btn" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </header>
      <div class="dialog-body">
        <p class="dialog-text">{localT.whyFreeP1}</p>
        <p class="dialog-text" style="margin-top: 0.75rem;">{localT.whyFreeP2}</p>
      </div>
    </div>
  </dialog>

  <!-- Terms Dialog (Modal) -->
  <dialog id="terms-dialog" closedby="any" class="custom-dialog">
    <div class="dialog-wrapper">
      <header class="dialog-header">
        <h2 class="dialog-title">{localT.termsTitle}</h2>
        <button id="close-terms-dialog" class="close-btn" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </header>
      <div class="dialog-body">
        <p class="dialog-text">{localT.termsDesc}</p>
      </div>
    </div>
  </dialog>

  <!-- AI Converter Dialog (Modal) -->
  {enableConvertPaper && (
    <dialog id="ai-dialog" class="custom-dialog">
      <div class="dialog-wrapper" style="max-width: 30rem;">
        <header class="dialog-header">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <h2 class="dialog-title" style="margin: 0; font-size: 0.9375rem;">{t('aiTitle')}</h2>
            <span class="ai-badge" style="margin: 0; font-size: 0.625rem; padding: 0.25rem 0.6rem; background-color: #18181b; color: #ffffff; border-radius: 9999px; font-weight: 500;">{t('aiBadge')}</span>
          </div>
          <button id="close-ai-dialog" class="close-btn" aria-label={t('aiDialogClose')}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>
        <div class="dialog-body" style="padding: 1rem 0 0 0;">
          <p class="dialog-text" style="font-size: 0.75rem; margin: 0 0 1rem 0; line-height: 1.5;">
            {t('aiDesc')}
          </p>
          
          <form id="ai-crawler-form" class="ai-form" style="margin-top: 0.25rem;">
            <div class="ai-input-group" style="gap: 0.5rem;">
              <div class="image-upload-dropzone" id="ai-dropzone" style="padding: 1.5rem 1rem; border-radius: 0.75rem; border-style: dashed; border-width: 1px; gap: 0.35rem;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="upload-icon" style="width: 1.5rem; height: 1.5rem; color: #71717a;">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <span class="upload-text" style="font-size: 0.8125rem;">{t('aiDropzoneText')}</span>
                <span class="upload-subtext" style="font-size: 0.6875rem;">{t('aiDropzoneSubtext')}</span>
                <input type="file" id="ai-file-input" multiple accept="image/*" style="display: none;" />
              </div>
              <div id="selected-files-list" class="selected-files-list" style="display: none; font-size: 0.6875rem;"></div>
              <button 
                type="submit" 
                id="ai-submit-btn" 
                class="ai-btn" 
                disabled 
                data-status-start={t('aiProgressStart')}
                data-status-upload={t('aiProgressUpload')}
                data-status-processing={t('aiProgressProcessing')}
                data-status-extracting={t('aiProgressExtracting')}
                data-status-success={t('aiSuccess')}
                data-error-msg={t('aiErrorAlert')}
                style="padding: 0.75rem 1.5rem; font-size: 0.75rem; border-radius: 9999px; width: 100%; display: flex; align-items: center; justify-content: center;"
              >
                <span>{t('aiBtn')}</span>
              </button>
            </div>
          </form>
  
          <div id="ai-progress" class="ai-progress-container" style="display: none; margin-top: 1rem; flex-direction: column; gap: 0.5rem; width: 100%;">
            <div class="ai-progress-bar" style="height: 4px; background-color: #f4f4f5; border-radius: 2px; width: 100%; overflow: hidden;">
              <div id="ai-progress-fill" class="ai-progress-fill" style="width: 0%; height: 100%; background-color: #18181b; transition: width 0.3s ease;"></div>
            </div>
            <span id="ai-progress-status" class="ai-progress-status" style="font-size: 0.6875rem; color: #71717a;">{t('aiProgressStart')}</span>
          </div>
        </div>
      </div>
    </dialog>
  )}

  <!-- Random Collections Section -->
  {randomVendors.length > 0 && (
    <section class="collections-section animate-slide-up" style="animation-delay: 0.2s;">
      <h2 class="collections-title">{localT.someCollections}</h2>
      <div class="marquee-container">
        <div class="marquee-track">
          <div class="marquee-group">
            {marqueeItems.map((vendor) => (
              <a href={`/${vendor.slug}`} class="collection-card">
                <img src={vendor.logo} alt={vendor.name} class="collection-logo" loading="lazy" />
                <span class="collection-name">{vendor.name}</span>
              </a>
            ))}
          </div>
          <div class="marquee-group" aria-hidden="true">
            {marqueeItems.map((vendor) => (
              <a href={`/${vendor.slug}`} class="collection-card">
                <img src={vendor.logo} alt={vendor.name} class="collection-logo" loading="lazy" />
                <span class="collection-name">{vendor.name}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}
</main>

<script is:inline define:vars={{ currentLocale: locale }}>
  const priceTrigger = document.getElementById('price-trigger');
  const dialog = document.getElementById('info-dialog');
  const closeDialog = document.getElementById('close-dialog');

  if (priceTrigger && dialog) {
    priceTrigger.addEventListener('click', () => {
      dialog.showModal();
    });
  }

  if (closeDialog && dialog) {
    closeDialog.addEventListener('click', () => {
      dialog.close();
    });
  }

  if (dialog && !('closedBy' in HTMLDialogElement.prototype)) {
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      const isDialogContent = (
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width
      );
      if (!isDialogContent) {
        dialog.close();
      }
    });
  }

  const termsTrigger = document.getElementById('terms-trigger');
  const termsDialog = document.getElementById('terms-dialog');
  const closeTermsDialog = document.getElementById('close-terms-dialog');

  if (termsTrigger && termsDialog) {
    termsTrigger.addEventListener('click', () => {
      termsDialog.showModal();
    });
  }

  if (closeTermsDialog && termsDialog) {
    closeTermsDialog.addEventListener('click', () => {
      termsDialog.close();
    });
  }

  if (termsDialog && !('closedBy' in HTMLDialogElement.prototype)) {
    termsDialog.addEventListener('click', (event) => {
      if (event.target !== termsDialog) return;
      const rect = termsDialog.getBoundingClientRect();
      const isDialogContent = (
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width
      );
      if (!isDialogContent) {
        termsDialog.close();
      }
    });
  }

  // Language dropdown toggle logic
  const trigger = document.querySelector('.lang-dropdown-trigger');
  const menu = document.querySelector('.lang-dropdown-menu');

  if (trigger && menu) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
      menu.classList.toggle('show');
    });

    document.addEventListener('click', () => {
      trigger.setAttribute('aria-expanded', 'false');
      menu.classList.remove('show');
    });
  }

  const langItems = document.querySelectorAll('.lang-dropdown-item');
  langItems.forEach(item => {
    item.addEventListener('click', () => {
      const targetLang = item.getAttribute('data-lang') || 'fa';
      document.cookie = `lang=${targetLang}; path=/; max-age=31536000`;
      window.location.reload();
    });
  });

  // ── Homepage Analytics Tracking ──────────────────────────────────────
  (function() {
    if (typeof window === 'undefined' || typeof window.fetch === 'undefined') return;

    const storage = {
      get(key) { try { return localStorage.getItem(key); } catch(e) { return null; } },
      set(key, val) { try { localStorage.setItem(key, val); } catch(e) {} },
      remove(key) { try { localStorage.removeItem(key); } catch(e) {} }
    };

    const SESSION_DURATION = 1 * 60 * 60 * 1000;
    const sessionKey = 'hp_session_id';
    const expiryKey = 'hp_session_expiry';
    const visitKey = 'hp_visit_sent';

    let sessionId = storage.get(sessionKey);
    let sessionExpiry = storage.get(expiryKey);
    const now = Date.now();

    if (!sessionId || !sessionExpiry || now > parseInt(sessionExpiry, 10)) {
      sessionId = Math.random().toString(36).substring(2, 15);
      storage.set(sessionKey, sessionId);
      storage.set(expiryKey, (now + SESSION_DURATION).toString());
      storage.remove(visitKey);
    }

    let uniqueVisit = false;
    if (storage.get(visitKey) !== 'true') {
      uniqueVisit = true;
      storage.set(visitKey, 'true');
    }

    fetch(`/api/analytics/homepage-track?v=${now}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pageView: true, uniqueVisit: uniqueVisit }),
      keepalive: true
    }).catch(() => {});
  })();

  // ── AI Crawler Form Handling ─────────────────────────────────────────
  const dropzone = document.getElementById('ai-dropzone');
  const fileInput = document.getElementById('ai-file-input');
  const filesList = document.getElementById('selected-files-list');
  const crawlForm = document.getElementById('ai-crawler-form');
  const crawlSubmitBtn = document.getElementById('ai-submit-btn');
  const crawlProgress = document.getElementById('ai-progress');
  const progressFill = document.getElementById('ai-progress-fill');
  const progressStatus = document.getElementById('ai-progress-status');

  let selectedFiles = [];

  if (dropzone && fileInput) {
    dropzone.addEventListener('click', () => fileInput.click());
    
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('dragover');
    });

    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('dragover');
    });

    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragover');
      if (e.dataTransfer.files) {
        handleFiles(e.dataTransfer.files);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files) {
        handleFiles(e.target.files);
      }
    });
  }

  function handleFiles(files) {
    for (const file of files) {
      if (file.type.startsWith('image/')) {
        selectedFiles.push(file);
      }
    }
    renderFilesList();
  }

  function renderFilesList() {
    if (!filesList) return;
    filesList.innerHTML = '';
    if (selectedFiles.length > 0) {
      filesList.style.display = 'grid';
      selectedFiles.forEach((file, index) => {
        const item = document.createElement('div');
        item.className = 'file-item';

        const img = document.createElement('img');
        img.style.width = '100%';
        img.style.height = '100%';
        img.style.objectFit = 'cover';
        
        const reader = new FileReader();
        reader.onload = (e) => {
          img.src = e.target.result;
        };
        reader.readAsDataURL(file);
        
        item.appendChild(img);

        const removeBtn = document.createElement('button');
        removeBtn.className = 'remove-file-btn';
        removeBtn.setAttribute('data-index', index);
        removeBtn.innerHTML = '&times;';
        item.appendChild(removeBtn);

        filesList.appendChild(item);
      });
      
      filesList.querySelectorAll('.remove-file-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = parseInt(btn.getAttribute('data-index'));
          selectedFiles.splice(idx, 1);
          renderFilesList();
        });
      });
      
      if (crawlSubmitBtn) crawlSubmitBtn.disabled = false;
    } else {
      filesList.style.display = 'none';
      if (crawlSubmitBtn) crawlSubmitBtn.disabled = true;
    }
  }

  // ── AI Dialog Trigger and Close Logic ──
  const aiTrigger = document.getElementById('ai-dialog-trigger');
  const aiDialog = document.getElementById('ai-dialog');
  const closeAiBtn = document.getElementById('close-ai-dialog');

  if (aiTrigger && aiDialog) {
    aiTrigger.addEventListener('click', () => {
      aiDialog.showModal();
    });
  }

  if (closeAiBtn && aiDialog) {
    closeAiBtn.addEventListener('click', () => {
      aiDialog.close();
    });
  }


  if (crawlForm) {
    crawlForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (selectedFiles.length === 0) return;

      const statusStart = crawlSubmitBtn.getAttribute('data-status-start') || 'در حال خواندن فایل‌های منو...';
      const statusUpload = crawlSubmitBtn.getAttribute('data-status-upload') || 'در حال ارسال تصاویر به هوش مصنوعی...';
      const statusProcessing = crawlSubmitBtn.getAttribute('data-status-processing') || 'هوش مصنوعی در حال پردازش تصاویر منو...';
      const statusExtracting = crawlSubmitBtn.getAttribute('data-status-extracting') || 'در حال استخراج دسته‌بندی‌ها و محصولات...';
      const statusSuccess = crawlSubmitBtn.getAttribute('data-status-success') || 'آماده شد! انتقال به پیش‌نمایش...';
      const errorMsg = crawlSubmitBtn.getAttribute('data-error-msg') || 'خطا در پردازش تصاویر منو. لطفاً تصاویر واضح‌تری انتخاب کنید.';

      crawlSubmitBtn.disabled = true;
      crawlProgress.style.display = 'flex';
      progressFill.style.width = '10%';
      progressStatus.textContent = statusStart;

      // Read files as base64
      const base64Promises = selectedFiles.map(file => {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result);
          reader.onerror = err => reject(err);
          reader.readAsDataURL(file);
        });
      });

      try {
        const images = await Promise.all(base64Promises);
        
        progressFill.style.width = '30%';
        progressStatus.textContent = statusUpload;

        // Simulate progress updates during API call
        let progress = 30;
        const progressInterval = setInterval(() => {
          if (progress < 85) {
            progress += Math.floor(Math.random() * 4) + 1;
            progressFill.style.width = `${progress}%`;
            if (progress < 60) {
              progressStatus.textContent = statusProcessing;
            } else {
              progressStatus.textContent = statusExtracting;
            }
          }
        }, 1000);

        const response = await fetch('/api/ai/convert-paper-menu', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ images, locale: currentLocale }),
        });

        clearInterval(progressInterval);
        const data = await response.json();

        if (response.ok && data.success) {
          progressFill.style.width = '100%';
          progressStatus.textContent = statusSuccess;
          setTimeout(() => {
            window.location.href = `/preview/${data.id}`;
          }, 800);
        } else {
          throw new Error(data.error || 'Failed.');
        }
      } catch (err) {
        crawlSubmitBtn.disabled = false;
        progressFill.style.width = '0%';
        crawlProgress.style.display = 'none';
        
        if (window.showAlertDialog) {
          await window.showAlertDialog(err.message || errorMsg, {
            type: 'error',
            okText: crawlSubmitBtn.getAttribute('data-error-retry') || 'تلاش مجدد',
          });
        } else {
          alert(err.message || errorMsg);
        }
      }
    });
  }
</script>

