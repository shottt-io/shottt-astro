<script is:inline define:vars={{ priceMo: t.paidPriceMo, priceYr: t.paidPriceYr, periodMo: t.paidPeriodMo, periodYr: t.paidPeriodYr, isIranServer: IS_IRAN_SERVER }}>

  // Toggle billing logic
  const toggleBtn = document.getElementById('billing-toggle');
  const priceEl = document.getElementById('paid-price');
  const periodEl = document.getElementById('paid-period');
  const labelMonthly = document.getElementById('label-monthly');
  const labelYearly = document.getElementById('label-yearly');

  let isYearly = false;

  function updatePricing() {
    if (isYearly) {
      toggleBtn.classList.add('active');
      priceEl.textContent = priceYr;
      periodEl.textContent = '/ ' + periodYr;
      labelYearly.classList.add('active-label');
      labelMonthly.classList.remove('active-label');
    } else {
      toggleBtn.classList.remove('active');
      priceEl.textContent = priceMo;
      periodEl.textContent = '/ ' + periodMo;
      labelMonthly.classList.add('active-label');
      labelYearly.classList.remove('active-label');
    }
  }

  if (toggleBtn && priceEl && periodEl) {
    labelMonthly.classList.add('active-label');
    
    toggleBtn.addEventListener('click', () => {
      isYearly = !isYearly;
      updatePricing();
    });
    
    labelMonthly.addEventListener('click', () => {
      isYearly = false;
      updatePricing();
    });

    labelYearly.addEventListener('click', () => {
      isYearly = true;
      updatePricing();
    });
  }

  // Language dropdown toggle logic
  const trigger = document.querySelector('.lang-dropdown-trigger');
  const menu = document.querySelector('.lang-dropdown-menu');

  if (trigger && menu) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
      menu.classList.toggle('show');
    });

    document.addEventListener('click', () => {
      trigger.setAttribute('aria-expanded', 'false');
      menu.classList.remove('show');
    });
  }

  const langItems = document.querySelectorAll('.lang-dropdown-item');
  langItems.forEach(item => {
    item.addEventListener('click', (e) => {
      const targetLang = item.getAttribute('data-lang') || 'fa';
      if (targetLang === 'fa' && !isIranServer) {
        e.preventDefault();
        e.stopPropagation();
        
        // Show redirect modal
        const modal = document.getElementById('iran-redirect-modal');
        if (modal) {
          modal.classList.add('show-modal');
        }
      } else {
        document.cookie = `lang=${targetLang}; path=/; max-age=31536000`;
        window.location.reload();
      }
    });
  });

  // Modal event listeners
  const redirectModal = document.getElementById('iran-redirect-modal');
  const closeRedirectBtn = document.getElementById('close-redirect-modal');
  const cancelRedirectBtn = document.getElementById('cancel-redirect-modal');
  const continueRedirectBtn = document.getElementById('continue-intl-fa');

  function hideRedirectModal() {
    if (redirectModal) {
      redirectModal.classList.remove('show-modal');
    }
  }

  closeRedirectBtn?.addEventListener('click', hideRedirectModal);
  cancelRedirectBtn?.addEventListener('click', hideRedirectModal);

  redirectModal?.addEventListener('click', (e) => {
    if (e.target === redirectModal) {
      hideRedirectModal();
    }
  });

  continueRedirectBtn?.addEventListener('click', () => {
    document.cookie = `lang=fa; path=/; max-age=31536000`;
    window.location.reload();
  });


  // ── Homepage Analytics Tracking ──────────────────────────────────────
  (function() {
    if (typeof window === 'undefined' || typeof window.fetch === 'undefined') return;

    const storage = {
      get(key) { try { return localStorage.getItem(key); } catch(e) { return null; } },
      set(key, val) { try { localStorage.setItem(key, val); } catch(e) {} },
      remove(key) { try { localStorage.removeItem(key); } catch(e) {} }
    };

    const SESSION_DURATION = 1 * 60 * 60 * 1000;
    const sessionKey = 'hp_session_id';
    const expiryKey = 'hp_session_expiry';
    const visitKey = 'hp_visit_sent';

    let sessionId = storage.get(sessionKey);
    let sessionExpiry = storage.get(expiryKey);
    const now = Date.now();

    if (!sessionId || !sessionExpiry || now > parseInt(sessionExpiry, 10)) {
      sessionId = Math.random().toString(36).substring(2, 15);
      storage.set(sessionKey, sessionId);
      storage.set(expiryKey, (now + SESSION_DURATION).toString());
      storage.remove(visitKey);
    }

    let uniqueVisit = false;
    if (storage.get(visitKey) !== 'true') {
      uniqueVisit = true;
      storage.set(visitKey, 'true');
    }

    fetch(`/api/analytics/homepage-track?v=${now}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pageView: true, uniqueVisit: uniqueVisit }),
      keepalive: true
    }).catch(() => {});
  })();

  // ── AI Crawler Form Handling ─────────────────────────────────────────
  const dropzone = document.getElementById('ai-dropzone');
  const fileInput = document.getElementById('ai-file-input');
  const filesList = document.getElementById('selected-files-list');
  const crawlForm = document.getElementById('ai-crawler-form');
  const crawlSubmitBtn = document.getElementById('ai-submit-btn');
  const crawlProgress = document.getElementById('ai-progress');
  const progressFill = document.getElementById('ai-progress-fill');
  const progressStatus = document.getElementById('ai-progress-status');

  let selectedFiles = [];

  if (dropzone && fileInput) {
    dropzone.addEventListener('click', () => fileInput.click());
    
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('dragover');
    });

    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('dragover');
    });

    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragover');
      if (e.dataTransfer.files) {
        handleFiles(e.dataTransfer.files);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files) {
        handleFiles(e.target.files);
      }
    });
  }

  function handleFiles(files) {
    for (const file of files) {
      if (file.type.startsWith('image/')) {
        selectedFiles.push(file);
      }
    }
    renderFilesList();
  }

  function renderFilesList() {
    if (!filesList) return;
    filesList.innerHTML = '';
    if (selectedFiles.length > 0) {
      filesList.style.display = 'grid';
      selectedFiles.forEach((file, index) => {
        const item = document.createElement('div');
        item.className = 'file-item';

        const img = document.createElement('img');
        img.style.width = '100%';
        img.style.height = '100%';
        img.style.objectFit = 'cover';
        
        const reader = new FileReader();
        reader.onload = (e) => {
          img.src = e.target.result;
        };
        reader.readAsDataURL(file);
        
        item.appendChild(img);

        const removeBtn = document.createElement('button');
        removeBtn.className = 'remove-file-btn';
        removeBtn.setAttribute('data-index', index);
        removeBtn.innerHTML = '&times;';
        item.appendChild(removeBtn);

        filesList.appendChild(item);
      });
      
      filesList.querySelectorAll('.remove-file-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = parseInt(btn.getAttribute('data-index'));
          selectedFiles.splice(idx, 1);
          renderFilesList();
        });
      });
      
      if (crawlSubmitBtn) crawlSubmitBtn.disabled = false;
    } else {
      filesList.style.display = 'none';
      if (crawlSubmitBtn) crawlSubmitBtn.disabled = true;
    }
  }

  // ── AI Dialog Trigger and Close Logic ──
  const aiTrigger = document.getElementById('ai-dialog-trigger');
  const aiDialog = document.getElementById('ai-dialog');
  const closeAiBtn = document.getElementById('close-ai-dialog');

  if (aiTrigger && aiDialog) {
    aiTrigger.addEventListener('click', () => {
      aiDialog.showModal();
    });
  }

  if (closeAiBtn && aiDialog) {
    closeAiBtn.addEventListener('click', () => {
      aiDialog.close();
    });
  }


  if (crawlForm) {
    crawlForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (selectedFiles.length === 0) return;

      crawlSubmitBtn.disabled = true;
      crawlProgress.style.display = 'flex';
      progressFill.style.width = '10%';
      progressStatus.textContent = crawlSubmitBtn.getAttribute('data-status-start') || 'Reading menu files...';

      // Read files as base64
      const base64Promises = selectedFiles.map(file => {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result);
          reader.onerror = err => reject(err);
          reader.readAsDataURL(file);
        });
      });

      try {
        const images = await Promise.all(base64Promises);
        
        progressFill.style.width = '30%';
        progressStatus.textContent = crawlSubmitBtn.getAttribute('data-status-upload') || 'Uploading images to AI...';

        // Simulate progress updates during API call
        let progress = 30;
        const progressInterval = setInterval(() => {
          if (progress < 85) {
            progress += Math.floor(Math.random() * 4) + 1;
            progressFill.style.width = `${progress}%`;
            if (progress < 60) {
              progressStatus.textContent = crawlSubmitBtn.getAttribute('data-status-processing') || 'AI is processing menu images...';
            } else {
              progressStatus.textContent = crawlSubmitBtn.getAttribute('data-status-extracting') || 'Extracting categories and products...';
            }
          }
        }, 1000);

        const response = await fetch('/api/ai/convert-paper-menu', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ images }),
        });

        clearInterval(progressInterval);
        const data = await response.json();

        if (response.ok && data.success) {
          progressFill.style.width = '100%';
          progressStatus.textContent = crawlSubmitBtn.getAttribute('data-status-success') || 'Done! Redirecting to preview...';
          setTimeout(() => {
            window.location.href = `/preview/${data.id}`;
          }, 800);
        } else {
          throw new Error(data.error || 'Failed to process menu.');
        }
      } catch (err) {
        crawlSubmitBtn.disabled = false;
        progressFill.style.width = '0%';
        crawlProgress.style.display = 'none';
        alert(err.message || crawlSubmitBtn.getAttribute('data-error-msg') || 'Failed to process menu images.');
      }
    });
  }
</script>

