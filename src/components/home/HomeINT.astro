const t = homeTranslations[currentLocale as Locale] || homeTranslations['en'];

---

<main class="marketing-container font-sans" style={`direction: ${currentLocale === 'fa' ? 'rtl' : 'ltr'};`}>
  <!-- Language & Login Top Bar -->
  <nav class="top-nav">
    <div class="top-nav-inner">
      <div class="lang-dropdown-container">
        <button class="lang-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="globe-icon w-4 h-4">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span>{currentLocale === 'fa' ? 'فارسی' : currentLocale === 'tr' ? 'Türkçe' : 'English'}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="lang-dropdown-menu">
          <button class={`lang-dropdown-item ${currentLocale === 'fa' ? 'active' : ''}`} data-lang="fa">فارسی</button>
          <button class={`lang-dropdown-item ${currentLocale === 'en' ? 'active' : ''}`} data-lang="en">English</button>
          <button class={`lang-dropdown-item ${currentLocale === 'tr' ? 'active' : ''}`} data-lang="tr">Türkçe</button>
        </div>
      </div>
      <a href="/admin" class="top-login-link">{t.ctaLogin}</a>
    </div>
  </nav>

  <div class="content-wrapper animate-slide-up">
    <!-- Big Centered Logo -->
    <div class="logo-container">
      <img src="/logo.png" alt="shottt logo" class="brand-logo-img" />
    </div>

    <!-- Hero Section -->
    <section class="message-section">
      <h1 class="main-statement">{t.heroTitle}</h1>
      <p class="sub-statement">{t.heroSubtitle}</p>
    </section>

    <!-- CTAs -->
    <div class="action-section">
      <a href="/admin/register" class="cta-btn primary-btn">
        <span>{t.ctaCreate}</span>
      </a>
      {enableConvertPaper && (
        <button id="ai-dialog-trigger" class="ai-trigger-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1.1rem; height: 1.1rem; margin-inline-end: 0.5rem;">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>{globalT('aiTriggerBtn')}</span>
        </button>
      )}
    </div>
  </div>

  <!-- Pricing Section -->
  <section class="pricing-section animate-slide-up" style="animation-delay: 0.1s;">
    <div class="pricing-header">
      <h2 class="pricing-title">{t.pricingTitle}</h2>
      <p class="pricing-subtitle">{t.pricingSubtitle}</p>
      
      <!-- Billing Switcher -->
      <div class="billing-toggle-container">
        <span class="toggle-label" id="label-monthly">{t.monthly}</span>
        <button class="billing-toggle" id="billing-toggle" aria-label="Toggle billing period">
          <span class="toggle-slider"></span>
        </button>
        <span class="toggle-label" id="label-yearly">{t.yearly}</span>
        <span class="save-badge">{t.save2Months}</span>
      </div>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="pricing-grid">
      <!-- Free Plan -->
      <div class="pricing-card card-glass">
        <div class="card-header">
          <h3 class="plan-name">{t.freeTitle}</h3>
          <p class="plan-desc">{t.freeDesc}</p>
          <div class="price-wrap">
            <span class="price-value">{t.freePrice}</span>
          </div>
        </div>
        <ul class="features-list">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{t.freeFeature1}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{t.freeFeature2}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{t.freeFeature3}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{t.freeFeature4}</span>
          </li>
        </ul>
        <a href="/admin/register" class="pricing-btn-action secondary-pricing-btn">{t.pricingBtn}</a>
      </div>

      <!-- Paid Plan -->
      <div class="pricing-card card-premium">
        <div class="premium-badge">Popular</div>
        <div class="card-header">
          <h3 class="plan-name">{t.paidTitle}</h3>
          <p class="plan-desc" style="color: rgba(255,255,255,0.7);">{t.paidDesc}</p>
          <div class="price-wrap">
            <span class="price-value" id="paid-price">{t.paidPriceMo}</span>
            <span class="price-period" id="paid-period">/ {t.paidPeriodMo}</span>
          </div>
        </div>
        <ul class="features-list premium-list">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{t.paidFeature1}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{t.paidFeature2}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{t.paidFeature3}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{t.paidFeature4}</span>
          </li>
        </ul>
        <a href="/admin/register" class="pricing-btn-action primary-pricing-btn">{t.pricingBtn}</a>
      </div>
    </div>
  </section>

  <!-- AI Converter Dialog (Modal) -->
  {enableConvertPaper && (
    <dialog id="ai-dialog" class="custom-dialog">
      <div class="dialog-wrapper" style="max-width: 30rem;">
        <header class="dialog-header">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <h2 class="dialog-title" style="margin: 0; font-size: 0.9375rem;">{globalT('aiTitle')}</h2>
            <span class="ai-badge" style="margin: 0; font-size: 0.625rem; padding: 0.25rem 0.6rem; background-color: #18181b; color: #ffffff; border-radius: 9999px; font-weight: 500;">{globalT('aiBadge')}</span>
          </div>
          <button id="close-ai-dialog" class="close-btn" aria-label={globalT('aiDialogClose')}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>
        <div class="dialog-body" style="padding: 1rem 0 0 0;">
          <p class="dialog-text" style="font-size: 0.75rem; margin: 0 0 1rem 0; line-height: 1.5;">
            {globalT('aiDesc')}
          </p>
          
          <form id="ai-crawler-form" class="ai-form" style="margin-top: 0.25rem;">
            <div class="ai-input-group" style="gap: 0.5rem;">
              <div class="image-upload-dropzone" id="ai-dropzone" style="padding: 1.5rem 1rem; border-radius: 0.75rem; border-style: dashed; border-width: 1px; gap: 0.35rem;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="upload-icon" style="width: 1.5rem; height: 1.5rem; color: #71717a;">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <span class="upload-text" style="font-size: 0.8125rem;">{globalT('aiDropzoneText')}</span>
                <span class="upload-subtext" style="font-size: 0.6875rem;">{globalT('aiDropzoneSubtext')}</span>
                <input type="file" id="ai-file-input" multiple accept="image/*" style="display: none;" />
              </div>
              <div id="selected-files-list" class="selected-files-list" style="display: none; font-size: 0.6875rem;"></div>
              <button 
                type="submit" 
                id="ai-submit-btn" 
                class="ai-btn" 
                disabled 
                data-status-start={globalT('aiProgressStart')}
                data-status-upload={globalT('aiProgressUpload')}
                data-status-processing={globalT('aiProgressProcessing')}
                data-status-extracting={globalT('aiProgressExtracting')}
                data-status-success={globalT('aiSuccess')}
                data-error-msg={globalT('aiErrorAlert')}
                style="padding: 0.75rem 1.5rem; font-size: 0.75rem; border-radius: 9999px; width: 100%; display: flex; align-items: center; justify-content: center;"
              >
                <span>{globalT('aiBtn')}</span>
              </button>
            </div>
          </form>
  
          <div id="ai-progress" class="ai-progress-container" style="display: none; margin-top: 1rem; flex-direction: column; gap: 0.5rem; width: 100%;">
            <div class="ai-progress-bar" style="height: 4px; background-color: #f4f4f5; border-radius: 2px; width: 100%; overflow: hidden;">
              <div id="ai-progress-fill" class="ai-progress-fill" style="width: 0%; height: 100%; background-color: #18181b; transition: width 0.3s ease;"></div>
            </div>
            <span id="ai-progress-status" class="ai-progress-status" style="font-size: 0.6875rem; color: #71717a;">{globalT('aiProgressStart')}</span>
          </div>
        </div>
      </div>
    </dialog>
  )}

  <!-- Featured Collections Section -->
  {randomVendors.length > 0 && (
    <section class="collections-section animate-slide-up" style="animation-delay: 0.2s;">
      <h2 class="collections-title">{t.featuredCatalogs}</h2>
      <div class="marquee-container">
        <div class="marquee-track">
          <div class="marquee-group">
            {marqueeItems.map((vendor) => (
              <a href={`/${vendor.slug}`} class="collection-card">
                <img src={vendor.logo} alt={vendor.name} class="collection-logo" loading="lazy" />
                <span class="collection-name">{vendor.name}</span>
              </a>
            ))}
          </div>
          {/* Duplicate group for seamless infinite looping */}
          <div class="marquee-group" aria-hidden="true">
            {marqueeItems.map((vendor) => (
              <a href={`/${vendor.slug}`} class="collection-card">
                <img src={vendor.logo} alt={vendor.name} class="collection-logo" loading="lazy" />
                <span class="collection-name">{vendor.name}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Footer -->
  <footer class="home-footer">
    <div class="footer-platform-link">
      {t.footerText}
      <img src="/logo.png" alt="shottt" class="footer-logo-img" />
    </div>
  </footer>
</main>

<!-- Iran Server Redirect Dialog/Modal -->
<div id="iran-redirect-modal" class="modal-overlay">
  <div class="modal-content" style="max-width: 450px; direction: rtl; text-align: right;">
    <div class="modal-header">
      <span class="modal-title">سرورهای ایران شات</span>
      <button type="button" class="modal-close" id="close-redirect-modal">&times;</button>
    </div>
    <div class="modal-body">
      <div style="display: flex; align-items: center; justify-content: center; background: #fffbeb; border-radius: 50%; width: 3.5rem; height: 3.5rem; color: #d97706; margin-bottom: 0.5rem;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-7 h-7" style="width: 1.75rem; height: 1.75rem;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <p style="font-size: 0.875rem; line-height: 1.7; color: #374151; margin: 0; text-align: center; font-family: 'Estedad', system-ui, -apple-system, sans-serif;">
        زیرساخت و سرورهای نسخه ایران مجزا هستند. اگر مشتریان یا کسب‌وکار شما در داخل ایران قرار دارند، پیشنهاد می‌شود از نسخه بهینه شده برای ایران استفاده کنید.
      </p>
    </div>
    <div class="modal-footer">
