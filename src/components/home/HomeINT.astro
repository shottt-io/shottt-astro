---
import { db } from '../../db/db';
import { vendors as vendorsTable } from '../../db/schema';
import { sql } from 'drizzle-orm';
const enableConvertPaper = import.meta.env.ENABLE_CONVERT_PAPER === 'true' || process.env.ENABLE_CONVERT_PAPER === 'true';

let randomVendors: Array<{ name: string; slug: string; logo: string }> = [];
try {
  randomVendors = await db
    .select({
      name: vendorsTable.name,
      slug: vendorsTable.slug,
      logo: vendorsTable.logo,
    })
    .from(vendorsTable)
    .orderBy(sql`random()`)
    .limit(10);
} catch (e) {
  console.warn("Could not load vendors from database:", e);
}

let marqueeItems = [...randomVendors];
while (marqueeItems.length > 0 && marqueeItems.length < 8) {
  marqueeItems = [...marqueeItems, ...randomVendors];
}

